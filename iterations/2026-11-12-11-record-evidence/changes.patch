diff --git a/tests/Prototypes/Ntfs/NtfsRecordEvidence.cs b/tests/Prototypes/Ntfs/NtfsRecordEvidence.cs
new file mode 100644
index 0000000..7c9e0f7
--- /dev/null
+++ b/tests/Prototypes/Ntfs/NtfsRecordEvidence.cs
@@ -0,0 +1,274 @@
+using System.Security.Cryptography;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+namespace DiskAtlas.NtfsPrototype;
+
+internal sealed record NtfsReplayReport(int Records, int Matching, int Mismatching);
+
+// Local-only, bounded reproduction evidence. Payloads are FILE record bodies,
+// never the IOCTL output header. This store is not connected to the live reader.
+internal sealed class NtfsRecordEvidence
+{
+    private const int MaximumBytes = 512 * 1024, MaximumManifest = 64 * 1024;
+    private const string Prefix = "ntfs-record-evidence-";
+    private readonly string nonce;
+    private readonly object gate = new();
+    internal string Root { get; }
+    private sealed record Entry(string CaseId, string Payload, int Length, string Sha256,
+        ulong Volume, ulong Reference, int SectorSize, int ClusterSize, ushort Major, ushort Minor,
+        string ExpectedCode, string ExpectedStatus);
+    private sealed record Manifest(int Schema, string Nonce, IReadOnlyList<Entry> Records);
+
+    private NtfsRecordEvidence(string root, string value) { Root = root; nonce = value; }
+    private static InvalidDataException Invalid() => new("EvidenceInvalid");
+    private static T Guard<T>(Func<T> action)
+    {
+        try { return action(); }
+        catch (InvalidDataException) { throw Invalid(); }
+        catch (JsonException) { throw Invalid(); }
+        catch (InvalidOperationException) { throw Invalid(); }
+        catch (ArgumentException) { throw Invalid(); }
+        catch (NotSupportedException) { throw Invalid(); }
+        catch (UnauthorizedAccessException) { throw new IOException("EvidenceIO"); }
+        catch (IOException) { throw new IOException("EvidenceIO"); }
+    }
+    private static bool ShortId(string value, int limit) => value != null &&
+        Regex.IsMatch(value, @"\A[A-Za-z][A-Za-z0-9-]{0," + (limit - 1) + @"}\z", RegexOptions.CultureInvariant);
+    private static string Full(string path)
+    {
+        if (string.IsNullOrEmpty(path) || !Path.IsPathFullyQualified(path)) throw Invalid();
+        return Path.TrimEndingDirectorySeparator(Path.GetFullPath(path));
+    }
+    private static void NoReparse(string path)
+    {
+        string? current = path;
+        while (current != null)
+        {
+            if ((File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0) throw Invalid();
+            current = Path.GetDirectoryName(current);
+        }
+    }
+    private static string Session(string directory)
+    {
+        string root = Full(directory), leaf = Path.GetFileName(root);
+        if (!Regex.IsMatch(leaf, @"\Antfs-record-evidence-[0-9a-f]{32}\z", RegexOptions.CultureInvariant) ||
+            !string.Equals(Path.GetFileName(Path.GetDirectoryName(root)), "artifacts", StringComparison.OrdinalIgnoreCase) ||
+            !Directory.Exists(root)) throw Invalid();
+        NoReparse(root);
+        return root;
+    }
+    internal static NtfsRecordEvidence Create(string artifactsRoot) => Guard(() =>
+    {
+        string parent = Full(artifactsRoot);
+        if (!string.Equals(Path.GetFileName(parent), "artifacts", StringComparison.OrdinalIgnoreCase) ||
+            !Directory.Exists(parent)) throw Invalid();
+        NoReparse(parent);
+        string nonce = Guid.NewGuid().ToString("N"), root = Path.Combine(parent, Prefix + nonce);
+        if (Directory.Exists(root) || File.Exists(root)) throw Invalid();
+        Directory.CreateDirectory(root);
+        bool complete = false;
+        var created = new HashSet<string>(StringComparer.Ordinal);
+        try
+        {
+            NoReparse(root);
+            string marker = Path.Combine(root, "marker.json"), manifest = Path.Combine(root, "manifest.json");
+            WriteNew(marker, JsonSerializer.SerializeToUtf8Bytes(new { Schema = 1, Nonce = nonce }), () => created.Add(marker));
+            WriteNew(manifest, JsonSerializer.SerializeToUtf8Bytes(new Manifest(1, nonce, [])), () => created.Add(manifest));
+            complete = true;
+            return new NtfsRecordEvidence(root, nonce);
+        }
+        finally
+        {
+            if (!complete)
+            {
+                NoReparse(root);
+                var actual = Directory.EnumerateFileSystemEntries(root).Take(3).ToArray();
+                if (actual.All(created.Contains))
+                {
+                    foreach (string path in actual) RemoveNew(root, path);
+                    Directory.Delete(root, false);
+                }
+            }
+        }
+    });
+
+    internal string Capture(string caseId, byte[] payload, ulong volume, ulong reference, int sectorSize,
+        int clusterSize, ushort major, ushort minor, string expectedCode) => Guard(() =>
+    {
+        lock (gate)
+        {
+            string root = Session(Root);
+            var entries = ReadManifest(root, nonce);
+            if (payload == null || payload.Length is < 1024 or > 65536 || payload.Length % 512 != 0 ||
+                !ShortId(caseId, 40) || !ShortId(expectedCode, 80) || !Geometry(sectorSize) || !Geometry(clusterSize)) throw Invalid();
+            if (entries.Count >= 6) return "LimitReached";
+            if (entries.Any(item => string.Equals(item.CaseId, caseId, StringComparison.OrdinalIgnoreCase))) throw Invalid();
+            // Own an immutable copy even if the caller reuses its input buffer.
+            byte[] owned = (byte[])payload.Clone();
+            var decoded = NtfsRecordDecoder.DecodeKernelReturned(owned, sectorSize,
+                reference & NtfsRecordDecoder.MaximumRecordNumber, clusterSize, major, minor);
+            string name = "record-" + (entries.Count + 1).ToString("D3", System.Globalization.CultureInfo.InvariantCulture) + ".bin";
+            var added = new Entry(caseId, name, owned.Length, Convert.ToHexString(SHA256.HashData(owned)), volume,
+                reference, sectorSize, clusterSize, major, minor, expectedCode, decoded.Status.ToString());
+            var next = entries.Append(added).ToArray();
+            byte[] json = JsonSerializer.SerializeToUtf8Bytes(new Manifest(1, nonce, next));
+            if (json.Length > MaximumManifest || owned.Length + json.Length + entries.Sum(item => item.Length) + 1024 > MaximumBytes)
+                return "LimitReached";
+            string pending = Path.Combine(root, "manifest.pending"), body = Path.Combine(root, name);
+            bool bodyCreated = false, pendingCreated = false, committed = false;
+            try
+            {
+                // Verify ownership again before creating any file. CreateNew never overwrites.
+                _ = ReadManifest(root, nonce);
+                WriteNew(body, owned, () => bodyCreated = true);
+                WriteNew(pending, json, () => pendingCreated = true);
+                NoReparse(root); NoReparse(body); NoReparse(pending); NoReparse(Path.Combine(root, "manifest.json"));
+                File.Move(pending, Path.Combine(root, "manifest.json"), true);
+                pendingCreated = false; committed = true;
+                return "Saved";
+            }
+            finally
+            {
+                if (!committed)
+                {
+                    // Only this attempt's exact new files are eligible for cleanup.
+                    try { if (pendingCreated) RemoveNew(root, pending); }
+                    finally { if (bodyCreated) RemoveNew(root, body); }
+                }
+            }
+        }
+    });
+
+    internal static NtfsReplayReport Replay(string sessionDirectory) => Guard(() =>
+    {
+        string root = Session(sessionDirectory);
+        var entries = ReadManifest(root, Path.GetFileName(root)[Prefix.Length..]);
+        int matching = 0;
+        foreach (var entry in entries)
+        {
+            byte[] bytes = ReadBounded(Path.Combine(root, entry.Payload), 65536);
+            if (bytes.Length != entry.Length || !string.Equals(Convert.ToHexString(SHA256.HashData(bytes)), entry.Sha256, StringComparison.Ordinal)) throw Invalid();
+            var decoded = NtfsRecordDecoder.DecodeKernelReturned(bytes, entry.SectorSize,
+                entry.Reference & NtfsRecordDecoder.MaximumRecordNumber, entry.ClusterSize, entry.Major, entry.Minor);
+            bool identity = decoded.Record == null || decoded.Record.Reference == entry.Reference;
+            if (decoded.Code == entry.ExpectedCode && decoded.Status.ToString() == entry.ExpectedStatus && identity) matching++;
+        }
+        return new NtfsReplayReport(entries.Count, matching, entries.Count - matching);
+    });
+
+    internal void DeleteOwned() => Guard(() =>
+    {
+        lock (gate)
+        {
+            string root = Session(Root);
+            var entries = ReadManifest(root, nonce);
+            // Never recurse: an unknown file, directory or reparse point prevents deletion.
+            foreach (var entry in entries) RemoveNew(root, Path.Combine(root, entry.Payload));
+            RemoveNew(root, Path.Combine(root, "manifest.json"));
+            RemoveNew(root, Path.Combine(root, "marker.json"));
+            NoReparse(root);
+            Directory.Delete(root, false);
+            return true;
+        }
+    });
+
+    private static bool Geometry(int value) => value is >= 512 and <= 65536 && (value & (value - 1)) == 0;
+    private static void Fields(JsonElement value, params string[] names)
+    {
+        if (value.ValueKind != JsonValueKind.Object) throw Invalid();
+        var seen = new HashSet<string>(StringComparer.Ordinal);
+        foreach (var field in value.EnumerateObject())
+            if (!names.Contains(field.Name, StringComparer.Ordinal) || !seen.Add(field.Name)) throw Invalid();
+        if (seen.Count != names.Length) throw Invalid();
+    }
+    private static string Text(JsonElement value, string name)
+    {
+        var item = value.GetProperty(name);
+        if (item.ValueKind != JsonValueKind.String) throw Invalid();
+        return item.GetString() ?? throw Invalid();
+    }
+    private static int Integer(JsonElement value, string name)
+    {
+        if (!value.GetProperty(name).TryGetInt32(out int number)) throw Invalid();
+        return number;
+    }
+    private static ulong Unsigned(JsonElement value, string name)
+    {
+        if (!value.GetProperty(name).TryGetUInt64(out ulong number)) throw Invalid();
+        return number;
+    }
+    private static List<Entry> ReadManifest(string root, string nonce)
+    {
+        root = Session(root);
+        if (Path.GetFileName(root) != Prefix + nonce) throw Invalid();
+        using (var marker = JsonDocument.Parse(ReadBounded(Path.Combine(root, "marker.json"), 1024)))
+        {
+            Fields(marker.RootElement, "Schema", "Nonce");
+            if (Integer(marker.RootElement, "Schema") != 1 || Text(marker.RootElement, "Nonce") != nonce) throw Invalid();
+        }
+        using var document = JsonDocument.Parse(ReadBounded(Path.Combine(root, "manifest.json"), MaximumManifest));
+        var manifest = document.RootElement;
+        Fields(manifest, "Schema", "Nonce", "Records");
+        if (Integer(manifest, "Schema") != 1 || Text(manifest, "Nonce") != nonce) throw Invalid();
+        var records = manifest.GetProperty("Records");
+        if (records.ValueKind != JsonValueKind.Array || records.GetArrayLength() > 6) throw Invalid();
+        var entries = new List<Entry>(6);
+        var cases = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        foreach (var value in records.EnumerateArray())
+        {
+            Fields(value, "CaseId", "Payload", "Length", "Sha256", "Volume", "Reference", "SectorSize", "ClusterSize", "Major", "Minor", "ExpectedCode", "ExpectedStatus");
+            string caseId = Text(value, "CaseId"), payload = Text(value, "Payload"), hash = Text(value, "Sha256"), code = Text(value, "ExpectedCode"), status = Text(value, "ExpectedStatus");
+            int length = Integer(value, "Length"), sector = Integer(value, "SectorSize"), cluster = Integer(value, "ClusterSize"), major = Integer(value, "Major"), minor = Integer(value, "Minor");
+            string expectedName = "record-" + (entries.Count + 1).ToString("D3", System.Globalization.CultureInfo.InvariantCulture) + ".bin";
+            if (!ShortId(caseId, 40) || !cases.Add(caseId) || payload != expectedName || !ShortId(code, 80) ||
+                !Regex.IsMatch(hash, @"\A[0-9A-F]{64}\z", RegexOptions.CultureInvariant) || length is < 1024 or > 65536 || length % 512 != 0 ||
+                !Geometry(sector) || !Geometry(cluster) || major is < 0 or > ushort.MaxValue || minor is < 0 or > ushort.MaxValue ||
+                status is not ("Decoded" or "Free" or "Invalid" or "Unsupported")) throw Invalid();
+            entries.Add(new(caseId, payload, length, hash, Unsigned(value, "Volume"), Unsigned(value, "Reference"), sector, cluster,
+                (ushort)major, (ushort)minor, code, status));
+        }
+        var allowed = new HashSet<string>(entries.Select(item => item.Payload), StringComparer.Ordinal) { "marker.json", "manifest.json" };
+        var files = Directory.EnumerateFileSystemEntries(root).Take(9).ToArray();
+        if (files.Length != allowed.Count) throw Invalid();
+        long bytes = 0;
+        foreach (string path in files)
+        {
+            NoReparse(path);
+            if (!allowed.Remove(Path.GetFileName(path)) || (File.GetAttributes(path) & FileAttributes.Directory) != 0) throw Invalid();
+            long length = new FileInfo(path).Length;
+            if (length < 0 || length > MaximumManifest || (bytes += length) > MaximumBytes) throw Invalid();
+        }
+        foreach (var entry in entries)
+        {
+            byte[] payload = ReadBounded(Path.Combine(root, entry.Payload), 65536);
+            if (payload.Length != entry.Length || Convert.ToHexString(SHA256.HashData(payload)) != entry.Sha256) throw Invalid();
+        }
+        return entries;
+    }
+    private static byte[] ReadBounded(string path, int maximum)
+    {
+        NoReparse(path);
+        using var stream = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read);
+        if (stream.Length < 1 || stream.Length > maximum) throw Invalid();
+        byte[] result = new byte[(int)stream.Length];
+        stream.ReadExactly(result);
+        if (stream.Position != stream.Length) throw Invalid();
+        NoReparse(path);
+        return result;
+    }
+    private static void WriteNew(string path, byte[] value, Action? created = null)
+    {
+        using var stream = new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.None);
+        created?.Invoke();
+        stream.Write(value);
+        stream.Flush(true);
+    }
+    private static void RemoveNew(string root, string path)
+    {
+        if (Path.GetDirectoryName(path) != root) throw Invalid();
+        NoReparse(root); NoReparse(path);
+        if ((File.GetAttributes(path) & FileAttributes.Directory) != 0) throw Invalid();
+        File.Delete(path);
+    }
+}
diff --git a/tests/Prototypes/Ntfs/NtfsRecordEvidenceTests.cs b/tests/Prototypes/Ntfs/NtfsRecordEvidenceTests.cs
new file mode 100644
index 0000000..bc3126c
--- /dev/null
+++ b/tests/Prototypes/Ntfs/NtfsRecordEvidenceTests.cs
@@ -0,0 +1,262 @@
+using System.Diagnostics;
+using System.Security.Cryptography;
+using System.Text.Json.Nodes;
+
+namespace DiskAtlas.NtfsPrototype;
+
+// Uses deterministic synthetic bytes and this invocation's temporary artifacts only.
+// No volume handles, personal paths, or original kernel records are read here.
+internal static class NtfsRecordEvidenceTests
+{
+    internal static int Run()
+    {
+        int passed = 0;
+        void Check(bool condition, string name)
+        {
+            if (!condition) throw new InvalidOperationException("NTFS record evidence check failed: " + name);
+            passed++;
+            Console.WriteLine("PASS NTFS record evidence " + name);
+        }
+        void Rejected(Action action, string name)
+        {
+            bool rejected = false;
+            try { action(); }
+            catch (InvalidDataException) { rejected = true; }
+            catch (IOException) { rejected = true; }
+            Check(rejected, name);
+        }
+
+        string temp = Path.GetFullPath(Path.GetTempPath());
+        string owner = Path.Combine(temp, "AsukaLens-record-evidence-" + Guid.NewGuid().ToString("N"));
+        string artifacts = Path.Combine(owner, "artifacts");
+        Directory.CreateDirectory(artifacts);
+        const ulong volume = 41;
+        ulong reference = NtfsRecordFixtures.Reference(52, 3);
+        ulong slot = reference & NtfsRecordDecoder.MaximumRecordNumber;
+        byte[] protectedRecord = NtfsRecordFixtures.File();
+        byte[] restoredRecord = (byte[])protectedRecord.Clone();
+        Array.Copy(restoredRecord, 50, restoredRecord, 510, 2);
+        Array.Copy(restoredRecord, 52, restoredRecord, 1022, 2);
+        byte[] mismatchedRecord = (byte[])protectedRecord.Clone();
+        NtfsRecordFixtures.U16(mismatchedRecord, 510, 0x1234);
+        string Code(byte[] bytes) => NtfsRecordDecoder.DecodeKernelReturned(bytes, 512, slot, 4096, 3, 1).Code;
+        string Capture(NtfsRecordEvidence evidence, string caseId, byte[] bytes, string? code = null) =>
+            evidence.Capture(caseId, bytes, volume, reference, 512, 4096, 3, 1, code ?? Code(bytes));
+        void ChildReplay(string directory, int expectedExit, string expectedSummary)
+        {
+            string host = Environment.ProcessPath ?? throw new InvalidOperationException("Evidence child host unavailable.");
+            var start = new ProcessStartInfo(host)
+            {
+                UseShellExecute = false,
+                CreateNoWindow = true,
+                RedirectStandardOutput = true,
+                RedirectStandardError = true
+            };
+            if (string.Equals(Path.GetFileNameWithoutExtension(host), "dotnet", StringComparison.OrdinalIgnoreCase))
+                start.ArgumentList.Add(typeof(NtfsRecordEvidenceTests).Assembly.Location);
+            start.ArgumentList.Add("--ntfs-record-replay");
+            start.ArgumentList.Add(directory);
+            using var process = Process.Start(start) ?? throw new InvalidOperationException("Evidence child did not start.");
+            var output = process.StandardOutput.ReadToEndAsync();
+            var errors = process.StandardError.ReadToEndAsync();
+            bool exited = process.WaitForExit(10000);
+            if (!exited)
+            {
+                try { process.Kill(entireProcessTree: true); }
+                finally { process.WaitForExit(2000); }
+            }
+            Check(exited, "independent replay process finishes within its time budget");
+            Check(Task.WaitAll([output, errors], 2000), "independent replay redirected streams complete");
+            // Never echo captured child output: only compare it with the fixed public contract.
+            Check(process.ExitCode == expectedExit && errors.Result.Length == 0 && output.Result.Length < 256 &&
+                output.Result.TrimEnd('\r', '\n') == expectedSummary,
+                "independent replay returns the expected fixed summary and exit status");
+        }
+
+        try
+        {
+            Check(Code(protectedRecord) == "Decoded", "protected control has a strict expected result");
+            Check(Code(restoredRecord) == "Decoded", "restored control has a strict expected result");
+            Check(Code(mismatchedRecord) == "FixupMismatch", "mismatched tails stay a strict failure");
+            var evidence = NtfsRecordEvidence.Create(artifacts);
+            string root = evidence.Root;
+            Check(Path.GetDirectoryName(root) == artifacts && Directory.Exists(root), "session is an owned direct child");
+            Check(Path.GetFileName(root).StartsWith("ntfs-record-evidence-", StringComparison.Ordinal), "session has a recognizable bounded name");
+            Check(Capture(evidence, "Protected", protectedRecord) == "Saved", "protected bytes are captured");
+            Check(Capture(evidence, "Restored", restoredRecord) == "Saved", "restored bytes are captured");
+            Check(Capture(evidence, "Mismatch", mismatchedRecord) == "Saved", "strict failure bytes can be captured without becoming success");
+            var report = NtfsRecordEvidence.Replay(root);
+            Check(report.Records == 3 && report.Matching == 3 && report.Mismatching == 0, "same-process disk reload reproduces all expected outcomes");
+            ChildReplay(root, 0, "NTFS record replay: records=3; matching=3; mismatching=0");
+            Check(protectedRecord.SequenceEqual(NtfsRecordFixtures.File()), "capture and replay leave caller bytes unchanged");
+
+            string manifest = Path.Combine(root, "manifest.json");
+            JsonObject document = JsonNode.Parse(File.ReadAllText(manifest))!.AsObject();
+            var records = document["Records"]!.AsArray();
+            Check(records.Count == 3, "manifest contains only saved records");
+            byte[][] originals = [protectedRecord, restoredRecord, mismatchedRecord];
+            for (int i = 0; i < originals.Length; i++)
+            {
+                var entry = records[i]!.AsObject();
+                string payload = entry["Payload"]!.GetValue<string>();
+                byte[] saved = File.ReadAllBytes(Path.Combine(root, payload));
+                Check(saved.SequenceEqual(originals[i]), "stored payload is byte exact");
+                Check(entry["Length"]!.GetValue<int>() == saved.Length, "stored payload length matches the original");
+                Check(string.Equals(entry["Sha256"]!.GetValue<string>(), Convert.ToHexString(SHA256.HashData(saved)), StringComparison.OrdinalIgnoreCase),
+                    "manifest hash binds the exact original payload");
+            }
+            byte[] manifestBytes = File.ReadAllBytes(manifest);
+            void AlterManifest(Action<JsonObject> change, Action assertion)
+            {
+                try
+                {
+                    var changed = JsonNode.Parse(manifestBytes)!.AsObject();
+                    change(changed);
+                    File.WriteAllText(manifest, changed.ToJsonString());
+                    assertion();
+                }
+                finally { File.WriteAllBytes(manifest, manifestBytes); }
+            }
+            void RejectManifest(Action<JsonObject> change, string name) =>
+                AlterManifest(change, () => Rejected(() => NtfsRecordEvidence.Replay(root), name));
+            void RejectRawManifest(Func<string, string> change, string name)
+            {
+                try
+                {
+                    string compact = JsonNode.Parse(manifestBytes)!.ToJsonString();
+                    File.WriteAllText(manifest, change(compact));
+                    Rejected(() => NtfsRecordEvidence.Replay(root), name);
+                }
+                finally { File.WriteAllBytes(manifest, manifestBytes); }
+            }
+            RejectRawManifest(x => "{\"Schema\":1," + x[1..], "duplicate JSON properties are rejected");
+            RejectRawManifest(x => "{\"schema\":1," + x[1..], "case-variant JSON properties are rejected");
+            RejectRawManifest(x => x.Insert(x.IndexOf("\"CaseId\":", StringComparison.Ordinal), "\"CaseId\":\"Injected\","),
+                "duplicate per-record JSON properties are rejected");
+            RejectManifest(x => x["Injected"] = "not permitted", "unknown manifest fields are rejected");
+            RejectManifest(x => x["Records"]![0]!["Injected"] = "not permitted", "unknown per-record fields are rejected");
+            RejectManifest(x => x["Schema"] = 999, "unknown schema cannot be replayed");
+            RejectManifest(x => x["Nonce"] = "not-the-owned-session", "manifest must match the owned session identity");
+            RejectManifest(x => x["Records"]![0]!["Payload"] = "../outside.bin", "payload path traversal is rejected");
+            RejectManifest(x => x["Records"]![0]!["Payload"] = Path.Combine(owner, "outside.bin"), "absolute payload paths are rejected");
+            RejectManifest(x => x["Records"]![0]!["CaseId"] = "../Injected", "injected case paths are rejected at replay");
+            RejectManifest(x => x["Records"]![1]!["CaseId"] = x["Records"]![0]!["CaseId"]!.GetValue<string>(), "duplicate case identities are rejected");
+            RejectManifest(x => x["Records"]![1]!["Payload"] = x["Records"]![0]!["Payload"]!.GetValue<string>(), "duplicate payload references are rejected");
+            RejectManifest(x => x["Records"]![0]!["Length"] = 65537, "declared oversized payload is rejected");
+            RejectManifest(x => x["Records"]![0]!["Sha256"] = new string('0', 64), "hash tampering is rejected");
+            RejectManifest(x => x["Records"]![0]!["ExpectedCode"] = "Injected\nMessage", "non-whitelisted expected result text is rejected");
+            AlterManifest(x => x["Records"]![0]!["ExpectedCode"] = "FixupMismatch", () =>
+            {
+                var different = NtfsRecordEvidence.Replay(root);
+                Check(different.Records == 3 && different.Matching == 2 && different.Mismatching == 1,
+                    "a legal expected-code disagreement remains a visible mismatch");
+                ChildReplay(root, 1, "NTFS record replay: records=3; matching=2; mismatching=1");
+            });
+            AlterManifest(x => x["Records"]![0]!["Reference"] = NtfsRecordFixtures.Reference(52, 4), () =>
+            {
+                var different = NtfsRecordEvidence.Replay(root);
+                Check(different.Records == 3 && different.Matching == 2 && different.Mismatching == 1,
+                    "decoded record sequence disagreement is a visible identity mismatch");
+            });
+            try
+            {
+                File.WriteAllBytes(manifest, new byte[512 * 1024 + 1]);
+                Rejected(() => NtfsRecordEvidence.Replay(root), "oversized manifest is rejected before parsing");
+            }
+            finally { File.WriteAllBytes(manifest, manifestBytes); }
+
+            string firstPayload = Path.Combine(root, records[0]!["Payload"]!.GetValue<string>());
+            byte[] firstBytes = File.ReadAllBytes(firstPayload);
+            try
+            {
+                byte[] altered = (byte[])firstBytes.Clone(); altered[100] ^= 1;
+                File.WriteAllBytes(firstPayload, altered);
+                Rejected(() => NtfsRecordEvidence.Replay(root), "payload modification is rejected by its hash");
+                File.WriteAllBytes(firstPayload, new byte[65537]);
+                Rejected(() => NtfsRecordEvidence.Replay(root), "actual oversized payload is rejected");
+            }
+            finally { File.WriteAllBytes(firstPayload, firstBytes); }
+            foreach (string caseId in new[] { "", "../escape", "bad/name", "bad\\name", "bad:name", "bad\0name", new string('x', 41) })
+                Rejected(() => Capture(evidence, caseId, protectedRecord), "invalid capture case identity is rejected");
+            Rejected(() => Capture(evidence, "Protected", protectedRecord), "capture refuses an existing case identity");
+            foreach (int length in new[] { 0, 512, 1025, 65537 })
+                Rejected(() => Capture(evidence, "InvalidSize", new byte[length], "RecordLength"), "capture rejects out-of-contract payload size");
+            Rejected(() => Capture(evidence, "BadCode", protectedRecord, "Injected\nCode"), "capture expected result is bounded controlled text");
+
+            string unknown = Path.Combine(root, "unknown.tmp");
+            File.WriteAllText(unknown, "synthetic interference");
+            Rejected(() => NtfsRecordEvidence.Replay(root), "unexpected session files block replay");
+            Rejected(evidence.DeleteOwned, "unknown files block owned deletion");
+            Check(File.Exists(unknown) && File.Exists(firstPayload), "refused deletion preserves all session files");
+            File.Delete(unknown);
+
+            string targetSentinel = Path.Combine(owner, "symlink-target.bin");
+            File.WriteAllBytes(targetSentinel, firstBytes);
+            bool linkCreated = false;
+            try
+            {
+                File.Delete(firstPayload);
+                try { File.CreateSymbolicLink(firstPayload, targetSentinel); linkCreated = true; }
+                catch (UnauthorizedAccessException) { Console.WriteLine("SKIP NTFS record evidence reparse checks: link capability unavailable"); }
+                catch (IOException) { Console.WriteLine("SKIP NTFS record evidence reparse checks: link capability unavailable"); }
+                if (linkCreated)
+                {
+                    Rejected(() => NtfsRecordEvidence.Replay(root), "a known payload name cannot redirect replay through a reparse entry");
+                    Rejected(evidence.DeleteOwned, "a known payload reparse entry blocks owned deletion");
+                    Check(File.ReadAllBytes(targetSentinel).SequenceEqual(firstBytes), "refused reparse deletion leaves its external target untouched");
+                }
+            }
+            finally
+            {
+                if (linkCreated) File.Delete(firstPayload);
+                File.WriteAllBytes(firstPayload, firstBytes);
+            }
+
+            for (int i = 4; i <= 5; i++)
+                Check(Capture(evidence, "Limit" + i, protectedRecord) == "Saved", "capture accepts records within the six-record budget");
+            Check(Capture(evidence, "MaximumSize", new byte[65536]) == "Saved", "exact 64 KiB payload endpoint is retained without truncation");
+            Check(Capture(evidence, "Seventh", protectedRecord) == "LimitReached", "seventh capture is explicitly limited");
+            var limited = NtfsRecordEvidence.Replay(root);
+            Check(limited.Records == 6 && limited.Matching == 6 && limited.Mismatching == 0, "limit refusal does not alter the six retained records");
+            Check(Directory.EnumerateFiles(root, "*.bin").Count() == 6, "limit refusal creates no extra binary sample");
+            evidence.DeleteOwned();
+            Check(!Directory.Exists(root) && Directory.Exists(artifacts), "owned cleanup removes its session and preserves the artifacts parent");
+            return passed;
+        }
+        finally
+        {
+            // Every path in this flat synthetic test owner was created above. Never follow links.
+            string full = Path.GetFullPath(owner);
+            if (Path.GetDirectoryName(full) != temp.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) ||
+                !Path.GetFileName(full).StartsWith("AsukaLens-record-evidence-", StringComparison.Ordinal))
+                throw new InvalidOperationException("NTFS record evidence cleanup boundary failed.");
+            if (Directory.Exists(full))
+            {
+                if ((File.GetAttributes(full) & FileAttributes.ReparsePoint) != 0) Directory.Delete(full);
+                else DeleteTree(full);
+            }
+        }
+    }
+
+    private static void DeleteTree(string directory)
+    {
+        // Check the directory itself before enumeration; a changed root must never redirect cleanup.
+        if ((File.GetAttributes(directory) & FileAttributes.ReparsePoint) != 0)
+        {
+            Directory.Delete(directory);
+            return;
+        }
+        foreach (string entry in Directory.EnumerateFileSystemEntries(directory))
+        {
+            FileAttributes attributes = File.GetAttributes(entry);
+            bool isDirectory = (attributes & FileAttributes.Directory) != 0;
+            if ((attributes & FileAttributes.ReparsePoint) != 0)
+            {
+                if (isDirectory) Directory.Delete(entry); else File.Delete(entry);
+            }
+            else if (isDirectory) DeleteTree(entry);
+            else File.Delete(entry);
+        }
+        Directory.Delete(directory);
+    }
+}
diff --git a/tests/Prototypes/Ntfs/README.md b/tests/Prototypes/Ntfs/README.md
index c59bbb3..b867112 100644
--- a/tests/Prototypes/Ntfs/README.md
+++ b/tests/Prototypes/Ntfs/README.md
@@ -68,6 +68,8 @@ pwsh -NoProfile -File tests/NtfsSpecialCostEvidence.Tests.ps1
 
 ## 合成夹具与依据
 
+`NtfsRecordEvidence` 提供本机有界正文留样与严格无卷重放；最多六条、每条 64 KiB，清单 64 KiB、会话总计 512 KiB。拒绝字段注入、重复/大小写变体字段、路径越界、哈希变化、重解析及未知文件；清理只针对当前实例明确拥有的平坦会话。重放匹配原错误码也计 Matching，不能将其当作解码通过。基础不接 Live，不保存 IOCTL 外层头，固定矩阵/真实留样、崩溃孤儿恢复及并发对抗尚未验收，见[基础记录](../../../iterations/2026-11-12-11-record-evidence/README.md)。
+
 `NtfsRecordFixtures` 在内存创建记录；测试覆盖 fixup、属性边界、UTF-16、空/驻留/非驻留文件、硬链接与 DOS 名称、簇几何、特殊类型的补查标记、取消和索引冲突，另有 512 次固定种子的有限变异检查。合成数据不是磁盘镜像；测试不是完整 NTFS 格式一致性认证。
 
 格式参考 Microsoft Learn 的 [FILE_RECORD_SEGMENT_HEADER](https://learn.microsoft.com/en-us/windows/win32/devnotes/file-record-segment-header)、[MULTI_SECTOR_HEADER](https://learn.microsoft.com/en-us/windows/win32/devnotes/multi-sector-header)、[ATTRIBUTE_RECORD_HEADER](https://learn.microsoft.com/en-us/windows/win32/devnotes/attribute-record-header)、[FILE_NAME](https://learn.microsoft.com/en-us/windows/win32/devnotes/file-name)。部分头部字段在公开结构中被保留，本原型的合成布局尚需未来独立来源和真实记录交叉验证；文件身份采用外部提供的槽号加记录序列，不猜测保留字段。

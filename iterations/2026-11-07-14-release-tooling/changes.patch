index 0000000..b4a8edc
--- /dev/null
+++ b/scripts/release/AsukaLens.iss
@@ -0,0 +1,245 @@
+; Compiler: pinned Inno Setup 7.1.1. No downloads, services or user-data removal.
+#ifndef AppVersion
+  #error AppVersion is required
+#endif
+#ifndef PayloadDir
+  #error PayloadDir is required
+#endif
+#ifndef OutputDir
+  #error OutputDir is required
+#endif
+#ifndef LocalTest
+  #define LocalTest 0
+#endif
+#if LocalTest
+  #define ProductName "AsukaLens (LOCAL TEST)"
+  #define ProductId "AsukaLens.LocalTest"
+#else
+  #define ProductName "AsukaLens"
+  #define ProductId "AsukaLens.8E3208AB-7151-4AC5-983C-22C5529B8746"
+#endif
+
+[Setup]
+AppId={#ProductId}
+AppName={#ProductName}
+AppVersion={#AppVersion}
+AppVerName={#ProductName} v{#AppVersion}
+AppPublisher=M66Y
+AppPublisherURL=https://github.com/M66Y/Hard-Drive-Space-Visualization
+DefaultDirName={localappdata}\Programs\{#ProductName}
+DefaultGroupName={#ProductName}
+PrivilegesRequired=lowest
+ArchitecturesAllowed=x64compatible and not arm64
+ArchitecturesInstallIn64BitMode=x64compatible
+MinVersion=10.0.22000
+LicenseFile={#PayloadDir}\LICENSE
+InfoBeforeFile={#PayloadDir}\INSTALL-NOTICE.txt
+SetupIconFile={#PayloadDir}\app.ico
+UninstallDisplayIcon={app}\AsukaLens.exe
+OutputDir={#OutputDir}
+OutputBaseFilename=AsukaLens v{#AppVersion}
+VersionInfoVersion={#AppVersion}.0
+VersionInfoProductName={#ProductName}
+Compression=lzma2
+SolidCompression=yes
+WizardStyle=modern
+DisableProgramGroupPage=yes
+AllowNoIcons=yes
+UsePreviousAppDir=yes
+UsePreviousTasks=yes
+CloseApplications=no
+RestartApplications=no
+RestartIfNeededByRun=no
+AppMutex=Local\AsukaLens.Running
+SetupMutex=Local\AsukaLens.Setup
+Uninstallable=yes
+UninstallLogging=yes
+
+[Languages]
+Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"
+Name: "english"; MessagesFile: "compiler:Default.isl"
+
+[Tasks]
+Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; Flags: unchecked
+
+[CustomMessages]
+chinesesimplified.BadVersion=无法读取已安装版本。请先修复或卸载该版本，再重新安装。
+english.BadVersion=Cannot read the installed version. Repair or uninstall it before proceeding.
+chinesesimplified.Downgrade=已经安装了更新版本。已取消降级，没有修改程序文件。
+english.Downgrade=A newer AsukaLens version is installed. Downgrade was cancelled; no files were changed.
+chinesesimplified.CloseFirst=请关闭所有 AsukaLens 窗口后重试。安装程序不会结束应用进程。
+english.CloseFirst=Close all AsukaLens windows, then retry. Setup will not terminate applications.
+chinesesimplified.UnsafeDirectory=目标文件夹已包含其他文件。请选择空文件夹，或保留已有 AsukaLens 的安装位置。
+english.UnsafeDirectory=Choose an empty folder or keep the registered AsukaLens installation directory.
+chinesesimplified.BackupFailed=无法备份原有程序文件，已停止安装。请关闭占用文件的程序并检查可用空间后重试。
+english.BackupFailed=Cannot back up an existing program file. Setup stopped. Close programs using it and check free space before retrying.
+chinesesimplified.RecoveryPending=存在未清理的安装恢复文件。请先根据 destinations.txt 恢复或检查备份，再重试。备份位置：%1
+english.RecoveryPending=Installation recovery files remain. Restore or review the backups using destinations.txt before retrying. Backup location: %1
+
+[Files]
+Source: "{#PayloadDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs; BeforeInstall: PreserveOriginal
+
+[Icons]
+Name: "{autoprograms}\{#ProductName}"; Filename: "{app}\AsukaLens.exe"; WorkingDir: "{app}"
+Name: "{autodesktop}\{#ProductName}"; Filename: "{app}\AsukaLens.exe"; WorkingDir: "{app}"; Tasks: desktopicon
+
+[Run]
+Filename: "{app}\AsukaLens.exe"; Description: "{cm:LaunchProgram,AsukaLens}"; Flags: nowait postinstall skipifsilent
+
+[Code]
+const
+  UninstallKey = 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{#ProductId}_is1';
+
+var
+  RecoveryDir: String;
+  Originals, Backups: TArrayOfString;
+  InstallCommitted: Boolean;
+
+function SetFileAttributesW(const Filename: String; Attributes: Cardinal): Boolean;
+  external 'SetFileAttributesW@kernel32.dll stdcall';
+
+function RecoveryParent(): String;
+begin
+  Result := ExpandConstant('{localappdata}\AsukaLens\InstallerRecovery-{#ProductId}');
+end;
+
+procedure PreserveOriginal();
+var
+  Destination, Backup, CandidateDir: String;
+  Count: Integer;
+begin
+  Destination := ExpandConstant(CurrentFilename);
+  if not FileExists(Destination) then Exit;
+  if RecoveryDir = '' then
+  begin
+    if not ForceDirectories(RecoveryParent()) then
+      RaiseException(CustomMessage('BackupFailed'));
+    CandidateDir := GenerateUniqueName(AddBackslash(RecoveryParent()), '.backup');
+    if not CreateDir(CandidateDir) then
+      RaiseException(CustomMessage('BackupFailed'));
+    RecoveryDir := CandidateDir;
+  end;
+  Count := GetArrayLength(Originals);
+  Backup := AddBackslash(RecoveryDir) + IntToStr(Count) + '.bak';
+  if not CopyFile(Destination, Backup, True) then
+  begin
+    DeleteFile(Backup);
+    RaiseException(CustomMessage('BackupFailed'));
+  end;
+  SetArrayLength(Originals, Count + 1);
+  SetArrayLength(Backups, Count + 1);
+  Originals[Count] := Destination;
+  Backups[Count] := Backup;
+  // Index N in this local-only file maps N.bak to its original destination.
+  if not SaveStringsToUTF8File(AddBackslash(RecoveryDir) + 'destinations.txt', Originals, False) then
+    RaiseException(CustomMessage('BackupFailed'));
+end;
+
+procedure CurStepChanged(CurStep: TSetupStep);
+begin
+  if CurStep = ssPostInstall then InstallCommitted := True;
+end;
+
+procedure DeinitializeSetup();
+var
+  I: Integer;
+  Restored, Cleaned: Boolean;
+begin
+  if RecoveryDir = '' then Exit;
+  Restored := True;
+  if not InstallCommitted then
+  begin
+    // Inno has rolled back new files/registration by this point, but does not
+    // restore overwritten files. Restore only the originals we actually backed up.
+    for I := GetArrayLength(Originals) - 1 downto 0 do
+    begin
+      if FileExists(Originals[I]) then SetFileAttributesW(Originals[I], $80);
+      if not CopyFile(Backups[I], Originals[I], False) then Restored := False;
+    end;
+  end;
+  if Restored then
+  begin
+    // No recursive deletion: only files created by this transaction are removed.
+    Cleaned := True;
+    for I := 0 to GetArrayLength(Backups) - 1 do
+    begin
+      SetFileAttributesW(Backups[I], $80);
+      if not DeleteFile(Backups[I]) then Cleaned := False;
+    end;
+    if Cleaned then
+    begin
+      DeleteFile(AddBackslash(RecoveryDir) + 'destinations.txt');
+      RemoveDir(RecoveryDir);
+      RemoveDir(RecoveryParent());
+    end;
+  end
+  else
+    SuppressibleMsgBox(FmtMessage(CustomMessage('RecoveryPending'), [RecoveryDir]), mbError, MB_OK, IDOK);
+end;
+
+function InitializeSetup(): Boolean;
+var
+  Previous: String;
+  OldVersion, NewVersion: Int64;
+begin
+  Result := False;
+  if RegQueryStringValue(HKCU64, UninstallKey, 'DisplayVersion', Previous) then
+  begin
+    if not StrToVersion(Previous, OldVersion) then
+    begin
+      SuppressibleMsgBox(CustomMessage('BadVersion'), mbError, MB_OK, IDOK);
+      Exit;
+    end;
+    StrToVersion('{#AppVersion}', NewVersion);
+    if ComparePackedVersion(OldVersion, NewVersion) > 0 then
+    begin
+      SuppressibleMsgBox(CustomMessage('Downgrade'), mbError, MB_OK, IDOK);
+      Exit;
+    end;
+  end;
+  Result := True;
+end;
+
+function PrepareToInstall(var NeedsRestart: Boolean): String;
+var
+  RegisteredDir, TargetDir: String;
+  Item: TFindRec;
+  IsUpgrade: Boolean;
+begin
+  Result := '';
+  if DirExists(RecoveryParent()) then
+  begin
+    Result := FmtMessage(CustomMessage('RecoveryPending'), [RecoveryParent()]);
+    Exit;
+  end;
+  if CheckForMutexes('Local\AsukaLens.Running') then
+  begin
+    Result := CustomMessage('CloseFirst');
+    Exit;
+  end;
+  TargetDir := RemoveBackslashUnlessRoot(ExpandConstant('{app}'));
+  IsUpgrade := RegQueryStringValue(HKCU64, UninstallKey, 'Inno Setup: App Path', RegisteredDir);
+  if IsUpgrade then
+    IsUpgrade := CompareText(TargetDir, RemoveBackslashUnlessRoot(RegisteredDir)) = 0;
+  if (not IsUpgrade) and FindFirst(AddBackslash(TargetDir) + '*', Item) then
+  begin
+    try
+      repeat
+        if (Item.Name <> '.') and (Item.Name <> '..') then
+        begin
+          Result := CustomMessage('UnsafeDirectory');
+          Break;
+        end;
+      until not FindNext(Item);
+    finally
+      FindClose(Item);
+    end;
+  end;
+end;
+
+function InitializeUninstall(): Boolean;
+begin
+  Result := not CheckForMutexes('Local\AsukaLens.Running');
+  if not Result then
+    SuppressibleMsgBox(CustomMessage('CloseFirst'), mbError, MB_OK, IDOK);
+end;
diff --git a/scripts/release/New-Release.ps1 b/scripts/release/New-Release.ps1
new file mode 100644
index 0000000..6b00538
--- /dev/null
+++ b/scripts/release/New-Release.ps1
@@ -0,0 +1,116 @@
+#requires -Version 7.4
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][string]$Version,
+    [Parameter(Mandatory)][string]$Commit,
+    [Parameter(Mandatory)][string]$Compiler,
+    [switch]$LocalTest,
+    [string]$OutputRoot = (Join-Path $PSScriptRoot '../../artifacts/releases')
+)
+. (Join-Path $PSScriptRoot 'Release.Common.ps1')
+$numeric = Assert-ReleaseVersion $Version
+$repository = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../..'))
+$OutputRoot = [IO.Path]::GetFullPath($OutputRoot)
+if ($OutputRoot.StartsWith($repository + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase) -and
+    -not $OutputRoot.StartsWith((Join-Path $repository 'artifacts') + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)) {
+    throw 'Inside the checkout, release output must be below artifacts/.'
+}
+if ($OutputRoot -eq $repository) { throw 'Cannot use the repository root for release output.' }
+$Compiler = (Resolve-Path -LiteralPath $Compiler).Path
+Assert-NoReparse $OutputRoot
+Assert-NoReparse $Compiler
+$tools = Get-Content -LiteralPath (Join-Path $PSScriptRoot 'toolchain.json') -Raw | ConvertFrom-Json
+if ((Get-FileHash -LiteralPath $Compiler).Hash.ToLowerInvariant() -ne $tools.iscc_sha256) { throw 'Compiler does not match the pinned toolchain.' }
+$compilerVersion = (& $Compiler --version).Trim()
+if ($LASTEXITCODE -ne 0 -or $compilerVersion -ne $tools.inno_version) { throw 'Unexpected compiler version.' }
+$compilerLicense = Join-Path (Split-Path -Parent $Compiler) 'License.txt'
+if ((Get-FileHash -LiteralPath $compilerLicense).Hash.ToLowerInvariant() -ne $tools.inno_license_sha256) { throw 'Compiler license does not match.' }
+$destination = Join-Path $OutputRoot ($Version + $(if ($LocalTest) { '-local-test' } else { '' }))
+if (Test-Path -LiteralPath $destination) { throw 'Snapshot already exists. Choose a new version or explicitly remove your disposable local-test output.' }
+[IO.Directory]::CreateDirectory($OutputRoot) | Out-Null
+$lock = [IO.File]::Open(($destination + '.lock'), [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
+$stage = Join-Path $OutputRoot ('.stage-' + [guid]::NewGuid().ToString('N'))
+$oldTelemetry = $env:DOTNET_CLI_TELEMETRY_OPTOUT
+$oldCertificate = $env:DOTNET_GENERATE_ASPNET_CERTIFICATE
+try {
+    New-Item -ItemType Directory -Path $stage | Out-Null
+    $source = Join-Path $stage 'source'
+    New-SourceSnapshot $repository $Commit $source -LocalTest:$LocalTest
+    [xml]$project = Get-Content -LiteralPath (Join-Path $source 'DiskAtlas.csproj') -Raw
+    if ([string]$project.Project.PropertyGroup.Version -ne $numeric) { throw 'Requested version does not match DiskAtlas.csproj.' }
+    $sourceFiles = @(Get-FileInventory $source)
+    $out = Join-Path $stage 'assets'
+    $payload = Join-Path $stage 'payload'
+    [IO.Directory]::CreateDirectory($out) | Out-Null
+    New-SourceArchives $source (Join-Path $out "AsukaLens $Version-source.zip") (Join-Path $out "AsukaLens $Version-source.tar.gz")
+    $cache = Join-Path $repository 'artifacts/release-cache'
+    Assert-NoReparse $cache
+    $env:DOTNET_CLI_TELEMETRY_OPTOUT = '1'
+    $env:DOTNET_GENERATE_ASPNET_CERTIFICATE = 'false'
+    Push-Location $source
+    try {
+        $sdk = (& dotnet --version).Trim()
+        if ($LASTEXITCODE -ne 0) { throw 'SDK unavailable.' }
+        Invoke-ReleaseTool dotnet @('publish','DiskAtlas.csproj','-c','Release','-r',$tools.rid,'--self-contained','true','--output',$payload,
+            '--nologo','-p:TargetPlatformDisplayName=Windows','-p:NuGetAudit=false','-p:DebugType=None','-p:DebugSymbols=false',
+            '-p:PublishSingleFile=false','-p:PublishTrimmed=false','-p:PublishAot=false',('-p:RuntimeFrameworkVersion='+$tools.runtime),
+            ('-p:RestorePackagesPath='+$cache),('-p:RestoreConfigFile='+(Join-Path $PSScriptRoot 'NuGet.release.config')),
+            ('-p:SourceRevisionId='+$Commit))
+    } finally { Pop-Location }
+    Move-Item -LiteralPath (Join-Path $payload 'DiskAtlas.exe') -Destination (Join-Path $payload 'AsukaLens.exe')
+    foreach ($name in @('LICENSE','NOTICE.md','licenses/CC-BY-NC-4.0.txt','assets/README.md','使用说明.txt','docs/diagnostics.md')) {
+        $target = Join-Path $payload $name
+        [IO.Directory]::CreateDirectory((Split-Path -Parent $target)) | Out-Null
+        Copy-Item -LiteralPath (Join-Path $source $name) -Destination $target
+    }
+    Copy-Item -LiteralPath (Join-Path $source 'assets/app.ico') -Destination (Join-Path $payload 'app.ico')
+    $licenseRoot = Join-Path $payload 'licenses/runtime'
+    foreach ($pack in @('microsoft.netcore.app.runtime.win-x64','microsoft.windowsdesktop.app.runtime.win-x64')) {
+        $packRoot = Join-Path $cache ($pack + '/' + $tools.runtime)
+        $licenses = @(Get-ChildItem -LiteralPath $packRoot -File | Where-Object { $_.Name -match '(?i)license|third.*notices' })
+        $minimum = if ($pack -like 'microsoft.netcore.*') { 2 } else { 1 }
+        if ($licenses.Count -lt $minimum) { throw 'Runtime license / notices missing.' }
+        $target = Join-Path $licenseRoot $pack
+        [IO.Directory]::CreateDirectory($target) | Out-Null
+        foreach ($license in $licenses) { Copy-Item -LiteralPath $license.FullName -Destination $target }
+    }
+    Copy-Item -LiteralPath $compilerLicense -Destination (Join-Path $payload 'licenses/Inno-Setup.txt')
+    $notice = @"
+AsukaLens $Version — M66Y
+Windows 11 x64; .NET $($tools.runtime) runtime included.
+Noncommercial use: project code uses PolyForm Noncommercial 1.0.0.
+Documentation/artwork use CC BY-NC 4.0. Third-party components retain their own licenses.
+See LICENSE, NOTICE.md and licenses/. AI-generated artwork by M66Y.
+Unzip the entire portable folder and launch AsukaLens.exe. No administrator rights are required.
+Settings, backgrounds and diagnostics remain in the current user's AppData, including portable mode.
+Uninstall removes program files and shortcuts; it keeps user data. Close the app before upgrading.
+
+简体中文：本版本内含 .NET 运行时。便携版完整解压后运行 AsukaLens.exe。
+仅供非商业用途，许可和署名见 LICENSE、NOTICE.md 和 licenses 目录。
+安装仅针对当前用户；升级前请关闭软件，卸载保留背景、诊断与问题记录。
+便携版设置仍保存于当前用户 AppData，详细操作见“使用说明.txt”。
+"@
+    if ($LocalTest) { $notice = "LOCAL TEST ONLY / 仅供本机验收，不得发布`r`n" + $notice }
+    [IO.File]::WriteAllText((Join-Path $payload 'INSTALL-NOTICE.txt'), $notice, [Text.UTF8Encoding]::new($true))
+    Write-ReleaseJson ([ordered]@{ schema=1; version=$Version; commit=$Commit; local_test=[bool]$LocalTest; runtime=$tools.runtime }) (Join-Path $payload 'build-info.json')
+    $payloadFiles = @(Get-FileInventory $payload)
+    [IO.Compression.ZipFile]::CreateFromDirectory($payload, (Join-Path $out "AsukaLens $Version.zip"), [IO.Compression.CompressionLevel]::Optimal, $false)
+    Invoke-ReleaseTool $Compiler @('--quiet','--no-ide-signtools',('--define=AppVersion='+$numeric),('--define=PayloadDir='+$payload),
+        ('--define=OutputDir='+$out),('--define=LocalTest='+[int][bool]$LocalTest),(Join-Path $PSScriptRoot 'AsukaLens.iss'))
+    $assets = @(Get-FileInventory $out)
+    $manifest = [ordered]@{ schema=1; product='AsukaLens'; version=$Version; commit=$Commit; local_test=[bool]$LocalTest;
+        source_kind=$(if ($LocalTest) {'working-tree'} else {'git-commit'}); rid=$tools.rid; self_contained=$true;
+        sdk=$sdk; runtime=$tools.runtime; inno=$compilerVersion; iscc_sha256=$tools.iscc_sha256;
+        assets=$assets; source_files=$sourceFiles; payload_files=$payloadFiles }
+    Write-ReleaseJson $manifest (Join-Path $out 'release-manifest.json')
+    [IO.File]::WriteAllLines((Join-Path $out 'SHA256SUMS.txt'), @($assets | ForEach-Object { $_.sha256 + '  ' + $_.path }), [Text.UTF8Encoding]::new($false))
+    & (Join-Path $PSScriptRoot 'Test-Release.ps1') -Directory $out | Out-Host
+    # Atomic promotion within one parent: incomplete runs never occupy a snapshot name.
+    Move-Item -LiteralPath $out -Destination $destination
+    Write-Host ('Verified local assets: ' + $destination)
+} finally {
+    [Environment]::SetEnvironmentVariable('DOTNET_CLI_TELEMETRY_OPTOUT',$oldTelemetry,'Process')
+    [Environment]::SetEnvironmentVariable('DOTNET_GENERATE_ASPNET_CERTIFICATE',$oldCertificate,'Process')
+    try { Remove-OwnedDirectory $stage $OutputRoot }
+    finally { $lock.Dispose(); Remove-Item -LiteralPath ($destination + '.lock') }
+}

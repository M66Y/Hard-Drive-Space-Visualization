--- /dev/null
+++ b/scripts/release/Release.Common.ps1
@@ -0,0 +1,202 @@
+#requires -Version 7.4
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+function Assert-ReleaseVersion([string]$Version) {
+    if ($Version -notmatch '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$') { throw 'Use vX.X.X without leading zeroes.' }
+    foreach ($part in $Version.Substring(1).Split('.')) {
+        if ([long]$part -gt 65535) { throw 'Version components must fit Windows version fields.' }
+    }
+    return $Version.Substring(1)
+}
+
+function Assert-SafeRelativePath([string]$Name) {
+    if ([string]::IsNullOrWhiteSpace($Name) -or $Name.StartsWith('/') -or $Name.Contains('\')) { throw 'Invalid relative path.' }
+    foreach ($part in $Name.Split('/')) {
+        if ($part -in @('', '.', '..') -or $part -match '[<>:"|?*\x00-\x1f]' -or $part -match '[. ]$' -or
+            $part -match '^(?i:CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\.|$)') { throw 'Unsafe archive path.' }
+    }
+}
+
+function Assert-SourcePath([string]$Name) {
+    Assert-SafeRelativePath $Name
+    if ($Name -match '(?i)(^|/)(\.git|\.codex|\.agents|\.aws|bin|obj|artifacts|软件|node_modules)(/|$)' -or $Name -match '^(?i:diagnostics)/' -or
+        $Name -match '(?i)(\.log|\.dmp|\.user|\.pfx|\.pem|\.key|\.exe|\.zip|\.tar\.gz)$' -or
+        $Name -match '(?i)(^|/)(background\.dat.*|problem-notes\.json.*|runtime-.*\.jsonl|\.env.*)$') {
+        throw 'Source contains an excluded file.'
+    }
+}
+
+function Assert-NoReparse([string]$Path) {
+    $item = [IO.Path]::GetFullPath($Path)
+    while ($item) {
+        if ((Test-Path -LiteralPath $item) -and ((Get-Item -LiteralPath $item -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) {
+            throw 'Reparse points are not allowed in release paths.'
+        }
+        $item = [IO.Path]::GetDirectoryName($item)
+    }
+}
+
+function Assert-SafeTree([string]$Path) {
+    Assert-NoReparse $Path
+    # Enumerate one level at a time so a junction is rejected before recursion.
+    foreach ($item in Get-ChildItem -LiteralPath $Path -Force) {
+        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Release tree contains a link.' }
+        if ($item.PSIsContainer) { Assert-SafeTree $item.FullName }
+    }
+}
+
+function Remove-OwnedDirectory([string]$Path, [string]$Parent) {
+    $absolute = [IO.Path]::GetFullPath($Path)
+    $boundary = [IO.Path]::GetFullPath($Parent).TrimEnd([IO.Path]::DirectorySeparatorChar) + [IO.Path]::DirectorySeparatorChar
+    if (-not $absolute.StartsWith($boundary, [StringComparison]::OrdinalIgnoreCase)) { throw 'Cleanup boundary violation.' }
+    if (Test-Path -LiteralPath $absolute) {
+        Assert-SafeTree $absolute
+        Remove-Item -LiteralPath $absolute -Recurse -Force
+    }
+}
+
+function Invoke-ReleaseTool([string]$File, [string[]]$Arguments) {
+    & $File @Arguments | Out-Host
+    if ($LASTEXITCODE -ne 0) { throw ('External tool failed: ' + [IO.Path]::GetFileName($File) + ', exit ' + $LASTEXITCODE) }
+}
+
+function Get-FileInventory([string]$Directory) {
+    Assert-SafeTree $Directory
+    $root = [IO.Path]::GetFullPath($Directory)
+    $files = @(Get-ChildItem -LiteralPath $root -Recurse -File -Force | Sort-Object FullName)
+    foreach ($file in $files) {
+        $relative = [IO.Path]::GetRelativePath($root, $file.FullName).Replace('\', '/')
+        Assert-SafeRelativePath $relative
+        [ordered]@{ path=$relative; bytes=$file.Length; sha256=(Get-FileHash -LiteralPath $file.FullName -Algorithm SHA256).Hash.ToLowerInvariant() }
+    }
+}
+
+function Write-ReleaseJson($Value, [string]$Path) {
+    [IO.File]::WriteAllText($Path, ($Value | ConvertTo-Json -Depth 12) + "`n", [Text.UTF8Encoding]::new($false))
+}
+
+function New-SourceSnapshot([string]$Repository, [string]$Commit, [string]$Destination, [switch]$LocalTest) {
+    if (Test-Path -LiteralPath $Destination) { throw 'Snapshot destination already exists.' }
+    $head = (& git -C $Repository rev-parse HEAD).Trim()
+    if ($LASTEXITCODE -ne 0 -or $Commit -notmatch '^[0-9a-f]{40}$') { throw 'An explicit full commit is required.' }
+    $resolved = & git -C $Repository rev-parse --verify ($Commit + '^{commit}')
+    if ($LASTEXITCODE -ne 0 -or $resolved.Trim() -ne $Commit) { throw 'Commit is unavailable.' }
+    foreach ($entry in (& git -C $Repository ls-tree -r $Commit)) {
+        if ($entry -notmatch '^100(644|755) blob ') { throw 'Source commit contains a link or submodule.' }
+    }
+    if ($LocalTest) {
+        if ($head -ne $Commit) { throw 'Local tests must identify the current HEAD as their baseline.' }
+        $names = (& git -C $Repository -c core.quotepath=false ls-files --cached --others --exclude-standard -z) -join "`n"
+    } else {
+        if ($head -ne $Commit -or (& git -C $Repository status --porcelain)) { throw 'Formal packages require a clean checkout at the requested commit.' }
+        $names = (& git -C $Repository -c core.quotepath=false ls-tree -r --name-only -z $Commit) -join "`n"
+    }
+    if ($LASTEXITCODE -ne 0) { throw 'Cannot enumerate source files.' }
+    $paths = @($names.Split([char]0, [StringSplitOptions]::RemoveEmptyEntries))
+    $seen = [Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
+    foreach ($name in $paths) {
+        Assert-SourcePath $name
+        if (-not $seen.Add($name)) { throw 'Duplicate source path.' }
+        Assert-NoReparse (Join-Path $Repository $name)
+    }
+    New-Item -ItemType Directory -Path $Destination | Out-Null
+    if ($LocalTest) {
+        foreach ($name in $paths) {
+            $target = Join-Path $Destination $name
+            [IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($target)) | Out-Null
+            [IO.File]::Copy((Join-Path $Repository $name), $target, $false)
+        }
+    } else {
+        # archive reads committed blobs, not autocrlf-transformed working-tree bytes.
+        $archive = $Destination + '.zip'
+        try {
+            Invoke-ReleaseTool git @('-C', $Repository, '-c', 'core.autocrlf=false', 'archive', '--format=zip', ('--output=' + $archive), $Commit)
+            [IO.Compression.ZipFile]::ExtractToDirectory($archive, $Destination)
+        } finally { if (Test-Path -LiteralPath $archive) { Remove-Item -LiteralPath $archive } }
+    }
+    Assert-SafeTree $Destination
+}
+
+function New-SourceArchives([string]$Source, [string]$Zip, [string]$TarGz) {
+    [IO.Compression.ZipFile]::CreateFromDirectory($Source, $Zip, [IO.Compression.CompressionLevel]::Optimal, $false)
+    $file = [IO.File]::Open($TarGz, [IO.FileMode]::CreateNew)
+    try {
+        $gzip = [IO.Compression.GZipStream]::new($file, [IO.Compression.CompressionLevel]::Optimal, $true)
+        try { [System.Formats.Tar.TarFile]::CreateFromDirectory($Source, $gzip, $false) }
+        finally { $gzip.Dispose() }
+    } finally { $file.Dispose() }
+}
+
+function Get-ArchiveInventory([string]$Path, [switch]$TarGz) {
+    $seen = [Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
+    $result = [Collections.Generic.List[object]]::new()
+    function Add-Entry([string]$Name, [long]$Length, [IO.Stream]$Stream) {
+        $Name = $Name -replace '^\./',''
+        Assert-SafeRelativePath $Name
+        if (-not $seen.Add($Name)) { throw 'Duplicate archive entry.' }
+        if ($null -eq $Stream -and $Length -ne 0) { throw 'Missing archive data stream.' }
+        $sha = [Security.Cryptography.SHA256]::HashData($(if ($null -eq $Stream) { [IO.Stream]::Null } else { $Stream }))
+        $result.Add([ordered]@{ path=$Name; bytes=$Length; sha256=[Convert]::ToHexString($sha).ToLowerInvariant() })
+    }
+    if ($TarGz) {
+        $file = [IO.File]::OpenRead($Path)
+        $gzip = [IO.Compression.GZipStream]::new($file, [IO.Compression.CompressionMode]::Decompress)
+        $reader = [System.Formats.Tar.TarReader]::new($gzip)
+        try {
+            while ($entry = $reader.GetNextEntry()) {
+                if ($entry.EntryType -eq [System.Formats.Tar.TarEntryType]::Directory) {
+                    $name = $entry.Name -replace '^\./',''
+                    if ($name.TrimEnd('/')) { Assert-SafeRelativePath $name.TrimEnd('/') }
+                    continue
+                }
+                if ($entry.EntryType -notin @([System.Formats.Tar.TarEntryType]::RegularFile, [System.Formats.Tar.TarEntryType]::V7RegularFile)) { throw 'Unsupported tar entry type.' }
+                Add-Entry $entry.Name $entry.Length $entry.DataStream
+            }
+        } finally { $reader.Dispose(); $gzip.Dispose(); $file.Dispose() }
+    } else {
+        $zip = [IO.Compression.ZipFile]::OpenRead($Path)
+        try {
+            foreach ($entry in $zip.Entries) {
+                if ($entry.FullName.EndsWith('/')) { Assert-SafeRelativePath $entry.FullName.TrimEnd('/'); continue }
+                if ((($entry.ExternalAttributes -shr 16) -band 0xF000) -eq 0xA000) { throw 'ZIP links are not allowed.' }
+                $stream = $entry.Open()
+                try { Add-Entry $entry.FullName $entry.Length $stream } finally { $stream.Dispose() }
+            }
+        } finally { $zip.Dispose() }
+    }
+    return $result.ToArray()
+}
+
+function Assert-SameInventory($Expected, $Actual) {
+    $expectedList = @($Expected | Sort-Object { $_.path })
+    $actualList = @($Actual | Sort-Object { $_.path })
+    if ($expectedList.Count -ne $actualList.Count) { throw 'Archive file count mismatch.' }
+    for ($i=0; $i -lt $expectedList.Count; $i++) {
+        if ($expectedList[$i].path -cne $actualList[$i].path -or $expectedList[$i].sha256 -ne $actualList[$i].sha256 -or
+            $expectedList[$i].bytes -ne $actualList[$i].bytes) { throw 'Archive file content mismatch.' }
+    }
+}
+
+function Assert-DraftState($Releases, [switch]$Resume) {
+    $list = @($Releases)
+    if ($list.Count -gt 1 -or ($list.Count -eq 1 -and (-not $list[0].draft -or -not $Resume))) {
+        throw 'Release exists; published snapshots cannot be changed, draft resumes must be explicit.'
+    }
+}
+
+function Get-MissingDraftFiles([string[]]$Files, $Assets) {
+    $names = @($Files | ForEach-Object { [IO.Path]::GetFileName($_) })
+    foreach ($asset in $Assets) {
+        if ($asset.name -cnotin $names) { throw 'Unexpected draft asset; review the draft without overwriting it.' }
+    }
+    foreach ($file in $Files) {
+        $name = [IO.Path]::GetFileName($file)
+        $matches = @($Assets | Where-Object { $_.name -ceq $name })
+        if ($matches.Count -gt 1) { throw 'Duplicate draft asset.' }
+        if ($matches.Count -eq 1) {
+            $digest = 'sha256:' + (Get-FileHash -LiteralPath $file).Hash.ToLowerInvariant()
+            if ($matches[0].digest -ne $digest) { throw 'Existing draft asset differs; refusing overwrite.' }
+        } else { $file }
+    }
+}
diff --git a/scripts/release/Test-Release.ps1 b/scripts/release/Test-Release.ps1
new file mode 100644
index 0000000..df131ff
--- /dev/null
+++ b/scripts/release/Test-Release.ps1
@@ -0,0 +1,66 @@
+#requires -Version 7.4
+[CmdletBinding()]
+param([Parameter(Mandatory)][string]$Directory)
+. (Join-Path $PSScriptRoot 'Release.Common.ps1')
+$Directory = (Resolve-Path -LiteralPath $Directory).Path
+Assert-SafeTree $Directory
+$manifest = Get-Content -LiteralPath (Join-Path $Directory 'release-manifest.json') -Raw | ConvertFrom-Json
+$numeric = Assert-ReleaseVersion $manifest.version
+if ($manifest.schema -ne 1 -or $manifest.product -ne 'AsukaLens' -or $manifest.commit -notmatch '^[0-9a-f]{40}$' -or
+    $manifest.rid -ne 'win-x64' -or $manifest.self_contained -ne $true -or $manifest.local_test -isnot [bool] -or
+    $manifest.source_kind -ne $(if ($manifest.local_test) { 'working-tree' } else { 'git-commit' })) { throw 'Invalid release manifest.' }
+$version = $manifest.version
+$expectedNames = @("AsukaLens $version.zip", "AsukaLens $version.exe", "AsukaLens $version-source.zip", "AsukaLens $version-source.tar.gz")
+$assetNames = @($manifest.assets | ForEach-Object { $_.path })
+if ($assetNames.Count -ne 4 -or (Compare-Object ($expectedNames | Sort-Object) ($assetNames | Sort-Object) -CaseSensitive)) { throw 'Exactly four correctly named assets are required.' }
+$expectedFiles = $expectedNames + @('release-manifest.json','SHA256SUMS.txt')
+if ((Get-ChildItem -LiteralPath $Directory -Force).Count -ne 6 -or
+    (Compare-Object ($expectedFiles | Sort-Object) @((Get-ChildItem -LiteralPath $Directory -Force).Name | Sort-Object) -CaseSensitive)) { throw 'Unexpected files in the release directory.' }
+foreach ($asset in $manifest.assets) {
+    Assert-SafeRelativePath $asset.path
+    $file = Get-Item -LiteralPath (Join-Path $Directory $asset.path)
+    if ($file.Length -ne $asset.bytes -or (Get-FileHash -LiteralPath $file.FullName).Hash.ToLowerInvariant() -ne $asset.sha256) { throw 'Asset checksum mismatch.' }
+}
+$checksumLines = @([IO.File]::ReadAllLines((Join-Path $Directory 'SHA256SUMS.txt')))
+$expectedChecksums = @($manifest.assets | ForEach-Object { $_.sha256 + '  ' + $_.path })
+if ($checksumLines.Count -ne 4 -or (Compare-Object $expectedChecksums $checksumLines)) { throw 'SHA256SUMS does not match the manifest.' }
+$sourceZip = @(Get-ArchiveInventory (Join-Path $Directory "AsukaLens $version-source.zip"))
+$sourceTar = @(Get-ArchiveInventory (Join-Path $Directory "AsukaLens $version-source.tar.gz") -TarGz)
+foreach ($file in $sourceZip) { Assert-SourcePath $file.path }
+Assert-SameInventory $manifest.source_files $sourceZip
+Assert-SameInventory $sourceZip $sourceTar
+$payload = @(Get-ArchiveInventory (Join-Path $Directory "AsukaLens $version.zip"))
+Assert-SameInventory $manifest.payload_files $payload
+$payloadNames = @($payload | ForEach-Object { $_.path })
+foreach ($required in @('AsukaLens.exe','DiskAtlas.dll','DiskAtlas.runtimeconfig.json','DiskAtlas.deps.json','coreclr.dll','hostfxr.dll','hostpolicy.dll',
+    'System.Private.CoreLib.dll','System.Windows.Forms.dll','LICENSE','NOTICE.md','licenses/CC-BY-NC-4.0.txt','licenses/Inno-Setup.txt','build-info.json','INSTALL-NOTICE.txt','使用说明.txt','docs/diagnostics.md')) {
+    if ($required -cnotin $payloadNames) { throw ('Payload is missing ' + $required) }
+}
+foreach ($pack in @('microsoft.netcore.app.runtime.win-x64','microsoft.windowsdesktop.app.runtime.win-x64')) {
+    $minimum = if ($pack -like 'microsoft.netcore.*') { 2 } else { 1 }
+    if (@($payloadNames | Where-Object { $_ -like "licenses/runtime/$pack/*" }).Count -lt $minimum) { throw 'Missing third-party runtime notices.' }
+}
+$zip = [IO.Compression.ZipFile]::OpenRead((Join-Path $Directory "AsukaLens $version.zip"))
+try {
+    function Read-ZipJson([string]$Name) {
+        $reader = [IO.StreamReader]::new($zip.GetEntry($Name).Open())
+        try { return ($reader.ReadToEnd() | ConvertFrom-Json) } finally { $reader.Dispose() }
+    }
+    $config = Read-ZipJson 'DiskAtlas.runtimeconfig.json'
+    if ($config.runtimeOptions.PSObject.Properties.Name -contains 'framework' -or $config.runtimeOptions.PSObject.Properties.Name -contains 'frameworks') { throw 'Payload still requires a shared runtime.' }
+    $frameworks = @($config.runtimeOptions.includedFrameworks)
+    if (@($frameworks | Where-Object { $_.name -eq 'Microsoft.NETCore.App' -and $_.version -eq $manifest.runtime }).Count -ne 1 -or
+        @($frameworks | Where-Object { $_.name -eq 'Microsoft.WindowsDesktop.App' -and $_.version -eq $manifest.runtime }).Count -ne 1) { throw 'Bundled runtime versions differ.' }
+    $identity = Read-ZipJson 'build-info.json'
+    if ($identity.version -ne $version -or $identity.commit -ne $manifest.commit -or $identity.local_test -ne $manifest.local_test) { throw 'Payload build identity mismatch.' }
+} finally { $zip.Dispose() }
+$installer = Join-Path $Directory "AsukaLens $version.exe"
+$exe = [IO.File]::OpenRead($installer)
+try { if ($exe.ReadByte() -ne 77 -or $exe.ReadByte() -ne 90) { throw 'Installer is not a Windows executable.' } }
+finally { $exe.Dispose() }
+$info = [Diagnostics.FileVersionInfo]::GetVersionInfo($installer)
+$fileVersion = '{0}.{1}.{2}.{3}' -f $info.FileMajorPart,$info.FileMinorPart,$info.FileBuildPart,$info.FilePrivatePart
+if ($info.ProductName.Trim() -ne $(if ($manifest.local_test) {'AsukaLens (LOCAL TEST)'} else {'AsukaLens'}) -or $fileVersion -ne ($numeric+'.0')) {
+    throw ("Installer metadata mismatch: product=$($info.ProductName), version=$fileVersion, expected=$numeric.0, local-test=$($manifest.local_test)")
+}
+[PSCustomObject]@{ Passed=$true; Version=$version; LocalTest=$manifest.local_test; Assets=4; SourceFiles=$sourceZip.Count; PayloadFiles=$payload.Count; PackageExecutionTested=$false }
diff --git a/scripts/release/Upload-Draft.ps1 b/scripts/release/Upload-Draft.ps1
new file mode 100644
index 0000000..d147bf5
--- /dev/null
+++ b/scripts/release/Upload-Draft.ps1
@@ -0,0 +1,71 @@
+#requires -Version 7.4
+[CmdletBinding(SupportsShouldProcess, ConfirmImpact='High')]
+param(
+    [Parameter(Mandatory)][string]$Directory,
+    [Parameter(Mandatory)][string]$Notes,
+    [Parameter(Mandatory)][string]$Acceptance,
+    [switch]$Resume
+)
+. (Join-Path $PSScriptRoot 'Release.Common.ps1')
+$Directory = (Resolve-Path -LiteralPath $Directory).Path
+& (Join-Path $PSScriptRoot 'Test-Release.ps1') -Directory $Directory | Out-Host
+$manifest = Get-Content -LiteralPath (Join-Path $Directory 'release-manifest.json') -Raw | ConvertFrom-Json
+if ($manifest.local_test) { throw 'Local-test assets can never be uploaded by this script.' }
+$repository = 'M66Y/Hard-Drive-Space-Visualization'
+$qualifiedRepository = 'github.com/' + $repository
+$notesText = Get-Content -LiteralPath $Notes -Raw -Encoding utf8
+if ($notesText -notmatch '(?m)^## 简体中文' -or $notesText -notmatch '(?m)^## English' -or -not $notesText.Contains($manifest.version)) { throw 'Provide reviewed bilingual release notes with the exact version.' }
+$accepted = Get-Content -LiteralPath $Acceptance -Raw | ConvertFrom-Json
+if ($accepted.commit -ne $manifest.commit -or $accepted.manifest_sha256 -ne (Get-FileHash -LiteralPath (Join-Path $Directory 'release-manifest.json')).Hash.ToLowerInvariant()) { throw 'Acceptance does not cover these assets.' }
+foreach ($check in @('clean_windows_no_dotnet','portable_workflow','install_upgrade_uninstall','failure_recovery','source_builds','privacy_and_licenses')) {
+    if ($accepted.checks.$check -ne 'passed') { throw ('Package acceptance is incomplete: ' + $check) }
+}
+if ($WhatIfPreference) {
+    $PSCmdlet.ShouldProcess("$repository / $($manifest.version)",'Create or resume a draft; remote commit/tag/draft checks will run on execution') | Out-Null
+    return
+}
+$gh = (Get-Command gh -CommandType Application -ErrorAction Stop).Source
+function Gh-Json([string[]]$Arguments) {
+    $text = & $gh @Arguments --hostname github.com -H 'X-GitHub-Api-Version: 2026-03-10'
+    if ($LASTEXITCODE -ne 0) { throw 'GitHub query failed; no changes made by this query.' }
+    return ($text -join "`n" | ConvertFrom-Json)
+}
+$remote = Gh-Json @('api',"repos/$repository/commits/$($manifest.commit)")
+if ($remote.sha -ne $manifest.commit) { throw 'Release commit is not available in the target repository.' }
+# A pre-existing exact tag is required: this script cannot create or move tags.
+$tag = Gh-Json @('api',"repos/$repository/git/ref/tags/$($manifest.version)")
+$tagObject = $tag.object
+if ($tagObject.type -eq 'tag') { $tagObject = (Gh-Json @('api',"repos/$repository/git/tags/$($tagObject.sha)")).object }
+if ($tagObject.type -ne 'commit' -or $tagObject.sha -ne $manifest.commit) { throw 'Tag points to another commit.' }
+$releases = Gh-Json @('api',"repos/$repository/releases",'--paginate','--slurp')
+$existing = @($releases | ForEach-Object { foreach ($release in $_) { $release } } | Where-Object { $_.tag_name -eq $manifest.version })
+Assert-DraftState $existing -Resume:$Resume
+$uploads = @($manifest.assets | ForEach-Object { Join-Path $Directory $_.path }) + @((Join-Path $Directory 'SHA256SUMS.txt'),(Join-Path $Directory 'release-manifest.json'))
+if (-not $PSCmdlet.ShouldProcess("$repository / $($manifest.version)",'Create or resume a draft and upload verified assets; never publish')) { return }
+if ($existing.Count -eq 0) {
+    Invoke-ReleaseTool $gh @('release','create',$manifest.version,'--repo',$qualifiedRepository,'--draft','--verify-tag','--title',('AsukaLens '+$manifest.version),'--notes-file',(Resolve-Path -LiteralPath $Notes).Path)
+}
+# The by-tag REST endpoint targets published releases; list with push credentials to locate drafts.
+$pages = Gh-Json @('api',"repos/$repository/releases",'--paginate','--slurp')
+$drafts = @($pages | ForEach-Object { foreach ($release in $_) { $release } } | Where-Object { $_.tag_name -eq $manifest.version })
+if ($drafts.Count -ne 1) { throw 'The expected draft was not returned; check authentication and repository permissions.' }
+$draft = $drafts[0]
+Assert-DraftState @($draft) -Resume
+$missing = @(Get-MissingDraftFiles $uploads $draft.assets)
+foreach ($file in $missing) {
+    $current = Gh-Json @('api',"repos/$repository/releases/$($draft.id)")
+    Assert-DraftState @($current) -Resume
+    Invoke-ReleaseTool $gh @('release','upload',$manifest.version,$file,'--repo',$qualifiedRepository)
+}
+$download = Join-Path $Directory ('.verify-download-' + [guid]::NewGuid().ToString('N'))
+try {
+    [IO.Directory]::CreateDirectory($download) | Out-Null
+    Invoke-ReleaseTool $gh @('release','download',$manifest.version,'--repo',$qualifiedRepository,'--dir',$download)
+    foreach ($file in $uploads) {
+        if ((Get-FileHash -LiteralPath $file).Hash -ne (Get-FileHash -LiteralPath (Join-Path $download ([IO.Path]::GetFileName($file)))).Hash) { throw 'Downloaded draft asset differs.' }
+    }
+    & (Join-Path $PSScriptRoot 'Test-Release.ps1') -Directory $download | Out-Host
+} finally { Remove-OwnedDirectory $download $Directory }
+$current = Gh-Json @('api',"repos/$repository/releases/$($draft.id)")
+Assert-DraftState @($current) -Resume
+Write-Host 'Draft assets downloaded and verified. Release remains unpublished.'

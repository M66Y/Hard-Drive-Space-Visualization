diff --git a/tests/Prototypes/Ntfs/NtfsSpecialCostExperiment.cs b/tests/Prototypes/Ntfs/NtfsSpecialCostExperiment.cs
new file mode 100644
index 0000000..623a71c
--- /dev/null
+++ b/tests/Prototypes/Ntfs/NtfsSpecialCostExperiment.cs
@@ -0,0 +1,147 @@
+using System.Diagnostics;
+
+namespace DiskAtlas.NtfsPrototype;
+
+internal sealed record NtfsSpecialCostSample(int Round, string Order, double ReferenceMilliseconds, double LeaseMilliseconds);
+internal sealed record NtfsSpecialCostReport(int Objects, int ReferenceCalls, int LeaseCalls, int HandlesOpened,
+    int SnapshotReads, IReadOnlyList<NtfsSpecialCostSample> Samples);
+
+// Warm-cache cost observation over four already decoded, known fixture objects.
+// The reference is today's one-snapshot NativeStorage read; the lease applies
+// stricter identity/metadata stability checks. Their guarantees are not equivalent.
+// These intervals exclude MFT acquisition, creation, indexing, UI, external result verification and
+// warm-up. Callback/handle/group counts are not Win32-call or physical-I/O counts.
+internal static class NtfsSpecialCostExperiment
+{
+    private sealed record ReferenceRun(FileStorageInfo?[] Values, int Calls, double Milliseconds);
+    private sealed record LeaseRun(NtfsLookupBatch Batch, IReadOnlyList<(NtfsLookupItem Item, NtfsLeaseResult Result)> Raw,
+        int Calls, int Handles, int Snapshots, bool AllSuccessful, double Milliseconds);
+
+    internal static NtfsSpecialCostReport Run(IReadOnlyList<NtfsLookupItem> items, Action<bool, string> check)
+    {
+        void Require(bool condition, string code)
+        {
+            check(condition, code);
+            if (!condition) throw new InvalidOperationException(code);
+        }
+        Require(items.Count <= NtfsSizeLookup.MaximumObjects, "SpecialCostInputBound");
+        var candidates = items.Where(item => item.Record.LookupReasons is NtfsLookupReason.Compressed or NtfsLookupReason.Sparse).ToArray();
+        Require(candidates.Length == 4, "SpecialCostFixtureBound");
+        var expected = new Dictionary<(ulong Volume, ulong Reference), (long Logical, long Allocated)>();
+
+        FileStorageInfo? Read(NtfsLookupItem item) =>
+            NativeStorage.TryRead(item.Path, false, FileAttributes.Normal, out var storage, out _) ? storage : null;
+        bool Bound(NtfsLookupItem input, FileStorageInfo? observed)
+        {
+            int links = input.Record.Names.Where(name => name.Namespace != 2)
+                .Select(name => (name.ParentReference, name.Name)).Distinct().Count();
+            return observed != null && observed.Identity == new FileIdentity(input.Volume, input.Record.Reference, 0) &&
+                observed.LogicalBytes == input.Record.LogicalBytes && observed.LogicalBytes >= 0 && observed.AllocatedBytes >= 0 &&
+                !observed.WritableHandleOpen && observed.Modified.HasValue && observed.LinkCount == links;
+        }
+        foreach (var input in candidates)
+        {
+            Require(NtfsSpecialLease.Preflight(input.Record, input.Path) == null, "SpecialCostEligibleInput");
+            var native = Read(input);
+            Require(Bound(input, native), "SpecialCostInitialReference");
+            Require(expected.TryAdd((input.Volume, input.Record.Reference), (native!.LogicalBytes, native.AllocatedBytes)),
+                "SpecialCostUniqueObject");
+        }
+
+        ReferenceRun RunReference()
+        {
+            var clock = Stopwatch.StartNew();
+            int calls = 0;
+            var values = new FileStorageInfo?[candidates.Length];
+            for (int i = 0; i < candidates.Length; i++)
+            {
+                calls++;
+                values[i] = Read(candidates[i]);
+            }
+            clock.Stop();
+            return new(values, calls, clock.Elapsed.TotalMilliseconds);
+        }
+        LeaseRun RunLease()
+        {
+            var clock = Stopwatch.StartNew();
+            int calls = 0, handles = 0, snapshots = 0;
+            bool allSuccessful = true;
+            var raw = new List<(NtfsLookupItem, NtfsLeaseResult)>(candidates.Length);
+            var batch = NtfsSizeLookup.ResolveSpecialWithLease(candidates, (item, token) =>
+            {
+                calls++;
+                var result = NtfsSpecialLease.Read(item.Volume, item.Record, item.Path, token);
+                handles = checked(handles + result.HandlesOpened);
+                snapshots = checked(snapshots + result.SnapshotReads);
+                allSuccessful &= result.Success;
+                raw.Add((item, result));
+                return result;
+            });
+            clock.Stop();
+            return new(batch, raw.AsReadOnly(), calls, handles, snapshots, allSuccessful, clock.Elapsed.TotalMilliseconds);
+        }
+        bool ValidTime(double value) => double.IsFinite(value) && value >= 0;
+        void ValidateReference(ReferenceRun run)
+        {
+            Require(run.Calls == candidates.Length && run.Values.Length == candidates.Length, "SpecialCostReferenceBudget");
+            for (int i = 0; i < candidates.Length; i++)
+            {
+                var input = candidates[i];
+                var native = run.Values[i];
+                var value = expected[(input.Volume, input.Record.Reference)];
+                Require(Bound(input, native) && native!.LogicalBytes == value.Logical && native.AllocatedBytes == value.Allocated,
+                    "SpecialCostReferenceValues");
+            }
+            Require(ValidTime(run.Milliseconds), "SpecialCostReferenceTime");
+        }
+        void ValidateLease(LeaseRun run)
+        {
+            Require(run.Batch.Complete && run.Batch.Code == "ResolvedBatch" && run.Batch.Items.Count == candidates.Length &&
+                run.Batch.Metrics.Objects == candidates.Length && run.Batch.Metrics.EligibleObjects == candidates.Length &&
+                run.Batch.Metrics.ResolvedObjects == candidates.Length && run.Batch.Metrics.FailedObjects == 0 &&
+                run.Batch.Metrics.UnsupportedObjects == 0, "SpecialCostLeaseComplete");
+            Require(run.AllSuccessful && run.Calls == candidates.Length && run.Handles == candidates.Length &&
+                run.Snapshots == candidates.Length * 2 && run.Raw.Count == candidates.Length &&
+                run.Batch.Metrics.NativeCalls == candidates.Length, "SpecialCostLeaseWorkBudget");
+            foreach (var (input, result) in run.Raw)
+            {
+                var value = expected[(input.Volume, input.Record.Reference)];
+                Require(result.Success && result.HandlesOpened == 1 && result.SnapshotReads == 2 && Bound(input, result.Storage) &&
+                    result.Storage!.LogicalBytes == value.Logical && result.Storage.AllocatedBytes == value.Allocated,
+                    "SpecialCostNativeLeaseValues");
+            }
+            Require(run.Batch.Items.Select(item => (item.Volume, item.Reference)).Distinct().Count() == candidates.Length,
+                "SpecialCostLeaseUniqueOutput");
+            foreach (var output in run.Batch.Items)
+            {
+                Require(expected.TryGetValue((output.Volume, output.Reference), out var value) &&
+                    output.LogicalBytes == value.Logical && output.AllocatedBytes == value.Allocated &&
+                    output.LogicalSource == NtfsSizeSource.Record && output.AllocatedSource == NtfsSizeSource.HandleLookup &&
+                    output.Code == "SpecialLookup", "SpecialCostPublishedValues");
+            }
+            Require(ValidTime(run.Milliseconds), "SpecialCostLeaseTime");
+        }
+
+        // Pre-read reference acquisition above and one warm-up per strategy are
+        // outside the six timed rounds and their reported per-batch counts.
+        ValidateReference(RunReference());
+        ValidateLease(RunLease());
+        var samples = new List<NtfsSpecialCostSample>(6);
+        ReferenceRun? lastReference = null;
+        LeaseRun? lastLease = null;
+        for (int round = 0; round < 6; round++)
+        {
+            ReferenceRun reference;
+            LeaseRun lease;
+            if (round % 2 == 0) { reference = RunReference(); lease = RunLease(); }
+            else { lease = RunLease(); reference = RunReference(); }
+            ValidateReference(reference);
+            ValidateLease(lease);
+            samples.Add(new(round + 1, round % 2 == 0 ? "reference-first" : "lease-first", reference.Milliseconds, lease.Milliseconds));
+            lastReference = reference;
+            lastLease = lease;
+        }
+        return new(candidates.Length, lastReference!.Calls, lastLease!.Calls, lastLease.Handles, lastLease.Snapshots,
+            samples.AsReadOnly());
+    }
+}
diff --git a/tests/Prototypes/Ntfs/NtfsSpecialEvidence.cs b/tests/Prototypes/Ntfs/NtfsSpecialEvidence.cs
new file mode 100644
index 0000000..9ae65f5
--- /dev/null
+++ b/tests/Prototypes/Ntfs/NtfsSpecialEvidence.cs
@@ -0,0 +1,59 @@
+namespace DiskAtlas.NtfsPrototype;
+
+internal sealed record NtfsSpecialCaseResult(string Kind, long LogicalBytes, long AllocatedBytes, string Source);
+internal sealed record NtfsSpecialLookupReport(int Objects, int CompressedObjects, int SparseObjects, int UnsupportedObjects,
+    int ResolvedObjects, int FailedObjects, int LeaseCalls, int HandlesOpened, int SnapshotReads,
+    IReadOnlyList<NtfsSpecialCaseResult> Cases);
+
+// Correctness evidence only: no paths, object IDs, native messages or timing.
+internal static class NtfsSpecialEvidence
+{
+    internal static NtfsSpecialLookupReport Run(IReadOnlyList<(string Kind, NtfsLookupItem Item)> supported,
+        IReadOnlyList<NtfsLookupItem> unsupported, Action<bool, string> check)
+    {
+        void Require(bool condition, string code)
+        { check(condition, code); if (!condition) throw new InvalidOperationException(code); }
+        string[] kinds = ["CompressedZero", "CompressedRandom", "SparseHole", "SparseWritten"];
+        Require(supported.Count is > 0 and <= 4 && supported.Count + unsupported.Count <= 16, "SpecialEvidenceBound");
+        Require(supported.Select(item => item.Kind).Distinct().Count() == supported.Count &&
+            supported.All(item => kinds.Contains(item.Kind)), "SpecialEvidenceKinds");
+        var items = supported.Select(item => item.Item).Concat(unsupported).ToArray();
+        int calls = 0, handles = 0, snapshots = 0;
+        bool allSuccessful = true;
+        var batch = NtfsSizeLookup.ResolveSpecialWithLease(items, (item, token) =>
+        {
+            calls++;
+            var result = NtfsSpecialLease.Read(item.Volume, item.Record, item.Path, token);
+            handles += result.HandlesOpened; snapshots += result.SnapshotReads;
+            allSuccessful &= result.Success;
+            return result;
+        });
+        Require(batch.Items.Count == items.Length && batch.Metrics.EligibleObjects == supported.Count &&
+            batch.Metrics.ResolvedObjects == supported.Count && batch.Metrics.FailedObjects == 0 &&
+            batch.Metrics.UnsupportedObjects == unsupported.Count && batch.Complete == (unsupported.Count == 0), "SpecialEvidenceBatch");
+        Require(allSuccessful && calls == supported.Count && handles == calls && snapshots == 2 * calls &&
+            batch.Metrics.NativeCalls == calls, "SpecialEvidenceWorkBudget");
+        var output = batch.Items.ToDictionary(item => (item.Volume, item.Reference));
+        var cases = new List<NtfsSpecialCaseResult>();
+        foreach (var (kind, input) in supported)
+        {
+            Require(input.Record.LookupReasons == (kind.StartsWith("Compressed", StringComparison.Ordinal)
+                ? NtfsLookupReason.Compressed : NtfsLookupReason.Sparse), "SpecialEvidenceReasonMatchesKind");
+            var result = output[(input.Volume, input.Record.Reference)];
+            Require(result.AllocatedSource == NtfsSizeSource.HandleLookup && result.LogicalSource == NtfsSizeSource.Record &&
+                result.Code == "SpecialLookup" && result.LogicalBytes.HasValue && result.AllocatedBytes.HasValue, "SpecialEvidenceSource");
+            Require(NativeStorage.TryRead(input.Path, false, File.GetAttributes(input.Path), out var reference, out _) &&
+                reference != null && !reference.WritableHandleOpen && reference.Identity == new FileIdentity(input.Volume, input.Record.Reference, 0) &&
+                result.LogicalBytes == reference.LogicalBytes && result.AllocatedBytes == reference.AllocatedBytes, "SpecialEvidenceMatchesReference");
+            cases.Add(new(kind, result.LogicalBytes!.Value, result.AllocatedBytes!.Value, result.AllocatedSource.ToString()));
+        }
+        foreach (var input in unsupported)
+        {
+            var result = output[(input.Volume, input.Record.Reference)];
+            Require(result.AllocatedBytes == null && result.AllocatedSource == NtfsSizeSource.Unknown, "SpecialEvidenceUnsupportedRemainsUnknown");
+        }
+        int compressed = supported.Count(item => item.Item.Record.LookupReasons == NtfsLookupReason.Compressed);
+        return new(items.Length, compressed, supported.Count - compressed, unsupported.Count, supported.Count, 0,
+            calls, handles, snapshots, cases.AsReadOnly());
+    }
+}
diff --git a/tests/Prototypes/Ntfs/NtfsSpecialLease.cs b/tests/Prototypes/Ntfs/NtfsSpecialLease.cs
new file mode 100644
index 0000000..faf64be
--- /dev/null
+++ b/tests/Prototypes/Ntfs/NtfsSpecialLease.cs
@@ -0,0 +1,186 @@
+using System.Runtime.InteropServices;
+using Microsoft.Win32.SafeHandles;
+
+namespace DiskAtlas.NtfsPrototype;
+
+internal sealed record NtfsSpecialObservation(FileIdentity Identity, long LogicalBytes, long AllocatedBytes,
+    uint Links, bool DeletePending, bool Directory, uint Attributes, long LastWrite, long ChangeTime,
+    ushort CompressionFormat, byte UnitShift, byte ChunkShift, byte ClusterShift);
+
+// Test-only, default-stream lookup for the two explicitly supported reasons.
+// Read sharing is not an oplock, a residency detector, or a volume snapshot.
+internal static class NtfsSpecialLease
+{
+    private const uint ReadAttributesAndData = 0x81, ShareRead = 1;
+    private const uint BackupAndOpenReparse = 0x02000000 | 0x00200000;
+    private const uint Compressed = 0x800, Sparse = 0x200;
+    private const uint UnsupportedAttributes = 0x10 | 0x40 | 0x400 | 0x1000 | 0x4000 | 0x40000 | 0x400000;
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct BasicInfo
+    {
+        public long Creation, Access, Write, Change;
+        public uint Attributes;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct IdInfo { public ulong Volume, Low, High; }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct StandardInfo
+    {
+        public long Allocation, EndOfFile;
+        public uint Links;
+        public byte DeletePending, Directory;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct CompressionInfo
+    {
+        public long Size;
+        public ushort Format;
+        public byte UnitShift, ChunkShift, ClusterShift, Reserved1, Reserved2, Reserved3;
+    }
+
+    internal static (int Basic, int Id, int Standard, int Compression) LayoutSizes =>
+        (Marshal.SizeOf<BasicInfo>(), Marshal.SizeOf<IdInfo>(), Marshal.SizeOf<StandardInfo>(), Marshal.SizeOf<CompressionInfo>());
+
+    [DllImport("kernel32.dll", EntryPoint = "GetFileInformationByHandleEx", SetLastError = true)]
+    [DefaultDllImportSearchPaths(DllImportSearchPath.System32)]
+    private static extern bool Basic(SafeFileHandle handle, int infoClass, out BasicInfo value, uint size);
+    [DllImport("kernel32.dll", EntryPoint = "GetFileInformationByHandleEx", SetLastError = true)]
+    [DefaultDllImportSearchPaths(DllImportSearchPath.System32)]
+    private static extern bool Identity(SafeFileHandle handle, int infoClass, out IdInfo value, uint size);
+    [DllImport("kernel32.dll", EntryPoint = "GetFileInformationByHandleEx", SetLastError = true)]
+    [DefaultDllImportSearchPaths(DllImportSearchPath.System32)]
+    private static extern bool Standard(SafeFileHandle handle, int infoClass, out StandardInfo value, uint size);
+    [DllImport("kernel32.dll", EntryPoint = "GetFileInformationByHandleEx", SetLastError = true)]
+    [DefaultDllImportSearchPaths(DllImportSearchPath.System32)]
+    private static extern bool Compression(SafeFileHandle handle, int infoClass, out CompressionInfo value, uint size);
+
+    private static string? RecordProblem(NtfsRecord record)
+    {
+        if (record == null || record.IsDirectory || record.BaseReference != 0 || (record.Reference >> 48) == 0 ||
+            record.LookupReasons is not (NtfsLookupReason.Compressed or NtfsLookupReason.Sparse) ||
+            record.LogicalBytes is not >= 0 || record.AllocatedBytes != null || record.Names == null ||
+            record.Names.Count is < 1 or > 256 || record.LinkCount != record.Names.Count)
+            return "UnsupportedObject";
+        foreach (var name in record.Names)
+            if (name == null || name.Namespace > 3 || (name.ParentReference >> 48) == 0 ||
+                name.Name is not { Length: > 0 and <= 255 } || name.Name is "." or ".." ||
+                name.Name.IndexOfAny(['\0', '\\', '/', ':']) >= 0)
+                return "InvalidName";
+        return VisibleNames(record) == 0 ? "MissingVisibleNames" : null;
+    }
+
+    private static int VisibleNames(NtfsRecord record) => record.Names.Where(name => name.Namespace != 2)
+        .Select(name => (name.ParentReference, name.Name)).Distinct().Count();
+
+    internal static string? Preflight(NtfsRecord record, string path)
+    {
+        string? problem = RecordProblem(record);
+        if (problem != null) return problem;
+        if (string.IsNullOrWhiteSpace(path) || path.Contains('\0') || !Path.IsPathFullyQualified(path)) return "InvalidPath";
+        return record.Names.Any(name => name.Namespace != 2 && name.Name == Path.GetFileName(path)) ? null : "NameMismatch";
+    }
+
+    internal static string? Validate(ulong volume, NtfsRecord record, NtfsSpecialObservation first,
+        NtfsSpecialObservation second)
+    {
+        string? problem = RecordProblem(record);
+        if (problem != null) return problem;
+        int names = VisibleNames(record);
+        string? ObservationProblem(NtfsSpecialObservation sample)
+        {
+            if (sample == null) return "InvalidSnapshot";
+            if (sample.Identity != new FileIdentity(volume, record.Reference, 0)) return "IdentityChanged";
+            if (sample.LogicalBytes != record.LogicalBytes) return "LogicalChanged";
+            if (sample.AllocatedBytes < 0 || sample.Links != names || sample.DeletePending || sample.Directory)
+                return "InvalidSnapshot";
+            if ((sample.Attributes & UnsupportedAttributes) != 0) return "UnsupportedAttributes";
+            uint expected = record.LookupReasons == NtfsLookupReason.Compressed ? Compressed : Sparse;
+            if ((sample.Attributes & (Compressed | Sparse)) != expected) return "AttributeMismatch";
+            ushort expectedFormat = record.LookupReasons == NtfsLookupReason.Compressed ? (ushort)2 : (ushort)0;
+            if (sample.CompressionFormat != expectedFormat) return "UnsupportedCompressionFormat";
+            if (sample.UnitShift > 63 || sample.ChunkShift > 63 || sample.ClusterShift > 63)
+                return "InvalidCompressionDescription";
+            if (!ValidTime(sample.LastWrite) || !ValidTime(sample.ChangeTime)) return "InvalidTimestamp";
+            return null;
+        }
+        problem = ObservationProblem(first) ?? ObservationProblem(second);
+        if (problem != null) return problem;
+        return first == second ? null : "SnapshotChanged";
+    }
+
+    private static bool ValidTime(long value)
+    {
+        if (value < 0) return false;
+        try { _ = DateTime.FromFileTimeUtc(value); return true; }
+        catch (ArgumentOutOfRangeException) { return false; }
+    }
+
+    internal static NtfsLeaseResult Read(ulong volume, NtfsRecord record, string path, CancellationToken token = default)
+    {
+        token.ThrowIfCancellationRequested();
+        int opened = 0, reads = 0;
+        NtfsLeaseResult Fail(string code) => new(false, null, code, opened, reads);
+        string? problem = Preflight(record, path);
+        if (problem != null) return Fail(problem);
+        if (!OperatingSystem.IsWindows()) return Fail("UnsupportedPlatform");
+
+        using var handle = NativeStorage.CreateFileW(NativeStorage.LongPath(path), ReadAttributesAndData, ShareRead,
+            IntPtr.Zero, 3, BackupAndOpenReparse, IntPtr.Zero);
+        int openError = handle.IsInvalid ? Marshal.GetLastWin32Error() : 0;
+        if (!handle.IsInvalid) opened = 1;
+        token.ThrowIfCancellationRequested();
+        if (handle.IsInvalid) return Fail("OpenError-" + openError);
+
+        NtfsSpecialObservation? Capture(out string code)
+        {
+            token.ThrowIfCancellationRequested();
+            reads++;
+            code = "NativeReadFailed";
+            bool read = Basic(handle, 0, out var before, (uint)Marshal.SizeOf<BasicInfo>());
+            token.ThrowIfCancellationRequested();
+            if (!read) return null;
+            token.ThrowIfCancellationRequested();
+            read = Identity(handle, 18, out var id, (uint)Marshal.SizeOf<IdInfo>());
+            token.ThrowIfCancellationRequested();
+            if (!read) return null;
+            token.ThrowIfCancellationRequested();
+            read = Standard(handle, 1, out var standard, (uint)Marshal.SizeOf<StandardInfo>());
+            token.ThrowIfCancellationRequested();
+            if (!read) return null;
+            token.ThrowIfCancellationRequested();
+            read = Compression(handle, 8, out var compression, (uint)Marshal.SizeOf<CompressionInfo>());
+            token.ThrowIfCancellationRequested();
+            if (!read) return null;
+            token.ThrowIfCancellationRequested();
+            read = Basic(handle, 0, out var after, (uint)Marshal.SizeOf<BasicInfo>());
+            token.ThrowIfCancellationRequested();
+            if (!read) return null;
+            if (before.Write != after.Write || before.Change != after.Change || before.Attributes != after.Attributes)
+            { code = "SnapshotChanged"; return null; }
+            if (standard.Allocation < 0) { code = "InvalidSnapshot"; return null; }
+            code = "None";
+            return new(new(id.Volume, id.Low, id.High), standard.EndOfFile, compression.Size, standard.Links,
+                standard.DeletePending != 0, standard.Directory != 0, after.Attributes, after.Write, after.Change,
+                compression.Format, compression.UnitShift, compression.ChunkShift, compression.ClusterShift);
+        }
+
+        var first = Capture(out string code);
+        if (first == null) return Fail(code);
+        problem = Validate(volume, record, first, first);
+        token.ThrowIfCancellationRequested();
+        if (problem != null) return Fail(problem);
+        var second = Capture(out code);
+        if (second == null) return Fail(code);
+        problem = Validate(volume, record, first, second);
+        token.ThrowIfCancellationRequested();
+        if (problem != null) return Fail(problem);
+        var modified = DateTime.FromFileTimeUtc(first.LastWrite).ToLocalTime();
+        token.ThrowIfCancellationRequested();
+        var storage = new FileStorageInfo(first.Identity, first.AllocatedBytes, first.Links, false, first.LogicalBytes, modified);
+        return new(true, storage, "SpecialLease", opened, reads);
+    }
+}
diff --git a/tests/Prototypes/Ntfs/NtfsSpecialLeaseTests.cs b/tests/Prototypes/Ntfs/NtfsSpecialLeaseTests.cs
new file mode 100644
index 0000000..c38458e
--- /dev/null
+++ b/tests/Prototypes/Ntfs/NtfsSpecialLeaseTests.cs
@@ -0,0 +1,240 @@
+using System.Runtime.InteropServices;
+using DiskAtlas;
+
+namespace DiskAtlas.NtfsPrototype;
+
+// Native checks open only this invocation's newly created, flat temporary tree.
+// Synthetic observations are kept separate from the actual-file capability checks.
+internal static class NtfsSpecialLeaseTests
+{
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+    private static extern bool CreateHardLinkW(string name, string existing, IntPtr reserved);
+
+    internal static int Run()
+    {
+        int passed = 0;
+        void Check(bool condition, string name)
+        {
+            if (!condition) throw new InvalidOperationException("NTFS special lease check failed: " + name);
+            passed++; Console.WriteLine("PASS NTFS special lease " + name);
+        }
+        const ulong volume = 41;
+        ulong parent = NtfsRecordFixtures.Reference(5, 1), reference = NtfsRecordFixtures.Reference(52, 3);
+        var compressed = new NtfsRecord(reference, 0, false, 1, [new(parent, "compressed.bin", 1)],
+            65536, null, NtfsLookupReason.Compressed);
+        var sparse = compressed with { Names = [new(parent, "sparse.bin", 1)], LookupReasons = NtfsLookupReason.Sparse };
+        var first = new NtfsSpecialObservation(new(volume, reference, 0), 65536, 4096, 1, false, false,
+            (uint)(FileAttributes.Archive | FileAttributes.Compressed), 133000000000000000, 133000000000000001,
+            2, 16, 12, 12);
+        var sparseFirst = first with { Attributes = (uint)(FileAttributes.Archive | FileAttributes.SparseFile), CompressionFormat = 0 };
+        string temp = Path.GetFullPath(Path.GetTempPath());
+        const string prefix = "AsukaLens-special-lease-";
+        string nonce = Guid.NewGuid().ToString("N");
+        string root = Path.Combine(temp, prefix + nonce);
+        string compressedPath = Path.Combine(root, "compressed.bin"), sparsePath = Path.Combine(root, "sparse.bin");
+        Check(NtfsSpecialLease.LayoutSizes == (40, 24, 24, 16), "native metadata structures have the expected ABI sizes");
+        Check(NtfsSpecialLease.Preflight(compressed, compressedPath) == null, "single compressed reason is eligible");
+        Check(NtfsSpecialLease.Preflight(sparse, sparsePath) == null, "single sparse reason is eligible");
+        Check(NtfsSpecialLease.Validate(volume, compressed, first, first) == null, "stable compressed observations are accepted");
+        Check(NtfsSpecialLease.Validate(volume, sparse, sparseFirst, sparseFirst) == null, "stable sparse observations are accepted");
+        var zero = sparseFirst with { AllocatedBytes = 0 };
+        Check(NtfsSpecialLease.Validate(volume, sparse, zero, zero) == null, "known zero sparse allocation is distinct from unknown");
+
+        void PreflightFails(NtfsRecord record, string name, string? path = null) =>
+            Check(NtfsSpecialLease.Preflight(record, path ?? compressedPath) != null, name);
+        foreach (var reason in Enum.GetValues<NtfsLookupReason>().Where(reason => reason is not (NtfsLookupReason.Compressed or NtfsLookupReason.Sparse)))
+            PreflightFails(compressed with { LookupReasons = reason }, "other single reason is not silently broadened: " + reason);
+        foreach (var reason in new[] { NtfsLookupReason.Compressed | NtfsLookupReason.Sparse,
+            NtfsLookupReason.Compressed | NtfsLookupReason.NamedData, NtfsLookupReason.Sparse | NtfsLookupReason.NamedData,
+            NtfsLookupReason.Compressed | NtfsLookupReason.ResidentAllocation, NtfsLookupReason.Sparse | NtfsLookupReason.AttributeList,
+            NtfsLookupReason.Compressed | NtfsLookupReason.ExtensionRecord })
+            PreflightFails(compressed with { LookupReasons = reason }, "combined reasons remain unsupported");
+        PreflightFails(compressed with { IsDirectory = true }, "directory input is rejected");
+        PreflightFails(compressed with { BaseReference = 1 }, "extension input is rejected");
+        PreflightFails(compressed with { Reference = 52 }, "missing sequence is rejected");
+        PreflightFails(compressed with { LogicalBytes = null }, "unknown EOF is rejected");
+        PreflightFails(compressed with { LogicalBytes = -1 }, "negative EOF is rejected");
+        PreflightFails(compressed with { AllocatedBytes = 0 }, "already-known allocation is not a lookup candidate");
+        PreflightFails(compressed with { Names = [] }, "missing names are rejected");
+        PreflightFails(compressed with { LinkCount = 2 }, "incomplete raw link names are rejected");
+        PreflightFails(compressed with { LinkCount = 257, Names = Enumerable.Repeat(compressed.Names[0], 257).ToArray() }, "name capacity is bounded");
+        PreflightFails(compressed with { Names = [new(parent, "COMPRE~1.BIN", 2)] }, "DOS-only names are rejected");
+        PreflightFails(compressed with { Names = [new(5, "compressed.bin", 1)] }, "parent sequence is required");
+        PreflightFails(compressed with { Names = [new(parent, "compressed.bin", 4)] }, "unknown namespace is rejected");
+        foreach (string name in new[] { "", "bad/name", "bad\\name", "bad:name", "bad\0name", new string('x', 256) })
+            PreflightFails(compressed with { Names = [new(parent, name, 1)] }, "invalid name is rejected");
+        PreflightFails(compressed, "relative path is rejected", "compressed.bin");
+        PreflightFails(compressed, "empty path is rejected", " ");
+        PreflightFails(compressed, "NUL path is rejected", compressedPath + '\0');
+        PreflightFails(compressed, "unrelated basename is rejected", sparsePath);
+        var dos = compressed with { LinkCount = 2, Names = [compressed.Names[0], new(parent, "COMPRE~1.BIN", 2)] };
+        Check(NtfsSpecialLease.Preflight(dos, compressedPath) == null && NtfsSpecialLease.Validate(volume, dos, first, first) == null,
+            "DOS alias is not a second visible native link");
+        var hardLinks = compressed with { LinkCount = 2, Names = [compressed.Names[0], new(parent, "alias.bin", 1)] };
+        var twice = first with { Links = 2 };
+        Check(NtfsSpecialLease.Validate(volume, hardLinks, twice, twice) == null, "visible native links are counted independently of DOS aliases");
+
+        void InvalidObservation(NtfsSpecialObservation observation, string name)
+        {
+            Check(NtfsSpecialLease.Validate(volume, compressed, observation, observation) != null, name + " in first observation");
+            Check(NtfsSpecialLease.Validate(volume, compressed, first, observation) != null, name + " in second observation");
+        }
+        InvalidObservation(first with { Identity = first.Identity with { Volume = volume + 1 } }, "wrong volume is rejected");
+        InvalidObservation(first with { Identity = first.Identity with { Low = reference + 1 } }, "wrong record slot is rejected");
+        InvalidObservation(first with { Identity = first.Identity with { Low = NtfsRecordFixtures.Reference(52, 4) } }, "reused sequence is rejected");
+        InvalidObservation(first with { Identity = first.Identity with { High = 1 } }, "full identity is required");
+        InvalidObservation(first with { LogicalBytes = first.LogicalBytes + 1 }, "EOF change is rejected");
+        InvalidObservation(first with { AllocatedBytes = -1 }, "negative allocation is rejected");
+        InvalidObservation(first with { Links = 2 }, "unexpected visible links are rejected");
+        InvalidObservation(first with { DeletePending = true }, "delete-pending state is rejected");
+        InvalidObservation(first with { Directory = true }, "actual directory is rejected");
+        InvalidObservation(first with { Attributes = (uint)FileAttributes.Archive }, "actual special type must match the record");
+        InvalidObservation(first with { Attributes = (uint)FileAttributes.SparseFile }, "sparse metadata cannot satisfy compressed evidence");
+        foreach (FileAttributes flag in new[] { FileAttributes.ReparsePoint, FileAttributes.Offline, FileAttributes.Encrypted, FileAttributes.Directory, FileAttributes.Device })
+            InvalidObservation(first with { Attributes = first.Attributes | (uint)flag }, "unsupported current attributes are rejected");
+        foreach (uint flag in new uint[] { 0x40000, 0x400000 })
+            InvalidObservation(first with { Attributes = first.Attributes | flag }, "recall attribute is rejected");
+        InvalidObservation(first with { CompressionFormat = 0 }, "compressed format none is rejected");
+        InvalidObservation(first with { CompressionFormat = 1 }, "default request format is not reported LZNT1");
+        InvalidObservation(first with { CompressionFormat = 3 }, "unknown compression format is rejected");
+        InvalidObservation(first with { UnitShift = 64 }, "unit shift is bounded");
+        InvalidObservation(first with { ChunkShift = 64 }, "chunk shift is bounded");
+        InvalidObservation(first with { ClusterShift = 64 }, "cluster shift is bounded");
+        InvalidObservation(first with { LastWrite = -1 }, "negative last-write time is rejected");
+        InvalidObservation(first with { ChangeTime = -1 }, "negative change time is rejected");
+        InvalidObservation(first with { LastWrite = long.MaxValue }, "overflowing last-write time is rejected");
+        InvalidObservation(first with { ChangeTime = long.MaxValue }, "overflowing change time is rejected");
+        foreach (var changed in new[] { first with { AllocatedBytes = 8192 }, first with { LastWrite = first.LastWrite + 1 },
+            first with { ChangeTime = first.ChangeTime + 1 }, first with { Attributes = first.Attributes | (uint)FileAttributes.Hidden },
+            first with { UnitShift = 15 }, first with { ChunkShift = 11 }, first with { ClusterShift = 11 } })
+            Check(NtfsSpecialLease.Validate(volume, compressed, first, changed) != null, "observable metadata change between snapshots is rejected");
+        Check(NtfsSpecialLease.Validate(volume, sparse, sparseFirst with { CompressionFormat = 2 }, sparseFirst with { CompressionFormat = 2 }) != null,
+            "sparse-only evidence does not accept compressed format");
+        Check(NtfsSpecialLease.Validate(volume, sparse, sparseFirst with { Attributes = first.Attributes }, sparseFirst with { Attributes = first.Attributes }) != null,
+            "compressed attributes do not satisfy sparse-only record");
+        using (var cancelled = new CancellationTokenSource())
+        {
+            cancelled.Cancel(); bool stopped = false;
+            try { NtfsSpecialLease.Read(volume, compressed, compressedPath, cancelled.Token); }
+            catch (OperationCanceledException) { stopped = true; }
+            Check(stopped && !Directory.Exists(root), "pre-cancellation opens no synthetic file");
+        }
+
+        if (!OperatingSystem.IsWindows() || !string.Equals(new DriveInfo(Path.GetPathRoot(root)!).DriveFormat, "NTFS", StringComparison.OrdinalIgnoreCase))
+        {
+            Console.WriteLine("SKIP NTFS special lease native checks: Windows NTFS temporary storage required");
+            return passed;
+        }
+        Directory.CreateDirectory(root);
+        try
+        {
+            bool compressedSupported;
+            using (var file = new FileStream(compressedPath, FileMode.CreateNew, FileAccess.ReadWrite, FileShare.None))
+            {
+                compressedSupported = NativeStorage.DeviceIoControl(file.SafeFileHandle, 0x9c040, [2, 0], 2, [], 0, out _, IntPtr.Zero);
+                if (compressedSupported) { file.Write(new byte[2 * 1024 * 1024]); file.Flush(true); }
+            }
+            if (compressedSupported)
+            {
+                NativeChecks(compressedPath, NtfsLookupReason.Compressed);
+                string randomPath = Path.Combine(root, "random.bin");
+                using (var file = new FileStream(randomPath, FileMode.CreateNew, FileAccess.ReadWrite, FileShare.None))
+                {
+                    Check(NativeStorage.DeviceIoControl(file.SafeFileHandle, 0x9c040, [2, 0], 2, [], 0, out _, IntPtr.Zero), "incompressible fixture compression enabled");
+                    var bytes = new byte[131072]; new Random(8371).NextBytes(bytes); file.Write(bytes); file.Flush(true);
+                }
+                NativeChecks(randomPath, NtfsLookupReason.Compressed, exerciseSharing: false);
+            }
+            else Console.WriteLine("SKIP NTFS special lease compressed native checks: feature unavailable");
+
+            bool sparseSupported;
+            using (var file = new FileStream(sparsePath, FileMode.CreateNew, FileAccess.ReadWrite, FileShare.None))
+            {
+                sparseSupported = NativeStorage.DeviceIoControl(file.SafeFileHandle, 0x900c4, null, 0, [], 0, out _, IntPtr.Zero);
+                if (sparseSupported) { file.SetLength(4 * 1024 * 1024); file.Flush(true); }
+            }
+            if (sparseSupported)
+            {
+                var hole = NativeChecks(sparsePath, NtfsLookupReason.Sparse);
+                Check(hole.AllocatedBytes == 0, "unwritten sparse fixture reports known zero allocation");
+                using (var file = new FileStream(sparsePath, FileMode.Open, FileAccess.Write, FileShare.None))
+                {
+                    file.Position = 131072; var bytes = new byte[65536]; new Random(719).NextBytes(bytes); file.Write(bytes); file.Flush(true);
+                }
+                var written = NativeChecks(sparsePath, NtfsLookupReason.Sparse, exerciseSharing: false);
+                Check(written.AllocatedBytes > 0 && written.AllocatedBytes < written.LogicalBytes,
+                    "allocated sparse region is distinguished from a completely empty hole");
+            }
+            else Console.WriteLine("SKIP NTFS special lease sparse native checks: feature unavailable");
+        }
+        finally
+        {
+            string resolved = Path.GetFullPath(root);
+            if (!string.Equals(Path.GetDirectoryName(resolved), Path.TrimEndingDirectorySeparator(temp), StringComparison.OrdinalIgnoreCase) ||
+                Path.GetFileName(resolved) != prefix + nonce || (File.GetAttributes(resolved) & FileAttributes.ReparsePoint) != 0 ||
+                Directory.EnumerateFileSystemEntries(resolved).Any(path => (File.GetAttributes(path) & (FileAttributes.ReparsePoint | FileAttributes.Directory)) != 0))
+                throw new InvalidOperationException("Refused unexpected special lease fixture cleanup target");
+            Directory.Delete(resolved, true);
+        }
+        Console.WriteLine("PASS NTFS special lease checks: " + passed + "; only owned temporary files opened");
+        return passed;
+
+        FileStorageInfo NativeChecks(string path, NtfsLookupReason reason, bool exerciseSharing = true)
+        {
+            Check(NativeStorage.TryRead(path, false, File.GetAttributes(path), out var observed, out _) && observed != null &&
+                observed.Identity.High == 0 && (observed.Identity.Low >> 48) != 0, "native reference has full NTFS identity");
+            FileStorageInfo native = observed!;
+            var record = compressed with { Reference = native.Identity.Low, LogicalBytes = native.LogicalBytes,
+                Names = [new(parent, Path.GetFileName(path), 1)], LookupReasons = reason };
+            NtfsLeaseResult Read(NtfsRecord? candidate = null) => NtfsSpecialLease.Read(native.Identity.Volume, candidate ?? record, path);
+            void Same(NtfsLeaseResult result, FileStorageInfo expected, string name) =>
+                Check(result.Success && result.Storage == expected && result.HandlesOpened == 1 && result.SnapshotReads == 2, name);
+            void Unknown(NtfsLeaseResult result, string name) => Check(!result.Success && result.Storage == null, name);
+            Same(Read(), native, "single handle snapshots match current native reference");
+            using (var exclusive = new FileStream(path, FileMode.Open, FileAccess.ReadWrite, FileShare.None))
+                Check(exclusive.Length == native.LogicalBytes, "success releases its handle for an exclusive reopen");
+            Unknown(Read(record with { Reference = record.Reference ^ 1 }), "wrong actual file identity remains unknown");
+            Unknown(Read(record with { LogicalBytes = record.LogicalBytes + 1 }), "stale EOF remains unknown");
+            using (var exclusive = new FileStream(path, FileMode.Open, FileAccess.ReadWrite, FileShare.None))
+                Check(exclusive.Length == native.LogicalBytes, "failed native lookup releases its handle");
+            if (!exerciseSharing) return native;
+            using (var writer = new FileStream(path, FileMode.Open, FileAccess.ReadWrite, FileShare.ReadWrite | FileShare.Delete))
+            {
+                var blocked = Read();
+                Check(!blocked.Success && blocked.Storage == null && blocked.HandlesOpened == 0 && blocked.SnapshotReads == 0,
+                    "existing data writer is refused without permissive share retry");
+            }
+            using (var deleting = NativeStorage.CreateFileW(NativeStorage.LongPath(path), 0x10000, NativeStorage.ShareAll, IntPtr.Zero, 3, 0x02200000, IntPtr.Zero))
+            {
+                Check(!deleting.IsInvalid, "owned fixture can open delete access");
+                var blocked = Read();
+                Check(!blocked.Success && blocked.Storage == null && blocked.HandlesOpened == 0 && blocked.SnapshotReads == 0,
+                    "existing delete access is refused without permissive share retry");
+            }
+            string alias = Path.Combine(root, reason == NtfsLookupReason.Compressed ? "compressed-alias.bin" : "sparse-alias.bin");
+            if (CreateHardLinkW(alias, path, IntPtr.Zero))
+            {
+                try
+                {
+                    Unknown(Read(), "new visible hard link invalidates the old name set");
+                    Check(NativeStorage.TryRead(path, false, File.GetAttributes(path), out var linked, out _) && linked?.LinkCount == 2,
+                        "hard link fixture has two native links");
+                    var linkedRecord = record with { LinkCount = 2, Names = [record.Names[0], new(parent, Path.GetFileName(alias), 1)] };
+                    Same(Read(linkedRecord), linked!, "complete hard link evidence resolves one current allocation");
+                    using var writer = new FileStream(alias, FileMode.Open, FileAccess.Write, FileShare.ReadWrite | FileShare.Delete);
+                    Unknown(Read(linkedRecord), "already-open writer through another hard link is refused");
+                }
+                finally { File.Delete(alias); }
+            }
+            else Console.WriteLine("SKIP NTFS special lease hard links: native feature unavailable");
+            Same(Read(), native, "sharing checks release handles and preserve native values");
+            using var cancelled = new CancellationTokenSource(); cancelled.Cancel(); bool stopped = false;
+            try { NtfsSpecialLease.Read(native.Identity.Volume, record, path, cancelled.Token); }
+            catch (OperationCanceledException) { stopped = true; }
+            Check(stopped, "native fixture pre-cancellation propagates");
+            using (var exclusive = new FileStream(path, FileMode.Open, FileAccess.ReadWrite, FileShare.None))
+                Check(exclusive.Length == native.LogicalBytes, "cancelled lookup retains no native handle");
+            return native;
+        }
+    }
+}

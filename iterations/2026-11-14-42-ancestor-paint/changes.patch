                             [new HandledMouseEventArgs(MouseButtons.None, 0, grid.Width / 2, grid.ColumnHeadersHeight + 8, -120)]);
                         Check(paints > beforeWheel && grid.BackdropBuilds == builds, "WheelPresentsBeforeReturningWithoutRebuildingBackdrop");
 
+                        // The resize coordinator owns an ancestor HWND, not
+                        // the grid. Direct scrollbar painting and scroll Update
+                        // must respect that same pause until the owner releases.
+                        var ancestor = Field<Control>(form, "contentLayoutRoot");
+                        var presentation = Field<LayoutPresentation>(form, "layoutPresentation");
+                        Check(!grid.ScrollbarPaintingPaused && IsWindowVisible(grid.Handle),
+                            "AncestorPauseProbeStartsWithVisibleUnpausedGrid");
+                        int ancestorBuilds = grid.BackdropBuilds, ancestorPaints = paints;
+                        int priorPresentations = presentation.Presentations;
+                        SendMessage(ancestor.Handle, 0x000B, IntPtr.Zero, IntPtr.Zero);
+                        try
+                        {
+                            Check(GetProp(ancestor.Handle, "SysSetRedraw") != IntPtr.Zero && !IsWindowVisible(grid.Handle),
+                                "OwnedAncestorHoldIsNativeAndCoversGrid");
+                            Check(grid.ScrollbarPaintingPaused, "AncestorRedrawHoldPausesScrollbarPainting");
+                            // A changed source makes any accidental direct bar
+                            // paint observably rebuild its backing bitmap.
+                            SetImage(Color.FromArgb(42, 83, 127));
+                            presentation.ResizeSurfaces();
+                            var bar = grid.Controls.OfType<VScrollBar>().Single(item => item.Visible);
+                            SendMessage(bar.Handle, 0x00E0, new IntPtr(bar.Value), new IntPtr(1));
+                            // WM_PRINTCLIENT uses an explicit memory HDC and
+                            // must not fall through to native painting while an
+                            // ancestor's redraw ownership is still active.
+                            using (var print = new Bitmap(bar.ClientSize.Width, bar.ClientSize.Height))
+                            {
+                                Color sentinelPixel = Color.FromArgb(13, 227, 179);
+                                using (var graphics = Graphics.FromImage(print))
+                                {
+                                    graphics.Clear(sentinelPixel);
+                                    IntPtr hdc = graphics.GetHdc();
+                                    try { SendMessage(bar.Handle, 0x0318, hdc, new IntPtr(0x0004)); }
+                                    finally { graphics.ReleaseHdc(hdc); }
+                                }
+                                bool unchanged = true;
+                                for (int y = 0; unchanged && y < print.Height; y++)
+                                for (int x = 0; unchanged && x < print.Width; x++)
+                                    unchanged = (print.GetPixel(x, y).ToArgb() & 0x00ffffff) ==
+                                        (sentinelPixel.ToArgb() & 0x00ffffff);
+                                Check(unchanged, "AncestorPauseKeepsScrollbarPrintClientBitmapUntouched");
+                            }
+                            grid.FirstDisplayedScrollingRowIndex++;
+                            Check(grid.BackdropBuilds == ancestorBuilds && paints == ancestorPaints,
+                                "AncestorPausePreventsDirectBarBackdropBuildAndScrollPresentation");
+                            Check(GetProp(ancestor.Handle, "SysSetRedraw") != IntPtr.Zero,
+                                "ScrollNeverReleasesExternallyOwnedAncestorHold");
+                        }
+                        finally
+                        {
+                            SendMessage(ancestor.Handle, 0x000B, new IntPtr(1), IntPtr.Zero);
+                            presentation.RetryPending();
+                        }
+                        // No PaintNow/Update here: the production parent
+                        // RedrawWindow path must deliver the final child paint.
+                        await Settle();
+                        Check(!grid.ScrollbarPaintingPaused && IsWindowVisible(grid.Handle) &&
+                            GetProp(ancestor.Handle, "SysSetRedraw") == IntPtr.Zero,
+                            "AncestorReleaseRestoresGridPaintingAvailability");
+                        Check(presentation.Presentations > priorPresentations && paints > ancestorPaints &&
+                            grid.BackdropBuilds > ancestorBuilds && grid.BackdropBytes > 0,
+                            "ParentPresentationRebuildsAndPaintsGridAfterAncestorRelease");
+
                         // Isolate each cache-key input rather than letting a

diff --git a/src/Monitoring/DiskActivityMonitor.cs b/src/Monitoring/DiskActivityMonitor.cs
new file mode 100644
index 0000000..b9da8f6
--- /dev/null
+++ b/src/Monitoring/DiskActivityMonitor.cs
@@ -0,0 +1,155 @@
+namespace DiskAtlas;
+
+internal sealed record DiskActivityUpdate(long Revision, DiskActivitySample? Sample, string Message,
+    IReadOnlyList<DiskActivityTarget>? Targets = null);
+
+// One background owner and a capacity-one wake-up signal. Rapid changes replace
+// the desired state; no native query or task is queued for each UI interaction.
+internal sealed class DiskActivityMonitor : IDisposable
+{
+    private sealed record Request(string? Path, int? Disk, bool Enabled, long Revision);
+    private readonly object gate = new();
+    private readonly SemaphoreSlim changed = new(0, 1);
+    private readonly CancellationTokenSource stopped = new();
+    private readonly Action<DiskActivityUpdate> publish;
+    private readonly Func<string, CancellationToken, DiskActivityTarget?> resolve;
+    private readonly Func<CancellationToken, IReadOnlyList<DiskActivityTarget>> discover;
+    private readonly Func<int, IDiskActivitySource> create;
+    private readonly TimeSpan interval;
+    private readonly Task worker;
+    private Request desired = new(null, null, false, 0);
+    private long revision;
+    private int disposed;
+
+    internal DiskActivityMonitor(Action<DiskActivityUpdate> publish,
+        Func<string, CancellationToken, DiskActivityTarget?>? resolve = null,
+        Func<CancellationToken, IReadOnlyList<DiskActivityTarget>>? discover = null,
+        Func<int, IDiskActivitySource>? create = null, TimeSpan? interval = null)
+    {
+        this.publish = publish;
+        this.resolve = resolve ?? DiskActivityResolver.Resolve;
+        this.discover = discover ?? DiskActivityResolver.Discover;
+        this.create = create ?? (disk => new PdhDiskActivitySource(disk));
+        this.interval = interval ?? TimeSpan.FromSeconds(1);
+        if (this.interval <= TimeSpan.Zero) throw new ArgumentOutOfRangeException(nameof(interval));
+        worker = Task.Run(Work);
+    }
+
+    internal Task Completion => worker;
+    internal bool IsCurrent(long value) => Volatile.Read(ref disposed) == 0 && value == Volatile.Read(ref revision);
+
+    internal long Update(string? path, int? disk, bool enabled)
+    {
+        lock (gate)
+        {
+            if (disposed != 0) return -1;
+            if (desired.Path == path && desired.Disk == disk && desired.Enabled == enabled) return desired.Revision;
+            desired = new(path, disk, enabled, Interlocked.Increment(ref revision));
+            try { changed.Release(); } catch (SemaphoreFullException) { }
+            return desired.Revision;
+        }
+    }
+
+    private Request Current() { lock (gate) return desired; }
+    internal void InvalidateTarget()
+    {
+        lock (gate)
+        {
+            if (disposed != 0) return;
+            desired = desired with { Revision = Interlocked.Increment(ref revision) };
+            try { changed.Release(); } catch (SemaphoreFullException) { }
+        }
+    }
+    private void Publish(Request request, DiskActivitySample? sample, string message,
+        IReadOnlyList<DiskActivityTarget>? targets = null)
+    {
+        if (IsCurrent(request.Revision)) publish(new(request.Revision, sample, message, targets));
+    }
+
+    private async Task Work()
+    {
+        IDiskActivitySource? source = null;
+        long activeRevision = -1;
+        var token = stopped.Token;
+        try
+        {
+            while (true)
+            {
+                token.ThrowIfCancellationRequested();
+                var request = Current();
+                while (changed.Wait(0)) { }
+                if (activeRevision != request.Revision)
+                {
+                    source?.Dispose(); source = null;
+                    activeRevision = request.Revision;
+                    if (request.Enabled)
+                    {
+                        Publish(request, null, "正在识别磁盘…");
+                        try
+                        {
+                            var targets = discover(token);
+                            if (!IsCurrent(request.Revision)) continue;
+                            Publish(request, null, "", targets);
+                            var target = request.Disk.HasValue
+                                ? targets.FirstOrDefault(item => item.DiskNumber == request.Disk.Value)
+                                : string.IsNullOrWhiteSpace(request.Path) ? null : resolve(request.Path, token);
+                            if (!IsCurrent(request.Revision)) continue;
+                            if (target == null)
+                                Publish(request, null, request.Disk.HasValue || !string.IsNullOrWhiteSpace(request.Path)
+                                    ? "无法可靠映射物理磁盘 · 可选择其他磁盘" : "选择扫描目录或手动选择磁盘");
+                            else
+                            {
+                                source = create(target.DiskNumber);
+                                Publish(request, null, "等待首个有效采样间隔…");
+                            }
+                        }
+                        catch (OperationCanceledException) when (token.IsCancellationRequested) { throw; }
+                        catch { Publish(request, null, "磁盘监测不可用"); }
+                    }
+                    else Publish(request, null, "已暂停 · 展开面板后采样");
+                }
+                if (source != null && request.Enabled && IsCurrent(request.Revision))
+                {
+                    try
+                    {
+                        var sample = source.Collect(token);
+                        Publish(request, sample, sample.Status switch
+                        {
+                            DiskActivityStatus.Waiting => "等待首个有效采样间隔…",
+                            DiskActivityStatus.Unavailable => "磁盘计数器不可用",
+                            _ => ""
+                        });
+                    }
+                    catch (OperationCanceledException) when (token.IsCancellationRequested) { throw; }
+                    catch
+                    {
+                        source.Dispose(); source = null;
+                        Publish(request, null, "磁盘监测不可用 · 收起再展开可重试");
+                    }
+                }
+                if (!IsCurrent(request.Revision)) continue;
+                if (request.Enabled && source != null) await changed.WaitAsync(interval, token);
+                else await changed.WaitAsync(token);
+            }
+        }
+        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
+        finally
+        {
+            source?.Dispose();
+            // Serialize final CTS disposal with the UI's Cancel call.
+            lock (gate) { changed.Dispose(); stopped.Dispose(); }
+        }
+    }
+
+    public void Dispose()
+    {
+        lock (gate)
+        {
+            if (Interlocked.Exchange(ref disposed, 1) != 0) return;
+            Interlocked.Increment(ref revision);
+            stopped.Cancel();
+        }
+        // Native calls may finish later. The worker owns their final disposal;
+        // the UI never waits for a synchronous provider call during close.
+    }
+}
diff --git a/src/Monitoring/DiskActivityPanel.cs b/src/Monitoring/DiskActivityPanel.cs
new file mode 100644
index 0000000..735d89f
--- /dev/null
+++ b/src/Monitoring/DiskActivityPanel.cs
@@ -0,0 +1,331 @@
+using System.Drawing.Drawing2D;
+using System.Globalization;
+using System.ComponentModel;
+
+namespace DiskAtlas;
+
+// UI-thread owned. Samples stay in this fixed, in-memory ring; no timer or disk I/O.
+internal sealed class DiskActivityPanel : Control
+{
+    private readonly DiskActivitySample?[] history = new DiskActivitySample?[60];
+    private int historyStart, historyCount;
+    private DiskActivitySample? current;
+    private DateTimeOffset? displayTime;
+    private string message = "等待采样";
+    private bool changingTargets, disposed;
+    private readonly ComboBox targetBox;
+    private readonly Button toggle;
+    private readonly Font heading = Theme.Font(9, FontStyle.Bold);
+    private readonly Font small = Theme.Font(8);
+    private readonly Font value = Theme.Font(13, FontStyle.Bold);
+
+    private sealed record TargetChoice(int? Number, string Label)
+    {
+        public override string ToString() => Label;
+    }
+
+    [DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]
+    public bool Expanded { get; private set; }
+    [DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]
+    public int? SelectedDiskNumber => (targetBox.SelectedItem as TargetChoice)?.Number;
+    public event EventHandler? ExpansionChanged;
+    public event EventHandler? TargetChanged;
+
+    public DiskActivityPanel()
+    {
+        SetStyle(ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer |
+            ControlStyles.UserPaint | ControlStyles.ResizeRedraw, true);
+        BackColor = Theme.Surface;
+        AccessibleName = "磁盘活动";
+        AccessibleRole = AccessibleRole.Grouping;
+        targetBox = new ComboBox
+        {
+            DropDownStyle = ComboBoxStyle.DropDownList, Font = small,
+            FlatStyle = FlatStyle.Flat, IntegralHeight = true, DropDownWidth = 220,
+            AccessibleName = "磁盘活动目标", AccessibleDescription = "跟随扫描目录，或选择整块物理磁盘。",
+            TabIndex = 0
+        };
+        targetBox.Items.Add(new TargetChoice(null, "跟随扫描目录"));
+        targetBox.SelectedIndex = 0;
+        targetBox.SelectedIndexChanged += (_, _) =>
+        {
+            if (changingTargets || disposed) return;
+            ResetHistory();
+            TargetChanged?.Invoke(this, EventArgs.Empty);
+        };
+        toggle = new Button
+        {
+            Text = "展开", Font = small, FlatStyle = FlatStyle.Flat,
+            BackColor = Theme.Surface, ForeColor = Theme.Accent, TabIndex = 1,
+            AccessibleName = "展开磁盘活动", UseVisualStyleBackColor = false
+        };
+        toggle.FlatAppearance.BorderSize = 1;
+        toggle.Click += (_, _) =>
+        {
+            if (disposed) return;
+            Expanded = !Expanded;
+            toggle.Text = Expanded ? "收起" : "展开";
+            toggle.AccessibleName = Expanded ? "收起磁盘活动" : "展开磁盘活动";
+            ExpansionChanged?.Invoke(this, EventArgs.Empty);
+            Invalidate();
+        };
+        Controls.Add(targetBox);
+        Controls.Add(toggle);
+        UpdateDescription();
+    }
+
+    public void SetTargets(IReadOnlyList<DiskActivityTarget> targets)
+    {
+        if (disposed) return;
+        ArgumentNullException.ThrowIfNull(targets);
+        int? previous = SelectedDiskNumber;
+        changingTargets = true;
+        targetBox.BeginUpdate();
+        try
+        {
+            targetBox.Items.Clear();
+            targetBox.Items.Add(new TargetChoice(null, "跟随扫描目录"));
+            var seen = new HashSet<int>();
+            foreach (var target in targets)
+                if (target.DiskNumber >= 0 && seen.Add(target.DiskNumber))
+                    targetBox.Items.Add(new TargetChoice(target.DiskNumber, target.Label));
+            targetBox.SelectedIndex = 0;
+            for (int i = 1; i < targetBox.Items.Count; i++)
+                if (((TargetChoice)targetBox.Items[i]!).Number == previous) targetBox.SelectedIndex = i;
+        }
+        finally { targetBox.EndUpdate(); changingTargets = false; }
+        if (previous != SelectedDiskNumber)
+        {
+            ResetHistory();
+            TargetChanged?.Invoke(this, EventArgs.Empty);
+        }
+        Invalidate();
+    }
+
+    public void SetSample(DiskActivitySample sample)
+    {
+        if (disposed) return;
+        ArgumentNullException.ThrowIfNull(sample);
+        if (displayTime.HasValue && displayTime.Value - sample.Timestamp > TimeSpan.FromSeconds(4)) return;
+        if (historyCount > 0 && At(historyCount - 1).DiskNumber != sample.DiskNumber) ResetHistory();
+        if (current != null && current.DiskNumber != sample.DiskNumber) ResetHistory();
+        if (historyCount > 0 && sample.Timestamp <= At(historyCount - 1).Timestamp) return;
+        while (historyCount > 0 && sample.Timestamp - At(0).Timestamp >= TimeSpan.FromSeconds(60))
+        { history[historyStart] = null; historyStart = (historyStart + 1) % history.Length; historyCount--; }
+        if (historyCount == history.Length)
+        { history[historyStart] = null; historyStart = (historyStart + 1) % history.Length; historyCount--; }
+        history[(historyStart + historyCount) % history.Length] = sample;
+        historyCount++;
+        current = sample;
+        if (!displayTime.HasValue || sample.Timestamp > displayTime) displayTime = sample.Timestamp;
+        message = sample.Status switch
+        {
+            DiskActivityStatus.Available => $"磁盘 {sample.DiskNumber} · 最近 60 秒",
+            DiskActivityStatus.Waiting => "等待采样",
+            _ => "磁盘活动暂不可用"
+        };
+        UpdateDescription();
+        Invalidate();
+    }
+
+    public void SetMessage(string text)
+    {
+        if (disposed) return;
+        ResetHistory();
+        message = string.IsNullOrWhiteSpace(text) ? "等待采样" : text[..Math.Min(text.Length, 160)];
+        UpdateDescription();
+        Invalidate();
+    }
+
+    public void ResetHistory()
+    {
+        if (disposed) return;
+        Array.Clear(history);
+        historyStart = historyCount = 0;
+        current = null;
+        displayTime = null;
+        message = "等待采样";
+        UpdateDescription();
+        Invalidate();
+    }
+
+    // Called by the visible host's 1 Hz UI clock, even if a native provider stalls.
+    internal void AdvanceClock(DateTimeOffset now)
+    {
+        if (disposed) return;
+        if (displayTime.HasValue && now < displayTime.Value)
+        {
+            ResetHistory();
+            message = "时间变化 · 等待更新";
+            UpdateDescription();
+            return;
+        }
+        displayTime = now;
+        while (historyCount > 0 && now - At(0).Timestamp >= TimeSpan.FromSeconds(60))
+        { history[historyStart] = null; historyStart = (historyStart + 1) % history.Length; historyCount--; }
+        if (current != null && now - current.Timestamp > TimeSpan.FromSeconds(4))
+        {
+            current = null;
+            message = "采样延迟 · 等待更新";
+        }
+        UpdateDescription();
+        Invalidate();
+    }
+
+    private DiskActivitySample At(int index) => history[(historyStart + index) % history.Length]!;
+    private int S(float logical) => (int)Math.Round(logical * DeviceDpi / 96f);
+    private static double? Valid(double? number, double max = double.MaxValue) =>
+        number is { } value && double.IsFinite(value) && value >= 0 && value <= max ? value : null;
+    private double? Metric(Func<DiskActivitySample, double?> getter, double max = double.MaxValue) =>
+        current?.Status == DiskActivityStatus.Available ? Valid(getter(current), max) : null;
+    private static string Number(double? number, string suffix, bool integer = false) =>
+        number is { } value ? value.ToString(integer ? "0" : "0.0", CultureInfo.CurrentCulture) + suffix : "—";
+    private string[] Values() =>
+    [
+        Number(Metric(sample => sample.ActivePercent, 100), "%", true),
+        Number(Metric(sample => sample.ReadBytesPerSecond) / (1024 * 1024), " MiB/s"),
+        Number(Metric(sample => sample.WriteBytesPerSecond) / (1024 * 1024), " MiB/s"),
+        Number(Metric(sample => sample.ResponseMilliseconds), " 毫秒")
+    ];
+    private void UpdateDescription()
+    {
+        var values = Values();
+        AccessibleDescription = $"整块磁盘，包含其他进程；{message}；活动时间 {values[0]}；读取速度 {values[1]}；写入速度 {values[2]}；平均响应 {values[3]}";
+    }
+
+    protected override void OnLayout(LayoutEventArgs levent)
+    {
+        base.OnLayout(levent);
+        if (targetBox == null || toggle == null) return;
+        toggle.Bounds = new Rectangle(Math.Max(0, Width - S(62)), S(3), S(52), S(24));
+        targetBox.Bounds = new Rectangle(Math.Max(0, toggle.Left - S(118)), S(4), S(110), S(23));
+    }
+    protected override void OnDpiChangedAfterParent(EventArgs e)
+    {
+        base.OnDpiChangedAfterParent(e);
+        PerformLayout();
+        Invalidate();
+    }
+
+    private List<PointF[]> BuildSegments(RectangleF chart)
+    {
+        var result = new List<PointF[]>();
+        if (historyCount == 0) return result;
+        var segment = new List<PointF>(60);
+        DiskActivitySample? previous = null;
+        DateTimeOffset end = displayTime ?? At(historyCount - 1).Timestamp;
+        void Flush() { if (segment.Count > 0) result.Add(segment.ToArray()); segment.Clear(); }
+        for (int i = 0; i < historyCount; i++)
+        {
+            var sample = At(i);
+            double? active = sample.Status == DiskActivityStatus.Available ? Valid(sample.ActivePercent, 100) : null;
+            if (active == null) { Flush(); previous = null; continue; }
+            if (previous != null && (sample.Timestamp - previous.Timestamp > TimeSpan.FromSeconds(2.5) ||
+                sample.DiskNumber != previous.DiskNumber)) Flush();
+            segment.Add(new PointF(chart.Right - chart.Width * (float)(end - sample.Timestamp).TotalSeconds / 60,
+                chart.Bottom - chart.Height * (float)active.Value / 100));
+            previous = sample;
+        }
+        Flush();
+        return result;
+    }
+
+    protected override void OnPaint(PaintEventArgs e)
+    {
+        if (disposed || Width < 2 || Height < 2) return;
+        base.OnPaint(e);
+        bool contrast = SystemInformation.HighContrast;
+        Color surface = contrast ? SystemColors.Window : Theme.Surface;
+        Color text = contrast ? SystemColors.WindowText : Theme.Text;
+        Color muted = contrast ? SystemColors.WindowText : Theme.Muted;
+        Color accent = contrast ? SystemColors.Highlight : Theme.Accent;
+        Color borderColor = contrast ? SystemColors.WindowText : Theme.Border;
+        if (BackColor != surface) BackColor = surface;
+        targetBox.BackColor = toggle.BackColor = surface;
+        targetBox.ForeColor = text;
+        toggle.ForeColor = accent;
+        toggle.FlatAppearance.BorderColor = borderColor;
+        var graphics = e.Graphics;
+        graphics.SmoothingMode = SmoothingMode.AntiAlias;
+        using var border = new Pen(borderColor);
+        using var outline = Theme.Round(new RectangleF(.5f, .5f, Width - 1, Height - 1), S(9));
+        graphics.DrawPath(border, outline);
+        DrawText(graphics, "磁盘活动", heading, text, new Rectangle(S(14), S(3), S(82), S(24)));
+        int textEnd = targetBox.Left - S(10);
+        DrawText(graphics, "整块磁盘，包含其他进程", small, muted,
+            new Rectangle(S(104), S(3), Math.Max(0, Math.Min(S(192), textEnd - S(104))), S(24)));
+        if (textEnd > S(340))
+        {
+            string summary = !Expanded && current?.Status == DiskActivityStatus.Available
+                ? $"{Values()[0]} · 读 {Values()[1]}" : message;
+            DrawText(graphics, summary, small, muted,
+                new Rectangle(S(306), S(3), Math.Max(0, textEnd - S(306)), S(24)));
+        }
+        if (!Expanded) return;
+        float logicalWidth = Width * 96f / DeviceDpi;
+        float chartRight = Width * (logicalWidth < 900 ? .34f : .44f);
+        var chart = new RectangleF(S(14), S(35), Math.Max(S(50), chartRight - S(30)), S(47));
+        using var grid = new Pen(contrast ? borderColor : Theme.Mix(borderColor, surface, .4f));
+        for (int i = 0; i <= 4; i++)
+        {
+            float y = chart.Top + chart.Height * i / 4;
+            graphics.DrawLine(grid, chart.Left, y, chart.Right, y);
+        }
+        for (int i = 0; i <= 6; i++)
+        {
+            float x = chart.Left + chart.Width * i / 6;
+            graphics.DrawLine(grid, x, chart.Top, x, chart.Bottom);
+        }
+        using var line = new Pen(accent, 1.5f * DeviceDpi / 96f);
+        using var fill = new SolidBrush(Color.FromArgb(contrast ? 0 : 30, accent));
+        foreach (var points in BuildSegments(chart))
+        {
+            if (points.Length == 1)
+            {
+                using var dot = new SolidBrush(accent);
+                graphics.FillEllipse(dot, points[0].X - S(1), points[0].Y - S(1), S(2), S(2));
+                continue;
+            }
+            using var area = new GraphicsPath();
+            area.AddLines(points);
+            area.AddLine(points[^1], new PointF(points[^1].X, chart.Bottom));
+            area.AddLine(new PointF(points[^1].X, chart.Bottom), new PointF(points[0].X, chart.Bottom));
+            area.CloseFigure();
+            graphics.FillPath(fill, area);
+            graphics.DrawLines(line, points);
+        }
+        DrawText(graphics, current == null ? "最近 60 秒 · 活动时间" : $"磁盘 {current.DiskNumber} · 最近 60 秒", small, muted,
+            new Rectangle(S(14), S(82), Math.Max(0, (int)chart.Width), S(18)));
+        string[] labels = ["活动时间", "读取速度", "写入速度", "平均响应"];
+        string[] values = Values();
+        float start = chartRight + S(14), cell = Math.Max(0, (Width - start - S(12)) / 4);
+        for (int i = 0; i < labels.Length; i++)
+        {
+            float x = start + cell * i;
+            if (i > 0) graphics.DrawLine(grid, x - S(10), S(40), x - S(10), S(87));
+            DrawText(graphics, labels[i], small, muted,
+                new Rectangle((int)x, S(35), Math.Max(0, (int)cell - S(10)), S(21)));
+            DrawText(graphics, values[i], value, i == 0 ? accent : text,
+                new Rectangle((int)x, S(57), Math.Max(0, (int)cell - S(10)), S(30)));
+        }
+    }
+
+    private static void DrawText(Graphics graphics, string text, Font font, Color color, Rectangle bounds)
+    {
+        if (bounds.Width > 0 && bounds.Height > 0) Theme.TextAt(graphics, text, font, color, bounds);
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+        if (disposing && !disposed)
+        {
+            disposed = true;
+            Array.Clear(history);
+            current = null;
+            ExpansionChanged = null;
+            TargetChanged = null;
+            heading.Dispose(); small.Dispose(); value.Dispose();
+        }
+        base.Dispose(disposing);
+    }
+}
diff --git a/src/Monitoring/DiskActivityResolver.cs b/src/Monitoring/DiskActivityResolver.cs
new file mode 100644
index 0000000..510ea74
--- /dev/null
+++ b/src/Monitoring/DiskActivityResolver.cs
@@ -0,0 +1,161 @@
+using System.Buffers.Binary;
+using System.Runtime.InteropServices;
+using System.Security;
+using System.Text;
+using Microsoft.Win32.SafeHandles;
+
+namespace DiskAtlas;
+
+internal sealed record DiskActivityTarget(int DiskNumber, string Label);
+
+// Resolves Windows physical-disk counter numbers without enumerating any files.
+// Unsupported/ambiguous mappings remain unavailable instead of choosing a disk.
+internal static class DiskActivityResolver
+{
+    private const uint VolumeDiskExtents = 0x00560000, StorageQueryProperty = 0x002d1400;
+    private const int SingleExtentBytes = 32, DescriptorPrefixBytes = 36, MaximumDescriptorBytes = 65536;
+
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+    private static extern bool GetVolumePathNameW(string path, StringBuilder mountPoint, uint length);
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+    private static extern bool GetVolumeNameForVolumeMountPointW(string mountPoint, StringBuilder volumeName, uint length);
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode)]
+    private static extern uint GetDriveTypeW(string root);
+
+    internal static DiskActivityTarget? Resolve(string path, CancellationToken token = default)
+    {
+        token.ThrowIfCancellationRequested();
+        if (!OperatingSystem.IsWindows() || !IsLocalAbsolutePath(path)) return null;
+        try
+        {
+            string absolute = Path.GetFullPath(path);
+            var mountPoint = new StringBuilder(32768);
+            bool mapped = GetVolumePathNameW(absolute, mountPoint, (uint)mountPoint.Capacity);
+            token.ThrowIfCancellationRequested();
+            if (!mapped || !IsLocalAbsolutePath(mountPoint.ToString())) return null;
+            string mount = mountPoint.ToString();
+            uint driveType = GetDriveTypeW(mount);
+            token.ThrowIfCancellationRequested();
+            if (driveType != 3) return null; // DRIVE_FIXED only; never UNC/removable.
+            var volumeName = new StringBuilder(64);
+            bool named = GetVolumeNameForVolumeMountPointW(mount, volumeName, (uint)volumeName.Capacity);
+            token.ThrowIfCancellationRequested();
+            if (!named || !IsVolumeGuidPath(volumeName.ToString())) return null;
+
+            using var volume = NativeStorage.CreateFileW(volumeName.ToString()[..^1], 0, NativeStorage.ShareAll,
+                IntPtr.Zero, 3, 0, IntPtr.Zero);
+            token.ThrowIfCancellationRequested();
+            if (volume.IsInvalid) return null;
+            var extents = new byte[SingleExtentBytes];
+            bool located = NativeStorage.DeviceIoControl(volume, VolumeDiskExtents, null, 0, extents, extents.Length,
+                out int returned, IntPtr.Zero);
+            token.ThrowIfCancellationRequested();
+            if (!located || !TryReadSingleExtent(extents, returned, out int diskNumber)) return null;
+
+            using var disk = NativeStorage.CreateFileW(@"\\.\PhysicalDrive" + diskNumber, 0, NativeStorage.ShareAll,
+                IntPtr.Zero, 3, 0, IntPtr.Zero);
+            token.ThrowIfCancellationRequested();
+            if (disk.IsInvalid || !ReadSupportedDevice(disk, token)) return null;
+            token.ThrowIfCancellationRequested();
+            return new(diskNumber, "磁盘 " + diskNumber);
+        }
+        catch (Exception error) when (IsExpectedReadFailure(error)) { return null; }
+    }
+
+    internal static IReadOnlyList<DiskActivityTarget> Discover(CancellationToken token = default)
+    {
+        token.ThrowIfCancellationRequested();
+        if (!OperatingSystem.IsWindows()) return Array.Empty<DiskActivityTarget>();
+        DriveInfo[] drives;
+        try { drives = DriveInfo.GetDrives(); }
+        catch (Exception error) when (IsExpectedReadFailure(error)) { return Array.Empty<DiskActivityTarget>(); }
+        var targets = new SortedDictionary<int, DiskActivityTarget>();
+        foreach (var drive in drives)
+        {
+            token.ThrowIfCancellationRequested();
+            try
+            {
+                if (drive.DriveType != DriveType.Fixed) continue;
+                var target = Resolve(drive.RootDirectory.FullName, token);
+                if (target != null) targets.TryAdd(target.DiskNumber, target);
+            }
+            catch (Exception error) when (IsExpectedReadFailure(error)) { }
+        }
+        token.ThrowIfCancellationRequested();
+        return Array.AsReadOnly(targets.Values.ToArray());
+    }
+
+    private static bool ReadSupportedDevice(SafeFileHandle disk, CancellationToken token)
+    {
+        byte[] query = new byte[12]; // StorageDeviceProperty=0, PropertyStandardQuery=0.
+        var header = new byte[8];
+        bool received = NativeStorage.DeviceIoControl(disk, StorageQueryProperty, query, query.Length, header, header.Length,
+            out int returned, IntPtr.Zero);
+        token.ThrowIfCancellationRequested();
+        if (!received || !TryReadDescriptorSize(header, returned, out int size)) return false;
+        var descriptor = new byte[size];
+        received = NativeStorage.DeviceIoControl(disk, StorageQueryProperty, query, query.Length, descriptor, descriptor.Length,
+            out returned, IntPtr.Zero);
+        token.ThrowIfCancellationRequested();
+        return received && IsSupportedDeviceDescriptor(descriptor, returned);
+    }
+
+    // The native VOLUME_DISK_EXTENTS layout aligns DISK_EXTENT at offset 8;
+    // DiskNumber is at 8, StartingOffset at 16, and ExtentLength at 24.
+    internal static bool TryReadSingleExtent(ReadOnlySpan<byte> buffer, int returned, out int diskNumber)
+    {
+        diskNumber = -1;
+        if (returned < SingleExtentBytes || returned > buffer.Length) return false;
+        var bytes = buffer[..returned];
+        if (BinaryPrimitives.ReadUInt32LittleEndian(bytes) != 1) return false;
+        uint number = BinaryPrimitives.ReadUInt32LittleEndian(bytes[8..]);
+        long start = BinaryPrimitives.ReadInt64LittleEndian(bytes[16..]);
+        long length = BinaryPrimitives.ReadInt64LittleEndian(bytes[24..]);
+        if (number > int.MaxValue || start < 0 || length <= 0 || start > long.MaxValue - length) return false;
+        diskNumber = (int)number;
+        return true;
+    }
+
+    internal static bool TryReadDescriptorSize(ReadOnlySpan<byte> header, int returned, out int size)
+    {
+        size = 0;
+        if (returned < 8 || returned > header.Length) return false;
+        uint version = BinaryPrimitives.ReadUInt32LittleEndian(header);
+        uint declared = BinaryPrimitives.ReadUInt32LittleEndian(header[4..]);
+        if (version < DescriptorPrefixBytes || version > declared || declared < DescriptorPrefixBytes || declared > MaximumDescriptorBytes)
+            return false;
+        size = (int)declared;
+        return true;
+    }
+
+    internal static bool IsSupportedDeviceDescriptor(ReadOnlySpan<byte> buffer, int returned)
+    {
+        if (!TryReadDescriptorSize(buffer, returned, out int size) || size > returned) return false;
+        // SCSI direct-access block device, non-removable. Never decode identifying strings.
+        if (buffer[8] != 0 || buffer[10] != 0) return false;
+        uint rawLength = BinaryPrimitives.ReadUInt32LittleEndian(buffer[32..]);
+        if (rawLength > size - DescriptorPrefixBytes) return false;
+        return IsSupportedBusType(BinaryPrimitives.ReadUInt32LittleEndian(buffer[28..]));
+    }
+
+    internal static bool IsSupportedBusType(uint bus) => bus is 1 or 2 or 3 or 4 or 5 or 6 or 7 or 8 or 10 or 11 or 12 or 13 or 17 or 18 or 19;
+
+    internal static bool IsLocalAbsolutePath(string? path)
+    {
+        if (string.IsNullOrWhiteSpace(path) || path.IndexOf('\0') >= 0) return false;
+        ReadOnlySpan<char> local = path.AsSpan();
+        if (local.StartsWith(@"\\?\", StringComparison.Ordinal)) local = local[4..];
+        return local.Length >= 3 && char.IsAsciiLetter(local[0]) && local[1] == ':' &&
+            (local[2] == '\\' || local[2] == '/');
+    }
+
+    internal static bool IsVolumeGuidPath(string value)
+    {
+        const string prefix = @"\\?\Volume{";
+        return value.Length == prefix.Length + 38 && value.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) &&
+            value.EndsWith(@"}\", StringComparison.Ordinal) && Guid.TryParseExact(value.AsSpan(prefix.Length, 36), "D", out _);
+    }
+
+    internal static bool IsExpectedReadFailure(Exception error) => error is IOException or UnauthorizedAccessException or
+        ArgumentException or NotSupportedException or SecurityException or DllNotFoundException or EntryPointNotFoundException;
+}
diff --git a/src/Monitoring/DiskActivitySource.cs b/src/Monitoring/DiskActivitySource.cs
new file mode 100644
index 0000000..405efae
--- /dev/null
+++ b/src/Monitoring/DiskActivitySource.cs
@@ -0,0 +1,279 @@
+using System.Globalization;
+using System.Runtime.InteropServices;
+
+namespace DiskAtlas;
+
+internal enum DiskActivityStatus { Waiting, Available, Unavailable }
+internal sealed record DiskActivitySample(DateTimeOffset Timestamp, int DiskNumber, double? ActivePercent,
+    double? ReadBytesPerSecond, double? WriteBytesPerSecond, double? ResponseMilliseconds, DiskActivityStatus Status);
+internal interface IDiskActivitySource : IDisposable
+{
+    DiskActivitySample Collect(CancellationToken token);
+}
+
+// Internal seam keeps buffer/state tests independent of the machine's disks and counters.
+internal sealed record DiskActivityCounter(string Instance, int DiskNumber, double? Value);
+internal interface IDiskActivityQuery : IDisposable
+{
+    bool Collect(CancellationToken token);
+    IReadOnlyList<DiskActivityCounter>? Read(int counter, CancellationToken token);
+}
+
+// Owned by one background sampling loop. The constructor does not call PDH.
+internal sealed class PdhDiskActivitySource : IDiskActivitySource
+{
+    private readonly int diskNumber;
+    private readonly Func<IDiskActivityQuery> createQuery;
+    private readonly object gate = new();
+    private IDiskActivityQuery? query;
+    private bool primed, disposed;
+
+    internal PdhDiskActivitySource(int diskNumber) : this(diskNumber, () => new PdhDiskActivityQuery()) { }
+    internal PdhDiskActivitySource(int diskNumber, Func<IDiskActivityQuery> createQuery)
+    {
+        ArgumentOutOfRangeException.ThrowIfNegative(diskNumber);
+        this.diskNumber = diskNumber;
+        this.createQuery = createQuery ?? throw new ArgumentNullException(nameof(createQuery));
+    }
+
+    public DiskActivitySample Collect(CancellationToken token)
+    {
+        token.ThrowIfCancellationRequested();
+        lock (gate)
+        {
+            ObjectDisposedException.ThrowIf(disposed, this);
+            token.ThrowIfCancellationRequested();
+            try
+            {
+                query ??= createQuery();
+                bool collected = query.Collect(token);
+                DateTimeOffset collectedAt = DateTimeOffset.UtcNow;
+                token.ThrowIfCancellationRequested();
+                if (!collected)
+                {
+                    primed = false;
+                    return Empty(DiskActivityStatus.Unavailable);
+                }
+                if (!primed)
+                {
+                    primed = true;
+                    return Empty(DiskActivityStatus.Waiting);
+                }
+                var counters = new IReadOnlyList<DiskActivityCounter>?[4];
+                for (int i = 0; i < counters.Length; i++)
+                {
+                    token.ThrowIfCancellationRequested();
+                    counters[i] = query.Read(i, token);
+                }
+                token.ThrowIfCancellationRequested();
+                return Compose(collectedAt, diskNumber, counters[0], counters[1], counters[2], counters[3]);
+            }
+            catch (Exception error) when (error is DllNotFoundException or EntryPointNotFoundException or BadImageFormatException)
+            {
+                primed = false;
+                return Empty(DiskActivityStatus.Unavailable);
+            }
+        }
+    }
+
+    private DiskActivitySample Empty(DiskActivityStatus status) => new(DateTimeOffset.UtcNow, diskNumber, null, null, null, null, status);
+
+    internal static DiskActivitySample Compose(DateTimeOffset timestamp, int diskNumber,
+        IReadOnlyList<DiskActivityCounter>? idle, IReadOnlyList<DiskActivityCounter>? read,
+        IReadOnlyList<DiskActivityCounter>? write, IReadOnlyList<DiskActivityCounter>? response)
+    {
+        var arrays = new[] { idle, read, write, response };
+        var matches = new DiskActivityCounter?[4];
+        for (int i = 0; i < arrays.Length; i++)
+        {
+            if (arrays[i] is not { } items) continue;
+            bool duplicate = false;
+            foreach (var item in items)
+            {
+                if (item.DiskNumber != diskNumber || !TryParseInstance(item.Instance, out int parsed) || parsed != diskNumber) continue;
+                if (matches[i] != null) { duplicate = true; break; }
+                matches[i] = item;
+            }
+            if (duplicate) matches[i] = null;
+        }
+        // A topology/instance-name change between arrays must not join different instances.
+        string[] names = matches.Where(item => item != null).Select(item => item!.Instance).Distinct(StringComparer.Ordinal).ToArray();
+        if (names.Length != 1) return new(timestamp, diskNumber, null, null, null, null, DiskActivityStatus.Unavailable);
+        static double? Nonnegative(double? value) => value is { } number && double.IsFinite(number) && number >= 0 ? number : null;
+        double? idleValue = Nonnegative(matches[0]?.Value);
+        double? active = idleValue is <= 100 ? 100 - idleValue.Value : null;
+        double? readValue = Nonnegative(matches[1]?.Value), writeValue = Nonnegative(matches[2]?.Value);
+        double? seconds = Nonnegative(matches[3]?.Value);
+        double? milliseconds = seconds.HasValue ? Nonnegative(seconds.Value * 1000) : null;
+        bool available = active.HasValue || readValue.HasValue || writeValue.HasValue || milliseconds.HasValue;
+        return new(timestamp, diskNumber, active, readValue, writeValue, milliseconds,
+            available ? DiskActivityStatus.Available : DiskActivityStatus.Unavailable);
+    }
+
+    internal static bool TryParseInstance(string? name, out int diskNumber)
+    {
+        diskNumber = -1;
+        if (string.IsNullOrEmpty(name) || name.Length > 256) return false;
+        int digits = 0;
+        while (digits < name.Length && char.IsAsciiDigit(name[digits])) digits++;
+        if (digits == 0 || (digits > 1 && name[0] == '0') ||
+            !int.TryParse(name.AsSpan(0, digits), NumberStyles.None, CultureInfo.InvariantCulture, out int number)) return false;
+        var letters = new HashSet<char>();
+        for (int i = digits; i < name.Length; i += 3)
+        {
+            if (i + 2 >= name.Length || name[i] != ' ' || !char.IsAsciiLetter(name[i + 1]) || name[i + 2] != ':' ||
+                !letters.Add(char.ToUpperInvariant(name[i + 1]))) return false;
+        }
+        diskNumber = number;
+        return true;
+    }
+
+    public void Dispose()
+    {
+        lock (gate)
+        {
+            if (disposed) return;
+            disposed = true;
+            query?.Dispose();
+            query = null;
+        }
+    }
+}
+
+internal sealed class PdhDiskActivityQuery : IDiskActivityQuery
+{
+    internal const int MaximumBufferBytes = 1024 * 1024, MaximumItems = 4096, ItemBytes = 24;
+    private const uint MoreData = 0x800007D2, InvalidArgument = 0xC0000BBD;
+    private const uint Format = 0x00000200 | 0x00001000 | 0x00008000; // DOUBLE | NOSCALE | NOCAP100; validate idle bounds ourselves.
+    private readonly IntPtr[] counters = new IntPtr[4];
+    private IntPtr query;
+    private bool disposed;
+
+    [StructLayout(LayoutKind.Explicit, Size = ItemBytes)]
+    internal struct FormattedItem
+    {
+        [FieldOffset(0)] internal IntPtr Name;
+        [FieldOffset(8)] internal uint Status;
+        [FieldOffset(16)] internal double Value;
+    }
+
+    internal PdhDiskActivityQuery()
+    {
+        if (!OperatingSystem.IsWindows() || IntPtr.Size != 8) return;
+        if (PdhOpenQueryW(null, UIntPtr.Zero, out query) != 0 || query == IntPtr.Zero)
+        {
+            if (query != IntPtr.Zero) PdhCloseQuery(query);
+            query = IntPtr.Zero;
+            return;
+        }
+        try
+        {
+            string[] paths = [@"\PhysicalDisk(*)\% Idle Time", @"\PhysicalDisk(*)\Disk Read Bytes/sec",
+                @"\PhysicalDisk(*)\Disk Write Bytes/sec", @"\PhysicalDisk(*)\Avg. Disk sec/Transfer"];
+            for (int i = 0; i < paths.Length; i++)
+                if (PdhAddEnglishCounterW(query, paths[i], UIntPtr.Zero, out var counter) == 0) counters[i] = counter;
+        }
+        catch
+        {
+            PdhCloseQuery(query);
+            query = IntPtr.Zero;
+            throw;
+        }
+    }
+
+    public bool Collect(CancellationToken token)
+    {
+        ObjectDisposedException.ThrowIf(disposed, this);
+        token.ThrowIfCancellationRequested();
+        bool success = query != IntPtr.Zero && counters.Any(counter => counter != IntPtr.Zero) && PdhCollectQueryData(query) == 0;
+        token.ThrowIfCancellationRequested();
+        return success;
+    }
+
+    public IReadOnlyList<DiskActivityCounter>? Read(int counter, CancellationToken token)
+    {
+        ObjectDisposedException.ThrowIf(disposed, this);
+        ArgumentOutOfRangeException.ThrowIfNegative(counter);
+        ArgumentOutOfRangeException.ThrowIfGreaterThanOrEqual(counter, counters.Length);
+        token.ThrowIfCancellationRequested();
+        if (query == IntPtr.Zero || counters[counter] == IntPtr.Zero) return null;
+        // Restart the size probe after a race; PDH does not guarantee the size
+        // returned when an already nonzero buffer is insufficient.
+        for (int attempt = 0; attempt < 2; attempt++)
+        {
+            token.ThrowIfCancellationRequested();
+            uint bytes = 0;
+            uint status = PdhGetFormattedCounterArrayW(counters[counter], Format, ref bytes, out uint count, IntPtr.Zero);
+            if (status == 0 && count == 0) return Array.Empty<DiskActivityCounter>();
+            if (status != MoreData || bytes is 0 or > MaximumBufferBytes || count > MaximumItems) return null;
+            int capacity = (int)bytes;
+            IntPtr buffer = Marshal.AllocHGlobal(capacity);
+            try
+            {
+                status = PdhGetFormattedCounterArrayW(counters[counter], Format, ref bytes, out count, buffer);
+                token.ThrowIfCancellationRequested();
+                if (status is MoreData or InvalidArgument) continue;
+                if (status != 0 || bytes > capacity) return null;
+                return TryDecodeArray(buffer, (int)bytes, count, out var values) ? values : null;
+            }
+            finally { Marshal.FreeHGlobal(buffer); }
+        }
+        return null;
+    }
+
+    // The caller owns a readable buffer of exactly bufferBytes. Every embedded
+    // string pointer is checked against that same allocation before dereferencing.
+    internal static bool TryDecodeArray(IntPtr buffer, int bufferBytes, uint count, out IReadOnlyList<DiskActivityCounter> values)
+    {
+        values = Array.Empty<DiskActivityCounter>();
+        if (IntPtr.Size != 8 || bufferBytes < 0 || bufferBytes > MaximumBufferBytes || count > MaximumItems ||
+            (long)count * ItemBytes > bufferBytes) return false;
+        if (count == 0) return true;
+        long start = buffer.ToInt64();
+        if (start <= 0 || start > long.MaxValue - bufferBytes) return false;
+        long stringsStart = start + (long)count * ItemBytes, end = start + bufferBytes;
+        var output = new List<DiskActivityCounter>((int)count);
+        var disks = new HashSet<int>();
+        for (int i = 0; i < count; i++)
+        {
+            var item = Marshal.PtrToStructure<FormattedItem>(IntPtr.Add(buffer, i * ItemBytes));
+            long name = item.Name.ToInt64();
+            if (name < stringsStart || name > end - 2 || (name - start) % 2 != 0) return false;
+            int maximum = (int)Math.Min(257, (end - name) / 2), length = 0;
+            while (length < maximum && Marshal.ReadInt16(item.Name, length * 2) != 0) length++;
+            if (length == maximum || length > 256) return false;
+            string instance = Marshal.PtrToStringUni(item.Name, length) ?? string.Empty;
+            if (!PdhDiskActivitySource.TryParseInstance(instance, out int disk)) continue;
+            if (!disks.Add(disk)) return false;
+            double? number = item.Status is 0 or 1 && double.IsFinite(item.Value) && item.Value >= 0 ? item.Value : null;
+            output.Add(new(instance, disk, number));
+        }
+        values = output.AsReadOnly();
+        return true;
+    }
+
+    public void Dispose()
+    {
+        if (disposed) return;
+        disposed = true;
+        if (query != IntPtr.Zero) PdhCloseQuery(query); // Also removes all added counters.
+        query = IntPtr.Zero;
+        Array.Clear(counters);
+    }
+
+    [DllImport("pdh.dll", CharSet = CharSet.Unicode, ExactSpelling = true)]
+    [DefaultDllImportSearchPaths(DllImportSearchPath.System32)]
+    private static extern uint PdhOpenQueryW(string? source, UIntPtr userData, out IntPtr query);
+    [DllImport("pdh.dll", CharSet = CharSet.Unicode, ExactSpelling = true)]
+    [DefaultDllImportSearchPaths(DllImportSearchPath.System32)]
+    private static extern uint PdhAddEnglishCounterW(IntPtr query, string path, UIntPtr userData, out IntPtr counter);
+    [DllImport("pdh.dll", ExactSpelling = true)]
+    [DefaultDllImportSearchPaths(DllImportSearchPath.System32)]
+    private static extern uint PdhCollectQueryData(IntPtr query);
+    [DllImport("pdh.dll", ExactSpelling = true)]
+    [DefaultDllImportSearchPaths(DllImportSearchPath.System32)]
+    private static extern uint PdhGetFormattedCounterArrayW(IntPtr counter, uint format, ref uint bufferBytes, out uint count, IntPtr buffer);
+    [DllImport("pdh.dll", ExactSpelling = true)]
+    [DefaultDllImportSearchPaths(DllImportSearchPath.System32)]
+    private static extern uint PdhCloseQuery(IntPtr query);
+}
diff --git a/tests/DiskActivityLayoutPreview.cs b/tests/DiskActivityLayoutPreview.cs

index 0000000..84f725a
--- /dev/null
+++ b/tests/DiskActivityResolverTests.cs
@@ -0,0 +1,106 @@
+using System.Buffers.Binary;
+using System.Security;
+
+namespace DiskAtlas;
+
+internal static class DiskActivityResolverTests
+{
+    internal static int Run()
+    {
+        int passed = 0;
+        void Check(bool condition, string name)
+        {
+            if (!condition) throw new InvalidOperationException("Disk activity resolver check failed: " + name);
+            passed++; Console.WriteLine("PASS disk activity resolver " + name);
+        }
+        byte[] Extent(uint count = 1, uint disk = 2, long start = 1048576, long length = 268435456)
+        {
+            byte[] bytes = new byte[32];
+            BinaryPrimitives.WriteUInt32LittleEndian(bytes, count);
+            BinaryPrimitives.WriteUInt32LittleEndian(bytes.AsSpan(8), disk);
+            BinaryPrimitives.WriteInt64LittleEndian(bytes.AsSpan(16), start);
+            BinaryPrimitives.WriteInt64LittleEndian(bytes.AsSpan(24), length);
+            return bytes;
+        }
+        bool ExtentAccepted(byte[] bytes, int? returned = null) =>
+            DiskActivityResolver.TryReadSingleExtent(bytes, returned ?? bytes.Length, out _);
+        Check(DiskActivityResolver.TryReadSingleExtent(Extent(), 32, out int disk) && disk == 2,
+            "aligned single extent supplies the physical disk number");
+        Check(DiskActivityResolver.TryReadSingleExtent(Extent(disk: 0, start: 0, length: 1), 32, out disk) && disk == 0,
+            "zero disk and zero starting offset are valid");
+        foreach (uint count in new uint[] { 0, 2, uint.MaxValue })
+            Check(!ExtentAccepted(Extent(count: count)), "ambiguous or missing extents are rejected");
+        foreach (int returned in new[] { -1, 0, 8, 31, 33, int.MaxValue })
+            Check(!ExtentAccepted(Extent(), returned), "invalid native extent length is rejected");
+        Check(!ExtentAccepted(new byte[31], 32), "short extent buffer cannot be read");
+        Check(!ExtentAccepted(Extent(disk: uint.MaxValue)), "unrepresentable disk number is rejected");
+        Check(!ExtentAccepted(Extent(start: -1)), "negative starting offset is rejected");
+        Check(!ExtentAccepted(Extent(length: 0)) && !ExtentAccepted(Extent(length: -1)), "nonpositive extent length is rejected");
+        Check(!ExtentAccepted(Extent(start: long.MaxValue, length: 1)), "extent end overflow is rejected");
+        Check(ExtentAccepted(Extent(start: long.MaxValue - 1, length: 1)), "largest valid extent end stays representable");
+        Check(!DiskActivityResolver.TryReadSingleExtent(Extent(count: 2), 32, out disk) && disk == -1,
+            "failed extent parsing leaves no guessed disk number");
+
+        byte[] Descriptor(uint bus = 17, int size = 40)
+        {
+            var bytes = new byte[size];
+            BinaryPrimitives.WriteUInt32LittleEndian(bytes, 40);
+            BinaryPrimitives.WriteUInt32LittleEndian(bytes.AsSpan(4), (uint)size);
+            BinaryPrimitives.WriteUInt32LittleEndian(bytes.AsSpan(28), bus);
+            return bytes;
+        }
+        bool DescriptorAccepted(byte[] bytes, int? returned = null) =>
+            DiskActivityResolver.IsSupportedDeviceDescriptor(bytes, returned ?? bytes.Length);
+        Check(DescriptorAccepted(Descriptor()), "fixed NVMe direct-access descriptor is supported");
+        foreach (uint bus in new uint[] { 0, 9, 14, 15, 16, 20, 127, uint.MaxValue })
+            Check(!DescriptorAccepted(Descriptor(bus)), "unknown remote or virtual bus is rejected");
+        foreach (uint bus in new uint[] { 1, 2, 3, 4, 5, 6, 7, 8, 10, 11, 12, 13, 17, 18, 19 })
+            Check(DescriptorAccepted(Descriptor(bus)), "known fixed local bus is accepted");
+        var removable = Descriptor(); removable[10] = 1;
+        Check(!DescriptorAccepted(removable), "removable media are rejected");
+        var optical = Descriptor(); optical[8] = 5;
+        Check(!DescriptorAccepted(optical), "non-disk device types are rejected");
+        foreach (int returned in new[] { -1, 0, 7, 35, 39, 41, int.MaxValue })
+            Check(!DescriptorAccepted(Descriptor(), returned), "invalid or truncated descriptor result is rejected");
+        var wrongVersion = Descriptor(); BinaryPrimitives.WriteUInt32LittleEndian(wrongVersion, 0);
+        Check(!DescriptorAccepted(wrongVersion), "missing descriptor version is rejected");
+        var futureVersion = Descriptor(); BinaryPrimitives.WriteUInt32LittleEndian(futureVersion, 41);
+        Check(!DescriptorAccepted(futureVersion), "descriptor version cannot exceed its declared size");
+        var oversized = Descriptor(); BinaryPrimitives.WriteUInt32LittleEndian(oversized.AsSpan(4), 65537);
+        Check(!DiskActivityResolver.TryReadDescriptorSize(oversized, 8, out _), "descriptor allocation is bounded");
+        var shortHeader = new byte[7];
+        Check(!DiskActivityResolver.TryReadDescriptorSize(shortHeader, 7, out _), "truncated descriptor header is rejected");
+        var rawOverflow = Descriptor(); BinaryPrimitives.WriteUInt32LittleEndian(rawOverflow.AsSpan(32), 5);
+        Check(!DescriptorAccepted(rawOverflow), "bus-specific raw data cannot extend beyond the descriptor");
+        var rawFits = Descriptor(); BinaryPrimitives.WriteUInt32LittleEndian(rawFits.AsSpan(32), 4);
+        Check(DescriptorAccepted(rawFits), "bounded bus-specific raw bytes need not be interpreted");
+
+        foreach (string? path in new[] { null, "", " ", "relative", "C:relative", @"\rooted", @"\\server\fixture",
+            @"\\?\UNC\server\fixture", @"\\.\PhysicalDrive0", @"\\?\GLOBALROOT\Device\fixture", "C:\\fixture\0" })
+            Check(!DiskActivityResolver.IsLocalAbsolutePath(path) && DiskActivityResolver.Resolve(path!) == null,
+                "unsupported input returns unavailable before any native lookup");
+        foreach (string path in new[] { @"C:\", @"D:\fixture\folder", "D:/fixture/folder", @"\\?\D:\fixture" })
+            Check(DiskActivityResolver.IsLocalAbsolutePath(path), "absolute local syntax is recognized without accessing it");
+        const string guidPath = @"\\?\Volume{4f4ce85b-a857-4892-9c4f-c326c0aa60c6}\";
+        Check(DiskActivityResolver.IsVolumeGuidPath(guidPath), "canonical volume GUID path is accepted");
+        foreach (string value in new[] { @"C:\", guidPath[..^1], guidPath + "extra", guidPath.Replace("4f4ce85b", "notaguid") })
+            Check(!DiskActivityResolver.IsVolumeGuidPath(value), "noncanonical volume identity is rejected");
+        foreach (Exception error in new Exception[] { new IOException(), new UnauthorizedAccessException(), new ArgumentException(),
+            new NotSupportedException(), new SecurityException(), new DllNotFoundException(), new EntryPointNotFoundException() })
+            Check(DiskActivityResolver.IsExpectedReadFailure(error), "expected metadata failure can return unavailable");
+        Check(!DiskActivityResolver.IsExpectedReadFailure(new OperationCanceledException()), "cancellation is not swallowed as unavailable");
+        Check(!DiskActivityResolver.IsExpectedReadFailure(new InvalidOperationException()), "unexpected programming failure is not swallowed");
+        using (var cancelled = new CancellationTokenSource())
+        {
+            cancelled.Cancel(); bool resolveStopped = false, discoverStopped = false;
+            try { DiskActivityResolver.Resolve("synthetic", cancelled.Token); }
+            catch (OperationCanceledException) { resolveStopped = true; }
+            try { DiskActivityResolver.Discover(cancelled.Token); }
+            catch (OperationCanceledException) { discoverStopped = true; }
+            Check(resolveStopped && discoverStopped, "pre-cancelled resolution and discovery perform no native work");
+        }
+        Check(new DiskActivityTarget(2, "磁盘 2").Label == "磁盘 2", "public target label contains only the disk number");
+        Console.WriteLine("PASS disk activity resolver checks: " + passed + "; native drive mapping not exercised");
+        return passed;
+    }
+}
diff --git a/tests/DiskActivityResourceProbe.cs b/tests/DiskActivityResourceProbe.cs
new file mode 100644
index 0000000..b029050
--- /dev/null
+++ b/tests/DiskActivityResourceProbe.cs
@@ -0,0 +1,250 @@
+using System.Diagnostics;
+using System.Reflection;
+using System.Text;
+using System.Text.Json;
+using DiskAtlas;
+
+// Controlled local resource observation only. No scan, synthetic data, UI,
+// diagnostic logging, or output file is created. Loading the executable and its
+// runtime is naturally part of starting the four independent child processes.
+internal static class DiskActivityResourceProbe
+{
+    private sealed record Result(int Schema, string Mode, string Status, string Code,
+        double? WallMilliseconds, double? CpuMilliseconds, double? CpuSingleCorePercent,
+        long? LifetimePeakWorkingSetBytes, long? WindowEndWorkingSetBytes,
+        int WindowSamples, int WindowValidSamples);
+
+    private const string SkippedMarker = "DISK_ACTIVITY_RESOURCE_SKIPPED", FailedMarker = "DISK_ACTIVITY_RESOURCE_FAILED";
+    private static readonly string[] Fields = ["Schema", "Mode", "Status", "Code", "WallMilliseconds", "CpuMilliseconds",
+        "CpuSingleCorePercent", "LifetimePeakWorkingSetBytes", "WindowEndWorkingSetBytes", "WindowSamples", "WindowValidSamples"];
+
+    internal static int Run()
+    {
+        int failure = 0;
+        string[] modes = ["off", "on", "on", "off"];
+        for (int i = 0; i < modes.Length; i++)
+        {
+            Result result = RunChild(modes[i]);
+            // Rebuild the printable object: never relay raw child output or errors.
+            Console.WriteLine(JsonSerializer.Serialize(new
+            {
+                result.Schema, Round = i + 1, result.Mode, result.Status, result.Code,
+                CpuBasis = "single-core-percent-not-divided-by-logical-processors",
+                PeakScope = "child-process-lifetime-through-report-including-runtime-and-initialization",
+                result.WallMilliseconds, result.CpuMilliseconds, result.CpuSingleCorePercent,
+                result.LifetimePeakWorkingSetBytes, result.WindowEndWorkingSetBytes,
+                result.WindowSamples, result.WindowValidSamples
+            }));
+            if (result.Status == "failed") failure = 1;
+            else if (result.Status == "skipped" && failure == 0) failure = 2;
+        }
+        return failure;
+    }
+
+    internal static int Child(string mode)
+    {
+        Result result;
+        DiskActivityMonitor? monitor = null;
+        try
+        {
+            if (mode is not ("off" or "on"))
+                return Emit(Failure("invalid", "InvalidMode"));
+            string path = Environment.CurrentDirectory;
+            var target = DiskActivityResolver.Resolve(path);
+            if (target == null) return Emit(Empty(mode, "skipped", "UnsupportedTarget"));
+
+            object sampleGate = new();
+            bool measuring = false;
+            int samples = 0, valid = 0;
+            if (mode == "on")
+            {
+                // Use the production resolver/discovery/source and its real 1 Hz
+                // schedule. The callback only counts observations; there is no UI.
+                monitor = new DiskActivityMonitor(update =>
+                {
+                    if (update.Sample is not { } sample || sample.DiskNumber != target.DiskNumber) return;
+                    lock (sampleGate)
+                    {
+                        if (!measuring) return;
+                        samples++;
+                        if (sample.Status == DiskActivityStatus.Available &&
+                            (sample.ActivePercent.HasValue || sample.ReadBytesPerSecond.HasValue ||
+                             sample.WriteBytesPerSecond.HasValue || sample.ResponseMilliseconds.HasValue)) valid++;
+                    }
+                });
+                monitor.Update(path, null, true);
+            }
+            Pause(TimeSpan.FromMilliseconds(1500));
+            using var process = Process.GetCurrentProcess();
+            process.Refresh();
+            TimeSpan before = process.TotalProcessorTime;
+            long started = Stopwatch.GetTimestamp();
+            lock (sampleGate) measuring = true;
+            Pause(TimeSpan.FromSeconds(5));
+            lock (sampleGate) measuring = false;
+            long finished = Stopwatch.GetTimestamp();
+            process.Refresh();
+            double cpu = (process.TotalProcessorTime - before).TotalMilliseconds;
+            double wall = (finished - started) * 1000.0 / Stopwatch.Frequency;
+            long windowWorkingSet = process.WorkingSet64;
+            if (monitor != null)
+            {
+                var stopping = monitor;
+                monitor = null;
+                stopping.Dispose();
+                if (!stopping.Completion.Wait(TimeSpan.FromSeconds(2)))
+                    return Emit(Failure(mode, "ShutdownTimeout"));
+            }
+            process.Refresh();
+            // This OS-maintained peak is since child startup through this query,
+            // including initialization and shutdown; it is NOT a five-second peak.
+            long lifetimePeak = process.PeakWorkingSet64;
+            bool unavailable = mode == "on" && valid == 0;
+            result = new(1, mode, unavailable ? "skipped" : "passed", unavailable ? "CounterUnavailable" : "None",
+                wall, cpu, cpu / wall * 100.0, lifetimePeak, windowWorkingSet, samples, valid);
+            if (!Validate(result, mode)) result = Failure(mode, "ChildFailed");
+        }
+        catch
+        {
+            // Native exception messages, stack traces, and discovery details may
+            // contain private information. Only fixed codes leave this process.
+            result = Failure(mode is "on" or "off" ? mode : "invalid", "ChildFailed");
+        }
+        finally
+        {
+            if (monitor != null)
+            {
+                try { monitor.Dispose(); monitor.Completion.Wait(TimeSpan.FromSeconds(2)); }
+                catch { }
+            }
+        }
+        return Emit(result);
+    }
+
+    private static void Pause(TimeSpan duration)
+    {
+        long started = Stopwatch.GetTimestamp();
+        while (Stopwatch.GetElapsedTime(started) < duration) Thread.Sleep(50);
+    }
+
+    private static int Emit(Result result)
+    {
+        Console.WriteLine(JsonSerializer.Serialize(result));
+        if (result.Status == "skipped") { Console.Error.WriteLine(SkippedMarker); return 2; }
+        if (result.Status == "failed") { Console.Error.WriteLine(FailedMarker); return 1; }
+        return 0;
+    }
+
+    private static Result Empty(string mode, string status, string code) => new(1, mode, status, code, null, null, null, null, null, 0, 0);
+    private static Result Failure(string mode, string code) => Empty(mode, "failed", code);
+
+    private static Result RunChild(string mode)
+    {
+        Process? child = null;
+        try
+        {
+            string assembly = Assembly.GetExecutingAssembly().Location;
+            string? currentHost = Environment.ProcessPath;
+            string host = string.Equals(Path.GetFileNameWithoutExtension(currentHost), "dotnet", StringComparison.OrdinalIgnoreCase)
+                ? currentHost! : "dotnet";
+            var start = new ProcessStartInfo(host)
+            {
+                UseShellExecute = false, CreateNoWindow = true, WindowStyle = ProcessWindowStyle.Hidden,
+                RedirectStandardOutput = true, RedirectStandardError = true, WorkingDirectory = Environment.CurrentDirectory
+            };
+            start.ArgumentList.Add(assembly);
+            start.ArgumentList.Add("--disk-activity-resource-child");
+            start.ArgumentList.Add(mode);
+            child = Process.Start(start);
+            if (child == null) return Failure(mode, "ChildStartFailed");
+            using var deadline = new CancellationTokenSource(TimeSpan.FromSeconds(15));
+            var output = ReadBounded(child.StandardOutput.BaseStream, 16384, deadline.Token);
+            var error = ReadBounded(child.StandardError.BaseStream, 256, deadline.Token);
+            try
+            {
+                Task.WhenAll(output, error, child.WaitForExitAsync(deadline.Token)).GetAwaiter().GetResult();
+            }
+            catch (OperationCanceledException)
+            {
+                StopChild(child);
+                return Failure(mode, "ChildTimeout");
+            }
+            catch
+            {
+                StopChild(child);
+                return Failure(mode, "ChildOutputInvalid");
+            }
+            try
+            {
+                var encoding = new UTF8Encoding(false, true);
+                using var document = JsonDocument.Parse(encoding.GetString(output.Result));
+                var root = document.RootElement;
+                if (root.ValueKind != JsonValueKind.Object) return Failure(mode, "ChildOutputInvalid");
+                var names = new HashSet<string>(StringComparer.Ordinal);
+                foreach (var property in root.EnumerateObject())
+                    if (!names.Add(property.Name) || !Fields.Contains(property.Name, StringComparer.Ordinal))
+                        return Failure(mode, "ChildOutputInvalid");
+                if (names.Count != Fields.Length) return Failure(mode, "ChildOutputInvalid");
+                double? Number(string name) => root.GetProperty(name).ValueKind == JsonValueKind.Null ? null : root.GetProperty(name).GetDouble();
+                long? Integer(string name) => root.GetProperty(name).ValueKind == JsonValueKind.Null ? null : root.GetProperty(name).GetInt64();
+                var result = new Result(root.GetProperty("Schema").GetInt32(),
+                    root.GetProperty("Mode").GetString() ?? throw new FormatException(),
+                    root.GetProperty("Status").GetString() ?? throw new FormatException(),
+                    root.GetProperty("Code").GetString() ?? throw new FormatException(),
+                    Number("WallMilliseconds"), Number("CpuMilliseconds"), Number("CpuSingleCorePercent"),
+                    Integer("LifetimePeakWorkingSetBytes"), Integer("WindowEndWorkingSetBytes"),
+                    root.GetProperty("WindowSamples").GetInt32(), root.GetProperty("WindowValidSamples").GetInt32());
+                if (!Validate(result, mode)) return Failure(mode, "ChildOutputInvalid");
+                string stderr = encoding.GetString(error.Result).Trim();
+                int expectedExit = result.Status == "passed" ? 0 : result.Status == "skipped" ? 2 : 1;
+                string expectedError = result.Status == "passed" ? "" : result.Status == "skipped" ? SkippedMarker : FailedMarker;
+                return child.ExitCode == expectedExit && stderr == expectedError ? result : Failure(mode, "ChildOutputInvalid");
+            }
+            catch { return Failure(mode, "ChildOutputInvalid"); }
+        }
+        catch { if (child != null) StopChild(child); return Failure(mode, "ChildStartFailed"); }
+        finally { child?.Dispose(); }
+    }
+
+    private static async Task<byte[]> ReadBounded(Stream stream, int maximum, CancellationToken token)
+    {
+        using var data = new MemoryStream();
+        byte[] buffer = new byte[512];
+        while (true)
+        {
+            int count = await stream.ReadAsync(buffer.AsMemory(), token).ConfigureAwait(false);
+            if (count == 0) return data.ToArray();
+            if (data.Length + count > maximum) throw new InvalidDataException("ResourceChildOutputLimit");
+            data.Write(buffer, 0, count);
+        }
+    }
+
+    private static void StopChild(Process child)
+    {
+        try { if (!child.HasExited) child.Kill(true); } catch { }
+        try { child.WaitForExit(2000); } catch { }
+    }
+
+    private static bool Validate(Result result, string mode)
+    {
+        if (result.Schema != 1 || result.Mode != mode || result.Status is not ("passed" or "skipped" or "failed") ||
+            result.WindowSamples is < 0 or > 64 || result.WindowValidSamples < 0 || result.WindowValidSamples > result.WindowSamples ||
+            (mode == "off" && (result.WindowSamples != 0 || result.WindowValidSamples != 0))) return false;
+        if (result.Status == "failed")
+            return result.Code is "ChildFailed" or "ShutdownTimeout" or "InvalidMode" &&
+                result.WallMilliseconds == null && result.CpuMilliseconds == null && result.CpuSingleCorePercent == null &&
+                result.LifetimePeakWorkingSetBytes == null && result.WindowEndWorkingSetBytes == null && result.WindowSamples == 0;
+        if (result.Status == "skipped" && result.Code == "UnsupportedTarget")
+            return result.WallMilliseconds == null && result.CpuMilliseconds == null && result.CpuSingleCorePercent == null &&
+                result.LifetimePeakWorkingSetBytes == null && result.WindowEndWorkingSetBytes == null && result.WindowSamples == 0;
+        if (result.Status == "passed" ? result.Code != "None" : result.Code != "CounterUnavailable" || mode != "on" || result.WindowValidSamples != 0)
+            return false;
+        static bool Finite(double? number) => number.HasValue && double.IsFinite(number.Value) && number.Value >= 0;
+        if (!Finite(result.WallMilliseconds) || result.WallMilliseconds is < 5000 or > 12000 || !Finite(result.CpuMilliseconds) ||
+            !Finite(result.CpuSingleCorePercent) || result.LifetimePeakWorkingSetBytes is not > 0 || result.WindowEndWorkingSetBytes is not > 0 ||
+            result.LifetimePeakWorkingSetBytes < result.WindowEndWorkingSetBytes ||
+            (result.Status == "passed" && mode == "on" && result.WindowValidSamples == 0)) return false;
+        double expected = result.CpuMilliseconds!.Value / result.WallMilliseconds!.Value * 100.0;
+        return Math.Abs(result.CpuSingleCorePercent!.Value - expected) <= 0.000001 * Math.Max(1, expected);
+    }
+}
diff --git a/tests/DiskActivityScanProbe.cs b/tests/DiskActivityScanProbe.cs
new file mode 100644
index 0000000..66dc771
--- /dev/null
+++ b/tests/DiskActivityScanProbe.cs
@@ -0,0 +1,256 @@
+using System.Diagnostics;
+using System.Reflection;
+using System.Text;
+using System.Text.Json;
+using DiskAtlas;
+
+internal static class DiskActivityScanProbe
+{
+    private const string Prefix = "AsukaLens-monitor-scan-", Marker = ".asuka-monitor-owner";
+    private const string FixtureVariable = "ASUKALENS_MONITOR_SCAN_FIXTURE", OwnerVariable = "ASUKALENS_MONITOR_SCAN_OWNER";
+    private const int DirectoryCount = 60, FilesPerDirectory = 500;
+    private const BindingFlags Private = BindingFlags.Instance | BindingFlags.NonPublic;
+    internal sealed record Sample(string Mode, long Files, long Directories, long LogicalBytes, long AllocatedBytes,
+        long UnknownAllocation, bool Incomplete, long Skipped, int AllocationIssues, double WallMs, double CpuMs,
+        long PeakWorkingSetBytes, string PeakScope, int MonitorAvailableSamples, int MonitorAvailableDuringScan);
+
+    // Four fresh processes share the same owned fixture: off/on/on/off. The
+    // ownership preflight enumerates it before timing, so this is not a cold-cache test.
+    internal static int Run()
+    {
+        string root = Path.Combine(Path.GetFullPath(Path.GetTempPath()), Prefix + Guid.NewGuid().ToString("N"));
+        string owner = Guid.NewGuid().ToString("N");
+        var children = new List<Process>();
+        var samples = new List<Sample>();
+        int result = 1;
+        string? error = null;
+        bool statisticsMatch = false, monitoringObserved = false, owned = false;
+        try
+        {
+            Directory.CreateDirectory(root);
+            File.WriteAllText(Path.Combine(root, Marker), MarkerText(root, owner), new UTF8Encoding(false));
+            owned = true;
+            long expectedLogical = new FileInfo(Path.Combine(root, Marker)).Length;
+            for (int d = 0; d < DirectoryCount; d++)
+            {
+                string directory = Path.Combine(root, $"folder-{d:00}");
+                Directory.CreateDirectory(directory);
+                for (int f = 0; f < FilesPerDirectory; f++)
+                {
+                    byte[] bytes = new byte[f % 2 == 0 ? 17 : 1024];
+                    File.WriteAllBytes(Path.Combine(directory, $"file-{f:000}.bin"), bytes);
+                    expectedLogical += bytes.Length;
+                }
+            }
+            ValidateOwned(root, owner, complete: true);
+            foreach (string mode in new[] { "off", "on", "on", "off" })
+                samples.Add(RunChild(root, owner, mode, children));
+            var baseline = samples[0];
+            statisticsMatch = samples.All(sample => sample.Files == DirectoryCount * FilesPerDirectory + 1 && sample.Directories == DirectoryCount &&
+                sample.LogicalBytes == expectedLogical && sample.AllocatedBytes == baseline.AllocatedBytes &&
+                sample.UnknownAllocation == 0 && !sample.Incomplete && sample.Skipped == 0 && sample.AllocationIssues == 0);
+            monitoringObserved = samples.Where(sample => sample.Mode == "on").All(sample => sample.MonitorAvailableSamples > 0) &&
+                samples.Where(sample => sample.Mode == "off").All(sample => sample.MonitorAvailableSamples == 0);
+            if (!statisticsMatch) error = "MONITOR_SCAN_PROBE_STATISTICS_MISMATCH";
+            else if (!monitoringObserved) error = "MONITOR_SCAN_PROBE_MONITORING_NOT_OBSERVED";
+            else result = 0;
+        }
+        catch (OperationCanceledException) { error = "MONITOR_SCAN_PROBE_CHILD_TIMEOUT"; }
+        catch { error = "MONITOR_SCAN_PROBE_FAILED"; }
+        finally
+        {
+            bool stopped = true;
+            foreach (var child in children)
+            {
+                try
+                {
+                    if (!child.HasExited) child.Kill(entireProcessTree: true);
+                    if (!child.WaitForExit(5000)) stopped = false;
+                }
+                catch { stopped = false; }
+            }
+            if (owned)
+            {
+                try
+                {
+                    if (!stopped) throw new InvalidOperationException();
+                    ValidateOwned(root, owner, complete: false);
+                    Directory.Delete(root, true);
+                }
+                catch { result = 1; error = "MONITOR_SCAN_PROBE_CLEANUP_REFUSED"; }
+            }
+            foreach (var child in children) child.Dispose();
+        }
+        // Preserve every completed aggregate sample, including inconclusive/failing runs.
+        Console.WriteLine(JsonSerializer.Serialize(new
+        {
+            Kind = "disk-activity-ui-scan-probe", Order = "off/on/on/off", FixtureFiles = DirectoryCount * FilesPerDirectory,
+            OwnershipMarkerFiles = 1, FixtureDirectories = DirectoryCount, PrewaitMilliseconds = 1600,
+            TimingScope = "ScanFolder plus final UI query and refresh; excludes preparation and shutdown",
+            PeakScope = "whole child process lifetime through scan report; not scan-phase peak",
+            CacheScope = "not controlled; own-tree ownership validation precedes each scan",
+            StatisticsMatch = statisticsMatch, MonitoringObserved = monitoringObserved, Success = result == 0,
+            MonitoringDuringEveryOnScanObserved = samples.Where(sample => sample.Mode == "on").Any() &&
+                samples.Where(sample => sample.Mode == "on").All(sample => sample.MonitorAvailableDuringScan > 0),
+            Samples = samples
+        }));
+        if (error != null) Console.Error.WriteLine(error);
+        return result;
+    }
+
+    private static Sample RunChild(string root, string owner, string mode, List<Process> children)
+    {
+        var start = new ProcessStartInfo("dotnet")
+        {
+            UseShellExecute = false, RedirectStandardOutput = true, RedirectStandardError = true, CreateNoWindow = true
+        };
+        start.ArgumentList.Add(typeof(DiskActivityScanProbe).Assembly.Location);
+        start.ArgumentList.Add("--disk-activity-scan-child");
+        start.ArgumentList.Add(mode);
+        start.Environment[FixtureVariable] = root;
+        start.Environment[OwnerVariable] = owner;
+        start.Environment["ASUKALENS_DATA_DIR"] = Path.Combine(root, ".isolated-state");
+        start.Environment["DOTNET_CLI_TELEMETRY_OPTOUT"] = "1";
+        var process = new Process { StartInfo = start };
+        try { if (!process.Start()) throw new InvalidOperationException(); }
+        catch { process.Dispose(); throw; }
+        children.Add(process);
+        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(30));
+        var output = ReadBounded(process.StandardOutput.BaseStream, 16384, timeout.Token);
+        var errors = ReadBounded(process.StandardError.BaseStream, 4096, timeout.Token);
+        Task.WhenAll(process.WaitForExitAsync(timeout.Token), output, errors).GetAwaiter().GetResult();
+        if (process.ExitCode != 0 || errors.Result.Length != 0) throw new InvalidOperationException();
+        var sample = JsonSerializer.Deserialize<Sample>(output.Result) ?? throw new InvalidOperationException();
+        if (sample.Mode != mode || !double.IsFinite(sample.WallMs) || sample.WallMs <= 0 ||
+            !double.IsFinite(sample.CpuMs) || sample.CpuMs < 0 || sample.PeakWorkingSetBytes <= 0 ||
+            sample.Files < 0 || sample.Directories < 0 || sample.LogicalBytes < 0 || sample.AllocatedBytes < 0 ||
+            sample.UnknownAllocation < 0 || sample.Skipped < 0 || sample.AllocationIssues < 0 ||
+            sample.MonitorAvailableSamples < 0 || sample.MonitorAvailableDuringScan < 0 ||
+            sample.PeakScope != "process-start-through-scan-report") throw new InvalidOperationException();
+        return sample;
+    }
+
+    private static async Task<byte[]> ReadBounded(Stream stream, int maximum, CancellationToken token)
+    {
+        using var bytes = new MemoryStream();
+        byte[] buffer = new byte[1024];
+        while (true)
+        {
+            int count = await stream.ReadAsync(buffer, token);
+            if (count == 0) break;
+            if (bytes.Length + count > maximum) throw new InvalidOperationException();
+            bytes.Write(buffer, 0, count);
+        }
+        return bytes.ToArray();
+    }
+
+    // Called before the ordinary test runner's output/initialization by the root entry point.
+    internal static int Child(string mode)
+    {
+        if (mode is not ("off" or "on")) { Console.Error.WriteLine("MONITOR_SCAN_CHILD_MODE"); return 1; }
+        Sample? sample = null;
+        bool failed = false;
+        try
+        {
+            string root = Environment.GetEnvironmentVariable(FixtureVariable) ?? throw new InvalidOperationException();
+            string owner = Environment.GetEnvironmentVariable(OwnerVariable) ?? throw new InvalidOperationException();
+            ValidateOwned(root, owner, complete: true);
+            var thread = new Thread(() =>
+            {
+                try
+                {
+                    Application.SetUnhandledExceptionMode(UnhandledExceptionMode.ThrowException);
+                    Application.SetHighDpiMode(HighDpiMode.PerMonitorV2);
+                    Application.EnableVisualStyles();
+                    Application.SetCompatibleTextRenderingDefault(false);
+                    using var form = new MainForm(null, loadSavedBackground: false,
+                        backgroundSettingsPath: Path.Combine(root, ".unused-background.dat"), diagnostics: null)
+                    { Text = "AsukaLens - synthetic monitoring scan probe" };
+                    form.Shown += async (_, _) =>
+                    {
+                        try
+                        {
+                            var panel = Field<DiskActivityPanel>(form, "activityPanel");
+                            typeof(MainForm).GetField("activityPath", Private)!.SetValue(form, root);
+                            if (mode == "on") Field<Button>(panel, "toggle").PerformClick();
+                            await Task.Delay(1600);
+                            if (panel.Expanded != (mode == "on")) throw new InvalidOperationException();
+                            int before = AvailableSamples(panel);
+                            using var process = Process.GetCurrentProcess();
+                            var cpu = process.TotalProcessorTime;
+                            var clock = Stopwatch.StartNew();
+                            var scanTask = (Task?)typeof(MainForm).GetMethod("ScanFolder", Private)!.Invoke(form, [root]);
+                            if (scanTask == null) throw new InvalidOperationException();
+                            await scanTask;
+                            while (Field<CancellationTokenSource?>(form, "viewCancellation") != null ||
+                                !Field<DataGridView>(form, "grid").Enabled) await Task.Delay(10);
+                            form.Refresh();
+                            clock.Stop();
+                            double cpuMs = (process.TotalProcessorTime - cpu).TotalMilliseconds;
+                            var scan = Field<ScanResult?>(form, "scan") ?? throw new InvalidOperationException();
+                            if (Field<DataGridView>(form, "grid").RowCount == 0) throw new InvalidOperationException();
+                            int after = AvailableSamples(panel);
+                            process.Refresh();
+                            sample = new(mode, scan.Root.FileCount, scan.Root.FolderCount, scan.Root.Size, scan.Root.AllocatedSize,
+                                scan.Root.UnknownAllocationFiles, scan.Root.Incomplete, scan.Skipped, scan.AllocationIssues.Count,
+                                clock.Elapsed.TotalMilliseconds, cpuMs, process.PeakWorkingSet64,
+                                "process-start-through-scan-report", after, Math.Max(0, after - before));
+                        }
+                        catch { failed = true; }
+                        finally { form.Close(); }
+                    };
+                    Application.Run(form);
+                }
+                catch { failed = true; }
+            }) { IsBackground = true };
+            thread.SetApartmentState(ApartmentState.STA);
+            thread.Start();
+            if (!thread.Join(TimeSpan.FromSeconds(26))) { Console.Error.WriteLine("MONITOR_SCAN_CHILD_TIMEOUT"); return 1; }
+        }
+        catch { failed = true; }
+        if (failed || sample == null) { Console.Error.WriteLine("MONITOR_SCAN_CHILD_FAILED"); return 1; }
+        Console.WriteLine(JsonSerializer.Serialize(sample));
+        return 0;
+    }
+
+    private static T Field<T>(object owner, string name) => (T)owner.GetType().GetField(name, Private)!.GetValue(owner)!;
+    private static int AvailableSamples(DiskActivityPanel panel) => Field<DiskActivitySample?[]>(panel, "history")
+        .Count(sample => sample?.Status == DiskActivityStatus.Available);
+    private static string MarkerText(string root, string owner) => "ASUKALENS_MONITOR_SCAN_V1\n" + Path.GetFileName(root)[Prefix.Length..] + "\n" + owner;
+
+    private static void ValidateOwned(string root, string owner, bool complete)
+    {
+        string resolved = Path.GetFullPath(root);
+        string temp = Path.TrimEndingDirectorySeparator(Path.GetFullPath(Path.GetTempPath()));
+        string name = Path.GetFileName(resolved);
+        if (!Path.IsPathFullyQualified(root) || !string.Equals(resolved, root, StringComparison.OrdinalIgnoreCase) ||
+            !string.Equals(Path.GetDirectoryName(resolved), temp, StringComparison.OrdinalIgnoreCase) ||
+            !name.StartsWith(Prefix, StringComparison.Ordinal) || !Guid.TryParseExact(name.AsSpan(Prefix.Length), "N", out _) ||
+            !Guid.TryParseExact(owner, "N", out _) || (File.GetAttributes(resolved) & FileAttributes.ReparsePoint) != 0)
+            throw new InvalidOperationException();
+        string marker = Path.Combine(resolved, Marker);
+        if ((File.GetAttributes(marker) & (FileAttributes.ReparsePoint | FileAttributes.Directory)) != 0 ||
+            new FileInfo(marker).Length > 256 || File.ReadAllText(marker) != MarkerText(resolved, owner))
+            throw new InvalidOperationException();
+        var expectedDirectories = Enumerable.Range(0, DirectoryCount).Select(d => $"folder-{d:00}").ToHashSet(StringComparer.Ordinal);
+        int directoryCount = 0;
+        foreach (var entry in Directory.EnumerateFileSystemEntries(resolved, "*", SearchOption.TopDirectoryOnly))
+        {
+            var attributes = File.GetAttributes(entry);
+            if ((attributes & FileAttributes.ReparsePoint) != 0) throw new InvalidOperationException();
+            if (Path.GetFileName(entry) == Marker && (attributes & FileAttributes.Directory) == 0) continue;
+            if ((attributes & FileAttributes.Directory) == 0 || !expectedDirectories.Remove(Path.GetFileName(entry))) throw new InvalidOperationException();
+            directoryCount++;
+            var expectedFiles = Enumerable.Range(0, FilesPerDirectory).Select(f => $"file-{f:000}.bin").ToHashSet(StringComparer.Ordinal);
+            int fileCount = 0;
+            foreach (string file in Directory.EnumerateFileSystemEntries(entry, "*", SearchOption.TopDirectoryOnly))
+            {
+                if ((File.GetAttributes(file) & (FileAttributes.ReparsePoint | FileAttributes.Directory)) != 0 ||
+                    !expectedFiles.Remove(Path.GetFileName(file))) throw new InvalidOperationException();
+                fileCount++;
+            }
+            if (complete && fileCount != FilesPerDirectory) throw new InvalidOperationException();
+        }
+        if (complete && directoryCount != DirectoryCount) throw new InvalidOperationException();
+    }
+}
diff --git a/tests/DiskActivitySourceTests.cs b/tests/DiskActivitySourceTests.cs
new file mode 100644
index 0000000..4145324
--- /dev/null
+++ b/tests/DiskActivitySourceTests.cs
@@ -0,0 +1,147 @@
+using System.Runtime.InteropServices;
+using System.Text;
+using DiskAtlas;
+
+internal static class DiskActivitySourceTests
+{
+    private sealed class Query : IDiskActivityQuery
+    {
+        internal bool Success = true, Disposed;
+        internal int Collects, Reads;
+        internal Action? OnCollect;
+        internal Action<int>? OnRead;
+        internal IReadOnlyList<DiskActivityCounter>?[] Values =
+        [new[] { new DiskActivityCounter("0 C: D:", 0, 75) }, new[] { new DiskActivityCounter("0 C: D:", 0, 123456) },
+            new[] { new DiskActivityCounter("0 C: D:", 0, 654321) }, new[] { new DiskActivityCounter("0 C: D:", 0, 0.002) }];
+        public bool Collect(CancellationToken token) { Collects++; OnCollect?.Invoke(); return Success; }
+        public IReadOnlyList<DiskActivityCounter>? Read(int index, CancellationToken token) { Reads++; OnRead?.Invoke(index); return Values[index]; }
+        public void Dispose() => Disposed = true;
+    }
+
+    // All buffers and counter observations below are synthetic; no native query is opened.
+    internal static int Run()
+    {
+        int checks = 0;
+        void Check(bool condition, string name)
+        {
+            if (!condition) throw new InvalidOperationException("Disk activity source check failed: " + name);
+            checks++; Console.WriteLine("PASS disk activity source " + name);
+        }
+        Check(IntPtr.Size == 8 && Marshal.SizeOf<PdhDiskActivityQuery.FormattedItem>() == 24 &&
+            Marshal.OffsetOf<PdhDiskActivityQuery.FormattedItem>(nameof(PdhDiskActivityQuery.FormattedItem.Name)).ToInt32() == 0 &&
+            Marshal.OffsetOf<PdhDiskActivityQuery.FormattedItem>(nameof(PdhDiskActivityQuery.FormattedItem.Status)).ToInt32() == 8 &&
+            Marshal.OffsetOf<PdhDiskActivityQuery.FormattedItem>(nameof(PdhDiskActivityQuery.FormattedItem.Value)).ToInt32() == 16,
+            "x64 PDH item offsets and stride");
+        foreach (var (name, expected) in new[] { ("0", 0), ("0 C: D:", 0), ("12 X:", 12), ("2147483647", int.MaxValue) })
+            Check(PdhDiskActivitySource.TryParseInstance(name, out int disk) && disk == expected, "known instance grammar");
+        foreach (string? name in new string?[] { null, "", "_Total", "01 C:", "-1", "2147483648", " 0 C:", "0 C: ", "0 ", "0 other", "0 C: C:", "0 C:\\", "０ C:", "0  C:" })
+            Check(!PdhDiskActivitySource.TryParseInstance(name, out _), "unknown instance rejected");
+        bool negativeDisk = false;
+        try { using var invalid = new PdhDiskActivitySource(-1); } catch (ArgumentOutOfRangeException) { negativeDisk = true; }
+        Check(negativeDisk, "negative target disk rejected before native work");
+        using (var unavailable = new PdhDiskActivitySource(0, () => throw new DllNotFoundException("synthetic private marker")))
+            Check(unavailable.Collect(default).Status == DiskActivityStatus.Unavailable, "missing native provider degrades without exposing its message");
+        var stamp = DateTimeOffset.UtcNow;
+        var fake = new Query();
+        int created = 0;
+        using (var source = new PdhDiskActivitySource(0, () => { created++; return fake; }))
+        {
+            Check(created == 0, "construction has no native work");
+            var first = source.Collect(default);
+            Check(first.Status == DiskActivityStatus.Waiting && first.ActivePercent == null && fake.Reads == 0, "first collect primes without fake zero");
+            DateTimeOffset beforeRead = default;
+            fake.OnRead = index => { if (index == 0) { beforeRead = DateTimeOffset.UtcNow; Thread.Sleep(20); } };
+            var second = source.Collect(default);
+            Check(second.Timestamp <= beforeRead, "sample freshness begins at collection before slow formatting reads");
+            fake.OnRead = null;
+            Check(second.Status == DiskActivityStatus.Available && second.DiskNumber == 0 && second.ActivePercent == 25 &&
+                second.ReadBytesPerSecond == 123456 && second.WriteBytesPerSecond == 654321 && second.ResponseMilliseconds == 2,
+                "idle conversion and unscaled byte and millisecond units");
+            fake.Success = false;
+            Check(source.Collect(default).Status == DiskActivityStatus.Unavailable, "failed collection is unavailable");
+            fake.Success = true;
+            Check(source.Collect(default).Status == DiskActivityStatus.Waiting, "collection failure invalidates prime");
+            Check(source.Collect(default).Status == DiskActivityStatus.Available && created == 1, "query reused after fresh prime");
+            using var cancel = new CancellationTokenSource(); cancel.Cancel();
+            int before = fake.Collects; bool stopped = false;
+            try { source.Collect(cancel.Token); } catch (OperationCanceledException) { stopped = true; }
+            Check(stopped && fake.Collects == before, "pre-cancel avoids provider work");
+            using var mid = new CancellationTokenSource(); fake.OnCollect = mid.Cancel; stopped = false;
+            try { source.Collect(mid.Token); } catch (OperationCanceledException) { stopped = true; }
+            Check(stopped, "post-provider cancellation publishes no sample");
+            fake.OnCollect = null;
+        }
+        Check(fake.Disposed, "source disposes its query");
+        var disposed = new PdhDiskActivitySource(0, () => new Query()); disposed.Dispose(); disposed.Dispose();
+        bool refused = false;
+        try { disposed.Collect(default); } catch (ObjectDisposedException) { refused = true; }
+        Check(refused, "dispose is idempotent and blocks later samples");
+        using (var resumed = new PdhDiskActivitySource(0, () => new Query()))
+            Check(resumed.Collect(default).Status == DiskActivityStatus.Waiting, "new source resumes with a fresh prime");
+        IReadOnlyList<DiskActivityCounter> Metric(double? value, string instance = "0 C:") => new[] { new DiskActivityCounter(instance, 0, value) };
+        var partial = PdhDiskActivitySource.Compose(stamp, 0, null, Metric(10), null, null);
+        Check(partial.Status == DiskActivityStatus.Available && partial.ReadBytesPerSecond == 10 && partial.ActivePercent == null,
+            "single usable metric remains available");
+        foreach (double number in new[] { double.NaN, double.PositiveInfinity, double.NegativeInfinity, -1, 101 })
+            Check(PdhDiskActivitySource.Compose(stamp, 0, Metric(number), null, null, null).ActivePercent == null,
+                "invalid idle value cannot become activity");
+        foreach (double number in new[] { double.NaN, double.PositiveInfinity, double.NegativeInfinity, -1 })
+        {
+            var invalid = PdhDiskActivitySource.Compose(stamp, 0, null, Metric(number), Metric(number), Metric(number));
+            Check(invalid.Status == DiskActivityStatus.Unavailable && invalid.ReadBytesPerSecond == null && invalid.WriteBytesPerSecond == null && invalid.ResponseMilliseconds == null,
+                "invalid rates and latency remain unknown");
+        }
+        Check(PdhDiskActivitySource.Compose(stamp, 0, Metric(100), Metric(0), Metric(0), Metric(0)).ActivePercent == 0,
+            "valid zero remains measured zero");
+        Check(PdhDiskActivitySource.Compose(stamp, 0, Metric(0), null, null, null).ActivePercent == 100, "fully busy disk is bounded at 100");
+        Check(PdhDiskActivitySource.Compose(stamp, 0, null, null, null, Metric(double.MaxValue)).ResponseMilliseconds == null,
+            "unit conversion overflow stays unknown");
+        Check(PdhDiskActivitySource.Compose(stamp, 0, Metric(50), Metric(1, "0 D:"), null, null).Status == DiskActivityStatus.Unavailable,
+            "different instance names never join across counters");
+        Check(PdhDiskActivitySource.Compose(stamp, 0, new[] { new DiskActivityCounter("0 C:", 0, 1), new DiskActivityCounter("0 C:", 0, 2) }, Metric(5), null, null).ActivePercent == null,
+            "duplicate target invalidates the ambiguous metric");
+        var other = new[] { new DiskActivityCounter("1 D:", 1, 5) };
+        Check(PdhDiskActivitySource.Compose(stamp, 0, other, null, null, null).Status == DiskActivityStatus.Unavailable, "other disk is never substituted");
+
+        bool Decode((string Name, uint Status, double Value)[] entries, Action<IntPtr, int>? mutate, out IReadOnlyList<DiskActivityCounter> decoded)
+        {
+            int stringBytes = entries.Sum(item => Encoding.Unicode.GetByteCount(item.Name + '\0'));
+            int capacity = entries.Length * 24 + stringBytes;
+            IntPtr buffer = Marshal.AllocHGlobal(Math.Max(1, capacity));
+            try
+            {
+                int offset = entries.Length * 24;
+                for (int i = 0; i < entries.Length; i++)
+                {
+                    byte[] text = Encoding.Unicode.GetBytes(entries[i].Name + '\0');
+                    IntPtr name = IntPtr.Add(buffer, offset); Marshal.Copy(text, 0, name, text.Length);
+                    Marshal.StructureToPtr(new PdhDiskActivityQuery.FormattedItem { Name = name, Status = entries[i].Status, Value = entries[i].Value }, IntPtr.Add(buffer, i * 24), false);
+                    offset += text.Length;
+                }
+                mutate?.Invoke(buffer, capacity);
+                return PdhDiskActivityQuery.TryDecodeArray(buffer, capacity, (uint)entries.Length, out decoded);
+            }
+            finally { Marshal.FreeHGlobal(buffer); }
+        }
+        Check(Decode(new[] { ("0 C: D:", 0u, 75.5), ("1 X:", 1u, 2.0), ("_Total", 0u, 9.0), ("unknown", 0u, 1.0) }, null, out var decoded) &&
+            decoded.Count == 2 && decoded[0].Value == 75.5 && decoded[1].Value == 2, "array values and valid/new statuses decoded while totals ignored");
+        Check(Decode(new[] { ("0 C:", 0xC0000BBAu, 5.0) }, null, out decoded) && decoded.Single().Value == null,
+            "item status checked independently of API status");
+        foreach (double invalid in new[] { double.NaN, double.PositiveInfinity, double.NegativeInfinity, -1 })
+            Check(Decode(new[] { ("0 C:", 0u, invalid) }, null, out decoded) && decoded.Single().Value == null, "nonfinite or negative buffer value ignored");
+        Check(!Decode(new[] { ("0 C:", 0u, 1.0), ("0 D:", 0u, 2.0) }, null, out _), "duplicate disk number rejected in native array");
+        Check(!Decode(new[] { ("0 C:", 0u, 1.0) }, (buffer, _) => Marshal.WriteIntPtr(buffer, IntPtr.Zero), out _), "null name pointer rejected");
+        Check(!Decode(new[] { ("0 C:", 0u, 1.0) }, (buffer, _) => Marshal.WriteIntPtr(buffer, buffer), out _), "name pointer into item headers rejected");
+        Check(!Decode(new[] { ("0 C:", 0u, 1.0) }, (buffer, size) => Marshal.WriteIntPtr(buffer, IntPtr.Add(buffer, size)), out _), "name pointer past allocation rejected");
+        Check(!Decode(new[] { ("0 C:", 0u, 1.0) }, (buffer, _) => Marshal.WriteIntPtr(buffer, IntPtr.Add(buffer, 25)), out _), "unaligned name pointer rejected");
+        Check(!Decode(new[] { ("0 C:", 0u, 1.0) }, (buffer, size) => Marshal.WriteInt16(buffer, size - 2, 65), out _), "unterminated name rejected within buffer");
+        Check(!Decode(new[] { (new string('x', 257), 0u, 1.0) }, null, out _), "name length bounded");
+        Check(PdhDiskActivityQuery.TryDecodeArray(IntPtr.Zero, 0, 0, out decoded) && decoded.Count == 0, "empty arrays remain empty");
+        Check(!PdhDiskActivityQuery.TryDecodeArray(IntPtr.Zero, 23, 1, out _), "array header truncation rejected before dereference");
+        Check(!PdhDiskActivityQuery.TryDecodeArray(IntPtr.Zero, 1024 * 1024 + 1, 0, out _), "buffer cap enforced");
+        Check(!PdhDiskActivityQuery.TryDecodeArray(IntPtr.Zero, 0, 4097, out _), "item cap enforced");
+        Check(!PdhDiskActivityQuery.TryDecodeArray(IntPtr.Zero, -1, 0, out _), "negative buffer size rejected");
+        Console.WriteLine("PASS disk activity source checks: " + checks + "; native sampling: none");
+        return checks;
+    }
+}

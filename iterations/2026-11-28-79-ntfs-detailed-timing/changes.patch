+    $state=if($evidence.comparable){'product_timing_compared'}elseif($evidence.status -ceq 'not_comparable'){'product_timing_not_comparable'}else{'failed'}
+    $step=if($state -ceq 'product_timing_compared'){'ProductTimingCompared'}elseif($state -ceq 'product_timing_not_comparable'){'ProductTimingNotComparable'}else{'RunProductTiming'}
+    $code=if($state -ceq 'product_timing_compared'){'None'}elseif($state -ceq 'product_timing_not_comparable'){'ResultsDiffer'}else{'ProductTimingFixtureFailed'}
+    $result=[ordered]@{schema=1;mode='product-timing';status=$(if($CleanupFailure){'cleanup_failed'}else{$state});stage=$step;code=$code
+        exit_code=$RunnerExit;detached=([bool]$Detached -or -not $CleanupFailure);cleanup_completed=(-not $CleanupFailure);scale_benchmark=$null
+        snapshot_cleanup_confirmed=$evidence.cleanup_confirmed;native_error=0;product_timing=$evidence
+        product_timing_order=$OrderValue;fixture_files=$(if($OrderValue -ceq 'FOOF'){100000}else{10000})}
+    if($DetailMode){$result.product_timing_detailed=$true}
+    return $result
+}
+function Reject-SummaryChange([scriptblock]$Mutation, [string]$Name) {
+    $candidate=New-TestOwnerSummary $detailReport -DetailMode
+    & $Mutation $candidate | Out-Null
+    Reject-Pipeline { ConvertTo-ProductTimingFixtureSummary ($candidate | ConvertTo-Json -Depth 12 -Compress) $detailReport 0 0 FO -Detailed } $summaryError $Name
+}
+$summary=New-TestOwnerSummary $report
+$summaryJson=$summary | ConvertTo-Json -Depth 12 -Compress
+Check ((ConvertTo-ProductTimingFixtureSummary $summaryJson $report 0 0).status -ceq 'product_timing_compared') 'default owner summary independently verified'
+$detailSummary=New-TestOwnerSummary $detailReport -DetailMode
+$detailSummaryJson=$detailSummary | ConvertTo-Json -Depth 12 -Compress
+$safeSummary=ConvertTo-ProductTimingFixtureSummary $detailSummaryJson $detailReport 0 0 -Detailed
+Check ($safeSummary.product_timing_detailed -and $safeSummary.product_timing.fast.details.supplement_objects -eq 4) 'detailed owner summary rebuilt from local report'
+$fourSummary=New-TestOwnerSummary (Join-TestRecords $detailGroup) -OrderValue FOOF -DetailMode
+Check ((ConvertTo-ProductTimingFixtureSummary ($fourSummary | ConvertTo-Json -Depth 12 -Compress) (Join-TestRecords $detailGroup) 0 0 FOOF -Detailed).fixture_files -eq 100000) 'detailed four-run summary retained'
+$mismatchReport=Join-TestRecords @(New-TestPair -Different)
+$mismatchSummary=New-TestOwnerSummary $mismatchReport -RunnerExit 3
+Check ((ConvertTo-ProductTimingFixtureSummary ($mismatchSummary | ConvertTo-Json -Depth 12 -Compress) $mismatchReport 3 3).status -ceq 'product_timing_not_comparable') 'incomparable owner result keeps existing exit and cleanup semantics'
+$failedReport=Join-TestRecords $afterFast
+$failedSummary=New-TestOwnerSummary $failedReport -RunnerExit 1
+Check ((ConvertTo-ProductTimingFixtureSummary ($failedSummary | ConvertTo-Json -Depth 12 -Compress) $failedReport 1 1).cleanup_completed) 'ordinary failure after settled fast run remains safely cleaned'
+$uncertainReport=Join-TestRecords $partial
+$uncertainSummary=New-TestOwnerSummary $uncertainReport -RunnerExit 1 -CleanupFailure
+Check (-not (ConvertTo-ProductTimingFixtureSummary ($uncertainSummary | ConvertTo-Json -Depth 12 -Compress) $uncertainReport 1 1).snapshot_cleanup_confirmed) 'unconfirmed snapshot keeps conservative cleanup-failed evidence'
+foreach($wasDetached in @($false,$true)) {
+    $cleanupSummary=New-TestOwnerSummary $report -CleanupFailure -Detached:$wasDetached
+    Check ((ConvertTo-ProductTimingFixtureSummary ($cleanupSummary | ConvertTo-Json -Depth 12 -Compress) $report 0 1).status -ceq 'cleanup_failed') ('settled snapshot retains later cleanup failure detached=' + $wasDetached)
+}
+Reject-Pipeline { ConvertTo-ProductTimingFixtureSummary $detailSummaryJson $report 0 0 } $summaryError 'default summary rejects detailed marker and nested diagnostics'
+Reject-Pipeline { ConvertTo-ProductTimingFixtureSummary $summaryJson $detailReport 0 0 -Detailed } $summaryError 'detailed summary cannot silently omit diagnostics'
+Reject-Pipeline { ConvertTo-ProductTimingFixtureSummary $summaryJson $report 0 1 } $summaryError 'owner exit must agree with validated success'
+Reject-SummaryChange {param($s) $s.private='synthetic'} 'summary unknown root field rejected before output'
+Reject-SummaryChange {param($s) $s.product_timing.fast.details.name='synthetic'} 'summary nested arbitrary text rejected before output'
+Reject-SummaryChange {param($s) $s.product_timing.fast.details.supplement_objects=5} 'summary diagnostic values must match local trace'
+Reject-SummaryChange {param($s) $s.product_timing.samples[0].sample.details.reason_combinations[6]=2} 'summary buckets cannot diverge from local trace'
+Reject-SummaryChange {param($s) $s.product_timing.fast.total_ms=27} 'summary timer values independently corroborated'
+Reject-SummaryChange {param($s) $s.product_timing_detailed=$false} 'summary detailed marker must be true'
+Reject-SummaryChange {param($s) $s.product_timing_detailed='true'} 'summary detailed marker type enforced'
+Reject-SummaryChange {param($s) $s.schema='1'} 'summary integer schema cannot be a string'
+Reject-SummaryChange {param($s) $s.schema=1.0} 'summary integer schema cannot be floating point'
+Reject-SummaryChange {param($s) $s.detached=$false} 'successful owner must confirm detached state'
+Reject-SummaryChange {param($s) $s.cleanup_completed=$false} 'successful owner must confirm image cleanup'
+Reject-SummaryChange {param($s) $s.snapshot_cleanup_confirmed=$false} 'owner cleanup evidence must match validated sample'
+Reject-SummaryChange {param($s) $s.stage='synthetic'} 'summary stage cannot contain arbitrary text'
+Reject-SummaryChange {param($s) $s.code='synthetic'} 'summary error code cannot contain arbitrary text'
+Reject-SummaryChange {param($s) $s.scale_benchmark=@{private='synthetic'}} 'unrelated benchmark data rejected'
+Reject-SummaryChange {param($s) $s.product_timing_order='FOOF'} 'summary order bound to caller'
+Reject-Pipeline { ConvertTo-ProductTimingFixtureSummary ($summaryJson.Replace('"schema":1','"schema":1,"Schema":1')) $report 0 0 } $summaryError 'summary duplicate alias keys rejected'
 Write-Output ('RESULT: PASS (' + $checks + ' checks)')
diff --git a/tests/NtfsScanDiagnosticWireTests.cs b/tests/NtfsScanDiagnosticWireTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..7db188c8a39d3b9765da60ed9e3622b60c8ce21b
--- /dev/null
+++ b/tests/NtfsScanDiagnosticWireTests.cs
@@ -0,0 +1,131 @@
+using System.Buffers.Binary;
+using DiskAtlas.NtfsPrototype;
+
+namespace DiskAtlas;
+
+// Exercise the protocol with only an in-memory tree and byte streams.
+internal static class NtfsScanDiagnosticWireTests
+{
+    private const string RootPath = @"B:\AsukaLens-Synthetic";
+
+    internal static int Run()
+    {
+        int checks = 0;
+        void Check(bool test, string name)
+        {
+            checks++;
+            if (!test) throw new InvalidOperationException(name);
+        }
+        void RejectRead(FastScanWireReader reader, string name)
+        {
+            try { reader.Read(); }
+            catch (FastScanWireException) { Check(true, name); return; }
+            Check(false, name);
+        }
+        void Reject(byte[] bytes, bool detailed, bool afterReport, string name)
+        {
+            using var stream = new MemoryStream(bytes, writable: false);
+            var reader = detailed ? new FastScanWireReader(stream, RootPath, acceptDiagnostics: true) : new FastScanWireReader(stream, RootPath);
+            if (afterReport) Check(reader.Read().Kind == FastScanWireEventKind.Diagnostics, "valid report before " + name);
+            RejectRead(reader, name);
+            RejectRead(reader, "invalid transport stays terminal");
+        }
+        try
+        {
+            int[] reasons = new int[128]; reasons[3] = 1;
+            var report = new NtfsScanDiagnosticReport([2.5, 1, 7, 0, 3], 1, reasons);
+            byte[] diagnostics = Frames(s => FastScanWire.WriteDiagnostics(s, report, default));
+            byte[] status = Frames(s => FastScanWire.WriteStatus(s, FastScanWireStage.Cleanup));
+            byte[] tree = Frames(WriteTree);
+
+            using (var stream = new MemoryStream([.. status, .. diagnostics, .. tree], writable: false))
+            {
+                var reader = new FastScanWireReader(stream, RootPath, acceptDiagnostics: true);
+                Check(reader.Read() is { Kind: FastScanWireEventKind.Status, Stage: FastScanWireStage.Cleanup, Diagnostics: null },
+                    "existing status may precede diagnostic");
+                var observed = reader.Read();
+                Check(observed is { Kind: FastScanWireEventKind.Diagnostics, CleanupConfirmed: false, Result: null } &&
+                    observed.Diagnostics is { } detail && detail.PhaseMilliseconds.SequenceEqual(report.PhaseMilliseconds)
+                    && detail.SupplementObjects == 1 && detail.ReasonCombinations.SequenceEqual(reasons), "diagnostic event round trip");
+                var final = reader.Read();
+                Check(final is { Kind: FastScanWireEventKind.Completed, CleanupConfirmed: true, Diagnostics: null } &&
+                    final.Result?.Root is { FileCount: 1, Size: 17, AllocatedSize: 32 } && stream.Position == stream.Length,
+                    "valid tree required for terminal success");
+                RejectRead(reader, "success stays terminal");
+            }
+            using (var stream = new MemoryStream(tree, writable: false))
+            {
+                var normal = new FastScanWireReader(stream, RootPath);
+                Check(normal.Read() is { Kind: FastScanWireEventKind.Completed, CleanupConfirmed: true, Diagnostics: null }, "original wire success");
+            }
+            Reject([.. diagnostics, .. tree], detailed: false, afterReport: false, "normal reader rejects report");
+            Reject(tree, detailed: true, afterReport: false, "detailed reader rejects missing report");
+            Reject([.. diagnostics, .. diagnostics, .. tree], true, true, "duplicate report");
+            Reject([.. diagnostics, .. status, .. tree], true, true, "status between report and tree");
+            Reject(diagnostics, true, true, "report alone cannot complete scan");
+            int endOfTreeHeader = 12 + BinaryPrimitives.ReadInt32LittleEndian(tree.AsSpan(8));
+            Reject([.. diagnostics, .. tree[..endOfTreeHeader], .. diagnostics, .. tree[endOfTreeHeader..]], true, true, "report inside tree");
+            Reject([.. diagnostics, .. tree[..^1]], true, true, "partial tree cannot complete scan");
+
+            foreach (int length in new[] { 1, 11, 12, diagnostics.Length - 1 })
+                Reject(diagnostics[..length], true, false, "truncated diagnostic frame");
+            byte[] corrupted = (byte[])diagnostics.Clone();
+            BinaryPrimitives.WriteDoubleLittleEndian(corrupted.AsSpan(12), double.NaN);
+            Reject([.. corrupted, .. tree], true, false, "malformed diagnostic duration");
+            byte[] trailing = [.. diagnostics, 255];
+            BinaryPrimitives.WriteInt32LittleEndian(trailing.AsSpan(8), trailing.Length - 12);
+            Reject([.. trailing, .. tree], true, false, "unexpected diagnostic payload byte");
+
+            foreach (var code in new[] { FastScanWireError.PermissionDenied, FastScanWireError.Cancelled, FastScanWireError.CleanupUnconfirmed })
+            {
+                bool cleaned = code != FastScanWireError.CleanupUnconfirmed;
+                byte[] failure = Frames(s => FastScanWire.WriteFailure(s, code, cleaned));
+                using var stream = new MemoryStream([.. status, .. failure, .. diagnostics, .. tree], writable: false);
+                var reader = new FastScanWireReader(stream, RootPath, acceptDiagnostics: true);
+                Check(reader.Read().Kind == FastScanWireEventKind.Status, "status before failure");
+                var message = reader.Read();
+                Check(message is { Kind: FastScanWireEventKind.Failure, Diagnostics: null, Result: null }
+                    && message.Error == code && message.CleanupConfirmed == cleaned, "failure preserves cleanup without report");
+                RejectRead(reader, "failure cannot become success");
+            }
+            byte[] transferFailure = Frames(s => FastScanWire.WriteFailure(s, FastScanWireError.ProtocolError, true));
+            using (var stream = new MemoryStream([.. diagnostics, .. transferFailure], writable: false))
+            {
+                var reader = new FastScanWireReader(stream, RootPath, acceptDiagnostics: true);
+                Check(reader.Read() is { Kind: FastScanWireEventKind.Diagnostics, CleanupConfirmed: false, Result: null },
+                    "diagnostics are provisional");
+                Check(reader.Read() is { Kind: FastScanWireEventKind.Failure, Error: FastScanWireError.ProtocolError,
+                    CleanupConfirmed: true, Diagnostics: null, Result: null }, "tree validation failure after report");
+                RejectRead(reader, "failed publication stays terminal");
+            }
+        }
+        catch (Exception error)
+        {
+            Console.Error.WriteLine($"FAIL NTFS scan diagnostic wire checks={checks}: {error.Message}");
+            return 1;
+        }
+        Console.WriteLine($"PASS NTFS scan diagnostic wire checks={checks}; memory_streams_only=True");
+        return 0;
+    }
+
+    private static byte[] Frames(Action<Stream> write)
+    {
+        using var stream = new MemoryStream();
+        write(stream);
+        return stream.ToArray();
+    }
+
+    private static void WriteTree(Stream stream)
+    {
+        var modified = new DateTime(2026, 1, 1, 0, 0, 0, DateTimeKind.Utc);
+        var root = new DiskEntry(RootPath, true) { Storage = new(new(1, (1UL << 48) | 5, 0), 0, 1, false, -1, modified), Modified = modified };
+        var file = DiskEntry.FromName("demo.bin", false, root, ".bin");
+        file.Storage = new(new(1, (1UL << 48) | 6, 0), 32, 1, false, 17, modified);
+        file.Modified = modified;
+        file.FileCount = root.FileCount = 1;
+        file.Size = root.Size = 17;
+        root.MutableChildren.Add(file);
+        StorageMetrics.Calculate(root, default);
+        FastScanWire.WriteResult(stream, root, TimeSpan.FromMilliseconds(20), new DateTimeOffset(modified));
+    }
+}
diff --git a/tests/NtfsScanDiagnosticsTests.cs b/tests/NtfsScanDiagnosticsTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..25775d04173e2d92cfc4bffa482b067908256c9d
--- /dev/null
+++ b/tests/NtfsScanDiagnosticsTests.cs
@@ -0,0 +1,196 @@
+using System.Text.Json;
+using DiskAtlas.NtfsPrototype;
+
+namespace DiskAtlas;
+
+// In-memory samples only. The clock, object reasons and binary reports are synthetic.
+internal static class NtfsScanDiagnosticsTests
+{
+    private const int ObjectLimit = 1_048_576;
+    private const string ErrorCode = "ScanDiagnosticInvalid";
+
+    internal static int Run()
+    {
+        int checks = 0;
+        void Check(bool passed, string label)
+        {
+            checks++;
+            if (!passed) throw new InvalidOperationException(label);
+        }
+        void Reject(Action action, string label)
+        {
+            try { action(); }
+            catch (InvalidDataException ex) when (ex.Message == ErrorCode) { Check(true, label); return; }
+            Check(false, label);
+        }
+
+        try
+        {
+            double now = 10;
+            var model = new NtfsScanDiagnostics(() => now);
+            var empty = model.Snapshot();
+            Check(empty.PhaseMilliseconds.Length == 5 && empty.PhaseMilliseconds.All(value => value is null), "absent phases");
+            Check(empty.ReasonCombinations.Length == 128 && empty.ReasonCombinations.All(n => n == 0)
+                && empty.SupplementObjects == 0, "absent supplements");
+            empty.Validate();
+            Reject(() => empty.Validate(requireComplete: true), "complete report requires every phase");
+            Reject(() => Encode(empty), "partial report cannot be encoded");
+            Reject(() => NtfsPersonalTimingDriver.DiagnosticJson(new([0, 0, null, 0, 0], 0, new int[128])),
+                "details JSON requires every phase");
+            Reject(() => model.Measure((NtfsDiagnosticPhase)99), "undefined phase");
+
+            var phases = new[] { NtfsDiagnosticPhase.SourceValidation, NtfsDiagnosticPhase.VssSetup, NtfsDiagnosticPhase.VssCreation,
+                NtfsDiagnosticPhase.SnapshotValidation, NtfsDiagnosticPhase.IndexFinalization };
+            for (int i = 0; i < phases.Length; i++)
+            {
+                var phase = phases[i];
+                var measuring = model.Measure(phase);
+                Check(model.Snapshot().PhaseMilliseconds[(int)phase] is null, "active phase remains unreported");
+                Reject(() => model.Measure(phase), "overlapping measurement");
+                now += i * 0.5;
+                measuring.Dispose();
+                now += 10;
+                measuring.Dispose();
+                Check(model.Snapshot().PhaseMilliseconds[(int)phase] == i * 0.5, "zero and positive durations captured once");
+                Reject(() => model.Measure(phase), "completed phase cannot be replaced");
+            }
+
+            foreach (double invalidEnd in new[] { 5d, double.NaN, double.PositiveInfinity })
+            {
+                now = 10;
+                var timer = new NtfsScanDiagnostics(() => now).Measure(NtfsDiagnosticPhase.VssCreation);
+                now = invalidEnd;
+                Reject(timer.Dispose, "invalid clock on completion");
+            }
+            var invalidStart = new NtfsScanDiagnostics(() => double.NaN);
+            Reject(() => invalidStart.Measure(NtfsDiagnosticPhase.VssCreation), "invalid clock on entry");
+
+            // Each object contributes to exactly one combination even with multiple reasons.
+            for (int mask = 1; mask < 128; mask++) model.RecordSupplement((NtfsSupplementReason)mask);
+            model.RecordSupplement((NtfsSupplementReason)3);
+            foreach (int invalid in new[] { 0, 128, 129 })
+                Reject(() => model.RecordSupplement((NtfsSupplementReason)invalid), "invalid reason mask");
+            var full = model.Snapshot();
+            full.Validate(requireComplete: true);
+            CheckDetailedOutput(full, Check);
+            Check(full.SupplementObjects == 128 && full.ReasonCombinations[0] == 0 && full.ReasonCombinations[3] == 2,
+                "overlapping categories form one bucket per object");
+            Check(Enumerable.Range(1, 127).All(mask => full.ReasonCombinations[mask] == (mask == 3 ? 2 : 1)),
+                "all seven reason bits preserved");
+
+            var data = Encode(full);
+            var restored = Decode(data);
+            Check(restored.PhaseMilliseconds.SequenceEqual(full.PhaseMilliseconds)
+                && restored.SupplementObjects == full.SupplementObjects && restored.ReasonCombinations.SequenceEqual(full.ReasonCombinations),
+                "complete binary round trip");
+            full.PhaseMilliseconds[0] = 500;
+            full.ReasonCombinations[1] = 0;
+            var unchanged = model.Snapshot();
+            Check(unchanged.PhaseMilliseconds[0] == 0 && unchanged.ReasonCombinations[1] == 1, "snapshot arrays isolated");
+            Check(empty.PhaseMilliseconds.All(value => value is null) && empty.ReasonCombinations.All(n => n == 0), "prior snapshot remains immutable from model");
+
+            var maxModel = new NtfsScanDiagnostics(() => 0);
+            for (int i = 0; i < ObjectLimit; i++) maxModel.RecordSupplement((NtfsSupplementReason)1);
+            Reject(() => maxModel.RecordSupplement((NtfsSupplementReason)1), "object cap");
+            var max = maxModel.Snapshot();
+            Check(max.SupplementObjects == ObjectLimit && max.ReasonCombinations[1] == ObjectLimit, "overflow preserves previous counts");
+
+            void InvalidReport(NtfsScanDiagnosticReport report, string label)
+            {
+                Reject(() => report.Validate(), label);
+                Reject(() => Encode(report), "encode " + label);
+            }
+            var zeroTimes = new double?[] { 0, 0, 0, 0, 0 };
+            foreach (int length in new[] { 4, 6 })
+                InvalidReport(new(new double?[length], 0, new int[128]), "phase dimension");
+            foreach (int length in new[] { 127, 129 })
+                InvalidReport(new(zeroTimes, 0, new int[length]), "bucket dimension");
+            foreach (double value in new[] { -1d, double.NaN, double.PositiveInfinity, double.NegativeInfinity, 780001d })
+                InvalidReport(new([0, 0, value, 0, 0], 0, new int[128]), "invalid phase duration");
+            foreach (int count in new[] { -1, ObjectLimit + 1 })
+                InvalidReport(new(zeroTimes, count, new int[128]), "object count out of range");
+            foreach (var (bucket, count, total) in new[] { (0, 1, 1), (1, -1, 0), (2, 1, 0), (3, 0, 1), (7, int.MaxValue, ObjectLimit) })
+            {
+                int[] counts = new int[128]; counts[bucket] = count;
+                InvalidReport(new(zeroTimes, total, counts), "invalid bucket or total");
+            }
+            Check(Decode(Encode(new([780000d, 0, 0, 0, 0], ObjectLimit, max.ReasonCombinations))).SupplementObjects == ObjectLimit,
+                "duration and count at limit");
+
+            // Locate the changing bytes with two valid reports instead of depending on field offsets.
+            var countsA = new int[128]; countsA[10] = 1;
+            var countsB = new int[128]; countsB[11] = 1;
+            byte[] encodedA = Encode(new(zeroTimes, 1, countsA)), encodedB = Encode(new(zeroTimes, 1, countsB));
+            Check(encodedA.Length == encodedB.Length, "fixed report size");
+            foreach (int length in new[] { 0, encodedA.Length - 1 })
+            {
+                bool truncated = false;
+                try { Decode(encodedA[..length]); }
+                catch (EndOfStreamException) { truncated = true; }
+                catch (InvalidDataException ex) when (ex.Message == ErrorCode) { truncated = true; }
+                Check(truncated, "truncated report rejected");
+            }
+            int bucketByte = Enumerable.Range(0, encodedA.Length).First(i => encodedA[i] == 1 && encodedB[i] == 0);
+            encodedA[bucketByte] = 0;
+            Reject(() => Decode(encodedA), "wire count sum mismatch");
+        }
+        catch (Exception ex)
+        {
+            Console.Error.WriteLine($"FAIL NTFS scan diagnostics checks={checks}: {ex.Message}");
+            return 1;
+        }
+        Console.WriteLine($"PASS NTFS scan diagnostics checks={checks}; synthetic_only=True");
+        return 0;
+    }
+
+    private static byte[] Encode(NtfsScanDiagnosticReport value)
+    {
+        using var stream = new MemoryStream();
+        using var writer = new BinaryWriter(stream);
+        NtfsScanDiagnosticReport.Write(writer, value);
+        writer.Flush();
+        return stream.ToArray();
+    }
+
+    private static void CheckDetailedOutput(NtfsScanDiagnosticReport report, Action<bool, string> check)
+    {
+        const string verb = "--ntfs-personal-timing-details-ui";
+        check(NtfsPersonalTimingDriver.ValidDetailedUiInvocation([verb]), "explicit detailed verb");
+        check(!NtfsPersonalTimingDriver.ValidDetailedUiInvocation([]) &&
+              !NtfsPersonalTimingDriver.ValidDetailedUiInvocation([NtfsPersonalTimingDriver.UiArgument]) &&
+              !NtfsPersonalTimingDriver.ValidUiInvocation([verb]), "detailed and ordinary verbs isolated");
+        check(!NtfsPersonalTimingDriver.ValidDetailedUiInvocation([verb, @"B:\Synthetic"]) &&
+              !NtfsPersonalTimingDriver.ValidDetailedUiInvocation([verb, verb]), "detailed verb rejects extra arguments");
+
+        using var json = JsonDocument.Parse(NtfsPersonalTimingDriver.DiagnosticJson(report));
+        var row = json.RootElement;
+        static bool ExactFields(JsonElement obj, params string[] expected) =>
+            obj.EnumerateObject().Select(p => p.Name).Order(StringComparer.Ordinal).SequenceEqual(expected.Order(StringComparer.Ordinal));
+        check(ExactFields(row, "revision", "kind", "mode", "phases_ms", "supplement_objects", "reason_bits", "reason_combinations",
+                  "helper_measured", "multiple_reasons_per_object", "combination_counts_disjoint", "no_names_or_identities"),
+            "fixed top-level schema excludes paths and object names");
+        check(row.GetProperty("revision").GetString() == "ntfs-scan-details-v1" &&
+              row.GetProperty("kind").GetString() == "details" && row.GetProperty("mode").GetString() == "F", "fixed trace identity");
+        string[] phaseKeys = ["SourceValidation", "VssSetup", "VssCreation", "SnapshotValidation", "IndexFinalization"];
+        var durations = row.GetProperty("phases_ms");
+        check(ExactFields(durations, phaseKeys) && phaseKeys.Select(key => durations.GetProperty(key).GetDouble())
+            .SequenceEqual(report.PhaseMilliseconds.Select(ms => ms!.Value)), "five helper phase values");
+        string[] reasonKeys = ["ResidentAllocation", "Compressed", "Sparse", "IncompleteMetadata", "IncompleteLinks", "ModifiedConflict", "UnsupportedRecord"];
+        var reasonBits = row.GetProperty("reason_bits");
+        check(ExactFields(reasonBits, reasonKeys) && reasonKeys.Select((key, bit) => reasonBits.GetProperty(key).GetInt32() == (1 << bit)).All(ok => ok),
+            "seven stable reason names and bit values");
+        int[] bins = row.GetProperty("reason_combinations").EnumerateArray().Select(bucket => bucket.GetInt32()).ToArray();
+        check(bins.Length == 128 && bins.SequenceEqual(report.ReasonCombinations) && bins[0] == 0 &&
+            bins.Sum() == row.GetProperty("supplement_objects").GetInt32() && bins.Sum() == report.SupplementObjects,
+            "disjoint JSON counts sum to unique objects");
+        check(row.GetProperty("helper_measured").GetBoolean() && row.GetProperty("multiple_reasons_per_object").GetBoolean() &&
+            row.GetProperty("combination_counts_disjoint").GetBoolean() && row.GetProperty("no_names_or_identities").GetBoolean(), "diagnostic interpretation flags");
+    }
+
+    private static NtfsScanDiagnosticReport Decode(byte[] bytes)
+    {
+        using var stream = new MemoryStream(bytes, writable: false);
+        using var reader = new BinaryReader(stream);
+        return NtfsScanDiagnosticReport.Read(reader);
+    }
+}
diff --git a/tests/NtfsSupplementDiagnosticsTests.cs b/tests/NtfsSupplementDiagnosticsTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..8d90421762e2cd58e3afa39860aa1554f539820a
--- /dev/null
+++ b/tests/NtfsSupplementDiagnosticsTests.cs
@@ -0,0 +1,112 @@
+namespace DiskAtlas.NtfsPrototype;
+
+// Exercises the real size-index decisions with one in-memory MFT page.
+internal static class NtfsSupplementDiagnosticsTests
+{
+    internal static int Run()
+    {
+        int passed = 0;
+        void Check(bool condition, string name)
+        {
+            if (!condition) throw new InvalidOperationException("NTFS supplement diagnostics: " + name);
+            passed++;
+            Console.WriteLine("PASS NTFS supplement diagnostics " + name);
+        }
+
+        var time = new DateTime(2020, 1, 1);
+        static FileIdentity Id(int slot) => new(11, NtfsRecordFixtures.Reference((ulong)slot, 3), 0);
+        NtfsSnapshotNamespaceEntry Entry(int index, int slot, string name) =>
+            new(index, 0, name, Id(slot), FileAttributes.Archive, false) { Modified = time };
+
+        NtfsSnapshotNamespaceEntry[] entries = [
+            new(0, -1, "", Id(1), FileAttributes.Directory, false),
+            Entry(1, 2, "empty"), Entry(2, 3, "resident"),
+            Entry(3, 4, "alias-a"), Entry(4, 4, "alias-b") with { Modified = time.AddSeconds(1) },
+            Entry(5, 5, "compressed-sparse"), Entry(6, 6, "unsupported"), Entry(7, 7, "missing-data"),
+            Entry(8, 8, "ordinary")
+        ];
+        var scope = new NtfsSnapshotNamespaceResult(new("snapshot-namespace-v1", entries.Length, 8, 0, 7, 0,
+            1, 1, 2, entries.Sum(entry => entry.Name.Length), 1, true), entries, entries.Select(entry => entry.Name).ToArray(), Id(1));
+        const int bytes = 16384;
+        var map = NtfsMftMap.Parse(NtfsMftMapTests.Record0([0x11, 4, 10, 0], 3, bytes, bytes, bytes),
+            new(512, 4096, 1024, 1024 * 1024, 256, 10, bytes)).Map!;
+        var page = new byte[bytes];
+        void Record(int slot, byte[] data) => data.CopyTo(page, slot * NtfsRecordFixtures.RecordLength);
+        byte[] Name(string value) => NtfsRecordFixtures.Name(value, parent: Id(1).Low);
+        Record(1, NtfsRecordFixtures.Record([Name("root")], directory: true));
+        Record(2, NtfsRecordFixtures.Record([Name("empty"), NtfsRecordFixtures.Data(0)]));
+        Record(3, NtfsRecordFixtures.Record([Name("resident"), NtfsRecordFixtures.Data(32)]));
+        // Both aliases select one object, with incomplete link names and conflicting times.
+        Record(4, NtfsRecordFixtures.Record([Name("alias-a"), NtfsRecordFixtures.Data(32)], links: 2));
+        Record(5, NtfsRecordFixtures.Record([Name("compressed-sparse"), NtfsRecordFixtures.Nonresident(flags: 0x8001)]));
+        Record(6, NtfsRecordFixtures.Record([Name("unsupported"), NtfsRecordFixtures.Resident(0x110, [])]));
+        Record(7, NtfsRecordFixtures.Record([Name("missing-data")]));
+        Record(8, NtfsRecordFixtures.Record([Name("ordinary"), NtfsRecordFixtures.Nonresident()]));
+        int Read(long offset, Memory<byte> destination, CancellationToken token)
+        {
+            token.ThrowIfCancellationRequested();
+            page.AsMemory(checked((int)offset), destination.Length).CopyTo(destination);
+            return destination.Length;
+        }
+        NtfsSnapshotNativeSize Lookup(NtfsSnapshotSizeRequest request, CancellationToken token)
+        {
+            token.ThrowIfCancellationRequested();
+            return new(new(request.Identity, 32, request.Identity == Id(4) ? 2u : 1u, false,
+                request.ExpectedLogicalBytes ?? 32, time), request.Directory);
+        }
+
+        int completedLookups = 0, clockReads = 0;
+        var diagnostics = new NtfsScanDiagnostics(() =>
+        {
+            if (Volatile.Read(ref completedLookups) != 5) throw new InvalidOperationException("Finalization started before workers finished.");
+            return Interlocked.Increment(ref clockReads) * 3;
+        });
+        NtfsSnapshotNativeSize CountedLookup(NtfsSnapshotSizeRequest request, CancellationToken token)
+        {
+            var size = Lookup(request, token);
+            Interlocked.Increment(ref completedLookups);
+            return size;
+        }
+        var result = NtfsSnapshotSizeIndex.BuildAsync(scope, map, Read, _ => true, CountedLookup, diagnostics: diagnostics).GetAwaiter().GetResult();
+        var stats = diagnostics.Snapshot();
+        Check(result.Report.Complete && result.Report.NativeCalls == 5 && stats.SupplementObjects == 5,
+            "five unique objects require one lookup each");
+        Check(!result.Objects[Id(2)].Native && !result.Objects[Id(8)].Native &&
+            stats.ReasonCombinations.Sum() == stats.SupplementObjects && stats.ReasonCombinations[0] == 0,
+            "resolved empty and nonresident objects do not contribute to any reason bucket");
+        Check(stats.ReasonCombinations[(int)NtfsSupplementReason.ResidentAllocation] == 1, "plain nonempty resident allocation");
+        Check(stats.ReasonCombinations[(int)(NtfsSupplementReason.ResidentAllocation | NtfsSupplementReason.IncompleteLinks |
+            NtfsSupplementReason.ModifiedConflict)] == 1, "two aliases preserve all three reasons in one bucket");
+        Check(stats.ReasonCombinations[(int)(NtfsSupplementReason.Compressed | NtfsSupplementReason.Sparse)] == 1,
+            "two allocation flags stay associated with the same object");
+        Check(stats.ReasonCombinations[(int)NtfsSupplementReason.IncompleteMetadata] == 1, "missing default data");
+        Check(stats.ReasonCombinations[(int)NtfsSupplementReason.UnsupportedRecord] == 1, "strictly unsupported record");
+        int final = (int)NtfsDiagnosticPhase.IndexFinalization;
+        Check(clockReads == 2 && stats.PhaseMilliseconds[final] == 3, "finalization timed once, after the final lookup completed");
+        var baseline = NtfsSnapshotSizeIndex.BuildAsync(scope, map, Read, _ => true, Lookup).GetAwaiter().GetResult();
+        Check(result.Objects.Count == baseline.Objects.Count && result.Objects.All(pair => baseline.Objects[pair.Key] == pair.Value)
+            && result.Report.LogicalBytes == baseline.Report.LogicalBytes && result.Report.AllocatedBytes == baseline.Report.AllocatedBytes,
+            "enabling observations preserves every object and both totals");
+
+        // The pre-dispatch counters describe scheduled objects; they are not successful-call counts.
+        var failed = new NtfsScanDiagnostics();
+        bool rejected = false;
+        try
+        {
+            NtfsSnapshotSizeIndex.BuildAsync(scope, map, Read, _ => true, (_, _) => throw new IOException(),
+                diagnostics: failed).GetAwaiter().GetResult();
+        }
+        catch (NtfsSnapshotSizeException error) when (error.Code == "SnapshotSizeNativeRead") { rejected = true; }
+        Check(rejected && failed.Snapshot().SupplementObjects == 5 && failed.Snapshot().PhaseMilliseconds[final] == null,
+            "lookup failure does not report completed index finalization");
+        using var stop = new CancellationTokenSource();
+        stop.Cancel();
+        var cancelled = new NtfsScanDiagnostics();
+        bool observedCancel = false;
+        try { NtfsSnapshotSizeIndex.BuildAsync(scope, map, Read, _ => true, Lookup, stop.Token, cancelled).GetAwaiter().GetResult(); }
+        catch (OperationCanceledException) { observedCancel = true; }
+        Check(observedCancel && cancelled.Snapshot().SupplementObjects == 0 && cancelled.Snapshot().PhaseMilliseconds[final] == null,
+            "pre-cancelled index records no reasons or finalization");
+        return passed;
+    }
+}

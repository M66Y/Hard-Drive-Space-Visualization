     protected override void WndProc(ref Message message)
     {
+        // DefWindowProc sends WM_SIZE/WM_MOVE synchronously from this message.
+        // Capture the transition before base dispatch consumes the resize state,
+        // then paint the final child surfaces before returning to Windows.
+        bool restoredPosition = message.Msg == 0x0047 && restorePresentationPending;
         base.WndProc(ref message);
+        if (restoredPosition) PresentRestoredWindow();
         HandleMonitoringSystemEvent(message.Msg, message.WParam.ToInt64());
     }
 

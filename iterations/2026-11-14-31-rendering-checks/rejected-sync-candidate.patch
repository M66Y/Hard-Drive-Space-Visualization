+    private void PresentRestoredWindow()
+    {
+        if (!restorePresentationPending || paintingRestoredWindow || !IsHandleCreated || IsDisposed || Disposing ||
+            !Visible || WindowState == FormWindowState.Minimized || ClientSize.Width <= 0 || ClientSize.Height <= 0) return;
+        restorePresentationPending = false;
+        paintingRestoredWindow = true;
+        try
+        {
+            PerformLayout();
+            UpdateScopeLayout();
+            WallpaperRaster.Get(BackgroundImage, ClientSize, BackgroundCrop);
+            const uint invalidate = 0x0001, erase = 0x0004, allChildren = 0x0080, updateNow = 0x0100;
+            if (RedrawWindow(Handle, IntPtr.Zero, IntPtr.Zero, invalidate | erase | allChildren | updateNow))
+                restorePresentationPasses++;
+            else Invalidate(true);
+        }
+        finally { paintingRestoredWindow = false; }
+    }

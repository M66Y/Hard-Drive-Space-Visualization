+                Check(ScrollbarPointerTracking.ThumbStart(500,10,100,0,1000,false)==60 && ScrollbarPointerTracking.ThumbStart(0,10,100,0,1000,true)==110, "PreviewThumbMatchesRangeAndRtl");

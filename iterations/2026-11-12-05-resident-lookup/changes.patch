+function ConvertTo-LookupEvidence($Value) {
+    function Assert-Fields($Object, [string[]]$Expected) {
+        if ($null -eq $Object -or $Object -isnot [pscustomobject]) { throw 'LOOKUP_EVIDENCE_INVALID' }

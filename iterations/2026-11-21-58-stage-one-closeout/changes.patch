+using System.Diagnostics;
+using System.Drawing.Imaging;
+using System.Reflection;
+using System.Runtime.InteropServices;
+
+namespace DiskAtlas.ResizePrototype;
+
+// Owned STA-window lifecycle only. This does not exercise minimize/restore,
+// monitor changes, desktop pixels or user input, and is not visual acceptance.
+internal static class NativeResizeHostLifecycleTests
+{
+    private const BindingFlags Hidden = BindingFlags.Instance | BindingFlags.NonPublic;
+
+    internal static int Run(bool dpi96 = false)
+    {
+        int checks = 0;
+        string failure = "None";
+        bool cleanupDeferred = false;
+        Action? requestClose = null;
+        NativeResizeFrame? lastFrame = null;
+        ResizeRootCoverageHook? hook = null;
+        using var deadline = new CancellationTokenSource(TimeSpan.FromSeconds(30));
+        var worker = new Thread(() =>
+        {
+            try
+            {
+                Application.SetUnhandledExceptionMode(UnhandledExceptionMode.ThrowException);
+                Application.SetHighDpiMode(dpi96 ? HighDpiMode.DpiUnaware : HighDpiMode.PerMonitorV2);
+                Application.EnableVisualStyles();
+                Application.SetCompatibleTextRenderingDefault(false);
+                using var form = new LiveResizePrototypeForm(ResizeNativeMode.Canvas) { ShowInTaskbar = false };
+                form.EnableCoverageCandidate(true);
+                hook = Field<ResizeRootCoverageHook>(form, "coverageHook") ?? throw new Failure("HostCoverageHookMissing");
+                requestClose = () =>
+                {
+                    try
+                    {
+                        if (!form.IsDisposed && form.IsHandleCreated)
+                            form.BeginInvoke((Action)(() => { if (!form.IsDisposed) form.Close(); }));
+                    }
+                    catch (InvalidOperationException) { }
+                };
+                form.Shown += async (_, _) =>
+                {
+                    try { lastFrame = await CheckRecreation(form, hook, Check, deadline.Token); }
+                    catch (Failure error) { failure = error.Code; }
+                    catch (OperationCanceledException) { failure = "HostLifecycleDeadline"; }
+                    catch (TargetInvocationException) { failure = "HostRecreateInvocationFailed"; }
+                    catch { failure = "UnexpectedHostLifecycleFailure"; }
+                    finally { if (!form.IsDisposed) form.Close(); }
+                };
+                Application.Run(form);
+                if (failure == "None")
+                {
+                    Check(form.IsDisposed && form.BufferBytes == 0, "ClosedHostReleasesAllPixelStorage");
+                    Check(lastFrame != null && lastFrame.IsDisposed && lastFrame.OwnedBytes == 0, "ClosedHostDisposesLatestNativeFrame");
+                    Check(hook.Handle == IntPtr.Zero, "ClosedHostDetachesCoverageHook");
+                    Check(Field<NativeResizeFrame>(form, "nativeFrame") == null && Field<object>(form, "frame") == null &&
+                        Field<object>(form, "frameGraphics") == null, "ClosedHostRetainsNoNativeFrameAliases");
+                }
+            }
+            catch (Failure error) { failure = error.Code; }
+            catch { failure = "UnexpectedHostWorkerFailure"; }
+        }) { IsBackground = true, Name = "NativeResizeHostLifecycle" };
+        worker.SetApartmentState(ApartmentState.STA);
+        worker.Start();
+        if (!worker.Join(TimeSpan.FromSeconds(34)))
+        {
+            deadline.Cancel(); requestClose?.Invoke();
+            cleanupDeferred = !worker.Join(TimeSpan.FromSeconds(3));
+            failure = "HostWorkerDeadline";
+        }
+        Console.WriteLine($"NATIVE_HOST lifecycle_checks={checks}; cleanup_deferred={cleanupDeferred.ToString().ToLowerInvariant()}; dpi96={dpi96}; visual_acceptance=separate");
+        if (failure != "None") { Console.Error.WriteLine($"FAIL native resize host lifecycle: {failure}"); return 1; }
+        Console.WriteLine("PASS native resize host lifecycle; owned window generations only; no minimize or monitor testing");
+        return 0;
+
+        void Check(bool condition, string code)
+        { if (!condition) throw new Failure(code); checks++; }
+    }
+
+    private static async Task<NativeResizeFrame> CheckRecreation(LiveResizePrototypeForm form,
+        ResizeRootCoverageHook hook, Action<bool, string> check, CancellationToken token)
+    {
+        await Wait(() => form.FrameCount > 0 && form.PresentedLayout?.PixelSize == form.ClientSize &&
+            Field<NativeResizeFrame>(form, "nativeFrame") != null, token);
+        check(form.UsesNativeFrame && form.IsHandleCreated && IsWindow(form.Handle), "DibHostHasLiveRootHandle");
+        var recreate = typeof(Control).GetMethod("RecreateHandle", Hidden) ?? throw new Failure("RecreateHandleUnavailable");
+        var invalidateEdges = typeof(LiveResizePrototypeForm).GetMethod("InvalidateAnimatedEdges", Hidden)
+            ?? throw new Failure("AnimatedEdgeInvalidationUnavailable");
+        var changed = typeof(LiveResizePrototypeForm).GetMethod("Changed", Hidden)
+            ?? throw new Failure("HostStateChangeUnavailable");
+        var generationField = typeof(ResizeRootCoverageHook).GetField("handleGeneration", Hidden)
+            ?? throw new Failure("CoverageGenerationUnavailable");
+        var seenFrames = new List<NativeResizeFrame>(3);
+        NativeResizeFrame? latest = null;
+        foreach (var mode in new[] { ResizeNativeMode.Canvas, ResizeNativeMode.All })
+        {
+            int beforeMode = form.FrameCount;
+            form.SetMode(mode);
+            await Wait(() => form.FrameCount > beforeMode && form.PresentedLayout?.PixelSize == form.ClientSize, token);
+            var visibleTile = form.PresentedLayout!.Tiles.FirstOrDefault(tile => tile.RowIndex >= 0 &&
+                tile.Bounds.Width > 16 && tile.Bounds.Height > 16) ?? throw new Failure("AnimatedTileFixtureUnavailable");
+            form.SceneState.Selected = visibleTile.RowIndex;
+            changed.Invoke(form, [false]);
+            await Wait(() => form.PresentedLayout?.State.Selected == visibleTile.RowIndex, token);
+            int childCount = mode == ResizeNativeMode.Canvas ? 0 : 4;
+            check(form.Controls.Count == childCount, "HostModeHasExpectedNativeControls");
+            var oldFrame = Field<NativeResizeFrame>(form, "nativeFrame") ?? throw new Failure("ActiveHostFrameMissing");
+            check(!oldFrame.IsDisposed && oldFrame.OwnedBytes > 0, "OldGenerationOwnsLivePixelStorage");
+            check(form.BufferBytes > 0 && form.BufferBytes <= LiveResizePrototypeForm.MaxBufferBytes, "HostCombinedFrameAndCacheBudgetBounded");
+            IntPtr oldHandle = form.Handle;
+            int oldFrameCount = form.FrameCount;
+            long oldGeneration = (long)generationField.GetValue(hook)!;
+            int destroyed = 0, created = 0;
+            int createdEdgeInvalidations = 0;
+            bool recreatedEdgeWasQueued = false;
+            bool releasedAtDestroy = false, invalidatedAtDestroy = false, hookDetachedAtDestroy = false;
+            EventHandler observeDestroyed = (_, _) =>
+            {
+                destroyed++;
+                releasedAtDestroy = oldFrame.IsDisposed && oldFrame.OwnedBytes == 0 &&
+                    Field<NativeResizeFrame>(form, "nativeFrame") == null && Field<object>(form, "frame") == null &&
+                    Field<object>(form, "frameGraphics") == null;
+                invalidatedAtDestroy = Field<object>(form, "pendingLayout") == null &&
+                    Field<object>(form, "preparedLayout") == null && Field<object>(form, "animationDirty") == null &&
+                    Field<object>(form, "renderedLayout") == null;
+                hookDetachedAtDestroy = hook.Handle == IntPtr.Zero;
+            };
+            EventHandler observeCreated = (_, _) =>
+            {
+                created++;
+                // Queue exactly one ordinary edge Invalidate in this callback;
+                // do not Refresh/Update or synchronously paint the new handle.
+                invalidateEdges.Invoke(form, null);
+                createdEdgeInvalidations++;
+                recreatedEdgeWasQueued = Field<Region>(form, "animationDirty") != null;
+            };
+            form.HandleDestroyed += observeDestroyed;
+            form.HandleCreated += observeCreated;
+            try { recreate.Invoke(form, null); }
+            finally
+            {
+                form.HandleDestroyed -= observeDestroyed;
+                form.HandleCreated -= observeCreated;
+            }
+            check(destroyed == 1 && created == 1, "RootHandleDestroyedAndRecreatedExactlyOnce");
+            check(createdEdgeInvalidations == 1 && recreatedEdgeWasQueued, "RecreatedHandleQueuesOneAnimatedEdgeInvalidation");
+            check(releasedAtDestroy, "HandleDestructionReleasesOldNativeStorageBeforeEvent");
+            check(invalidatedAtDestroy, "HandleDestructionInvalidatesPreparedAndDirtyState");
+            check(hookDetachedAtDestroy, "CoverageHookDetachesFromDestroyedRoot");
+            check(oldFrame.IsDisposed && oldFrame.OwnedBytes == 0, "OldGenerationCannotRemainLiveAfterRecreation");
+            check(form.IsHandleCreated && form.Handle != IntPtr.Zero && IsWindow(form.Handle), "RecreatedRootHandleIsLive");
+            // Windows may recycle numeric HWND values after destruction. The
+            // lifecycle events, frame identity and hook generation establish
+            // that this is a new lifetime, without assuming numeric uniqueness.
+            check(oldHandle != IntPtr.Zero && (long)generationField.GetValue(hook)! >= oldGeneration + 2,
+                "CoverageGenerationAdvancesAcrossRootRecreation");
+            check(ReferenceEquals(Field<ResizeRootCoverageHook>(form, "coverageHook"), hook) && hook.Handle == form.Handle,
+                "ExistingCoverageOwnerAttachesToNewRootLifetime");
+            await Wait(() => form.FrameCount > oldFrameCount && form.PresentedLayout?.PixelSize == form.ClientSize &&
+                Field<NativeResizeFrame>(form, "nativeFrame") is { IsDisposed: false }, token);
+            latest = Field<NativeResizeFrame>(form, "nativeFrame") ?? throw new Failure("RecreatedNativeFrameMissing");
+            check(!ReferenceEquals(latest, oldFrame) && seenFrames.All(frame => !ReferenceEquals(frame, latest)),
+                "RecreatedRootPublishesFreshNativeFrameObject");
+            check(latest.Capacity.Width >= form.ClientSize.Width && latest.Capacity.Height >= form.ClientSize.Height &&
+                latest.Dpi == form.DeviceDpi && latest.OwnedBytes > 0, "FreshFrameMatchesCurrentRootGeometryAndDpi");
+            check(form.PresentedLayout!.PixelSize == form.ClientSize && form.FrameFailure == null,
+                "FreshGenerationPublishesValidCurrentLayout");
+            long nonOpaquePixels = NonOpaquePixels(latest.Bitmap, form.ClientSize);
+            Console.WriteLine($"NATIVE_HOST recreated_client_nonopaque_pixels={nonOpaquePixels}; native_mode={mode}");
+            check(nonOpaquePixels == 0, "RecreatedHostFrameIsOpaqueAcrossActualClient");
+            check(form.BufferBytes <= LiveResizePrototypeForm.MaxBufferBytes, "RecreatedGenerationRespectsCombinedBudget");
+            check(form.Controls.Count == childCount && form.Controls.Cast<Control>().All(control => !control.IsDisposed),
+                "ManagedNativeControlsSurviveRootRecreation");
+            seenFrames.Add(oldFrame);
+        }
+        check(seenFrames.Count == 2 && seenFrames.All(frame => frame.IsDisposed && frame.OwnedBytes == 0),
+            "AllPreviousHostGenerationsRemainReleased");
+        CheckPrintIsolation(form, check);
+        CheckExposedPixels(form, check);
+        return CheckSynchronousCachedRefill(form, check);
+    }
+
+    private static void CheckPrintIsolation(LiveResizePrototypeForm form, Action<bool, string> check)
+    {
+        var prepare = typeof(LiveResizePrototypeForm).GetMethod("PrepareNextGeometryFrame", Hidden)!;
+        var print = typeof(LiveResizePrototypeForm).GetMethod("OnPrint", Hidden)!;
+        prepare.Invoke(form, [form.ClientSize]);
+        var prepared = Field<ResizeSceneLayout>(form, "preparedLayout");
+        check(prepared != null, "PrintIsolationHasPreparedRootFrame");
+        var presented = form.PresentedLayout;
+        int rootFrames = form.FrameCount;
+        object? committed = typeof(LiveResizePrototypeForm).GetField("preparedCommitted", Hidden)!.GetValue(form);
+        using var bitmap = new Bitmap(64, 64);
+        using var graphics = Graphics.FromImage(bitmap);
+        using var args = new PaintEventArgs(graphics, new Rectangle(0, 0, 64, 64));
+        print.Invoke(form, [args]);
+        check(form.FrameCount == rootFrames && ReferenceEquals(form.PresentedLayout, presented), "PrintingCannotCommitRootFrame");
+        check(ReferenceEquals(prepared, Field<ResizeSceneLayout>(form, "preparedLayout")) &&
+            Equals(committed, typeof(LiveResizePrototypeForm).GetField("preparedCommitted", Hidden)!.GetValue(form)),
+            "PrintingCannotConsumePendingRootPresentation");
+        check((int)typeof(LiveResizePrototypeForm).GetField("printDepth", Hidden)!.GetValue(form)! == 0,
+            "PrintScopeRestoresRootPaintPurpose");
+    }
+
+    private static void CheckExposedPixels(LiveResizePrototypeForm form, Action<bool, string> check)
+    {
+        // Synchronous geometry changes, no Refresh/Update/DoEvents between the
+        // HWND move and independent GDI readback. Natural later paint cannot
+        // accidentally satisfy this witness as it did in the C49 baseline.
+        for (int i = 0; i < 2; i++)
+        {
+            form.SetWindowSize(false);
+            var oldGrid = form.Controls.OfType<DataGridView>().Single().Bounds;
+            form.SetWindowSize(true);
+            var grid = form.Controls.OfType<DataGridView>().Single().Bounds;
+            var point = new Point(form.ClientSize.Width - 2, form.ClientSize.Height * 2 / 3);
+            check(oldGrid.Contains(point) && !grid.Contains(point), "ResizeWitnessWasExposedByOldGrid");
+            var frame = Field<NativeResizeFrame>(form, "nativeFrame")!;
+            var layout = Field<ResizeSceneLayout>(form, "renderedLayout");
+            check(layout?.PixelSize == form.ClientSize, "ExposedPixelUsesCurrentFrameSize");
+            IntPtr dc = GetDC(form.Handle);
+            try
+            {
+                check(dc != IntPtr.Zero && PtVisible(dc, point.X, point.Y), "ExposedWitnessBelongsToVisibleRoot");
+                Color expected = frame.Bitmap.GetPixel(point.X, point.Y);
+                uint rgb = (uint)(expected.R | expected.G << 8 | expected.B << 16);
+                check(GetPixel(dc, point.X, point.Y) == rgb, "ExposedWitnessRestoredBeforeNextNaturalPaint");
+            }
+            finally { if (dc != IntPtr.Zero) ReleaseDC(form.Handle, dc); }
+        }
+    }
+
+    private static NativeResizeFrame CheckSynchronousCachedRefill(LiveResizePrototypeForm form, Action<bool, string> check)
+    {
+        // No await, DoEvents, window invalidation or synchronous UI paint in
+        // this fixture: its geometry/state/cache key cannot change mid-case.
+        var compose = typeof(LiveResizePrototypeForm).GetMethod("ComposeScene", Hidden)
+            ?? throw new Failure("HostComposeSceneUnavailable");
+        var release = typeof(LiveResizePrototypeForm).GetMethod("ReleaseFrame", Hidden)
+            ?? throw new Failure("HostReleaseFrameUnavailable");
+        var ensure = typeof(LiveResizePrototypeForm).GetMethod("EnsureFrame", Hidden)
+            ?? throw new Failure("HostEnsureFrameUnavailable");
+        var layout = ResizeSceneLayout.Build(form.ClientSize, form.DeviceDpi, form.SceneState);
+        var selectedTile = layout.Tiles.FirstOrDefault(tile => tile.RowIndex >= 0 &&
+            tile.Bounds.Width > 16 && tile.Bounds.Height > 16) ?? throw new Failure("SynchronousEdgeFixtureUnavailable");
+        compose.Invoke(form, [layout, null]);
+        var cache = Field<ResizeSceneBaseCache>(form, "baseCache") ?? throw new Failure("HostStaticCacheUnavailable");
+        check(cache.RetainedBytes > 0, "SynchronousRefillHasWarmStaticScene");
+        long cacheHits = cache.Hits;
+        var old = Field<NativeResizeFrame>(form, "nativeFrame") ?? throw new Failure("SynchronousOldFrameUnavailable");
+        release.Invoke(form, null);
+        check(old.IsDisposed && old.OwnedBytes == 0 && Field<object>(form, "renderedLayout") == null,
+            "SynchronousReleaseInvalidatesOldFramePixels");
+        ensure.Invoke(form, [form.ClientSize, form.DeviceDpi]);
+        var fresh = Field<NativeResizeFrame>(form, "nativeFrame") ?? throw new Failure("SynchronousFreshFrameUnavailable");
+        check(!ReferenceEquals(old, fresh) && !fresh.IsDisposed && Field<object>(form, "renderedLayout") == null,
+            "SynchronousEnsureCreatesUnrenderedFreshDib");
+        using var edge = new Region(selectedTile.Bounds);
+        float inset = 8 * form.DeviceDpi / 96f;
+        var inner = RectangleF.Inflate(selectedTile.Bounds, -inset, -inset);
+        check(inner.Width > 0 && inner.Height > 0, "SynchronousEdgeRegionHasUnpaintedInterior");
+        edge.Exclude(inner);
+        compose.Invoke(form, [layout, edge]);
+        check(cache.Hits > cacheHits, "SynchronousRefillDefinitelyHitsStaticCache");
+        // Flush only the in-memory drawing commands before reading the DIB;
+        // this neither invalidates nor repaints the actual window.
+        fresh.Graphics.Flush(System.Drawing.Drawing2D.FlushIntention.Sync);
+        long nonOpaquePixels = NonOpaquePixels(fresh.Bitmap, form.ClientSize);
+        Console.WriteLine($"NATIVE_HOST synchronous_cache_refill_nonopaque_pixels={nonOpaquePixels}");
+        check(nonOpaquePixels == 0, "EmptyDibWithEdgeClipReceivesOpaqueFullClientScene");
+        check(ReferenceEquals(Field<ResizeSceneLayout>(form, "renderedLayout"), layout),
+            "FullRefillPublishesValidPixelLayout");
+        check(form.BufferBytes <= LiveResizePrototypeForm.MaxBufferBytes, "SynchronousRefillKeepsCombinedPixelBudget");
+        return fresh;
+    }
+
+    private static T? Field<T>(object owner, string name) where T : class =>
+        owner.GetType().GetField(name, Hidden)?.GetValue(owner) as T;
+
+    private static long NonOpaquePixels(Bitmap frame, Size clientSize)
+    {
+        var bounds = new Rectangle(Point.Empty, clientSize);
+        var pixels = frame.LockBits(bounds, ImageLockMode.ReadOnly, PixelFormat.Format32bppPArgb);
+        long nonOpaque = 0;
+        try
+        {
+            var row = new byte[clientSize.Width * 4];
+            for (int y = 0; y < clientSize.Height; y++)
+            {
+                Marshal.Copy(pixels.Scan0 + y * pixels.Stride, row, 0, row.Length);
+                for (int offset = 3; offset < row.Length; offset += 4)
+                    if (row[offset] != byte.MaxValue) nonOpaque++;
+            }
+        }
+        finally { frame.UnlockBits(pixels); }
+        return nonOpaque;
+    }
+
+    private static async Task Wait(Func<bool> predicate, CancellationToken token)
+    {
+        var clock = Stopwatch.StartNew();
+        while (!predicate())
+        {
+            token.ThrowIfCancellationRequested();
+            if (clock.Elapsed > TimeSpan.FromSeconds(8)) throw new Failure("HostExpectedFrameDeadline");
+            await Task.Delay(12, token);
+        }
+    }
+
+    private sealed class Failure(string code) : Exception { internal string Code { get; } = code; }
+    [DllImport("user32.dll")][return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool IsWindow(IntPtr handle);
+    [DllImport("user32.dll")] private static extern IntPtr GetDC(IntPtr handle);
+    [DllImport("user32.dll")] private static extern int ReleaseDC(IntPtr handle, IntPtr dc);
+    [DllImport("gdi32.dll")] private static extern uint GetPixel(IntPtr dc, int x, int y);
+    [DllImport("gdi32.dll")][return: MarshalAs(UnmanagedType.Bool)] private static extern bool PtVisible(IntPtr dc, int x, int y);
+}
diff --git a/tests/Prototypes/Resize/ResizeBackgroundCoverage.cs b/tests/Prototypes/Resize/ResizeBackgroundCoverage.cs
new file mode 100644
index 0000000..b7cd170
--- /dev/null
+++ b/tests/Prototypes/Resize/ResizeBackgroundCoverage.cs
@@ -0,0 +1,202 @@
+using System.Drawing.Drawing2D;
+using System.Runtime.InteropServices;
+
+namespace DiskAtlas.ResizePrototype;
+
+// Test-only early coverage of newly exposed native client pixels. This draws
+// the real image at the NEW geometry; it never stretches a previous UI frame.
+internal sealed class ResizeBackgroundCoverage : IDisposable
+{
+    internal const long MaxPixels = 8_000_000;
+    internal long OwnedBytes => 0; // No extra raster or full-window buffer.
+    private bool disposed;
+
+    internal bool TryPaint(IntPtr hdc, Size nativeClientSize, Image wallpaper,
+        BackgroundView? view = null, int wash = 0, Size? previousClient = null)
+    {
+        ObjectDisposedException.ThrowIf(disposed, this);
+        ArgumentNullException.ThrowIfNull(wallpaper);
+        if (hdc == IntPtr.Zero || nativeClientSize.Width <= 0 || nativeClientSize.Height <= 0 ||
+            nativeClientSize.Width > 32768 || nativeClientSize.Height > 32768 ||
+            (long)nativeClientSize.Width * nativeClientSize.Height > MaxPixels || wash is < 0 or > 255)
+            return false;
+        var client = new Rectangle(Point.Empty, nativeClientSize);
+        if (previousClient is { } old && old.Width >= nativeClientSize.Width && old.Height >= nativeClientSize.Height)
+            return false;
+        using var graphics = Graphics.FromHdc(hdc);
+        var saved = graphics.Save();
+        try
+        {
+            graphics.SetClip(client, CombineMode.Intersect);
+            if (previousClient is { Width: > 0, Height: > 0 } previous)
+                graphics.ExcludeClip(new Rectangle(Point.Empty, previous));
+            graphics.CompositingMode = CompositingMode.SourceCopy;
+            using (var opaque = new SolidBrush(Theme.Background)) graphics.FillRectangle(opaque, client);
+            graphics.CompositingMode = CompositingMode.SourceOver;
+            graphics.InterpolationMode = InterpolationMode.HighQualityBilinear;
+            graphics.DrawImage(wallpaper, Wallpaper.CoverBounds(wallpaper, nativeClientSize, Point.Empty, view));
+            if (wash != 0)
+            {
+                using var veil = new SolidBrush(Color.FromArgb(wash, Theme.Surface));
+                graphics.FillRectangle(veil, client);
+            }
+            return true;
+        }
+        finally { graphics.Restore(saved); }
+    }
+
+    public void Dispose() => disposed = true;
+}
+
+// Installed ONLY by an explicit test-preview option. It owns a hook on its
+// supplied form and DCs from that form; normal application construction is unchanged.
+internal sealed class ResizeRootCoverageHook : NativeWindow, IDisposable
+{
+    private readonly Form owner;
+    private readonly ResizeBackgroundCoverage coverage = new();
+    private readonly Func<BackgroundView?> crop;
+    private readonly int wash;
+    private readonly Action<Size>? prepareFrame;
+    private readonly Func<IntPtr, Size, bool>? presentFrame;
+    private readonly bool presentBeforeNcPaint;
+    private Size previousNative;
+    private long handleGeneration;
+    private bool disposed, painting;
+    internal int PaintCount { get; private set; }
+    internal int Failures { get; private set; }
+    internal long PaintTicks { get; private set; }
+
+    internal ResizeRootCoverageHook(Form owner, Func<BackgroundView?> crop, int wash = 0,
+        Action<Size>? prepareFrame = null, Func<IntPtr, Size, bool>? presentFrame = null, bool presentBeforeNcPaint = false)
+    {
+        this.owner = owner; this.crop = crop; this.wash = wash;
+        this.prepareFrame = prepareFrame; this.presentFrame = presentFrame;
+        this.presentBeforeNcPaint = presentBeforeNcPaint;
+        owner.HandleCreated += Created;
+        owner.HandleDestroyed += Destroyed;
+        if (owner.IsHandleCreated) Created(owner, EventArgs.Empty);
+    }
+
+    private void Created(object? sender, EventArgs e)
+    {
+        if (disposed || owner.IsDisposed || !owner.IsHandleCreated) return;
+        if (Handle != IntPtr.Zero) ReleaseHandle();
+        handleGeneration++;
+        AssignHandle(owner.Handle);
+        previousNative = NativeSize();
+    }
+    private void Destroyed(object? sender, EventArgs e)
+    {
+        handleGeneration++;
+        if (Handle != IntPtr.Zero) ReleaseHandle();
+        previousNative = Size.Empty;
+    }
+    private Size NativeSize() => Handle != IntPtr.Zero && GetClientRect(Handle, out var r)
+        ? new(Math.Max(0, r.Right - r.Left), Math.Max(0, r.Bottom - r.Top)) : Size.Empty;
+
+    private bool Cover(IntPtr suppliedDc)
+    {
+        if (disposed || painting || owner.IsDisposed || owner.Disposing || Handle == IntPtr.Zero ||
+            IsIconic(Handle) || owner.BackgroundImage == null) return false;
+        IntPtr observedHandle = Handle;
+        long observedGeneration = handleGeneration;
+        Size size = NativeSize();
+        bool grew = size.Width > previousNative.Width || size.Height > previousNative.Height;
+        if (size.Width <= 0 || size.Height <= 0 || !grew && presentFrame == null)
+            return false;
+        IntPtr dc = suppliedDc;
+        bool ownDc = dc == IntPtr.Zero;
+        painting = true;
+        long began = System.Diagnostics.Stopwatch.GetTimestamp();
+        try
+        {
+            Image? image = owner.BackgroundImage;
+            BackgroundView? view = grew ? crop() : null;
+            if (image == null || disposed || owner.IsDisposed || Handle != observedHandle || handleGeneration != observedGeneration)
+                return false;
+            if (ownDc) dc = GetDC(observedHandle);
+            if (dc == IntPtr.Zero) { Failures++; return false; }
+            // WM_ERASE's supplied DC can cover only newly invalid strips. A
+            // complete prepared scene needs our OWN root client DC, otherwise
+            // shrinking would leave valid old-width pixels outside that clip.
+            bool presented = false;
+            if (presentFrame != null)
+            {
+                IntPtr frameDc = ownDc ? dc : GetDC(observedHandle);
+                try { if (frameDc != IntPtr.Zero) presented = presentFrame(frameDc, size); }
+                finally { if (!ownDc && frameDc != IntPtr.Zero) ReleaseDC(observedHandle, frameDc); }
+            }
+            if (presented)
+            {
+                if (disposed || Handle != observedHandle || handleGeneration != observedGeneration) return false;
+                previousNative = size; PaintCount++; return true;
+            }
+            if (!grew) return false;
+            if (image == null || disposed || owner.IsDisposed || Handle != observedHandle || handleGeneration != observedGeneration)
+                return false;
+            if (!coverage.TryPaint(dc, size, image, view, wash, previousNative))
+            { Failures++; return false; }
+            if (disposed || owner.IsDisposed || Handle != observedHandle || handleGeneration != observedGeneration)
+                return false;
+            previousNative = size;
+            PaintCount++;
+            return true;
+        }
+        catch (Exception error) when (error is ArgumentException or ExternalException or InvalidOperationException or OutOfMemoryException)
+        { Failures++; return false; }
+        finally
+        {
+            if (ownDc && dc != IntPtr.Zero) ReleaseDC(observedHandle, dc);
+            PaintTicks += System.Diagnostics.Stopwatch.GetTimestamp() - began;
+            painting = false;
+        }
+    }
+
+    protected override void WndProc(ref Message message)
+    {
+        if (message.Msg == 0x0046 && prepareFrame != null)
+        {
+            base.WndProc(ref message);
+            if (!disposed && !painting && Handle != IntPtr.Zero && !IsIconic(Handle) && message.LParam != IntPtr.Zero)
+            {
+                var next = Marshal.PtrToStructure<WindowPosition>(message.LParam);
+                Size current = NativeSize();
+                if ((next.Flags & 0x0001) == 0 && GetWindowRect(Handle, out var window))
+                {
+                    var size = new Size(next.Width - (window.Right - window.Left - current.Width),
+                        next.Height - (window.Bottom - window.Top - current.Height));
+                    if (size != current && size.Width > 0 && size.Height > 0 && (long)size.Width * size.Height <= ResizeBackgroundCoverage.MaxPixels)
+                        prepareFrame(size);
+                }
+            }
+            return;
+        }
+        if (message.Msg == 0x0014 && Cover(message.WParam))
+        { message.Result = (IntPtr)1; return; }
+        // Some paths suppress WM_ERASEBKGND. Cover only new right/bottom
+        // regions before nested WM_SIZE/layout work; never force a UI repaint.
+        if (message.Msg is 0x0047 or 0x0005 || presentBeforeNcPaint && message.Msg == 0x0085) Cover(IntPtr.Zero);
+        base.WndProc(ref message);
+        if (message.Msg == 0x0047 && !disposed && Handle != IntPtr.Zero && !IsIconic(Handle))
+            previousNative = NativeSize();
+    }
+
+    public void Dispose()
+    {
+        if (disposed) return;
+        disposed = true;
+        handleGeneration++;
+        owner.HandleCreated -= Created; owner.HandleDestroyed -= Destroyed;
+        if (Handle != IntPtr.Zero) ReleaseHandle();
+        coverage.Dispose();
+    }
+
+    [StructLayout(LayoutKind.Sequential)] private struct NativeRect { internal int Left, Top, Right, Bottom; }
+    [StructLayout(LayoutKind.Sequential)] private struct WindowPosition
+    { internal IntPtr Window, After; internal int X, Y, Width, Height; internal uint Flags; }
+    [DllImport("user32.dll")] [return: MarshalAs(UnmanagedType.Bool)] private static extern bool GetClientRect(IntPtr handle, out NativeRect rectangle);
+    [DllImport("user32.dll")] [return: MarshalAs(UnmanagedType.Bool)] private static extern bool GetWindowRect(IntPtr handle, out NativeRect rectangle);
+    [DllImport("user32.dll")] [return: MarshalAs(UnmanagedType.Bool)] private static extern bool IsIconic(IntPtr handle);
+    [DllImport("user32.dll")] private static extern IntPtr GetDC(IntPtr handle);
+    [DllImport("user32.dll")] private static extern int ReleaseDC(IntPtr handle, IntPtr dc);
+}
diff --git a/tests/Prototypes/Resize/ResizeCoverageTests.cs b/tests/Prototypes/Resize/ResizeCoverageTests.cs
new file mode 100644
index 0000000..7c2e614
--- /dev/null
+++ b/tests/Prototypes/Resize/ResizeCoverageTests.cs
@@ -0,0 +1,332 @@
+using System.Diagnostics;
+using System.Drawing.Drawing2D;
+using System.Drawing.Imaging;
+using System.Reflection;
+using System.Runtime.InteropServices;
+
+namespace DiskAtlas.ResizePrototype;
+
+// Own memory DCs, synthetic images and an owned prototype only. These checks
+// do not sample the desktop or alter diagnostic sampling/visual acceptance.
+internal static class ResizeCoverageTests
+{
+    private static readonly Color Sentinel = Color.FromArgb(19, 47, 71);
+
+    internal static int Run(bool dpi96 = false, bool nativeDib = false)
+    {
+        int checks = 0;
+        long pixelsChecked = 0;
+        string failure = "None";
+        bool cleanupDeferred = false;
+        Action? close = null;
+        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(50));
+        var worker = new Thread(() =>
+        {
+            try
+            {
+                Application.SetUnhandledExceptionMode(UnhandledExceptionMode.ThrowException);
+                Application.SetHighDpiMode(dpi96 ? HighDpiMode.DpiUnaware : HighDpiMode.PerMonitorV2);
+                Application.EnableVisualStyles();
+                Application.SetCompatibleTextRenderingDefault(false);
+                DrawingChecks(Check, ref pixelsChecked);
+                using var form = new LiveResizePrototypeForm(ResizeNativeMode.Canvas) { ShowInTaskbar = false };
+                Image? originalImage = form.BackgroundImage;
+                form.EnableCoverageCandidate(nativeDib);
+                var hook = typeof(LiveResizePrototypeForm).GetField("coverageHook", BindingFlags.Instance | BindingFlags.NonPublic)
+                    ?.GetValue(form) as ResizeRootCoverageHook ?? throw new CheckFailure("CoverageHookUnavailable");
+                close = () =>
+                {
+                    try { if (!form.IsDisposed && form.IsHandleCreated) form.BeginInvoke((Action)(() => form.Close())); }
+                    catch (InvalidOperationException) { }
+                };
+                form.Shown += async (_, _) =>
+                {
+                    try { await CompatibilityChecks(form, hook, originalImage, Check, timeout.Token); }
+                    catch (CheckFailure error) { failure = error.Code; }
+                    catch (OperationCanceledException) { failure = "CoverageWindowDeadline"; }
+                    catch { failure = "UnexpectedCoverageWindowFailure"; }
+                    finally { if (!form.IsDisposed) form.Close(); }
+                };
+                Application.Run(form);
+                Check(form.IsDisposed && form.BufferBytes == 0, "CoveragePrototypeDisposed");
+                Check(hook.Handle == IntPtr.Zero, "CoverageNativeHookReleased");
+            }
+            catch (CheckFailure error) { failure = error.Code; }
+            catch { failure = "UnexpectedCoverageWorkerFailure"; }
+        }) { IsBackground = true, Name = "ResizeCoverageChecks" };
+        worker.SetApartmentState(ApartmentState.STA);
+        worker.Start();
+        if (!worker.Join(TimeSpan.FromSeconds(54)))
+        {
+            timeout.Cancel(); close?.Invoke();
+            cleanupDeferred = !worker.Join(TimeSpan.FromSeconds(2));
+            failure = "CoverageWorkerDeadline";
+        }
+        Console.WriteLine($"COVERAGE checks={checks}; rgb_pixels_checked={pixelsChecked}; native_dib={nativeDib}; cleanup_deferred={cleanupDeferred.ToString().ToLowerInvariant()}; desktop_acceptance=separate");
+        if (failure != "None") { Console.Error.WriteLine($"FAIL resize coverage: {failure}"); return 1; }
+        Console.WriteLine("PASS resize coverage; synthetic memory DC and owned prototype; no scan or system changes");
+        return 0;
+
+        void Check(bool condition, string code)
+        {
+            if (!condition) throw new CheckFailure(code);
+            checks++;
+        }
+    }
+
+    private static void DrawingChecks(Action<bool, string> check, ref long pixelsChecked)
+    {
+        var native = new Size(320, 240);
+        var old = new Size(128, 96);
+        using var wallpaper = CreateWallpaper();
+        using var coverage = new ResizeBackgroundCoverage();
+        check(ResizeBackgroundCoverage.MaxPixels == 8_000_000, "CoverageBudgetIsExplicit");
+        check(coverage.OwnedBytes == 0, "CoverageDoesNotOwnAnotherFullFrame");
+        foreach (int dpi in new[] { 96, 144 })
+        foreach (var view in new[] { BackgroundView.Default, new BackgroundView(.2f, .7f, 1.6f, null) })
+        {
+            using var reference = BackgroundReference(native, dpi, wallpaper, view, 0);
+            using var actual = NewTarget(native, dpi);
+            WithDc(actual, dc => check(coverage.TryPaint(dc, native, wallpaper, view), "FullNativeBackgroundCovered"));
+            CompareRgb(actual, reference, (_, _) => true, check, "FullCoverageUsesRealWallpaperAtNativeGeometry", ref pixelsChecked);
+            check(Rgb(actual.GetPixel(native.Width - 8, native.Height - 8)) != Rgb(Theme.Surface), "NewCornerIsNotWhitePlaceholder");
+
+            using var exposed = NewTarget(native, dpi);
+            WithDc(exposed, dc => check(coverage.TryPaint(dc, native, wallpaper, view, previousClient: old), "ExposedNativeRegionCovered"));
+            CompareRgb(exposed, reference, (x, y) => x >= old.Width || y >= old.Height, check,
+                "ExposedRegionsUseNewWallpaperCoordinatesAndPreserveOldContent", ref pixelsChecked);
+            check(coverage.OwnedBytes == 0, "RepeatedCoverageKeepsZeroRasterOwnership");
+
+            using var washedReference = BackgroundReference(native, dpi, wallpaper, view, 93);
+            using var washed = NewTarget(native, dpi);
+            WithDc(washed, dc => check(coverage.TryPaint(dc, native, wallpaper, view, 93), "NativeWashAccepted"));
+            CompareRgb(washed, washedReference, (_, _) => true, check, "NativeWashRetainsWallpaperMapping", ref pixelsChecked);
+        }
+
+        using (var clipped = NewTarget(native, 96))
+        using (var reference = BackgroundReference(native, 96, wallpaper, BackgroundView.Default, 0))
+        {
+            IntPtr mask = CreateRectRgn(0, 0, 31, native.Height);
+            IntPtr bottom = CreateRectRgn(0, native.Height - 47, native.Width, native.Height);
+            IntPtr right = CreateRectRgn(native.Width - 61, 0, native.Width, native.Height);
+            IntPtr hole = CreateRectRgn(native.Width - 43, native.Height - 32, native.Width - 12, native.Height - 8);
+            IntPtr before = CreateRectRgn(0, 0, 0, 0), after = CreateRectRgn(0, 0, 0, 0);
+            try
+            {
+                check(mask != IntPtr.Zero && bottom != IntPtr.Zero && right != IntPtr.Zero && hole != IntPtr.Zero &&
+                    before != IntPtr.Zero && after != IntPtr.Zero, "OwnedClipRegionsCreated");
+                CombineRgn(mask, mask, bottom, 2); CombineRgn(mask, mask, right, 2); CombineRgn(mask, mask, hole, 4);
+                WithDc(clipped, dc =>
+                {
+                    check(SelectClipRgn(dc, mask) > 0 && GetClipRgn(dc, before) == 1, "ExternalComplexClipInstalled");
+                    bool viewportReadable = GetViewportOrgEx(dc, out var viewport);
+                    bool windowReadable = GetWindowOrgEx(dc, out var window);
+                    check(viewportReadable && windowReadable, "ExternalDcOriginsReadable");
+                    int stackBefore = SaveDC(dc); check(stackBefore > 0 && RestoreDC(dc, stackBefore), "ExternalDcStackReadable");
+                    for (int i = 0; i < 12; i++)
+                        check(coverage.TryPaint(dc, native, wallpaper, previousClient: old), "ComplexClippedCoverageAccepted");
+                    check(GetClipRgn(dc, after) == 1 && EqualRgn(before, after), "ExternalDcClipPreservedExactly");
+                    check(GetViewportOrgEx(dc, out var nextViewport) && GetWindowOrgEx(dc, out var nextWindow) &&
+                        viewport.Equals(nextViewport) && window.Equals(nextWindow), "ExternalDcOriginsPreserved");
+                    int stackAfter = SaveDC(dc); check(stackAfter == stackBefore && RestoreDC(dc, stackAfter), "RepeatedCoverageBalancesDcStateStack");
+                });
+                CompareRgb(clipped, reference, (x, y) => PtInRegion(mask, x, y) && (x >= old.Width || y >= old.Height),
+                    check, "ExternalComplexClipAndOldContentRemainIntact", ref pixelsChecked);
+            }
+            finally
+            {
+                foreach (IntPtr region in new[] { mask, bottom, right, hole, before, after })
+                    if (region != IntPtr.Zero) DeleteObject(region);
+            }
+        }
+
+        using (var rejected = NewTarget(native, 96))
+        {
+            WithDc(rejected, dc =>
+            {
+                check(!coverage.TryPaint(dc, Size.Empty, wallpaper), "EmptyNativeSizeRejected");
+                check(!coverage.TryPaint(dc, new Size(-1, 24), wallpaper), "NegativeNativeSizeRejected");
+                check(!coverage.TryPaint(dc, new Size(4001, 2000), wallpaper), "NativePixelBudgetEnforced");
+                check(!coverage.TryPaint(dc, new Size(32769, 1), wallpaper), "NativeSideBudgetEnforced");
+                check(!coverage.TryPaint(dc, native, wallpaper, wash: -1) && !coverage.TryPaint(dc, native, wallpaper, wash: 256),
+                    "InvalidWashRejected");
+                check(!coverage.TryPaint(dc, native, wallpaper, previousClient: native), "NoNewRegionNotReportedAsPainted");
+                check(!coverage.TryPaint(dc, native, wallpaper, previousClient: new Size(640, 480)), "ShrinkNotReportedAsNewCoverage");
+                check(!coverage.TryPaint(IntPtr.Zero, native, wallpaper), "MissingDcRejected");
+            });
+            CompareRgb(rejected, rejected, (_, _) => false, check, "RejectedCoverageDoesNotChangeCallerPixels", ref pixelsChecked);
+        }
+
+        using (var edge = NewTarget(native, 96))
+            WithDc(edge, dc => check(coverage.TryPaint(dc, new Size(4000, 2000), wallpaper), "ExactNativePixelBudgetAcceptedWithoutExtraRaster"));
+        check(coverage.OwnedBytes == 0, "BudgetEdgeDoesNotAllocateFullNativeFrame");
+
+        var state = new ResizeSceneState { View = 1, Selected = 9, Hover = 12, Scroll = 3, Search = "sample", Metric = 1, Progress = .4, Revision = 31 };
+        var layout = ResizeSceneLayout.Build(new Size(1440, 940), 96, state);
+        using (var target = NewTarget(native, 96)) WithDc(target, dc => coverage.TryPaint(dc, native, wallpaper));
+        var unchanged = ResizeSceneLayout.Build(layout.PixelSize, layout.Dpi, state);
+        check(layout.State == unchanged.State && layout.Search == unchanged.Search && layout.MapPanel == unchanged.MapPanel &&
+            layout.ListPanel == unchanged.ListPanel && layout.Rows.SequenceEqual(unchanged.Rows) &&
+            layout.Tiles.Select(tile => tile.Bounds).SequenceEqual(unchanged.Tiles.Select(tile => tile.Bounds)),
+            "BackgroundCoverageDoesNotMutateLayoutOrViewState");
+        coverage.Dispose(); coverage.Dispose();
+        check(coverage.OwnedBytes == 0, "CoverageDisposalLeavesNoOwnedRaster");
+        check(wallpaper.GetPixel(2, 2).ToArgb() == Color.FromArgb(178, 61, 38).ToArgb(), "CallerWallpaperRemainsOwnedByCaller");
+        bool disposedRejected = false;
+        try { coverage.TryPaint(IntPtr.Zero, native, wallpaper); }
+        catch (ObjectDisposedException) { disposedRejected = true; }
+        check(disposedRejected, "DisposedCoverageCannotPaint");
+    }
+
+    private static async Task CompatibilityChecks(LiveResizePrototypeForm form, ResizeRootCoverageHook hook,
+        Image? originalImage, Action<bool, string> check, CancellationToken token)
+    {
+        await Wait(() => form.FrameCount > 0 && form.PresentedLayout?.PixelSize == form.ClientSize, token);
+        check(form.Controls.Count == 0, "CoverageCanvasKeepsSingleManagedSurface");
+        foreach (var mode in new[] { ResizeNativeMode.Canvas, ResizeNativeMode.All })
+        {
+            int beforeFrame = form.FrameCount;
+            form.SetMode(mode);
+            await Wait(() => form.FrameCount > beforeFrame && form.PresentedLayout?.PixelSize == form.ClientSize, token);
+            check(form.Controls.Count == (mode == ResizeNativeMode.Canvas ? 0 : 4), "CoverageDoesNotReplaceNativeControls");
+            check(ReferenceEquals(form.BackgroundImage, originalImage), "CoverageDoesNotReplaceRealBackgroundImage");
+            var ordinary = ResizeSceneLayout.Build(form.ClientSize, form.DeviceDpi, form.SceneState);
+            check(SameGeometry(ordinary, form.PresentedLayout!), "CoveragePreservesCurrentLayoutRules");
+            form.SetWindowSize(true);
+            await Wait(() => form.PresentedLayout?.PixelSize == form.ClientSize, token);
+            int beforePaints = hook.PaintCount;
+            int preparedBefore = (int)typeof(LiveResizePrototypeForm).GetField("preparedPresents", BindingFlags.Instance | BindingFlags.NonPublic)!.GetValue(form)!;
+            form.SetWindowSize(false);
+            await Wait(() => form.PresentedLayout?.PixelSize == form.ClientSize && hook.PaintCount > beforePaints, token);
+            check(hook.Failures == 0, "NativeExpansionCoverageHasNoHookFailures");
+            check((int)typeof(LiveResizePrototypeForm).GetField("preparationCount", BindingFlags.Instance | BindingFlags.NonPublic)!.GetValue(form)! > 0,
+                "NewGeometryScenePreparedBeforeNativeCommit");
+            check((int)typeof(LiveResizePrototypeForm).GetField("preparedPresents", BindingFlags.Instance | BindingFlags.NonPublic)!.GetValue(form)! > preparedBefore,
+                "CompletePreparedScenePresentedAtExpansion");
+            check((int)typeof(LiveResizePrototypeForm).GetField("preparationFailures", BindingFlags.Instance | BindingFlags.NonPublic)!.GetValue(form)! == 0,
+                "PreparedSceneHasNoHiddenFailures");
+            check(SameGeometry(ResizeSceneLayout.Build(form.ClientSize, form.DeviceDpi, form.SceneState), form.PresentedLayout!),
+                "NativeExpansionKeepsUnifiedGeometry");
+            if (mode == ResizeNativeMode.All)
+            {
+                var search = form.Controls.OfType<TextBox>().Single();
+                search.Text = "__coverage_no_match__";
+                await Wait(() => form.PresentedLayout?.Data.Count == 0, token);
+                check(form.SceneState.Search == search.Text, "CoverageKeepsNativeTextBinding");
+                search.Text = "";
+                await Wait(() => form.PresentedLayout?.Data.Count > 0, token);
+                var metric = form.Controls.OfType<ComboBox>().Single(control => control.Name == "prototypeMetric");
+                metric.SelectedIndex = 1;
+                await Wait(() => form.PresentedLayout?.State.Metric == 1, token);
+                check(form.SceneState.Metric == 1, "CoverageKeepsNativeMetricBinding");
+                var grid = form.Controls.OfType<DataGridView>().Single();
+                check(grid.RowCount == form.PresentedLayout!.Data.Count && grid.Visible && grid.IsHandleCreated,
+                    "CoverageKeepsNativeGridDataAndHandle");
+            }
+        }
+    }
+
+    private static bool SameGeometry(ResizeSceneLayout first, ResizeSceneLayout second) => first.PixelSize == second.PixelSize &&
+        first.Dpi == second.Dpi && first.State == second.State && first.Sidebar == second.Sidebar &&
+        first.MapPanel == second.MapPanel && first.MapHeader == second.MapHeader && first.MapBody == second.MapBody &&
+        first.ListPanel == second.ListPanel && first.ListHeader == second.ListHeader && first.ListBody == second.ListBody &&
+        first.Search == second.Search && first.Strategy == second.Strategy && first.Metric == second.Metric &&
+        first.Details == second.Details && first.ProgressBounds == second.ProgressBounds &&
+        first.Toolbar.SequenceEqual(second.Toolbar) && first.Stats.SequenceEqual(second.Stats) && first.Rows.SequenceEqual(second.Rows);
+
+    private static Bitmap NewTarget(Size size, int dpi)
+    {
+        var result = new Bitmap(size.Width, size.Height, PixelFormat.Format32bppArgb);
+        result.SetResolution(dpi, dpi);
+        using var graphics = Graphics.FromImage(result); graphics.Clear(Sentinel);
+        return result;
+    }
+
+    private static Bitmap CreateWallpaper()
+    {
+        var result = new Bitmap(64, 48, PixelFormat.Format32bppArgb);
+        using var graphics = Graphics.FromImage(result);
+        using var a = new SolidBrush(Color.FromArgb(178, 61, 38));
+        using var b = new SolidBrush(Color.FromArgb(42, 128, 83));
+        using var c = new SolidBrush(Color.FromArgb(57, 86, 173));
+        using var d = new SolidBrush(Color.FromArgb(224, 150, 43));
+        graphics.FillRectangle(a, 0, 0, 32, 24); graphics.FillRectangle(b, 32, 0, 32, 24);
+        graphics.FillRectangle(c, 0, 24, 32, 24); graphics.FillRectangle(d, 32, 24, 32, 24);
+        return result;
+    }
+
+    private static Bitmap BackgroundReference(Size size, int dpi, Image wallpaper, BackgroundView view, int wash)
+    {
+        var image = new Bitmap(size.Width, size.Height, PixelFormat.Format32bppArgb); image.SetResolution(dpi, dpi);
+        using var graphics = Graphics.FromImage(image);
+        graphics.Clear(Theme.Background); graphics.InterpolationMode = InterpolationMode.HighQualityBilinear;
+        graphics.DrawImage(wallpaper, Wallpaper.CoverBounds(wallpaper, size, Point.Empty, view));
+        if (wash != 0)
+        { using var veil = new SolidBrush(Color.FromArgb(wash, Theme.Surface)); graphics.FillRectangle(veil, new Rectangle(Point.Empty, size)); }
+        return image;
+    }
+
+    private static void WithDc(Bitmap target, Action<IntPtr> action)
+    {
+        using var graphics = Graphics.FromImage(target);
+        IntPtr dc = graphics.GetHdc();
+        try { action(dc); }
+        finally { graphics.ReleaseHdc(dc); }
+    }
+
+    private static void CompareRgb(Bitmap actual, Bitmap reference, Func<int, int, bool> expectedPainted,
+        Action<bool, string> check, string code, ref long pixelsChecked)
+    {
+        long mismatches = 0;
+        var bounds = new Rectangle(Point.Empty, actual.Size);
+        var a = actual.LockBits(bounds, ImageLockMode.ReadOnly, PixelFormat.Format32bppArgb);
+        BitmapData? b = null;
+        try
+        {
+            if (!ReferenceEquals(actual, reference)) b = reference.LockBits(bounds, ImageLockMode.ReadOnly, PixelFormat.Format32bppArgb);
+            var actualRow = new byte[actual.Width * 4]; var expectedRow = new byte[actualRow.Length];
+            for (int y = 0; y < actual.Height; y++)
+            {
+                Marshal.Copy(a.Scan0 + y * a.Stride, actualRow, 0, actualRow.Length);
+                if (b != null) Marshal.Copy(b.Scan0 + y * b.Stride, expectedRow, 0, expectedRow.Length);
+                for (int x = 0; x < actual.Width; x++)
+                {
+                    int offset = x * 4;
+                    int wanted = expectedPainted(x, y) ? expectedRow[offset] | expectedRow[offset + 1] << 8 | expectedRow[offset + 2] << 16 : Rgb(Sentinel);
+                    int observed = actualRow[offset] | actualRow[offset + 1] << 8 | actualRow[offset + 2] << 16;
+                    if (observed != wanted) mismatches++;
+                    pixelsChecked++;
+                }
+            }
+        }
+        finally { actual.UnlockBits(a); if (b != null) reference.UnlockBits(b); }
+        if (mismatches != 0) Console.WriteLine($"COVERAGE mismatch_code={code}; rgb_mismatch_pixels={mismatches}");
+        check(mismatches == 0, code);
+    }
+
+    private static int Rgb(Color color) => color.ToArgb() & 0x00ffffff;
+    private static async Task Wait(Func<bool> predicate, CancellationToken token)
+    {
+        var clock = Stopwatch.StartNew();
+        while (!predicate())
+        {
+            token.ThrowIfCancellationRequested();
+            if (clock.Elapsed > TimeSpan.FromSeconds(8)) throw new CheckFailure("CoverageExpectedFrameDeadline");
+            await Task.Delay(12, token);
+        }
+    }
+
+    private sealed class CheckFailure(string code) : Exception { internal string Code { get; } = code; }
+    [StructLayout(LayoutKind.Sequential)] private struct NativePoint { internal int X, Y; }
+    [DllImport("gdi32.dll")] private static extern IntPtr CreateRectRgn(int left, int top, int right, int bottom);
+    [DllImport("gdi32.dll")] private static extern int CombineRgn(IntPtr destination, IntPtr first, IntPtr second, int mode);
+    [DllImport("gdi32.dll")] private static extern int SelectClipRgn(IntPtr dc, IntPtr region);
+    [DllImport("gdi32.dll")] private static extern int GetClipRgn(IntPtr dc, IntPtr region);
+    [DllImport("gdi32.dll")][return: MarshalAs(UnmanagedType.Bool)] private static extern bool EqualRgn(IntPtr first, IntPtr second);
+    [DllImport("gdi32.dll")][return: MarshalAs(UnmanagedType.Bool)] private static extern bool PtInRegion(IntPtr region, int x, int y);
+    [DllImport("gdi32.dll")][return: MarshalAs(UnmanagedType.Bool)] private static extern bool DeleteObject(IntPtr value);
+    [DllImport("gdi32.dll")] private static extern int SaveDC(IntPtr dc);
+    [DllImport("gdi32.dll")][return: MarshalAs(UnmanagedType.Bool)] private static extern bool RestoreDC(IntPtr dc, int saved);
+    [DllImport("gdi32.dll")][return: MarshalAs(UnmanagedType.Bool)] private static extern bool GetViewportOrgEx(IntPtr dc, out NativePoint point);
+    [DllImport("gdi32.dll")][return: MarshalAs(UnmanagedType.Bool)] private static extern bool GetWindowOrgEx(IntPtr dc, out NativePoint point);
+}
diff --git a/tests/Prototypes/Resize/ResizeDiagnosticReplay.cs b/tests/Prototypes/Resize/ResizeDiagnosticReplay.cs
new file mode 100644
index 0000000..3742be0
--- /dev/null
+++ b/tests/Prototypes/Resize/ResizeDiagnosticReplay.cs
@@ -0,0 +1,81 @@
+using System.Diagnostics;
+
+namespace DiskAtlas.ResizePrototype;
+
+// A diagnostic stimulus, not a resize workaround. Both cadences request the
+// exact same bounded Size sequence; the UI pump determines actual tick times.
+internal sealed class ResizeDiagnosticReplay : IDisposable
+{
+    internal const int StepLimit = 12;
+    private readonly Form owner;
+    private readonly System.Windows.Forms.Timer timer;
+    private readonly Func<ResizeDiagnosticTrace?> trace;
+    private readonly Action completed;
+    private readonly Size[] sizes;
+    private readonly long[] requestedAt = new long[StepLimit];
+    private int step;
+    internal int Steps => step;
+    internal int RequestedInterval { get; }
+    internal bool Completed => step == sizes.Length;
+
+    internal ResizeDiagnosticReplay(Form owner, int interval, Func<ResizeDiagnosticTrace?> trace, Action completed, Size? common = null)
+    {
+        if (interval is not (30 or 100)) throw new ArgumentOutOfRangeException(nameof(interval));
+        this.owner = owner; this.trace = trace; this.completed = completed;
+        RequestedInterval = interval;
+        sizes = Build(common ?? owner.Size, owner.MinimumSize);
+        timer = new() { Interval = interval };
+        timer.Tick += (_, _) => Tick();
+    }
+
+    internal static Size[] Build(Size common, Size minimum)
+    {
+        if (common.Width <= 0 || common.Height <= 0 || minimum.Width <= 0 || minimum.Height <= 0 ||
+            minimum.Width > common.Width || minimum.Height > common.Height)
+            throw new ArgumentOutOfRangeException(nameof(common));
+        var result = new Size[StepLimit];
+        for (int i = 0; i < result.Length; i++)
+        {
+            // Put newly exposed right/bottom regions in the first few steps.
+            // The earlier 160-step smooth sweep exhausted normal-form trace
+            // capacity while it was still shrinking, before the useful edge.
+            result[i] = i % 2 == 0 ? common : minimum;
+        }
+        return result;
+    }
+
+    internal void Start()
+    {
+        if (owner.IsDisposed || step != 0) return;
+        trace()?.Mark("ReplayStarted");
+        timer.Start();
+    }
+
+    private void Tick()
+    {
+        if (owner.IsDisposed) { timer.Stop(); return; }
+        if (step >= sizes.Length) { timer.Stop(); return; }
+        requestedAt[step] = Stopwatch.GetTimestamp();
+        trace()?.Mark("ReplayStep");
+        owner.Size = sizes[step++];
+        if (step < sizes.Length) return;
+        timer.Stop(); trace()?.Mark("ReplayFinished");
+        // The callback can queue close after the final natural Paint. It must
+        // never call Refresh/Update or block the observed UI thread.
+        completed();
+    }
+
+    internal object Summary()
+    {
+        double[] gaps = requestedAt.Take(step).Zip(requestedAt.Skip(1).Take(Math.Max(0, step - 1)),
+            (first, second) => Stopwatch.GetElapsedTime(first, second).TotalMilliseconds).Order().ToArray();
+        return new { revision = 2, sequence_kind = "alternating-common-minimum", requested_interval_ms = RequestedInterval, requested_steps = step,
+            completed = Completed, fixed_sequence_steps = sizes.Length,
+            actual_gap_p50_ms = gaps.Length == 0 ? 0 : gaps[gaps.Length / 2],
+            actual_gap_p95_ms = gaps.Length == 0 ? 0 : gaps[(int)Math.Floor((gaps.Length - 1) * .95)],
+            size_sequence = sizes.Take(step).Select(size => new { width = size.Width, height = size.Height }).ToArray(),
+            program_driven = true, native_mouse_drag = false };
+    }
+
+    public void Dispose() => timer.Dispose();
+}

diff --git a/src/UI/Rendering/RenderSession.cs b/src/UI/Rendering/RenderSession.cs
new file mode 100644
index 0000000..faf184f
--- /dev/null
+++ b/src/UI/Rendering/RenderSession.cs
@@ -0,0 +1,116 @@
+using System.Drawing.Imaging;
+using System.Runtime.InteropServices;
+
+namespace DiskAtlas;
+
+// One main window owns one budget, including bitmap fallback storage. Cached
+// native/managed aliases share pixels; allocation reserves before constructing.
+internal sealed class RenderSession
+{
+    internal const long MaxBytes = 128L * 1024 * 1024;
+    internal bool Requested { get; }
+    internal bool Active => Requested && failures < 3;
+    internal long Bytes { get; private set; }
+    internal long PeakBytes { get; private set; }
+    internal int Copies { get; private set; }
+    internal int Fallbacks { get; private set; }
+    internal int BudgetRejected { get; private set; }
+    internal Dictionary<NativeResizeFrame.CopyFailure, int> CopyFailureCounts { get; } = [];
+    private int failures;
+    internal RenderSession(bool enabled) => Requested = enabled;
+    internal bool Reserve(long bytes)
+    {
+        if (bytes <= 0 || bytes > MaxBytes - Bytes) { BudgetRejected++; return false; }
+        Bytes += bytes; PeakBytes = Math.Max(PeakBytes, Bytes); return true;
+    }
+    internal void Release(long bytes) => Bytes -= bytes;
+    internal void Copied() { Copies++; failures = 0; }
+    internal void Failed(bool unsupported = false) { Fallbacks++; if (!unsupported) failures++; }
+    internal void CopyFailed(NativeResizeFrame.CopyFailure code)
+    {
+        CopyFailureCounts[code] = CopyFailureCounts.GetValueOrDefault(code) + 1;
+        Failed(code is NativeResizeFrame.CopyFailure.GraphicsTransform or NativeResizeFrame.CopyFailure.TargetOrigin or
+            NativeResizeFrame.CopyFailure.GraphicsUnit);
+    }
+}
+
+internal sealed class PixelSurface : IDisposable
+{
+    private NativeResizeFrame? native;
+    private Bitmap? bitmap;
+    private RenderSession? session;
+    private readonly long bytes;
+    internal Bitmap Bitmap => bitmap ?? throw new ObjectDisposedException(nameof(PixelSurface));
+    internal bool Native => native != null;
+    private PixelSurface(Size size, int dpi, RenderSession? owner, bool gdiText)
+    {
+        // GDI text sealing uses one bounded 4KiB workspace; include its peak
+        // reservation rather than temporarily exceeding the window budget.
+        bytes = checked((long)size.Width * size.Height * 4 + (gdiText ? Math.Min(size.Width,1024)*4 : 0));
+        if (owner != null && !owner.Reserve(bytes)) throw new InvalidOperationException("PixelBudget");
+        session = owner;
+        try
+        {
+            if (owner?.Active == true || gdiText)
+            {
+                try { native = new NativeResizeFrame(size, dpi); bitmap = native.Bitmap; return; }
+                catch (Exception e) when (e is ArgumentException or ExternalException or InvalidOperationException or OutOfMemoryException)
+                { owner?.Failed(); if(gdiText) throw; }
+            }
+            bitmap = new Bitmap(size.Width, size.Height, PixelFormat.Format32bppPArgb);
+            bitmap.SetResolution(dpi, dpi);
+        }
+        catch { owner?.Release(bytes); session = null; throw; }
+    }
+    internal static PixelSurface? Create(Size size, int dpi, RenderSession? owner, bool gdiText = false)
+    {
+        if (size.Width <= 0 || size.Height <= 0) return null;
+        if (gdiText && owner is { Requested: true, Active: false }) return null;
+        try { return new PixelSurface(size, dpi, owner, gdiText); }
+        catch (Exception e) when (e is ArgumentException or ExternalException or InvalidOperationException or OutOfMemoryException) { return null; }
+    }
+    internal void RenderOpaque(Action<Graphics> paint)
+    {
+        if(native == null)throw new InvalidOperationException("NativeTextSurfaceRequired");
+        native.RenderOpaque(paint);
+    }
+    internal bool TryPublishLayered(IntPtr ownedSource) => native?.TryPublishLayered(ownedSource) == true;
+
+    internal bool TryCopy(Graphics target, Rectangle source, Point destination, Control? paintedControl = null)
+    {
+        if (native == null || session?.Active != true || source.Width <= 0 || source.Height <= 0) return false;
+        using (var transform = target.Transform)
+            if (!transform.IsIdentity)
+            { session.CopyFailed(NativeResizeFrame.CopyFailure.GraphicsTransform); return false; }
+        Point viewport = Point.Empty;
+        IntPtr dc = IntPtr.Zero;
+        try
+        {
+            dc = target.GetHdc();
+            // WinForms asks a parent to print its background into a child DC.
+            // Accept only a window actually in that parent's owned subtree.
+            var child = Control.FromHandle(WindowFromDC(dc));
+            if (child != null && paintedControl != null && child != paintedControl && paintedControl.Contains(child))
+                for (Control? node = child; node != null && node != paintedControl; node = node.Parent)
+                    viewport.Offset(-node.Left, -node.Top);
+        }
+        catch (Exception e) when (e is ArgumentException or ExternalException or InvalidOperationException)
+        { session.Failed(); return false; }
+        finally { if (dc != IntPtr.Zero) target.ReleaseHdc(dc); }
+        if (native.TryCopyTo(target, source, destination, viewport)) { session.Copied(); return true; }
+        session.CopyFailed(native.LastCopyFailure);
+        return false;
+    }
+    internal void Paint(Graphics target, Rectangle source, Point destination, Control? owner = null)
+    {
+        if (!TryCopy(target, source, destination, owner))
+            target.DrawImage(Bitmap, new Rectangle(destination, source.Size), source, GraphicsUnit.Pixel);
+    }
+    public void Dispose()
+    {
+        if (bitmap == null) return;
+        if (native != null) native.Dispose(); else bitmap.Dispose();
+        bitmap = null; native = null; session?.Release(bytes); session = null;
+    }
+    [DllImport("user32.dll")] private static extern IntPtr WindowFromDC(IntPtr dc);
+}
diff --git a/src/UI/Rendering/ResizeWorkProbe.cs b/src/UI/Rendering/ResizeWorkProbe.cs
new file mode 100644
index 0000000..879b348
--- /dev/null
+++ b/src/UI/Rendering/ResizeWorkProbe.cs
@@ -0,0 +1,72 @@
+using System.Diagnostics;
+
+namespace DiskAtlas;
+
+// Opt-in, UI-thread-only instrumentation for owned validation windows. Normal
+// operation keeps Current null. No paths, handles or arbitrary strings recorded.
+internal sealed class ResizeWorkProbe
+{
+    internal enum Work { None, PositionChanging, PositionChanged, Size, NonClient, Erase,
+        Wallpaper, RasterBuild, LayoutPresent, TreemapBuild, GridBuild, RootCover, ExposedCover }
+    [ThreadStatic] private static ResizeWorkProbe? currentProbe;
+    internal static ResizeWorkProbe? Current { get => currentProbe; set => currentProbe = value; }
+    private readonly long[,] ticks = new long[13, 13], counts = new long[13, 13], maxima = new long[13, 13];
+    private readonly List<(int Step, Size Size, Work Caller)> rasterKeys = [];
+    private readonly long[,] wallpaperTicks = new long[8, 256], wallpaperCalls = new long[8, 256];
+    private readonly long[] rootCache = new long[4];
+    internal enum CacheResult { Hit, KeyOrPolicy, Outside, ManagedHit }
+    internal static void Cache(CacheResult result) { if(Current is {} p)p.rootCache[(int)result]++; }
+    private long deferredPanels;
+    internal static void DeferredPanel() { if(Current is {} p)p.deferredPanels++; }
+    private Work current;
+    private int step;
+    internal int Dropped { get; private set; }
+    internal void BeginStep(int value) { if(value is < 0 or > 12)throw new ArgumentOutOfRangeException(nameof(value));step=value; }
+    internal static Scope Measure(Work work) => Current is { } probe && work != Work.None ? new(probe,work) : default;
+    internal static WallpaperScope MeasureWallpaper(Control control, int wash) => Current is { } probe
+        ? new(probe, control switch { Form => 0, WallpaperTable => 1, WallpaperSplitContainer => 2,
+            SplitterPanel => 3, WallpaperGrid => 4, TreemapControl => 5, _ => 6 }, Math.Clamp(wash,0,255)) : default;
+    internal static void RasterMiss(Size size)
+    {
+        if(Current is not { } probe)return;
+        if(probe.rasterKeys.Count<256)probe.rasterKeys.Add((probe.step,size,probe.current));else probe.Dropped++;
+    }
+    internal object Summary() => new
+    {
+        capacity_steps=12, capacity_raster_events=256, dropped=Dropped, inclusive_times=true,
+        steps=Enumerable.Range(1,12).Select(s=>new { step=s, phases=Enumerable.Range(1,12).Where(w=>counts[s,w]>0).Select(w=>new
+        { phase=((Work)w).ToString(), calls=counts[s,w], total_ms=ticks[s,w]*1000d/Stopwatch.Frequency, max_ms=maxima[s,w]*1000d/Stopwatch.Frequency }).ToArray() }).ToArray(),
+        raster_events=rasterKeys.Where(k=>k.Step>0).Select(k=>new {step=k.Step,width=k.Size.Width,height=k.Size.Height,caller=k.Caller.ToString()}).ToArray(),
+        wallpaper=Enumerable.Range(0,7).SelectMany(k=>Enumerable.Range(0,256).Where(a=>wallpaperCalls[k,a]>0)
+            .Select(a=>new {kind=new[]{"Root","Table","Split","SplitPanel","Grid","Map","Other"}[k],wash=a,
+                calls=wallpaperCalls[k,a],total_ms=wallpaperTicks[k,a]*1000d/Stopwatch.Frequency})).ToArray(),
+        root_cache=Enumerable.Range(0,4).Select(i=>new{code=((CacheResult)i).ToString(),count=rootCache[i]}).ToArray(),
+        deferred_panel_erases=deferredPanels
+    };
+    internal readonly struct WallpaperScope : IDisposable
+    {
+        private readonly ResizeWorkProbe? probe;
+        private readonly int kind, wash;
+        private readonly long started;
+        internal WallpaperScope(ResizeWorkProbe probe, int kind, int wash)
+        { this.probe=probe; this.kind=kind;this.wash=wash;started=Stopwatch.GetTimestamp(); }
+        public void Dispose()
+        { if(probe!=null){probe.wallpaperTicks[kind,wash]+=Stopwatch.GetTimestamp()-started;probe.wallpaperCalls[kind,wash]++;} }
+    }
+    internal readonly struct Scope : IDisposable
+    {
+        private readonly ResizeWorkProbe? probe;
+        private readonly Work work, previous;
+        private readonly int step;
+        private readonly long started;
+        internal Scope(ResizeWorkProbe probe, Work work)
+        { this.probe=probe;this.work=work;previous=probe.current;step=probe.step;started=Stopwatch.GetTimestamp();probe.current=work; }
+        public void Dispose()
+        {
+            if(probe==null)return;
+            long elapsed=Stopwatch.GetTimestamp()-started;
+            probe.ticks[step,(int)work]+=elapsed;probe.counts[step,(int)work]++;
+            probe.maxima[step,(int)work]=Math.Max(probe.maxima[step,(int)work],elapsed);probe.current=previous;
+        }
+    }
+}
diff --git a/src/UI/ResizePixelPolicy.cs b/src/UI/ResizePixelPolicy.cs
new file mode 100644
index 0000000..46a0267
--- /dev/null
+++ b/src/UI/ResizePixelPolicy.cs
@@ -0,0 +1,33 @@
+using System.Runtime.InteropServices;
+
+namespace DiskAtlas;
+
+// These surfaces sample window coordinates. Preserved pixels are invalid when
+// their geometry changes, even when Windows considers the client content reusable.
+internal static class ResizePixelPolicy
+{
+    internal static void Prepare(Control control, ref Message message)
+    {
+        // The top-level window must retain its last complete client pixels
+        // until the later geometry transaction presents the new surfaces.
+        // Never add or remove the caller's copy policy for that window.
+        if (control is Form || message.Msg != 0x0046 || message.LParam == IntPtr.Zero ||
+            control.FindForm()?.WindowState == FormWindowState.Minimized) return;
+        var position = Marshal.PtrToStructure<WindowPosition>(message.LParam);
+        bool moved = (position.Flags & 0x0002) == 0 &&
+            (position.X != control.Left || position.Y != control.Top);
+        bool resized = (position.Flags & 0x0001) == 0 &&
+            (position.Width != control.Width || position.Height != control.Height);
+        if (!resized && !moved) return;
+        position.Flags |= 0x0100; // SWP_NOCOPYBITS: invalidate instead of blitting old pixels.
+        Marshal.StructureToPtr(position, message.LParam, false);
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct WindowPosition
+    {
+        public IntPtr Handle, InsertAfter;
+        public int X, Y, Width, Height;
+        public uint Flags;
+    }
+}

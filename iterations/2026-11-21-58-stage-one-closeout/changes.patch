+                    batch.Root.Dirty = batch.Root.Control.ClientRectangle;
+                    continue;
+                }
+                var area = Rectangle.Intersect(batch.Root.Dirty.IsEmpty ? batch.Area : Rectangle.Union(batch.Area, batch.Root.Dirty), batch.Root.Control.ClientRectangle);

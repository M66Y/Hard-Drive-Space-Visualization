+        or Keys.PageUp or Keys.PageDown or Keys.Home or Keys.End or Keys.Tab or Keys.Enter;
+    protected override bool ProcessDataGridViewKey(KeyEventArgs e)
+    {
+        if (!MayScroll(e.KeyCode)) return base.ProcessDataGridViewKey(e);
+        bool handled = false;
+        PerformBufferedScroll(() => handled = base.ProcessDataGridViewKey(e));
+        return handled;
+    }
+    protected override bool ProcessDialogKey(Keys keyData)
+    {
+        if (!MayScroll(keyData)) return base.ProcessDialogKey(keyData);
+        bool handled = false;
+        PerformBufferedScroll(() => handled = base.ProcessDialogKey(keyData));
+        return handled;
+    }
+    protected override void WndProc(ref Message m)
+    {
+        ResizePixelPolicy.Prepare(this, ref m);
+        // Native child scrollbar messages reach the grid before ScrollWindow.
+        // Do not wrap WM_PAINT, ordinary movement or the entire main window.
+        if (m.Msg is 0x0114 or 0x0115)
+        {
+            var message = m;
+            PerformBufferedScroll(() => base.WndProc(ref message));
+            m = message;
+        }
+        else base.WndProc(ref m);
+    }
+
+    protected override void OnLocationChanged(EventArgs e)
+    {
+        base.OnLocationChanged(e);
+        ReleaseBackdrop();
+        Invalidate();
+    }
+
+    protected override void PaintBackground(Graphics graphics, Rectangle clipBounds, Rectangle gridBounds)
+    {
+        var saved = graphics.Save();
+        try
+        {
+            graphics.SetClip(clipBounds, CombineMode.Intersect);
+            if (GetBackdrop() is { } image)
+            {
+                graphics.CompositingMode = CompositingMode.SourceCopy;
+                if (backdropPixels?.TryCopy(graphics, new Rectangle(Point.Empty, image.Size), Point.Empty, this) != true)
+                    graphics.DrawImageUnscaled(image, 0, 0);
+            }
+            else Wallpaper.Paint(this, graphics, surface: WallpaperSurface.Data);
+        }
+        finally { graphics.Restore(saved); }
+    }
+
+    internal Rectangle ScrollbarCornerBounds
+    {
+        get
+        {
+            var horizontal = Controls.OfType<HScrollBar>().FirstOrDefault(bar => bar.Visible);
+            var vertical = Controls.OfType<VScrollBar>().FirstOrDefault(bar => bar.Visible);
+            return horizontal == null || vertical == null ? Rectangle.Empty :
+                Rectangle.Intersect(ClientRectangle, Rectangle.FromLTRB(vertical.Left, horizontal.Top, vertical.Right, horizontal.Bottom));
+        }
+    }
+
+    protected override void OnPaint(PaintEventArgs e)
+    {
+        base.OnPaint(e);
+        if (disposed || SystemInformation.HighContrast) return;
+        // DataGridView paints the two-scrollbar intersection with the system
+        // Control brush after PaintBackground. It is not part of either child
+        // scrollbar, so restore only that fixed-background corner afterwards.
+        var corner = Rectangle.Intersect(ScrollbarCornerBounds, e.ClipRectangle);
+        if (!corner.IsEmpty) PaintBackground(e.Graphics, corner, corner);
+    }
+
+    private Bitmap? GetBackdrop()
+    {
+        var form = FindForm();
+        var offset = Point.Empty;
+        for (Control? node = this; node != null && node != form; node = node.Parent) offset.Offset(node.Left, node.Top);
+        var key = new BackdropKey(ClientSize, form?.ClientSize ?? Size.Empty, offset, form?.BackgroundImage,
+            (form as MainForm)?.BackgroundCrop, DeviceDpi, Wallpaper.SurfaceAlpha(this, WallpaperSurface.Data),
+            Theme.Surface.ToArgb(), Theme.Background.ToArgb());
+        if (backdropKey == key) return backdrop;
+        if (rejectedBackdropKey == key) return null;
+        using var resizeWork = ResizeWorkProbe.Measure(ResizeWorkProbe.Work.GridBuild);
+        ReleaseBackdrop();
+        if (ClientSize.Width <= 0 || ClientSize.Height <= 0 || (long)ClientSize.Width * ClientSize.Height > MaxBackdropPixels)
+        { rejectedBackdropKey = key; return null; }
+        PixelSurface? candidate = null;
+        try
+        {
+            candidate = PixelSurface.Create(ClientSize, DeviceDpi, (form as MainForm)?.Rendering);
+            if (candidate == null) { rejectedBackdropKey = key; return null; }
+            using (var graphics = Graphics.FromImage(candidate.Bitmap))
+            {
+                graphics.Clear(Theme.Background);
+                Wallpaper.Paint(this, graphics, surface: WallpaperSurface.Data, nativeCopy: false);
+            }
+            backdropPixels = candidate; backdrop = candidate.Bitmap; candidate = null; backdropKey = key; BackdropBuilds++;
+            return backdrop;
+        }
+        catch (Exception error) when (error is OutOfMemoryException or ExternalException)
+        { rejectedBackdropKey = key; return null; }
+        finally { candidate?.Dispose(); }
+    }
+
+    private void ReleaseBackdrop()
+    {
+        backdropPixels?.Dispose(); backdropPixels = null; backdrop = null; backdropKey = rejectedBackdropKey = null;
+    }
+
+    internal void PaintCellSurface(DataGridViewCellPaintingEventArgs e)
+    {
+        if (e.Graphics == null) return;
+        var saved = e.Graphics.Save();
+        try
+        {
+            e.Graphics.SetClip(Rectangle.Intersect(e.CellBounds, e.ClipBounds), CombineMode.Intersect);
+            if (e.RowIndex >= 0 && (e.State & DataGridViewElementStates.Selected) != 0)
+            {
+                using var selection = new SolidBrush(Color.FromArgb(96, Theme.Selection));
+                e.Graphics.FillRectangle(selection, e.CellBounds);
+            }
+        }
+        finally { e.Graphics.Restore(saved); }
+    }
+
+    protected override void OnCellPainting(DataGridViewCellPaintingEventArgs e)
+    {
+        base.OnCellPainting(e);
+        if (e.Handled) return;
+        PaintCellSurface(e);
+        e.Paint(e.ClipBounds, e.PaintParts & (DataGridViewPaintParts.Border | DataGridViewPaintParts.ContentForeground |
+            DataGridViewPaintParts.ErrorIcon | DataGridViewPaintParts.Focus));
+        e.Handled = true;
+    }
+
+    protected override void OnSizeChanged(EventArgs e)
+    {
+        // A SizeChanged callback can already paint the new geometry. Retire
+        // the previous surface first, so that valid new cache survives base.
+        ReleaseBackdrop();
+        base.OnSizeChanged(e);
+    }
+    protected override void OnDpiChangedAfterParent(EventArgs e) { base.OnDpiChangedAfterParent(e); ReleaseBackdrop(); Invalidate(); }
+    protected override void OnParentChanged(EventArgs e) { base.OnParentChanged(e); ReleaseBackdrop(); }
+    protected override void OnHandleDestroyed(EventArgs e) { redrawHeldHandle = IntPtr.Zero; base.OnHandleDestroyed(e); ReleaseBackdrop(); }
+    protected override void OnVisibleChanged(EventArgs e)
+    {
+        base.OnVisibleChanged(e);
+        if (!Visible) ReleaseBackdrop();
+        else if (scrollDepth == 0) { RestoreRedraw(); PresentScroll(); }
+    }
+    protected override void Dispose(bool disposing)
+    {
+        if (disposing) { disposed = true; scrollbarSkin?.Dispose(); scrollbarSkin = null; ReleaseBackdrop(); }
+        base.Dispose(disposing);
+    }
+}
+
+internal sealed class WallpaperSplitContainer : SplitContainer
+{
+    // The experiment is instance-scoped and off in the normal application.
+    // Observation deliberately wraps the actual SplitterPanel message path:
+    // the counts below distinguish a parent paint invoked during its erase
+    // from an unrelated paint elsewhere in the window.
+    internal enum PanelBackgroundMode { Disabled, Observe, DirectWallpaper }
+    internal readonly record struct PanelBackgroundCounts(long Erases, long ParentBackgrounds,
+        long ParentForegrounds, long DirectPaints, long Fallbacks, long ElapsedTicks);
+    private PanelBackgroundMode panelBackgroundMode;
+    private PanelBackgroundWindow[]? panelBackgroundWindows;
+    private readonly long[,] panelBackgroundCounts = new long[2, 6];
+    private int panelEraseSource = -1;
+
+    internal PanelBackgroundMode BackgroundExperimentMode => panelBackgroundMode;
+    internal void ConfigurePanelBackgroundExperiment(PanelBackgroundMode mode)
+    {
+        ObjectDisposedException.ThrowIf(IsDisposed, this);
+        if (!Enum.IsDefined(mode)) throw new ArgumentOutOfRangeException(nameof(mode));
+        if (mode == panelBackgroundMode) return;
+        if (mode == PanelBackgroundMode.Disabled)
+        {
+            panelBackgroundMode = mode;
+            if (panelBackgroundWindows != null)
+                foreach (var window in panelBackgroundWindows) window.Dispose();
+            panelBackgroundWindows = null;
+        }
+        else if (panelBackgroundWindows == null)
+        {
+            PanelBackgroundWindow? first = null, second = null;
+            try
+            {
+                first = new(this, Panel1, 0);
+                second = new(this, Panel2, 1);
+                panelBackgroundWindows = [first, second];
+                panelBackgroundMode = mode;
+            }
+            catch
+            {
+                // Publish neither hook nor mode until both subscriptions
+                // succeed; a partially created experiment owns no handles.
+                second?.Dispose();
+                first?.Dispose();
+                throw;
+            }
+        }
+        else panelBackgroundMode = mode;
+    }
+    internal void ResetPanelBackgroundCounts() => Array.Clear(panelBackgroundCounts);
+    internal PanelBackgroundCounts GetPanelBackgroundCounts(int panel)
+    {
+        if (panel is < 1 or > 2) throw new ArgumentOutOfRangeException(nameof(panel));
+        int i = panel - 1;
+        return new(panelBackgroundCounts[i, 0], panelBackgroundCounts[i, 1], panelBackgroundCounts[i, 2],
+            panelBackgroundCounts[i, 3], panelBackgroundCounts[i, 4], panelBackgroundCounts[i, 5]);
+    }
+    protected override void WndProc(ref Message message)
+    {
+        ResizePixelPolicy.Prepare(this, ref message);
+        base.WndProc(ref message);
+    }
+    public WallpaperSplitContainer()
+    {
+        // Include AllPaintingInWmPaint so native background erases do not
+        // redraw the wallpaper before the buffered paint draws it again.
+        SetStyle(ControlStyles.OptimizedDoubleBuffer | ControlStyles.AllPaintingInWmPaint | ControlStyles.ResizeRedraw, true);
+        Panel1.BackColor = Color.Transparent;
+        Panel2.BackColor = Color.Transparent;
+    }
+    protected override void OnPaintBackground(PaintEventArgs e)
+    {
+        if (panelEraseSource >= 0) panelBackgroundCounts[panelEraseSource, 1]++;
+        Wallpaper.Paint(this, e.Graphics);
+    }
+    protected override void OnLocationChanged(EventArgs e)
+    {
+        base.OnLocationChanged(e);
+        Invalidate(true);
+    }
+    protected override void OnPaint(PaintEventArgs e)
+    {
+        if (panelEraseSource >= 0) panelBackgroundCounts[panelEraseSource, 2]++;
+        base.OnPaint(e);
+        var saved = e.Graphics.Save();
+        try
+        {
+            e.Graphics.SetClip(SplitterRectangle, CombineMode.Intersect);
+            Wallpaper.Paint(this, e.Graphics);
+        }
+        finally { e.Graphics.Restore(saved); }
+        if (Focused && ShowFocusCues && !IsSplitterFixed)
+        {
+            var focus = SplitterRectangle;
+            focus.Inflate(-1, -1);
+            if (focus.Width > 0 && focus.Height > 0)
+                ControlPaint.DrawFocusRectangle(e.Graphics, focus,
+                    SystemInformation.HighContrast ? SystemColors.ControlText : Theme.Text, Color.Transparent);
+        }
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+        if (disposing && panelBackgroundWindows != null)
+        {
+            foreach (var window in panelBackgroundWindows) window.Dispose();
+            panelBackgroundWindows = null;
+            panelBackgroundMode = PanelBackgroundMode.Disabled;
+        }
+        base.Dispose(disposing);
+    }
+
+    private sealed class PanelBackgroundWindow : NativeWindow, IDisposable
+    {
+        private readonly WallpaperSplitContainer owner;
+        private readonly SplitterPanel panel;
+        private readonly int index;
+        internal PanelBackgroundWindow(WallpaperSplitContainer owner, SplitterPanel panel, int index)
+        {
+            this.owner = owner; this.panel = panel; this.index = index;
+            try
+            {
+                panel.HandleCreated += Created;
+                panel.HandleDestroyed += Destroyed;
+                if (panel.IsHandleCreated) AssignHandle(panel.Handle);
+            }
+            catch { Dispose(); throw; }
+        }
+        private void Created(object? sender, EventArgs e)
+        {
+            if (Handle == IntPtr.Zero) AssignHandle(panel.Handle);
+        }
+        private void Destroyed(object? sender, EventArgs e)
+        {
+            if (Handle != IntPtr.Zero) ReleaseHandle();
+        }
+        protected override void WndProc(ref Message message)
+        {
+            if (message.Msg != 0x0014 || owner.panelBackgroundMode == PanelBackgroundMode.Disabled)
+            {
+                base.WndProc(ref message);
+                return;
+            }
+            long started = System.Diagnostics.Stopwatch.GetTimestamp();
+            owner.panelBackgroundCounts[index, 0]++;
+            int previousSource = owner.panelEraseSource;
+            owner.panelEraseSource = index;
+            try
+            {
+                if (owner.panelBackgroundMode == PanelBackgroundMode.DirectWallpaper &&
+                    message.WParam != IntPtr.Zero && owner.FindForm() is MainForm { Rendering.Active: true, IsGeometryPresentationPaused: true })
+                {
+                    // The outer geometry transaction always settles clips and
+                    // repaints these owned panels before it completes. Avoid
+                    // composing their intermediate bounds (which can extend
+                    // outside the new root); keep redraw ownership unchanged.
+                    ResizeWorkProbe.DeferredPanel();
+                    message.Result = new IntPtr(1);
+                    return;
+                }
+                if (owner.panelBackgroundMode == PanelBackgroundMode.DirectWallpaper &&
+                    message.WParam != IntPtr.Zero && panel.BackColor == Color.Transparent &&
+                    panel.BackgroundImage == null && !SystemInformation.HighContrast)
+                {
+                    // This sealed container's transparent panels only need
+                    // its wallpaper, not the split parent's foreground pass.
+                    // Paint in the panel's coordinates onto the supplied DC;
+                    // its native clip and the existing child Regions remain
+                    // authoritative. No cached old geometry is stretched.
+                    using var graphics = Graphics.FromHdc(message.WParam);
+                    Wallpaper.Paint(panel, graphics);
+                    owner.panelBackgroundCounts[index, 3]++;
+                    message.Result = new IntPtr(1);
+                    return;
+                }
+                if (owner.panelBackgroundMode == PanelBackgroundMode.DirectWallpaper)
+                    owner.panelBackgroundCounts[index, 4]++;
+                base.WndProc(ref message);
+            }
+            finally
+            {
+                owner.panelEraseSource = previousSource;
+                owner.panelBackgroundCounts[index, 5] += System.Diagnostics.Stopwatch.GetTimestamp() - started;
+            }
+        }
+        public void Dispose()
+        {
+            panel.HandleCreated -= Created;
+            panel.HandleDestroyed -= Destroyed;
+            if (Handle != IntPtr.Zero) ReleaseHandle();
+        }
+    }
 }

@@ -0,0 +1,36 @@
+namespace DiskAtlas;
+
+// Label.AutoEllipsis creates its own native tooltip. Draw visual truncation
+// without that provider; Text stays complete for accessible readers.
+internal sealed class NoHoverLabel : Label
+{
+    [System.ComponentModel.DefaultValue(false)]
+    internal bool WrapText { get; set; }
+    public NoHoverLabel() { AutoEllipsis = false; }
+
+    protected override void OnPaint(PaintEventArgs e)
+    {
+        var bounds = new Rectangle(Padding.Left, Padding.Top,
+            Math.Max(0, ClientSize.Width - Padding.Horizontal), Math.Max(0, ClientSize.Height - Padding.Vertical));
+        if (bounds.Width == 0 || bounds.Height == 0) return;
+        var flags = TextFormatFlags.NoPrefix | TextFormatFlags.PreserveGraphicsClipping;
+        flags |= WrapText ? TextFormatFlags.WordBreak | TextFormatFlags.TextBoxControl
+            : TextFormatFlags.SingleLine | TextFormatFlags.EndEllipsis;
+        flags |= TextAlign switch
+        {
+            ContentAlignment.TopCenter or ContentAlignment.MiddleCenter or ContentAlignment.BottomCenter => TextFormatFlags.HorizontalCenter,
+            ContentAlignment.TopRight or ContentAlignment.MiddleRight or ContentAlignment.BottomRight => TextFormatFlags.Right,
+            _ => TextFormatFlags.Left
+        };
+        flags |= TextAlign switch
+        {
+            ContentAlignment.MiddleLeft or ContentAlignment.MiddleCenter or ContentAlignment.MiddleRight => TextFormatFlags.VerticalCenter,
+            ContentAlignment.BottomLeft or ContentAlignment.BottomCenter or ContentAlignment.BottomRight => TextFormatFlags.Bottom,
+            _ => TextFormatFlags.Top
+        };
+        if (RightToLeft == RightToLeft.Yes) flags |= TextFormatFlags.RightToLeft;
+        TextRenderer.DrawText(e.Graphics, Text, Font, bounds,
+            SystemInformation.HighContrast ? Enabled ? SystemColors.ControlText : SystemColors.GrayText
+                : Enabled ? ForeColor : SystemColors.GrayText, flags);
+    }
+}
diff --git a/src/UI/Rendering/CompositionBackdrop.cs b/src/UI/Rendering/CompositionBackdrop.cs
new file mode 100644
index 0000000..4626d71
--- /dev/null
+++ b/src/UI/Rendering/CompositionBackdrop.cs
@@ -0,0 +1,180 @@
+using System.Runtime.InteropServices;
+
+namespace DiskAtlas;
+
+// Retains wallpaper in the compositor, behind every
+// child HWND. It never captures UI, changes root styles, or owns input.
+internal sealed class CompositionBackdrop : IDisposable
+{
+    internal enum State { Waiting, Active, Failed, Disposed }
+    private readonly Form owner;
+    private readonly int thread = Environment.CurrentManagedThreadId;
+    private IntPtr root, device, target, visual, content;
+    private Source? source;
+    private PixelSurface? published;
+    private bool disposed, publishing;
+    internal State Status { get; private set; }
+    internal bool Active => Status == State.Active;
+    internal int Publications { get; private set; }
+    internal int Generation { get; private set; }
+    internal Size PublishedSize { get; private set; }
+    internal IntPtr SourceHandle => source?.Handle ?? IntPtr.Zero;
+    internal int FailureCode { get; private set; }
+    internal Action<string>? TestFault { get; set; }
+
+    internal CompositionBackdrop(Form owner)
+    {
+        this.owner = owner;
+        owner.HandleDestroyed += Destroyed;
+    }
+
+    internal bool Publish(PixelSurface? frame)
+    {
+        if (disposed || publishing || Environment.CurrentManagedThreadId != thread || owner.IsDisposed || owner.Disposing) return false;
+        if (frame == null || !frame.Native || !owner.IsHandleCreated)
+        {
+            // An invalid frame cannot leave an old image attached to the root.
+            Detach(); return false;
+        }
+        if (Status == State.Failed) return false;
+        publishing = true;
+        IntPtr expectedRoot = owner.Handle;
+        int expectedGeneration = 0;
+        try
+        {
+            Trace("begin");
+            if (root != expectedRoot) { Detach(); root = expectedRoot; Generation++; }
+            expectedGeneration = Generation;
+            if (device == IntPtr.Zero) Initialize(expectedRoot, expectedGeneration);
+            Trace("initialized");
+            if (ReferenceEquals(frame, published)) return Active;
+            var size = frame.Bitmap.Size;
+            TestFault?.Invoke("publish");
+            Guard(expectedRoot, expectedGeneration);
+            if (!frame.TryPublishLayered(source!.Handle)) throw new COMException("BackdropUpload", Marshal.GetHRForLastWin32Error());
+            Trace("uploaded");
+            if (!IsWindowVisible(source.Handle)) ShowWindow(source.Handle, 4); // stays cloaked
+            Check(DwmGetWindowAttribute(source.Handle, 14, out int cloaked, sizeof(int)));
+            if (cloaked == 0) throw new COMException("BackdropCloakLost");
+            TestFault?.Invoke("commit");
+            Guard(expectedRoot, expectedGeneration);
+            Check(Call<NoArgs>(device, 3)(device));
+            Trace("committed");
+            Check(Call<NoArgs>(device, 4)(device));
+            Guard(expectedRoot, expectedGeneration);
+            Trace("ready");
+            published = frame;
+            PublishedSize = size;
+            Publications++;
+            Status = State.Active;
+            return true;
+        }
+        catch (RetiredPublication)
+        {
+            Detach();
+            Status = disposed ? State.Disposed : State.Waiting;
+            return false;
+        }
+        catch (Exception e) when (e is ExternalException or InvalidOperationException or ArgumentException or OutOfMemoryException or DllNotFoundException or EntryPointNotFoundException)
+        {
+            FailureCode = e.HResult;
+            Detach(); Status = State.Failed;
+            return false;
+        }
+        finally { publishing = false; }
+    }
+    private static void Trace(string stage)
+    {
+        if (AppContext.TryGetSwitch("AsukaLens.TraceComposition", out bool trace) && trace)
+            Console.WriteLine("COMPOSITION_STAGE " + stage);
+    }
+
+    private sealed class RetiredPublication : Exception { }
+    private void Guard(IntPtr expectedRoot, int expectedGeneration)
+    {
+        if (disposed || root != expectedRoot || Generation != expectedGeneration ||
+            !owner.IsHandleCreated || owner.Handle != expectedRoot)
+            throw new RetiredPublication();
+    }
+    private void Initialize(IntPtr expectedRoot, int expectedGeneration)
+    {
+        TestFault?.Invoke("device");
+        Guard(expectedRoot, expectedGeneration);
+        Guid iid = new("C37EA93A-E7AA-450D-B16F-9746CB0407F3");
+        Check(DCompositionCreateDevice(IntPtr.Zero, ref iid, out device));
+        source = new Source(root);
+        Guard(expectedRoot, expectedGeneration);
+        int cloak = 1;
+        Check(DwmSetWindowAttribute(source.Handle, 13, ref cloak, sizeof(int)));
+        TestFault?.Invoke("target");
+        Guard(expectedRoot, expectedGeneration);
+        Check(Call<CreateTarget>(device, 6)(device, root, 0, out target)); // below children
+        Check(Call<CreateObject>(device, 7)(device, out visual));
+        Check(Call<CreateWindowSurface>(device, 11)(device, source.Handle, out content));
+        Check(Call<SetObject>(visual, 15)(visual, content));
+        Check(Call<SetObject>(target, 3)(target, visual));
+    }
+
+    private void Destroyed(object? sender, EventArgs e)
+    {
+        Detach();
+        if (!disposed) Status = State.Waiting;
+    }
+    private void Detach()
+    {
+        Generation++;
+        if (target != IntPtr.Zero)
+        {
+            // Best effort on device loss; release our exact tree either way.
+            _ = Call<SetObject>(target, 3)(target, IntPtr.Zero);
+            if (device != IntPtr.Zero) _ = Call<NoArgs>(device, 3)(device);
+        }
+        Release(ref content); Release(ref visual); Release(ref target); Release(ref device);
+        source?.DestroyHandle(); source = null;
+        root = IntPtr.Zero; published = null; PublishedSize = Size.Empty;
+        if (!disposed && Status != State.Failed) Status = State.Waiting;
+    }
+    public void Dispose()
+    {
+        if (disposed) return;
+        if (Environment.CurrentManagedThreadId != thread) throw new InvalidOperationException("BackdropThread");
+        disposed = true;
+        owner.HandleDestroyed -= Destroyed;
+        Detach(); Status = State.Disposed;
+    }
+    private static void Release(ref IntPtr value)
+    {
+        var owned = value; value = IntPtr.Zero;
+        if (owned != IntPtr.Zero) Marshal.Release(owned);
+    }
+    private static void Check(int result) { if (result < 0) Marshal.ThrowExceptionForHR(result); }
+    // Slots follow the Windows SDK IDCompositionDevice/Target/Visual vtables.
+    private static T Call<T>(IntPtr instance, int slot) where T : Delegate =>
+        Marshal.GetDelegateForFunctionPointer<T>(Marshal.ReadIntPtr(Marshal.ReadIntPtr(instance), slot * IntPtr.Size));
+    [UnmanagedFunctionPointer(CallingConvention.StdCall)] private delegate int NoArgs(IntPtr self);
+    [UnmanagedFunctionPointer(CallingConvention.StdCall)] private delegate int CreateObject(IntPtr self, out IntPtr value);
+    [UnmanagedFunctionPointer(CallingConvention.StdCall)] private delegate int CreateTarget(IntPtr self, IntPtr hwnd, int topmost, out IntPtr value);
+    [UnmanagedFunctionPointer(CallingConvention.StdCall)] private delegate int CreateWindowSurface(IntPtr self, IntPtr hwnd, out IntPtr value);
+    [UnmanagedFunctionPointer(CallingConvention.StdCall)] private delegate int SetObject(IntPtr self, IntPtr value);
+
+    private sealed class Source : NativeWindow
+    {
+        internal Source(IntPtr root)
+        {
+            CreateHandle(new CreateParams { Caption = "AsukaLens owned backdrop", Parent = root,
+                Style = unchecked((int)0x80000000), ExStyle = 0x80000 | 0x80 | 0x8000000,
+                X = -32000, Y = -32000, Width = 1, Height = 1 });
+        }
+        protected override void WndProc(ref Message m)
+        {
+            if (m.Msg == 0x84) { m.Result = new IntPtr(-1); return; }
+            if (m.Msg == 0x21) { m.Result = new IntPtr(3); return; }
+            base.WndProc(ref m);
+        }
+    }
+    [DllImport("dcomp.dll")] private static extern int DCompositionCreateDevice(IntPtr dxgi, ref Guid iid, out IntPtr device);
+    [DllImport("dwmapi.dll")] private static extern int DwmSetWindowAttribute(IntPtr hwnd, int attribute, ref int value, int size);
+    [DllImport("dwmapi.dll")] private static extern int DwmGetWindowAttribute(IntPtr hwnd, int attribute, out int value, int size);
+    [DllImport("user32.dll")] private static extern bool ShowWindow(IntPtr hwnd, int command);
+    [DllImport("user32.dll")] private static extern bool IsWindowVisible(IntPtr hwnd);
+}
diff --git a/src/UI/Rendering/DesktopRendering.cs b/src/UI/Rendering/DesktopRendering.cs
new file mode 100644
index 0000000..6c30c58
--- /dev/null
+++ b/src/UI/Rendering/DesktopRendering.cs
@@ -0,0 +1,34 @@
+namespace DiskAtlas;
+
+// Ordinary startup uses the accepted composition path. Explicit developer
+// entries remain stable so archived candidates and pixel references keep their
+// original meaning; MainForm's test constructor is not silently changed.
+internal readonly record struct DesktopRendering(bool Dib, bool Opaque, bool Composition, bool CandidateLabel)
+{
+    internal static DesktopRendering Resolve(string[] args, string? executable)
+    {
+        string? selected = null;
+        foreach (string flag in new[] { "--legacy-rendering", "--dib-candidate", "--opaque-redirect-candidate", "--composition-dib-candidate" })
+        {
+            if (!args.Contains(flag, StringComparer.Ordinal)) continue;
+            if (selected != null) throw new ArgumentException("Choose one rendering option.");
+            selected = flag;
+        }
+        if (selected == null)
+            selected = Path.GetFileNameWithoutExtension(executable)?.ToUpperInvariant() switch
+            {
+                "ASUKALENS.DIBCANDIDATE" => "--dib-candidate",
+                "ASUKALENS.OPAQUEDIBCANDIDATE" => "--opaque-redirect-candidate",
+                "ASUKALENS.COMPOSITIONDIBCANDIDATE" => "--composition-dib-candidate",
+                _ => null
+            };
+        return selected switch
+        {
+            "--legacy-rendering" => new(false, false, false, false),
+            "--dib-candidate" => new(true, false, false, true),
+            "--opaque-redirect-candidate" => new(true, true, false, true),
+            "--composition-dib-candidate" => new(true, false, true, true),
+            _ => new(true, false, true, false)
+        };
+    }
+}
diff --git a/src/UI/Rendering/DibWindowCoverage.cs b/src/UI/Rendering/DibWindowCoverage.cs
new file mode 100644
index 0000000..9896b7d
--- /dev/null
+++ b/src/UI/Rendering/DibWindowCoverage.cs
@@ -0,0 +1,214 @@
+using System.Drawing.Drawing2D;
+using System.Runtime.InteropServices;
+
+namespace DiskAtlas;
+
+// Candidate-only coverage. Uses freshly rendered wallpaper at native client
+// geometry; never captures or stretches the last visible UI frame.
+internal sealed class DibWindowCoverage : IDisposable
+{
+    private readonly MainForm owner;
+    private const uint ClientDcFlags = 0x2 | 0x8 | 0x10; // CACHE | CLIPCHILDREN | CLIPSIBLINGS; never WINDOW.
+    private int depth;
+    private bool painting, disposed;
+    private PixelSurface? rootFrame;
+    private RootKey? rootKey;
+    private readonly record struct RootKey(Size Size, Image? Image, BackgroundView Crop, int Dpi,
+        int Surface, int Background, int Wash);
+    private readonly Dictionary<Control, Region> previous = [];
+    internal int EarlyCopies { get; private set; }
+    internal int ExposedCopies { get; private set; }
+    internal int EarlyVisible { get; private set; }
+    internal int EarlyBlack { get; private set; }
+    internal bool ObservePixels { get; set; }
+    // Controlled test comparison only; ordinary candidates use the cache.
+    internal bool UseRootCache { get; set; } = true;
+    internal DibWindowCoverage(MainForm owner) => this.owner = owner;
+
+    internal void Before(ref Message m)
+    {
+        if(disposed)return;
+        try { Begin(ref m); }
+        catch (Exception e) when (e is ArgumentException or ExternalException or InvalidOperationException or OutOfMemoryException)
+        { depth = 0; Clear(); }
+    }
+
+    private void Begin(ref Message m)
+    {
+        if (!owner.IsHandleCreated || owner.IsDisposed || owner.Disposing || IsIconic(owner.Handle)) return;
+        if (m.Msg == 0x0046 && m.LParam != IntPtr.Zero && GetWindowRect(owner.Handle, out var window) && GetClientRect(owner.Handle, out var client))
+        {
+            var pos = Marshal.PtrToStructure<Position>(m.LParam);
+            var next = new Size(pos.Width - (window.Right - window.Left - client.Right),
+                pos.Height - (window.Bottom - window.Top - client.Bottom));
+            if ((pos.Flags & 1) == 0 && next.Width > 0 && next.Height > 0 && next != new Size(client.Right, client.Bottom))
+            {
+                owner.WallpaperRaster.Get(owner.BackgroundImage, next, owner.BackgroundCrop);
+                // Prepare the already measured opaque composite BEFORE Windows
+                // exposes the new client area. Early coverage then only copies;
+                // its cost has moved, not disappeared from the resize total.
+                owner.PublishCompositionBackdrop(RootFrame(next));
+            }
+        }
+        if (m.Msg is 0x0085 or 0x0014 or 0x0047 or 0x0005) CoverRoot();
+        if (m.Msg is 0x0047 or 0x0005)
+        {
+            if (depth++ == 0) Capture(owner);
+        }
+    }
+
+    internal void After(ref Message m)
+    {
+        if (m.Msg == 0x83 && m.LParam != IntPtr.Zero && owner.CompositionBackdrop?.Active == true)
+        {
+            // WINDOWPOS's estimate uses the old non-client thickness. Windows
+            // returns the exact future client RECT here (including maximise /
+            // DPI border changes), before that destination area exists in GDI.
+            var client = Marshal.PtrToStructure<Rect>(m.LParam);
+            var exact = new Size(client.Right-client.Left, client.Bottom-client.Top);
+            if (exact.Width>0 && exact.Height>0) owner.PublishCompositionBackdrop(RootFrame(exact));
+        }
+        if (m.Msg is not (0x0047 or 0x0005) || depth == 0) return;
+        if (--depth != 0) return;
+        using var resizeWork = ResizeWorkProbe.Measure(ResizeWorkProbe.Work.ExposedCover);
+        try
+        {
+            foreach (var (control, region) in previous)
+            {
+                if (control.IsDisposed || !control.IsHandleCreated || !control.Visible || control.FindForm() != owner) continue;
+                foreach (Control child in control.Controls)
+                    if (child.Visible) AddChild(region, child, true);
+                region.Intersect(control.ClientRectangle);
+                IntPtr handle = control.Handle;
+                IntPtr dc = GetDCEx(handle, IntPtr.Zero, ClientDcFlags);
+                if (dc == IntPtr.Zero) { control.Invalidate(true); continue; }
+                try
+                {
+                    using var g = Graphics.FromHdc(dc);
+                    if (region.IsEmpty(g)) continue;
+                    g.SetClip(region, CombineMode.Intersect);
+                    if (control is WallpaperTable table) table.PaintExposed(g);
+                    else Wallpaper.Paint(control, g);
+                    ExposedCopies++;
+                }
+                finally { ReleaseDC(handle, dc); }
+            }
+        }
+        catch (Exception e) when (e is ArgumentException or ExternalException or InvalidOperationException or OutOfMemoryException)
+        { if (!owner.IsDisposed) owner.Invalidate(true); }
+        finally { Clear(); }
+    }
+
+    private void CoverRoot()
+    {
+        using var resizeWork = ResizeWorkProbe.Measure(ResizeWorkProbe.Work.RootCover);
+        if (painting || !GetClientRect(owner.Handle, out var size) || size.Right <= 0 || size.Bottom <= 0) return;
+        IntPtr handle = owner.Handle;
+        IntPtr dc = GetDCEx(handle, IntPtr.Zero, ClientDcFlags);
+        if (dc == IntPtr.Zero) return;
+        painting = true;
+        try
+        {
+            using var g = Graphics.FromHdc(dc);
+            var nativeSize = new Size(size.Right, size.Bottom);
+            // A native destination with many child-window holes makes each
+            // translucent GDI+ veil expensive. Composite that opaque root once
+            // at the exact geometry, then retain the destination's native clip.
+            var frame = RootFrame(nativeSize);
+            if (frame == null || !frame.TryCopy(g, new Rectangle(Point.Empty, nativeSize), Point.Empty, owner))
+                Wallpaper.Paint(owner, g, nativeSize: nativeSize);
+            g.Flush(System.Drawing.Drawing2D.FlushIntention.Sync);
+            int x = size.Right - 2, y = size.Bottom * 2 / 3;
+            if (ObservePixels && PtVisible(dc, x, y))
+            { EarlyVisible++; if ((GetPixel(dc, x, y) & 0xffffff) == 0) EarlyBlack++; }
+            EarlyCopies++;
+        }
+        catch (Exception e) when (e is ArgumentException or ExternalException or InvalidOperationException or OutOfMemoryException) { }
+        finally { painting = false; ReleaseDC(handle, dc); }
+    }
+    internal PixelSurface? RootFrame(Size size)
+    {
+        if(disposed || owner.IsDisposed || owner.Disposing)return null;
+        if(!UseRootCache || owner.Rendering?.Active != true) { ReleaseRoot(); return null; }
+        var key = new RootKey(size, owner.BackgroundImage, owner.BackgroundCrop, owner.DeviceDpi,
+            Theme.Surface.ToArgb(), Theme.Background.ToArgb(), Wallpaper.SurfaceAlpha(owner, WallpaperSurface.Ambient, 42));
+        if (key == rootKey && rootFrame != null) return rootFrame;
+        ReleaseRoot();
+        if (size.Width <= 0 || size.Height <= 0 || (long)size.Width * size.Height > WallpaperRaster.MaxPixels) return null;
+        PixelSurface? next = null;
+        try
+        {
+            next = PixelSurface.Create(size, owner.DeviceDpi, owner.Rendering);
+            if (next == null || !next.Native) return null;
+            using (var graphics = Graphics.FromImage(next.Bitmap))
+            {
+                graphics.Clear(Theme.Background);
+                Wallpaper.Paint(owner, graphics, nativeSize: size, nativeCopy: false);
+            }
+            rootFrame = next; rootKey = key; next = null;
+            return rootFrame;
+        }
+        catch (Exception e) when (e is ArgumentException or ExternalException or InvalidOperationException or OutOfMemoryException)
+        { return null; }
+        finally { next?.Dispose(); }
+    }
+    internal bool TryPaintCachedRoot(Control control, Graphics graphics, Size size, Point offset, int wash)
+    {
+        if(!UseRootCache || rootFrame == null || owner.Rendering?.Active != true || wash != 42 ||
+            control is NavigationPanel && owner.HasCustomBackground ||
+            rootKey != new RootKey(size,owner.BackgroundImage,owner.BackgroundCrop,owner.DeviceDpi,
+                Theme.Surface.ToArgb(),Theme.Background.ToArgb(),wash))
+        { ResizeWorkProbe.Cache(ResizeWorkProbe.CacheResult.KeyOrPolicy); return false; }
+        var source = new Rectangle(offset,control.ClientSize);
+        if(source.X<0 || source.Y<0 || source.Right>size.Width || source.Bottom>size.Height)
+        { ResizeWorkProbe.Cache(ResizeWorkProbe.CacheResult.Outside); return false; }
+        if(rootFrame.TryCopy(graphics,source,Point.Empty,control))
+        { ResizeWorkProbe.Cache(ResizeWorkProbe.CacheResult.Hit); return true; }
+        using(var transform=graphics.Transform)
+        {
+            var m=transform.Elements;
+            if(m[0]!=1 || m[1]!=0 || m[2]!=0 || m[3]!=1 ||
+                !float.IsFinite(m[4]) || !float.IsFinite(m[5]) || Math.Abs(m[4])>32768 || Math.Abs(m[5])>32768 ||
+                m[4]!=MathF.Truncate(m[4]) || m[5]!=MathF.Truncate(m[5]) || graphics.PageScale!=1 ||
+                graphics.PageUnit is not (GraphicsUnit.Pixel or GraphicsUnit.Display))return false;
+        }
+        // Transparent WinForms parent callbacks can carry a GDI+ translation.
+        // Preserve that mapping and clip rather than rebuilding wallpaper plus
+        // its translucent veil for every child. The exact opaque composite is
+        // valid for both publishers; native mapping guards remain unchanged.
+        graphics.DrawImage(rootFrame.Bitmap,new Rectangle(Point.Empty,source.Size),source,GraphicsUnit.Pixel);
+        ResizeWorkProbe.Cache(ResizeWorkProbe.CacheResult.ManagedHit);
+        return true;
+    }
+    private void ReleaseRoot() { rootFrame?.Dispose(); rootFrame = null; rootKey = null; }
+    private void Capture(Control control)
+    {
+        if (control.IsDisposed || !control.Visible) return;
+        if (control.HasChildren && control is not (DataGridView or InputFrame))
+        {
+            var region = new Region(); region.MakeEmpty();
+            foreach (Control child in control.Controls)
+                if (child.Visible) AddChild(region, child, false);
+            previous[control] = region;
+            foreach (Control child in control.Controls) Capture(child);
+        }
+    }
+    private static void AddChild(Region result, Control child, bool exclude)
+    {
+        using var shape = child.Region?.Clone() ?? new Region(new Rectangle(Point.Empty, child.Size));
+        shape.Intersect(new Rectangle(Point.Empty, child.Size));
+        shape.Translate(child.Left, child.Top);
+        if (exclude) result.Exclude(shape); else result.Union(shape);
+    }
+    private void Clear() { foreach (var region in previous.Values) region.Dispose(); previous.Clear(); }
+    public void Dispose() { disposed = true; depth = 0; Clear(); ReleaseRoot(); }
+    [StructLayout(LayoutKind.Sequential)] private struct Rect { internal int Left, Top, Right, Bottom; }
+    [StructLayout(LayoutKind.Sequential)] private struct Position { internal IntPtr Window, After; internal int X, Y, Width, Height; internal uint Flags; }
+    [DllImport("user32.dll")] private static extern bool GetClientRect(IntPtr hwnd, out Rect rect);
+    [DllImport("user32.dll")] private static extern bool GetWindowRect(IntPtr hwnd, out Rect rect);
+    [DllImport("user32.dll")] private static extern bool IsIconic(IntPtr hwnd);
+    [DllImport("user32.dll")] private static extern IntPtr GetDCEx(IntPtr hwnd, IntPtr region, uint flags);
+    [DllImport("user32.dll")] private static extern int ReleaseDC(IntPtr hwnd, IntPtr dc);
+    [DllImport("gdi32.dll")] private static extern bool PtVisible(IntPtr dc, int x, int y);
+    [DllImport("gdi32.dll")] private static extern uint GetPixel(IntPtr dc, int x, int y);
+}

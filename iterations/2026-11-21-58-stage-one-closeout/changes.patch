+            baseline_frame_boundary = "non-prototype-framecopied-is-root-wmpaint-exit-not-all-children",
+            mapping_audit = new { enabled = MappingAuditEnabled, mapping_limit = 128, root_limit = 1024, dropped = auditDropped,

+                paintedArea += area;
+                contained &= tile.Bounds.Width > 0 && tile.Bounds.Height > 0 &&
+                    tile.Bounds.Left >= bounds.Left - .01f && tile.Bounds.Top >= bounds.Top - .01f &&
+                    tile.Bounds.Right <= bounds.Right + .01f && tile.Bounds.Bottom <= bounds.Bottom + .01f;

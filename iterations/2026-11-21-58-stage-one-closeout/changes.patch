+                var area = child.Dirty; area.Offset(offset);
+                parent.Dirty = Rectangle.Union(parent.Dirty, area);
+                child.Dirty = Rectangle.Empty;
+            }
+            var batches = currentRoots.Where(root => !root.Dirty.IsEmpty && Ready(root.Control))

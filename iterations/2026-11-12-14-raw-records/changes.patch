index 0000000..f6a455f
--- /dev/null
+++ b/tests/Prototypes/Ntfs/NtfsMftMapTests.cs
@@ -0,0 +1,277 @@
+using System.Buffers.Binary;
+
+namespace DiskAtlas.NtfsPrototype;
+
+// Pure deterministic bytes and address plans only. No files, handles or native I/O.
+internal static class NtfsMftMapTests
+{
+    internal static int Run()
+    {
+        int passed = 0;
+        void Check(bool condition, string name)
+        {
+            if (!condition) throw new InvalidOperationException("NTFS MFT map check failed: " + name);
+            passed++; Console.WriteLine("PASS NTFS MFT map " + name);
+        }
+        void Rejected(Action action, string name)
+        {
+            bool rejected = false;
+            try { action(); } catch (InvalidDataException) { rejected = true; }
+            Check(rejected, name);
+        }
+        void Failed(byte[] bytes, NtfsMftGeometry geometry, string name, string? status = null)
+        {
+            var result = NtfsMftMap.Parse(bytes, geometry);
+            Check(result.Map == null && (result.Status is "Invalid" or "Unsupported") &&
+                (status == null || result.Status == status), name);
+            Check(result.Code.Length is > 0 and <= 80 && result.Code.All(c => char.IsAsciiLetterOrDigit(c) || c == '-'),
+                "failure uses only a bounded controlled code");
+        }
+        NtfsMftMap Mapped(byte[] bytes, NtfsMftGeometry geometry, string name)
+        {
+            var result = NtfsMftMap.Parse(bytes, geometry);
+            Check(result.Status == "Mapped" && result.Code == "Mapped" && result.Map != null, name);
+            return result.Map!;
+        }
+        var geometry = new NtfsMftGeometry(512, 4096, 1024, 1024 * 1024, 256, 10, 4096);
+        byte[] bytes = Record0();
+        byte[] original = (byte[])bytes.Clone();
+        var map = Mapped(bytes, geometry, "strict protected record zero creates a map");
+        Check(bytes.SequenceEqual(original), "parse leaves caller bytes unchanged");
+        Check(map.DataBytes == 4096 && map.InitializedBytes == 4096 && map.AllocatedBytes == 16384,
+            "logical initialized and allocated lengths stay distinct");
+        Check(map.Runs.SequenceEqual(new[] { new NtfsMftRun(0, 4, 10) }), "run representation preserves VCN length and LCN");
+        Check(map.PlanRecord(0).SequenceEqual(new[] { new NtfsRawSlice(40960, 1024, 0) }), "bootstrap slot maps to its verified native LCN");
+        Check(map.PlanRecord(3).SequenceEqual(new[] { new NtfsRawSlice(44032, 1024, 0) }), "final initialized record is addressable");
+        Rejected(() => map.PlanRecord(4), "record beyond native valid data length is rejected");
+        Rejected(() => map.PlanRecord(NtfsRecordDecoder.MaximumRecordNumber + 1), "full references cannot masquerade as slot numbers");
+        bool immutable = false;
+        try { ((IList<NtfsMftRun>)map.Runs)[0] = new(0, 4, 20); } catch (NotSupportedException) { immutable = true; }
+        Check(immutable, "run list cannot be edited by a consumer");
+        bytes[0] ^= 1;
+        Check(map.PlanRecord(0)[0].VolumeOffset == 40960, "map retains no caller buffer dependency");
+        Mapped(Record0(name: "$mFt"), geometry, "MFT name is compared ordinally without case");
+        Failed(Record0(name: "ordinary.bin"), geometry, "a different file cannot seed the MFT map", "Invalid");
+        Failed(Record0(nameSpace: 2), geometry, "a DOS-only MFT name cannot establish the seed", "Invalid");
+
+        var fragmented = Mapped(Record0([0x11, 2, 10, 0x11, 2, 250, 0], 3, 16384, 16384, 16384),
+            geometry with { MftValidDataLength = 16384 }, "negative LCN delta supports ordinary fragmentation");
+        Check(fragmented.Runs[1] == new NtfsMftRun(2, 2, 4), "negative LCN delta is sign extended");
+        Check(fragmented.PlanRecord(8).SequenceEqual(new[] { new NtfsRawSlice(16384, 1024, 0) }),
+            "slot addressing follows the MFT data stream instead of assumed contiguous storage");
+        foreach (long startLcn in new[] { (1L << 31) / 4096 + 1, (1L << 32) / 4096 + 1 })
+        {
+            var farGeometry = geometry with { VolumeBytes = 1L << 34, TotalClusters = (1L << 34) / 4096, MftStartLcn = startLcn };
+            byte[] farSource = Record0(WideInitialRun(startLcn, 4));
+            byte[] before = (byte[])farSource.Clone();
+            var farMap = Mapped(farSource, farGeometry, "physical addressing beyond signed and unsigned 32-bit offsets stays valid");
+            Check(farMap.PlanRecord(0).SequenceEqual(new[] { new NtfsRawSlice(startLcn * 4096, 1024, 0) }) &&
+                farMap.PlanRecord(3).SequenceEqual(new[] { new NtfsRawSlice(startLcn * 4096 + 3072, 1024, 0) }),
+                "far physical offset and intra-extent displacement retain all 64-bit address bits");
+            Check(farSource.SequenceEqual(before), "far addressing preserves the caller protected bytes");
+            Rejected(() => farMap.PlanRecord(4), "far physical address does not bypass native valid-length bounds");
+        }
+        var signedVectors = new (long Start, long End, byte[] EncodedDelta)[]
+        {
+            (1000, 700, [0x21, 2, 0xd4, 0xfe]), // -300, signed 16-bit.
+            (2_000_000, 1_900_000, [0x41, 2, 0x60, 0x79, 0xfe, 0xff]), // -100000, signed 32-bit.
+            (5_000_000_000, 2_000_000_000, [0x81, 2, 0x00, 0xa2, 0x2f, 0x4d, 0xff, 0xff, 0xff, 0xff]) // -3000000000, signed 64-bit.
+        };
+        foreach (var vector in signedVectors)
+        {
+            byte[] encoded = WideInitialRun(vector.Start, 2, vector.EncodedDelta);
+            byte[] signedSource = Record0(encoded, 3, 16384, 16384, 16384);
+            byte[] before = (byte[])signedSource.Clone();
+            var signedGeometry = geometry with { VolumeBytes = 32_768_000_000_000, TotalClusters = 8_000_000_000,
+                MftStartLcn = vector.Start, MftValidDataLength = 16384 };
+            var signedMap = Mapped(signedSource, signedGeometry, "multi-byte signed LCN deltas remain valid without overflow");
+            Check(signedMap.Runs.SequenceEqual(new[] { new NtfsMftRun(0, 2, vector.Start), new NtfsMftRun(2, 2, vector.End) }),
+                "signed delta maps to the independently specified backward physical extent");
+            Check(signedMap.PlanRecord(8).SequenceEqual(new[] { new NtfsRawSlice(vector.End * 4096, 1024, 0) }) &&
+                signedMap.PlanRecord(15).SequenceEqual(new[] { new NtfsRawSlice(vector.End * 4096 + 7168, 1024, 0) }),
+                "backward extent addresses and final record preserve exact 64-bit offsets");
+            Check(signedSource.SequenceEqual(before), "signed fragmented planning leaves caller bytes unchanged");
+            Rejected(() => signedMap.PlanRecord(16), "signed fragmented address does not bypass initialized-length bounds");
+        }
+        var adjacent = Mapped(Record0([0x11, 2, 10, 0x11, 2, 2, 0], 3), geometry,
+            "adjacent physical extents are permitted without overlap");
+        Check(adjacent.Runs.Count == 2, "validated extent identities are not silently merged");
+        var splitGeometry = geometry with { ClusterBytes = 512, TotalClusters = 2048 };
+        var split = Mapped(Record0([0x11, 3, 10, 0x11, 5, 250, 0], 7, 4096), splitGeometry,
+            "synthetic geometry permits a record spanning two extents");
+        var splitPlan = split.PlanRecord(1);
+        Check(splitPlan.SequenceEqual(new[] { new NtfsRawSlice(6144, 512, 0), new NtfsRawSlice(2048, 512, 512) }),
+            "split reads preserve logical order and exact destination offsets");
+        Check(splitPlan.Sum(x => x.Length) == splitGeometry.RecordBytes && splitPlan.All(x => x.Length > 0 && x.Length % 512 == 0),
+            "split plan fills exactly one sector-aligned record");
+        Failed(Record0([0x11, 1, 10, 0x11, 7, 10, 0], 7, 4096), splitGeometry,
+            "fragmentation inside bootstrap record zero is explicitly unsupported", "Unsupported");
+        Failed(Record0([0x11, 2, 10, 0x11, 2, 255, 0], 3), geometry,
+            "physical MFT runs cannot overlap", "Invalid");
+        Failed(Record0([0x11, 4, 11, 0], 3), geometry, "first run must match native MFT start", "Invalid");
+        Failed(Record0([0x11, 4, 254, 0], 3), geometry, "negative first physical address is rejected", "Invalid");
+        Failed(Record0([0x21, 4, 254, 0, 0], 3), geometry, "run ending beyond the volume is rejected", "Invalid");
+        Failed(Record0([0x11, 0, 10, 0], 3), geometry, "zero-length run is rejected", "Invalid");
+        Failed(Record0([0x01, 4, 0], 3), geometry, "a sparse run cannot supply physical MFT addresses", "Invalid");
+        Failed(Record0([0], 3), geometry, "empty mapping is rejected", "Invalid");
+        Failed(Record0([0x88, 1, 2, 3, 4, 5, 6, 7], 3), geometry, "truncated run integer is rejected", "Invalid");
+        Failed(Record0([0x11, 1, 10, 0x11, 1, 1, 0x11, 1], 3), geometry, "missing run terminator is rejected", "Invalid");
+        Failed(Record0([0x11, 3, 10, 0], 3), geometry, "VCN undercoverage is rejected", "Invalid");
+        Failed(Record0([0x11, 5, 10, 0], 3), geometry, "VCN overcoverage is rejected", "Invalid");
+        Failed(Record0([0x11, 4, 10, 0], 3, 8192), geometry, "allocated length must match the complete map", "Invalid");
+        Failed(Record0([0x81, 1, 255, 255, 255, 255, 255, 255, 255, 127, 0], 0, 4096, 1024, 1024),
+            geometry with { MftValidDataLength = 1024 }, "LCN end arithmetic overflow is controlled", "Invalid");
+
+        var many = new List<byte>();
+        for (int i = 0; i < NtfsMftMap.MaxRuns; i++) many.AddRange(new byte[] { 0x11, 1, (byte)(i == 0 ? 10 : 1) });
+        many.Add(0);
+        Check(Mapped(Record0(many.ToArray(), 127, 128L * 4096), geometry, "exact maximum run count is accepted").Runs.Count == 128,
+            "all maximum-budget extents are retained");
+        many.RemoveAt(many.Count - 1); many.AddRange(new byte[] { 0x11, 1, 1, 0 });
+        Failed(Record0(many.ToArray(), 128, 129L * 4096), geometry, "excess run count is unsupported rather than truncated", "Unsupported");
+        var lengthMap = Mapped(Record0(size: 8192, initialized: 6144), geometry, "native initialized data may be shorter than EOF and allocation");
+        Check(lengthMap.DataBytes == 8192 && lengthMap.InitializedBytes == 6144 && lengthMap.PlanRecord(3).Count == 1,
+            "all three length bounds are preserved");
+        Rejected(() => lengthMap.PlanRecord(4), "native initialized boundary limits otherwise covered records");
+        Failed(Record0(initialized: 2048), geometry, "native valid length cannot exceed DATA initialization", "Invalid");
+        Failed(Record0(size: 4096, initialized: 5120), geometry, "initialization beyond EOF is rejected", "Invalid");
+        Failed(Record0(size: 4608), geometry, "partial MFT record EOF is rejected", "Invalid");
+        Failed(Record0(initialized: 3584), geometry with { MftValidDataLength = 3072 }, "partial initialized MFT record is rejected", "Invalid");
+        Failed(Record0(size: 0, initialized: 0), geometry, "empty MFT data cannot seed record zero", "Invalid");
+
+        var invalidGeometry = new[] {
+            geometry with { ClusterBytes = 0 }, geometry with { ClusterBytes = 3072 }, geometry with { ClusterBytes = 131072 },
+            geometry with { RecordBytes = 512 }, geometry with { RecordBytes = 1025 }, geometry with { RecordBytes = 66048 },
+            geometry with { VolumeBytes = -1 }, geometry with { VolumeBytes = 1048577 }, geometry with { TotalClusters = 0 },
+            geometry with { TotalClusters = 257 }, geometry with { TotalClusters = long.MaxValue }, geometry with { MftStartLcn = -1 },
+            geometry with { MftStartLcn = 256 }, geometry with { MftValidDataLength = 0 }, geometry with { MftValidDataLength = 1025 }
+        };
+        foreach (var bad in invalidGeometry) Failed(Record0(), bad, "invalid geometry is rejected before addressing", "Invalid");
+        Failed(Record0(), null!, "null geometry is a controlled input failure", "Invalid");
+        Failed(Record0(), geometry with { VolumeBytes = 512, TotalClusters = 1, ClusterBytes = 512, MftStartLcn = 0 },
+            "bootstrap record cannot extend past the volume", "Invalid");
+        Failed(Record0(), geometry with { SectorBytes = 4096 }, "other fixup stride remains unsupported", "Unsupported");
+        Failed(new byte[1023], geometry, "short record source is rejected", "Invalid");
+        Failed(new byte[65537], geometry, "record source exceeding 64 KiB is rejected", "Invalid");
+        Failed(Record0(extra: NtfsRecordFixtures.Resident(0x20, [])), geometry, "attribute lists require a separate implementation", "Unsupported");
+        Failed(Record0(extra: NtfsRecordFixtures.Data(0, "meta")), geometry, "named DATA does not silently broaden supported MFT form", "Unsupported");
+        Failed(Record0(extra: NtfsRecordFixtures.Nonresident(4096, 16384)), geometry, "duplicate unnamed DATA remains unsupported", "Unsupported");
+        Failed(Record0(baseReference: 7), geometry, "an extension cannot seed the MFT map", "Unsupported");
+        Failed(Record0(flags: 1), geometry, "compressed MFT DATA is unsupported", "Unsupported");
+        Failed(Record0(flags: 0x8000), geometry, "sparse MFT DATA is unsupported", "Unsupported");
+        Failed(Record0(flags: 0x4000), geometry, "encrypted MFT DATA is unsupported", "Unsupported");
+        Failed(Record0(lowVcn: 1, highVcn: 4), geometry, "continuation VCN cannot masquerade as a complete map", "Unsupported");
+        Failed(NtfsRecordFixtures.Record([NtfsRecordFixtures.Name("$MFT"), NtfsRecordFixtures.Data(0)]), geometry,
+            "resident DATA is outside the MFT mapping contract", "Unsupported");
+        Failed(NtfsRecordFixtures.Record([NtfsRecordFixtures.Name("$MFT")]), geometry,
+            "missing DATA does not become an empty map", "Unsupported");
+        var unusualUnit = Record0();
+        NtfsRecordFixtures.U16(unusualUnit, NtfsRecordFixtures.FirstAttribute + NtfsRecordFixtures.Name("$MFT").Length + 34, 1);
+        Failed(unusualUnit, geometry, "ordinary DATA cannot carry a compression unit", "Unsupported");
+        var directory = Record0(); NtfsRecordFixtures.U16(directory, 22, 3);
+        Failed(directory, geometry, "directory metadata cannot seed MFT mapping", "Unsupported");
+        var free = Record0(); NtfsRecordFixtures.U16(free, 22, 0);
+        Failed(free, geometry, "a free record cannot seed MFT mapping", "Invalid");
+        var unknownSignature = Record0(); unknownSignature[0] = (byte)'X';
+        Failed(unknownSignature, geometry, "invalid signature cannot establish a map", "Invalid");
+        var damaged = Record0(); damaged[510] ^= 1;
+        Failed(damaged, geometry, "strict raw USA damage remains rejected", "Invalid");
+        var restored = Restore(Record0());
+        Failed(restored, geometry, "already restored logical bytes cannot enter the raw parser", "Invalid");
+
+        var largeGeometry = new NtfsMftGeometry(512, 65536, 65536, 16 * 1024 * 1024, 256, 10, 65536);
+        var large = Mapped(Enlarge(Record0(allocated: 4L * 65536, size: 65536, initialized: 65536), 65536), largeGeometry,
+            "exact 64 KiB source endpoint is accepted");
+        Rejected(() => large.PlanRecord(NtfsRecordDecoder.MaximumRecordNumber), "slot multiplication overflow is a controlled failure");
+
+        // DATA starts at 496: its instance ID lies exactly at the first protected tail.
+        byte[] crossing = Record0(crossingInstance: true);
+        var crossingRestored = Restore(crossing);
+        Check(BinaryPrimitives.ReadUInt32LittleEndian(crossingRestored.AsSpan(496)) == 0x80 &&
+            BinaryPrimitives.ReadUInt16LittleEndian(crossingRestored.AsSpan(510)) == 3,
+            "regression fixture puts the DATA instance ID exactly at byte 510");
+        Mapped(crossing, geometry, "properly protected crossing instance remains strict raw success");
+        var logical = (byte[])crossingRestored.Clone();
+        BinaryPrimitives.WriteUInt16LittleEndian(logical.AsSpan(510), 4);
+        Check(NtfsRecordDecoder.DecodeKernelReturned(logical, 512, 0, 4096, 3, 1).Code == "FixupMismatch",
+            "independent logical ID cannot bypass the unchanged kernel USA contract");
+        Failed(logical, geometry, "the MFT map does not repair mismatched kernel logic into raw evidence", "Invalid");
+        byte[] logicalBefore = (byte[])logical.Clone();
+        var mechanical = Restore(logical);
+        Failed(mechanical, geometry, "mechanical replacement is still not a protected raw source", "Invalid");
+        Check(logical.SequenceEqual(logicalBefore), "examining a replacement copy never alters the original strict failure");
+        using var cancellation = new CancellationTokenSource(); cancellation.Cancel();
+        bool parseCanceled = false, planCanceled = false;
+        try { NtfsMftMap.Parse(original, geometry, cancellation.Token); } catch (OperationCanceledException) { parseCanceled = true; }
+        try { map.PlanRecord(0, cancellation.Token); } catch (OperationCanceledException) { planCanceled = true; }
+        Check(parseCanceled && planCanceled && original.SequenceEqual(Record0()), "cancellation throws without publishing partial state or changing source");
+        return passed;
+    }
+
+    private static byte[] Record0(byte[]? runs = null, ulong highVcn = 3, long allocated = 16384,
+        long size = 4096, long initialized = 4096, string name = "$MFT", byte nameSpace = 1,
+        byte[]? extra = null, ulong baseReference = 0, ushort flags = 0, ulong lowVcn = 0, bool crossingInstance = false)
+    {
+        byte[] data = Data(runs ?? [0x11, 4, 10, 0], highVcn, allocated, size, initialized, flags, lowVcn);
+        var attributes = new List<byte[]> { NtfsRecordFixtures.Name(name, nameSpace) };
+        if (crossingInstance)
+        {
+            attributes.Add(NtfsRecordFixtures.Resident(0x10, new byte[48]));
+            attributes.Add(NtfsRecordFixtures.Resident(0x40, new byte[240]));
+        }
+        attributes.Add(data);
+        if (extra != null) attributes.Add(extra);
+        return NtfsRecordFixtures.Record(attributes, baseReference: baseReference, addStandard: !crossingInstance);
+    }
+
+    private static byte[] Data(byte[] runs, ulong highVcn, long allocated, long size, long initialized, ushort flags, ulong lowVcn)
+    {
+        int header = (flags & 0x8001) != 0 ? 72 : 64;
+        var attribute = new byte[NtfsRecordFixtures.Align(header + runs.Length)];
+        NtfsRecordFixtures.U32(attribute, 0, 0x80); NtfsRecordFixtures.U32(attribute, 4, (uint)attribute.Length); attribute[8] = 1;
+        NtfsRecordFixtures.U16(attribute, 12, flags); NtfsRecordFixtures.U64(attribute, 16, lowVcn); NtfsRecordFixtures.U64(attribute, 24, highVcn);
+        NtfsRecordFixtures.U16(attribute, 32, (ushort)header); NtfsRecordFixtures.U16(attribute, 34, (flags & 1) != 0 ? (ushort)4 : (ushort)0);
+        NtfsRecordFixtures.U64(attribute, 40, unchecked((ulong)allocated)); NtfsRecordFixtures.U64(attribute, 48, unchecked((ulong)size));
+        NtfsRecordFixtures.U64(attribute, 56, unchecked((ulong)initialized));
+        if (header == 72) NtfsRecordFixtures.U64(attribute, 64, unchecked((ulong)allocated));
+        runs.CopyTo(attribute, header);
+        return attribute;
+    }
+
+    private static byte[] WideInitialRun(long firstLcn, byte clusters, byte[]? followingRun = null)
+    {
+        // Deliberately use the full signed 64-bit initial LCN encoding; following
+        // negative encodings above are independent literal regression vectors.
+        byte[] first = new byte[10]; first[0] = 0x81; first[1] = clusters;
+        BinaryPrimitives.WriteInt64LittleEndian(first.AsSpan(2), firstLcn);
+        return first.Concat(followingRun ?? []).Append((byte)0).ToArray();
+    }
+
+    private static byte[] Restore(byte[] source)
+    {
+        byte[] copy = (byte[])source.Clone();
+        int usa = BinaryPrimitives.ReadUInt16LittleEndian(copy.AsSpan(4)), count = BinaryPrimitives.ReadUInt16LittleEndian(copy.AsSpan(6));
+        for (int i = 1; i < count; i++)
+            BinaryPrimitives.WriteUInt16LittleEndian(copy.AsSpan(i * 512 - 2), BinaryPrimitives.ReadUInt16LittleEndian(copy.AsSpan(usa + i * 2)));
+        return copy;
+    }
+
+    private static byte[] Enlarge(byte[] source, int length)
+    {
+        byte[] restored = Restore(source), result = new byte[length];
+        restored.AsSpan(0, 48).CopyTo(result);
+        int oldFirst = BinaryPrimitives.ReadUInt16LittleEndian(restored.AsSpan(20));
+        int oldUsed = checked((int)BinaryPrimitives.ReadUInt32LittleEndian(restored.AsSpan(24)));
+        int count = length / 512 + 1, first = NtfsRecordFixtures.Align(48 + count * 2);
+        restored.AsSpan(oldFirst, oldUsed - oldFirst).CopyTo(result.AsSpan(first));
+        NtfsRecordFixtures.U16(result, 4, 48); NtfsRecordFixtures.U16(result, 6, (ushort)count); NtfsRecordFixtures.U16(result, 20, (ushort)first);
+        NtfsRecordFixtures.U32(result, 24, (uint)(first + oldUsed - oldFirst)); NtfsRecordFixtures.U32(result, 28, (uint)length);
+        NtfsRecordFixtures.U16(result, 48, 0xa55a);
+        for (int i = 1; i < count; i++)
+        {
+            ushort tail = BinaryPrimitives.ReadUInt16LittleEndian(result.AsSpan(i * 512 - 2));
+            NtfsRecordFixtures.U16(result, 48 + i * 2, tail); NtfsRecordFixtures.U16(result, i * 512 - 2, 0xa55a);
+        }
+        return result;
+    }
+}
diff --git a/tests/Prototypes/Ntfs/NtfsRawComparison.cs b/tests/Prototypes/Ntfs/NtfsRawComparison.cs
new file mode 100644
index 0000000..cbe7229
--- /dev/null
+++ b/tests/Prototypes/Ntfs/NtfsRawComparison.cs
@@ -0,0 +1,198 @@
+using Microsoft.Win32.SafeHandles;
+
+namespace DiskAtlas.NtfsPrototype;
+
+// Private fixture context. Paths and full identities never enter the report.
+internal sealed record NtfsRawTarget(string CaseId, string Path, string ParentPath,
+    FileStorageInfo Storage, FileStorageInfo ParentStorage, FileAttributes Attributes);
+internal sealed record NtfsRawVolumeFacts(NtfsMftGeometry Geometry, ulong Serial, int PhysicalSectorBytes);
+internal sealed record NtfsRawComparisonCase(string CaseId, string Kind, int NameLength, string KernelCode,
+    string RawCode, bool IdentityMatched, bool LogicalMatched, bool LinksMatched, bool NamesMatched, string AllocationCheck);
+internal sealed record NtfsRawComparisonReport(string Revision, int Objects, int KernelRequests, int KernelDecoded,
+    int KernelRejected, int RawRecords, int RawDecoded, int MatchedObjects, int UnknownAllocationObjects,
+    int MftRuns, int ReadCalls, long RequestedBytes, int PhysicalSectorBytes, bool LockAcquired,
+    bool UnlockSucceeded, bool PostNativeStable, IReadOnlyList<NtfsRawComparisonCase> Cases);
+
+// Test-only orchestration. The caller has proved image/volume ownership and has
+// closed every fixture file before entering. No production or arbitrary-volume API.
+internal static class NtfsRawComparison
+{
+    internal static NtfsRawComparisonReport Run(SafeFileHandle volume, IReadOnlyList<NtfsRawTarget> targets,
+        NtfsKernelMatrixReport kernel, NtfsRawVolumeFacts facts, Func<NtfsRawVolumeFacts> refreshFacts,
+        Action<bool, string> check, CancellationToken token = default)
+    {
+        void Require(bool condition, string code)
+        { check(condition, code); if (!condition) throw new InvalidDataException(code); }
+        token.ThrowIfCancellationRequested();
+        Require(targets.Count == 21 && targets.Count < 32 && kernel.Objects == targets.Count && kernel.Requests == 63,
+            "RawFixedTargetBudget");
+        Require(facts.Geometry is { SectorBytes: 512, ClusterBytes: 4096, RecordBytes: 1024 }, "RawFixtureGeometry");
+        Require(targets.Select(item => item.CaseId).Distinct(StringComparer.Ordinal).Count() == targets.Count &&
+            targets.Select(item => item.Storage.Identity).Distinct().Count() == targets.Count, "RawUniqueTargets");
+        var descriptors = NtfsKernelMatrix.Cases.ToDictionary(item => item.CaseId, StringComparer.Ordinal);
+        var kernelFinal = kernel.Rows.Where(item => item.Stage == "Flushed")
+            .ToDictionary(item => item.CaseId[..^"-Flushed".Length], StringComparer.Ordinal);
+        foreach (var target in targets)
+        {
+            token.ThrowIfCancellationRequested();
+            Require(descriptors.ContainsKey(target.CaseId) && kernelFinal.ContainsKey(target.CaseId), "RawKnownTarget");
+            Require(target.Storage.Identity.Volume == facts.Serial && target.Storage.Identity.High == 0 &&
+                target.Storage.Identity.Low >> 48 != 0 && target.ParentStorage.Identity.Volume == facts.Serial &&
+                target.ParentStorage.Identity.High == 0 && target.ParentStorage.Identity.Low >> 48 != 0 &&
+                !target.Storage.WritableHandleOpen && target.Storage.Modified.HasValue, "RawTargetNativeIdentity");
+        }
+
+        NtfsRawVolumeLease? lease = null;
+        NtfsMftMap? map = null;
+        int rawDecoded = 0, unknown = 0;
+        var rows = new List<NtfsRawComparisonCase>(21);
+        try
+        {
+            lease = NtfsRawVolumeLease.Acquire(volume, facts.Geometry.VolumeBytes,
+                facts.Geometry.SectorBytes, facts.PhysicalSectorBytes, token);
+            Require(true, "RawLockAcquired");
+            long bootstrap = checked(facts.Geometry.MftStartLcn * facts.Geometry.ClusterBytes);
+            byte[] raw0 = lease.Read(bootstrap, facts.Geometry.RecordBytes, token);
+            var parsed = NtfsMftMap.Parse(raw0, facts.Geometry, token);
+            Require(parsed.Status == "Mapped" && parsed.Map != null, "RawMftMap-" + parsed.Code);
+            map = parsed.Map!;
+            var bootstrapPlan = map.PlanRecord(0, token);
+            Require(bootstrapPlan.Count == 1 && bootstrapPlan[0].VolumeOffset == bootstrap &&
+                bootstrapPlan[0].Length == facts.Geometry.RecordBytes && bootstrapPlan[0].RecordOffset == 0,
+                "RawBootstrapReverseBinding");
+            rawDecoded++;
+            foreach (var target in targets)
+            {
+                token.ThrowIfCancellationRequested();
+                var descriptor = descriptors[target.CaseId];
+                ulong slot = target.Storage.Identity.Low & NtfsRecordDecoder.MaximumRecordNumber;
+                byte[] raw = new byte[facts.Geometry.RecordBytes];
+                int copied = 0;
+                foreach (var slice in map.PlanRecord(slot, token))
+                {
+                    token.ThrowIfCancellationRequested();
+                    Require(slice.RecordOffset == copied && slice.Length > 0 && slice.Length <= raw.Length - copied,
+                        "RawSliceCoverage");
+                    byte[] bytes = lease.Read(slice.VolumeOffset, slice.Length, token);
+                    bytes.CopyTo(raw, slice.RecordOffset); copied += bytes.Length;
+                }
+                Require(copied == raw.Length, "RawCompleteRecordRead");
+                var result = NtfsRecordDecoder.Decode(raw, facts.Geometry.SectorBytes, token: token,
+                    recordNumber: slot, clusterSize: facts.Geometry.ClusterBytes);
+                Require(result.Status == NtfsDecodeStatus.Decoded && result.Record != null, "RawStrict-" + result.Code);
+                var record = result.Record!;
+                bool identity = record.Reference == target.Storage.Identity.Low && record.BaseReference == 0 && !record.IsDirectory;
+                bool logical = record.LogicalBytes == target.Storage.LogicalBytes;
+                bool links = MatchesLinks(record, target.Storage.LinkCount);
+                bool names = MatchesNames(record, target.ParentStorage.Identity.Low, descriptor);
+                Require(identity && logical && links && names, "RawRecordMatchesNativeContext");
+                Require(MatchesLookupReasons(record, descriptor), "RawLookupReasonsMatchFixture");
+                string allocation;
+                if (descriptor.Kind == "Ordinary")
+                {
+                    Require(record.AllocatedBytes.HasValue && record.AllocatedBytes == target.Storage.AllocatedBytes,
+                        "RawDirectAllocationMatches");
+                    allocation = "Matched";
+                }
+                else
+                {
+                    NtfsLookupReason expected = descriptor.Kind == "Compressed" ? NtfsLookupReason.Compressed : NtfsLookupReason.Sparse;
+                    Require(record.LookupReasons.HasFlag(expected) && record.AllocatedBytes == null,
+                        "RawSpecialAllocationRemainsUnknown");
+                    unknown++; allocation = "Unknown";
+                }
+                rawDecoded++;
+                rows.Add(new(target.CaseId, descriptor.Kind, descriptor.NameLength, kernelFinal[target.CaseId].Code,
+                    result.Code, identity, logical, links, names, allocation));
+            }
+        }
+        catch (NtfsRawVolumeException error)
+        {
+            Require(false, "RawNative-" + error.Code + "-" + error.NativeErrorCode);
+            throw;
+        }
+        finally
+        {
+            lease?.Dispose();
+        }
+        Require(lease != null && lease.UnlockSucceeded, "RawUnlockSucceeded");
+        token.ThrowIfCancellationRequested();
+        foreach (var target in targets)
+        {
+            token.ThrowIfCancellationRequested();
+            Require(File.GetAttributes(target.Path) == target.Attributes &&
+                NativeStorage.TryRead(target.Path, false, target.Attributes, out var after, out _) && after == target.Storage,
+                "RawPostNativeObjectStable");
+            Require(NativeStorage.TryRead(target.ParentPath, true, File.GetAttributes(target.ParentPath), out var parent, out _) &&
+                parent != null && parent.Identity == target.ParentStorage.Identity, "RawPostNativeParentStable");
+            var descriptor = descriptors[target.CaseId];
+            FileStorageInfo? ReadAlias(string path)
+            {
+                var attributes = File.GetAttributes(path);
+                if ((attributes & FileAttributes.ReparsePoint) != 0) return null;
+                return NativeStorage.TryRead(path, false, attributes, out var info, out _) ? info : null;
+            }
+            Require(MatchesPostAlias(target, descriptor, ReadAlias), "RawPostNativeAliasStable");
+            if (descriptor.NamedStream)
+            {
+                using var stream = new FileStream(target.Path + ":meta", FileMode.Open, FileAccess.Read, FileShare.Read);
+                ReadOnlySpan<byte> expected = "synthetic named stream"u8;
+                Require(stream.Length == expected.Length, "RawPostNamedStreamLength");
+                var bytes = new byte[expected.Length]; stream.ReadExactly(bytes);
+                Require(bytes.AsSpan().SequenceEqual(expected), "RawPostNamedStreamContent");
+            }
+            token.ThrowIfCancellationRequested();
+        }
+        var afterFacts = ReadFinalFacts(refreshFacts, token);
+        Require(afterFacts == facts, "RawVolumeFactsStableAfterUnlock");
+        Require(rawDecoded == 22 && rows.Count == 21 && unknown == 14, "RawResultCoverage");
+        token.ThrowIfCancellationRequested();
+        return new("raw-records-v1", targets.Count, kernel.Requests, kernel.Decoded, kernel.DecodeFailures,
+            22, rawDecoded, rows.Count, unknown, map!.Runs.Count, lease!.ReadCalls, lease.RequestedBytes,
+            facts.PhysicalSectorBytes, true, true, true, rows.AsReadOnly());
+    }
+
+    internal static NtfsRawVolumeFacts ReadFinalFacts(Func<NtfsRawVolumeFacts> read, CancellationToken token)
+    {
+        token.ThrowIfCancellationRequested();
+        var result = read();
+        token.ThrowIfCancellationRequested();
+        return result;
+    }
+
+    internal static bool MatchesLinks(NtfsRecord record, uint nativeLinks)
+    {
+        var visible = record.Names.Where(item => item.Namespace != 2).ToArray();
+        return visible.Length == nativeLinks &&
+            visible.Select(item => (item.ParentReference, item.Name)).Distinct().Count() == visible.Length &&
+            record.Names.Select(item => (item.ParentReference, item.Name, item.Namespace)).Distinct().Count() == record.Names.Count &&
+            record.LinkCount == record.Names.Count;
+    }
+
+    internal static bool MatchesNames(NtfsRecord record, ulong expectedParent, NtfsKernelMatrixCase descriptor)
+    {
+        var visible = record.Names.Where(item => item.Namespace != 2).ToArray();
+        var expected = new HashSet<string>(StringComparer.Ordinal) { NtfsKernelMatrix.FileName(descriptor.NameLength) };
+        if (descriptor.HardLink) expected.Add("link.bin");
+        return record.Names.All(item => item.ParentReference == expectedParent) &&
+            visible.Length == expected.Count && expected.SetEquals(visible.Select(item => item.Name));
+    }
+
+    internal static bool MatchesLookupReasons(NtfsRecord record, NtfsKernelMatrixCase descriptor)
+    {
+        NtfsLookupReason? expected = descriptor.Kind switch
+        {
+            "Ordinary" => NtfsLookupReason.None,
+            "Compressed" => NtfsLookupReason.Compressed,
+            "Sparse" => NtfsLookupReason.Sparse,
+            _ => null
+        };
+        if (!expected.HasValue) return false;
+        if (descriptor.NamedStream) expected |= NtfsLookupReason.NamedData;
+        return record.LookupReasons == expected.Value;
+    }
+
+    internal static bool MatchesPostAlias(NtfsRawTarget target, NtfsKernelMatrixCase descriptor,
+        Func<string, FileStorageInfo?> reader) => !descriptor.HardLink ||
+        reader(Path.Combine(target.ParentPath, "link.bin")) == target.Storage;
+}
diff --git a/tests/Prototypes/Ntfs/NtfsRawComparisonTests.cs b/tests/Prototypes/Ntfs/NtfsRawComparisonTests.cs
new file mode 100644
index 0000000..5b8b0d2
--- /dev/null
+++ b/tests/Prototypes/Ntfs/NtfsRawComparisonTests.cs
@@ -0,0 +1,159 @@
+using DiskAtlas;
+
+namespace DiskAtlas.NtfsPrototype;
+
+// Pure metadata and reader-callback checks; never touches a filesystem or volume.
+internal static class NtfsRawComparisonTests
+{
+    internal static int Run()
+    {
+        int passed = 0;
+        void Check(bool condition, string name)
+        {
+            if (!condition) throw new InvalidOperationException("NTFS raw comparison check failed: " + name);
+            passed++; Console.WriteLine("PASS NTFS raw comparison " + name);
+        }
+        const ulong volume = 41;
+        ulong parent = NtfsRecordFixtures.Reference(7, 2), reference = NtfsRecordFixtures.Reference(52, 3);
+        var ordinary = NtfsKernelMatrix.Cases.Single(x => x.CaseId == "A-Ordinary-64");
+        var linked = NtfsKernelMatrix.Cases.Single(x => x.CaseId == "B-Ordinary-64");
+        var named = NtfsKernelMatrix.Cases.Single(x => x.CaseId == "C-Ordinary-64");
+        string name = NtfsKernelMatrix.FileName(64);
+        NtfsName primary = new(parent, name, 1), alias = new(parent, "link.bin", 3);
+        NtfsName dos = new(parent, "FXXXXX~1.BIN", 2), aliasDos = new(parent, "LINK~1.BIN", 2);
+        NtfsRecord Record(params NtfsName[] names) => new(reference, 0, false, (ushort)names.Length,
+            names, 131072, 131072, NtfsLookupReason.None);
+        bool Matches(NtfsRecord record, NtfsKernelMatrixCase descriptor, uint links) =>
+            NtfsRawComparison.MatchesLinks(record, links) && NtfsRawComparison.MatchesNames(record, parent, descriptor);
+
+        Check(Matches(Record(primary), ordinary, 1), "ordinary single visible name matches");
+        Check(Matches(Record(primary, dos), ordinary, 1), "DOS alias does not count as another native link");
+        Check(Matches(Record(primary with { Namespace = 0 }), ordinary, 1), "valid POSIX name namespace remains visible");
+        Check(Matches(Record(primary with { Namespace = 3 }), ordinary, 1), "combined namespace name remains one visible name");
+        Check(Matches(Record(primary, alias), linked, 2), "two distinct visible hard links match");
+        Check(Matches(Record(primary, dos, alias, aliasDos), linked, 2), "hard links with distinct DOS aliases preserve native link count");
+        Check(Matches(Record(aliasDos, alias, dos, primary), linked, 2), "name order has no semantic effect");
+        Check(NtfsRawComparison.MatchesLinks(Record(primary, primary), 2) == false,
+            "duplicate visible raw entries are rejected even when raw and native counts agree");
+        Check(NtfsRawComparison.MatchesLinks(Record(primary, primary), 1) == false,
+            "duplicate visible entries cannot be hidden by distinct-count folding");
+        Check(!Matches(Record(primary, primary), ordinary, 1), "duplicate visible names cannot claim a complete ordinary match");
+        Check(!Matches(Record(primary, primary), linked, 2), "two copies of the primary cannot replace the required alias");
+        Check(!NtfsRawComparison.MatchesLinks(Record(primary, primary with { Namespace = 3 }), 2),
+            "same parent and name in different visible namespaces is still duplicate identity");
+        Check(!NtfsRawComparison.MatchesLinks(Record(primary, dos, dos), 1), "duplicate DOS records are rejected independently of visible count");
+        Check(!Matches(Record(primary, dos, dos), ordinary, 1), "duplicate DOS metadata cannot pass the combined comparison");
+        Check(!NtfsRawComparison.MatchesLinks(Record(primary) with { LinkCount = 2 }, 1), "raw header link count must match raw name count");
+        Check(!NtfsRawComparison.MatchesLinks(Record(primary, alias), 1), "native visible link count cannot lose an alias");
+        Check(!NtfsRawComparison.MatchesLinks(Record(primary), 2), "native visible link count cannot invent an alias");
+        Check(!NtfsRawComparison.MatchesNames(Record(primary with { ParentReference = parent + 1 }), parent, ordinary),
+            "wrong visible parent reference is rejected");
+        Check(!NtfsRawComparison.MatchesNames(Record(primary, dos with { ParentReference = parent + 1 }), parent, ordinary),
+            "wrong DOS parent reference is rejected");
+        Check(!Matches(Record(primary, alias with { ParentReference = parent + 1 }), linked, 2),
+            "hard-link alias in another parent cannot match the generated case");
+        Check(!NtfsRawComparison.MatchesNames(Record(), parent, ordinary), "missing primary name is rejected");
+        Check(!NtfsRawComparison.MatchesNames(Record(primary), parent, linked), "missing hard-link alias is rejected");
+        Check(!NtfsRawComparison.MatchesNames(Record(alias), parent, linked), "alias cannot replace the primary name");
+        Check(!NtfsRawComparison.MatchesNames(Record(primary, alias), parent, ordinary), "extra visible name is rejected for ordinary case");
+        Check(!NtfsRawComparison.MatchesNames(Record(primary, alias, new(parent, "other.bin", 1)), parent, linked),
+            "extra third visible name is rejected for hard-link case");
+        Check(!NtfsRawComparison.MatchesNames(Record(primary, alias with { Name = "other.bin" }), parent, linked),
+            "different alias spelling cannot be accepted by matching counts");
+        Check(!NtfsRawComparison.MatchesNames(Record(primary with { Name = "other.bin" }, alias), parent, linked),
+            "swapped-away primary spelling cannot be replaced by the alias");
+        Check(!NtfsRawComparison.MatchesNames(Record(primary with { Name = name.ToUpperInvariant() }), parent, ordinary),
+            "generated spelling comparison remains ordinal");
+        Check(Matches(Record(primary, dos), named, 1), "named-stream descriptor keeps the same default-file name contract");
+
+        var compressed = NtfsKernelMatrix.Cases.Single(x => x.CaseId == "A-Compressed-64");
+        var compressedNamed = NtfsKernelMatrix.Cases.Single(x => x.CaseId == "C-Compressed-64");
+        var sparse = NtfsKernelMatrix.Cases.Single(x => x.CaseId == "A-Sparse-64");
+        var sparseNamed = NtfsKernelMatrix.Cases.Single(x => x.CaseId == "C-Sparse-64");
+        var reasonCases = new (NtfsKernelMatrixCase Descriptor, NtfsLookupReason Expected)[]
+        {
+            (ordinary, NtfsLookupReason.None), (named, NtfsLookupReason.NamedData),
+            (compressed, NtfsLookupReason.Compressed), (compressedNamed, NtfsLookupReason.Compressed | NtfsLookupReason.NamedData),
+            (sparse, NtfsLookupReason.Sparse), (sparseNamed, NtfsLookupReason.Sparse | NtfsLookupReason.NamedData)
+        };
+        foreach (var item in reasonCases)
+        {
+            Check(NtfsRawComparison.MatchesLookupReasons(Record(primary) with { LookupReasons = item.Expected }, item.Descriptor),
+                "exact ordinary or single-special fixture reasons match with the declared stream scope");
+            foreach (var reason in Enum.GetValues<NtfsLookupReason>().Where(value => value != NtfsLookupReason.None))
+            {
+                NtfsLookupReason changed = item.Expected ^ reason;
+                Check(!NtfsRawComparison.MatchesLookupReasons(Record(primary) with { LookupReasons = changed }, item.Descriptor),
+                    "missing or unexpected lookup reason cannot become a complete fixture match");
+            }
+            Check(!NtfsRawComparison.MatchesLookupReasons(Record(primary) with { LookupReasons = item.Expected | (NtfsLookupReason)(1 << 20) }, item.Descriptor),
+                "unknown lookup reason bit is rejected");
+        }
+        Check(!NtfsRawComparison.MatchesLookupReasons(Record(primary) with
+            { LookupReasons = NtfsLookupReason.Compressed | NtfsLookupReason.Sparse }, compressed),
+            "compressed fixture cannot silently accept sparse metadata too");
+        Check(!NtfsRawComparison.MatchesLookupReasons(Record(primary) with
+            { LookupReasons = NtfsLookupReason.Compressed | NtfsLookupReason.Sparse }, sparse),
+            "sparse fixture cannot silently accept compressed metadata too");
+        Check(!NtfsRawComparison.MatchesLookupReasons(Record(primary), ordinary with { Kind = "Unknown" }),
+            "unknown fixture kind never defaults to ordinary reasons");
+
+        var storage = new FileStorageInfo(new(volume, reference, 0), 131072, 2, false, 131072, new DateTime(2020, 1, 1));
+        const string syntheticParent = @"C:\Synthetic\B-Ordinary-64";
+        var target = new NtfsRawTarget(linked.CaseId, Path.Combine(syntheticParent, name), syntheticParent,
+            storage, new(new(volume, parent, 0), 0, 1, false), FileAttributes.Archive);
+        int calls = 0;
+        string? requested = null;
+        FileStorageInfo? ReadGood(string path) { calls++; requested = path; return storage; }
+        Check(NtfsRawComparison.MatchesPostAlias(target, linked, ReadGood), "post-unlock alias matches the complete stored native snapshot");
+        Check(calls == 1 && requested == Path.Combine(syntheticParent, "link.bin"),
+            "alias callback is limited to the expected basename in its generated parent");
+        Check(!NtfsRawComparison.MatchesPostAlias(target, linked, _ => null), "missing post-unlock alias fails");
+        foreach (var changed in new[]
+        {
+            storage with { Identity = new(volume + 1, reference, 0) },
+            storage with { Identity = new(volume, reference + 1, 0) },
+            storage with { Identity = new(volume, NtfsRecordFixtures.Reference(52, 4), 0) },
+            storage with { Identity = new(volume, reference, 1) },
+            storage with { LogicalBytes = storage.LogicalBytes + 1 },
+            storage with { AllocatedBytes = storage.AllocatedBytes + 4096 },
+            storage with { LinkCount = 1 },
+            storage with { WritableHandleOpen = true },
+            storage with { Modified = storage.Modified!.Value.AddTicks(1) },
+            storage with { Modified = null }
+        })
+            Check(!NtfsRawComparison.MatchesPostAlias(target, linked, _ => changed),
+                "changed alias identity or native metadata cannot pass by identity alone");
+        foreach (var descriptor in new[] { ordinary, named })
+        {
+            calls = 0;
+            Check(NtfsRawComparison.MatchesPostAlias(target, descriptor, _ => { calls++; return null; }) && calls == 0,
+                "non-hard-link case performs no alias lookup");
+        }
+        bool propagated = false;
+        try { NtfsRawComparison.MatchesPostAlias(target, linked, _ => throw new IOException("SyntheticAliasRead")); }
+        catch (IOException) { propagated = true; }
+        Check(propagated, "alias infrastructure failure propagates rather than producing successful verification");
+
+        var facts = new NtfsRawVolumeFacts(new(512, 4096, 1024, 1048576, 256, 10, 4096), 41, 512);
+        using var cancel = new CancellationTokenSource();
+        calls = 0;
+        cancel.Cancel();
+        bool canceled = false;
+        try { NtfsRawComparison.ReadFinalFacts(() => { calls++; return facts; }, cancel.Token); }
+        catch (OperationCanceledException) { canceled = true; }
+        Check(canceled && calls == 0, "pre-canceled final query performs no native callback");
+        using var duringRead = new CancellationTokenSource();
+        canceled = false;
+        try { NtfsRawComparison.ReadFinalFacts(() => { duringRead.Cancel(); return facts; }, duringRead.Token); }
+        catch (OperationCanceledException) { canceled = true; }
+        Check(canceled, "cancellation during final metadata callback cannot publish verification");
+        Check(NtfsRawComparison.ReadFinalFacts(() => facts, default) == facts,
+            "stable final query preserves the full geometry and volume facts");
+        propagated = false;
+        try { NtfsRawComparison.ReadFinalFacts(() => throw new IOException("SyntheticFactsRead"), default); }
+        catch (IOException) { propagated = true; }
+        Check(propagated, "final query failure propagates instead of publishing old facts");
+        return passed;
+    }
+}
diff --git a/tests/Prototypes/Ntfs/NtfsRawVolumeLease.cs b/tests/Prototypes/Ntfs/NtfsRawVolumeLease.cs
new file mode 100644
index 0000000..d09b223
--- /dev/null
+++ b/tests/Prototypes/Ntfs/NtfsRawVolumeLease.cs
@@ -0,0 +1,222 @@
+using System.Runtime.InteropServices;
+using Microsoft.Win32.SafeHandles;
+
+namespace DiskAtlas.NtfsPrototype;
+
+internal sealed class NtfsRawVolumeException : IOException
+{
+    internal string Code { get; }
+    internal int NativeErrorCode { get; }
+    internal NtfsRawVolumeException(string code, int nativeErrorCode = 0) : base(code)
+    { Code = code; NativeErrorCode = nativeErrorCode; }
+}
+
+// Test-only. The caller proves VHD ownership and geometry before passing its
+// already-open read-only volume handle. This type never opens a volume or writes.
+internal sealed class NtfsRawVolumeLease : IDisposable
+{
+    internal readonly record struct NativeResult(bool Success, int Error);
+    internal readonly record struct NativeReadResult(bool Success, int BytesRead, int Error);
+    internal interface INative
+    {
+        NativeResult Lock(SafeFileHandle volume);
+        NativeResult Unlock(SafeFileHandle volume);
+        NativeResult Seek(SafeFileHandle volume, long offset);
+        NativeReadResult Read(SafeFileHandle volume, IntPtr buffer, int length);
+        IntPtr Allocate(int bytes);
+        void Free(IntPtr allocation);
+    }
+
+    internal const int MaximumReadLength = 65536, MaximumReadCalls = 128;
+    internal const long MaximumRequestedBytes = 2 * 1024 * 1024;
+    private readonly object gate = new();
+    private readonly SafeFileHandle volume;
+    private readonly long volumeBytes;
+    private readonly int logicalSector, physicalSector;
+    private readonly INative native;
+    private bool referenceAdded, locked, disposed;
+    private int readCalls;
+    private long requestedBytes;
+    private string unlockCode = "NotLocked";
+    private int unlockNativeErrorCode;
+
+    private NtfsRawVolumeLease(SafeFileHandle borrowedVolume, long bytes, int logical, int physical, INative adapter)
+    {
+        volume = borrowedVolume; volumeBytes = bytes; logicalSector = logical; physicalSector = physical; native = adapter;
+    }
+
+    internal bool UnlockSucceeded { get { lock (gate) return unlockCode == "Unlocked"; } }
+    internal string UnlockCode { get { lock (gate) return unlockCode; } }
+    internal int UnlockNativeErrorCode { get { lock (gate) return unlockNativeErrorCode; } }
+    internal int ReadCalls { get { lock (gate) return readCalls; } }
+    internal long RequestedBytes { get { lock (gate) return requestedBytes; } }
+
+    internal static NtfsRawVolumeLease Acquire(SafeFileHandle borrowedVolume, long volumeBytes,
+        int logicalSector, int physicalSector, CancellationToken token = default) =>
+        AcquireForTests(borrowedVolume, volumeBytes, logicalSector, physicalSector, Native.Instance, token);
+
+    // The same orchestration is exercised with synthetic operations and an inert
+    // non-owning handle. Tests do not invoke Lock/Read on any real volume.
+    internal static NtfsRawVolumeLease AcquireForTests(SafeFileHandle borrowedVolume, long volumeBytes,
+        int logicalSector, int physicalSector, INative adapter, CancellationToken token = default)
+    {
+        ArgumentNullException.ThrowIfNull(borrowedVolume);
+        ArgumentNullException.ThrowIfNull(adapter);
+        if (borrowedVolume.IsClosed || borrowedVolume.IsInvalid) throw new InvalidDataException("RawVolumeHandle");
+        if (logicalSector != 512 || physicalSector is < 512 or > 65536 ||
+            (physicalSector & (physicalSector - 1)) != 0 || physicalSector < logicalSector ||
+            volumeBytes < logicalSector || volumeBytes % logicalSector != 0) throw new InvalidDataException("RawVolumeGeometry");
+        token.ThrowIfCancellationRequested();
+        var lease = new NtfsRawVolumeLease(borrowedVolume, volumeBytes, logicalSector, physicalSector, adapter);
+        try
+        {
+            borrowedVolume.DangerousAddRef(ref lease.referenceAdded);
+            token.ThrowIfCancellationRequested();
+            var result = adapter.Lock(borrowedVolume);
+            // Record ownership before the post-call cancellation check.
+            if (result.Success) { lease.locked = true; lease.unlockCode = "Pending"; }
+            token.ThrowIfCancellationRequested();
+            if (!result.Success) throw NativeFailure("LockFailed", result.Error);
+            return lease;
+        }
+        catch
+        {
+            lease.Dispose();
+            throw;
+        }
+    }
+
+    internal byte[] Read(long volumeOffset, int length, CancellationToken token = default)
+    {
+        lock (gate)
+        {
+            ObjectDisposedException.ThrowIf(disposed, this);
+            try
+            {
+                token.ThrowIfCancellationRequested();
+                if (!locked) throw new InvalidDataException("RawVolumeNotLocked");
+                if (volumeOffset < 0 || volumeOffset % logicalSector != 0 || length is < 1 or > MaximumReadLength ||
+                    length % logicalSector != 0 || volumeOffset > volumeBytes - length)
+                    throw new InvalidDataException("RawReadBounds");
+                if (readCalls >= MaximumReadCalls || length > MaximumRequestedBytes - requestedBytes)
+                    throw new InvalidDataException("RawReadBudget");
+                return ReadCore(volumeOffset, length, token);
+            }
+            catch
+            {
+                // ReadCore has completed any synchronous call and released its
+                // buffer before a failed/canceled lease relinquishes the lock.
+                Finish();
+                throw;
+            }
+        }
+    }
+
+    private byte[] ReadCore(long offset, int length, CancellationToken token)
+    {
+        IntPtr allocation = IntPtr.Zero;
+        bool primaryFailure = false;
+        try
+        {
+            token.ThrowIfCancellationRequested();
+            allocation = native.Allocate(checked(length + physicalSector - 1));
+            if (allocation == IntPtr.Zero) throw new NtfsRawVolumeException("AllocationFailed");
+            token.ThrowIfCancellationRequested();
+            nuint address = checked((nuint)allocation + (nuint)(physicalSector - 1));
+            address &= ~((nuint)physicalSector - 1);
+            var aligned = (IntPtr)address;
+            token.ThrowIfCancellationRequested();
+            var seek = native.Seek(volume, offset);
+            token.ThrowIfCancellationRequested();
+            if (!seek.Success) throw NativeFailure("SeekFailed", seek.Error);
+            token.ThrowIfCancellationRequested();
+            // Budget counts native Read attempts, including failed/short calls;
+            // it is not a physical-I/O count.
+            readCalls++;
+            requestedBytes = checked(requestedBytes + length);
+            var read = native.Read(volume, aligned, length);
+            token.ThrowIfCancellationRequested();
+            if (!read.Success) throw NativeFailure("ReadFailed", read.Error);
+            if (read.BytesRead != length) throw new NtfsRawVolumeException("ShortRead");
+            var bytes = new byte[length];
+            Marshal.Copy(aligned, bytes, 0, length);
+            token.ThrowIfCancellationRequested();
+            return bytes;
+        }
+        catch { primaryFailure = true; throw; }
+        finally
+        {
+            // Never free or reuse an address while a synchronous Read is active.
+            // A failed release cannot replace an existing primary exception.
+            if (allocation != IntPtr.Zero)
+            {
+                try { native.Free(allocation); }
+                catch { if (!primaryFailure) throw new NtfsRawVolumeException("BufferReleaseFailed"); }
+            }
+        }
+    }
+
+    private static NtfsRawVolumeException NativeFailure(string code, int error) => new(code, error);
+
+    private void Finish()
+    {
+        if (disposed) return;
+        disposed = true;
+        try
+        {
+            if (locked)
+            {
+                try
+                {
+                    var result = native.Unlock(volume);
+                    unlockNativeErrorCode = result.Success ? 0 : result.Error;
+                    unlockCode = result.Success ? "Unlocked" : "UnlockFailed";
+                }
+                catch { unlockCode = "UnlockFailed"; }
+                finally { locked = false; }
+            }
+            else unlockCode = "NotLocked";
+        }
+        finally
+        {
+            if (referenceAdded)
+            {
+                referenceAdded = false;
+                try { volume.DangerousRelease(); }
+                catch { unlockCode = "UnlockFailed"; }
+            }
+        }
+    }
+
+    public void Dispose() { lock (gate) Finish(); }
+
+    private sealed class Native : INative
+    {
+        internal static readonly Native Instance = new();
+        [DllImport("kernel32.dll", SetLastError = true)]
+        private static extern bool SetFilePointerEx(SafeFileHandle file, long distance, out long position, uint method);
+        [DllImport("kernel32.dll", SetLastError = true)]
+        private static extern bool ReadFile(SafeFileHandle file, IntPtr buffer, uint bytes, out uint read, IntPtr overlapped);
+
+        public NativeResult Lock(SafeFileHandle handle) => Control(handle, 0x90018);
+        public NativeResult Unlock(SafeFileHandle handle) => Control(handle, 0x9001c);
+        private static NativeResult Control(SafeFileHandle handle, uint code)
+        {
+            bool success = NativeStorage.DeviceIoControl(handle, code, null, 0, [], 0, out _, IntPtr.Zero);
+            return new(success, success ? 0 : Marshal.GetLastWin32Error());
+        }
+        public NativeResult Seek(SafeFileHandle handle, long offset)
+        {
+            bool success = SetFilePointerEx(handle, offset, out long position, 0);
+            int error = success ? 0 : Marshal.GetLastWin32Error();
+            return success && position != offset ? new(false, 87) : new(success, error);
+        }
+        public NativeReadResult Read(SafeFileHandle handle, IntPtr buffer, int length)
+        {
+            bool success = ReadFile(handle, buffer, (uint)length, out uint read, IntPtr.Zero);
+            return new(success, checked((int)read), success ? 0 : Marshal.GetLastWin32Error());
+        }
+        public IntPtr Allocate(int bytes) => Marshal.AllocHGlobal(bytes);
+        public void Free(IntPtr allocation) => Marshal.FreeHGlobal(allocation);
+    }
+}
diff --git a/tests/Prototypes/Ntfs/NtfsRawVolumeLeaseTests.cs b/tests/Prototypes/Ntfs/NtfsRawVolumeLeaseTests.cs
new file mode 100644
index 0000000..f14753a
--- /dev/null
+++ b/tests/Prototypes/Ntfs/NtfsRawVolumeLeaseTests.cs
@@ -0,0 +1,261 @@
+using System.Runtime.InteropServices;
+using Microsoft.Win32.SafeHandles;
+
+namespace DiskAtlas.NtfsPrototype;
+
+// Inert non-owning handles plus injected native operations only. No actual
+// volume lock, disk open, file creation or raw read is performed by these tests.
+internal static class NtfsRawVolumeLeaseTests
+{
+    private sealed class FakeNative : NtfsRawVolumeLease.INative
+    {
+        internal int Locks, Unlocks, Seeks, Reads, Allocations, Frees;
+        internal int Alignment = 4096;
+        internal bool Aligned = true, FreeWhileReading, AllocateZero;
+        internal long Position;
+        internal NtfsRawVolumeLease.NativeResult LockResult = new(true, 0), UnlockResult = new(true, 0), SeekResult = new(true, 0);
+        internal NtfsRawVolumeLease.NativeReadResult? ReadResult;
+        internal Action? OnLock, OnUnlock, OnAllocate, OnSeek, OnRead, OnFree;
+        internal List<string> Events { get; } = [];
+        private bool reading;
+        public NtfsRawVolumeLease.NativeResult Lock(SafeFileHandle _) { Locks++; Events.Add("Lock"); OnLock?.Invoke(); return LockResult; }
+        public NtfsRawVolumeLease.NativeResult Unlock(SafeFileHandle _) { Unlocks++; Events.Add("Unlock"); OnUnlock?.Invoke(); return UnlockResult; }
+        public NtfsRawVolumeLease.NativeResult Seek(SafeFileHandle _, long offset)
+        { Seeks++; Position = offset; Events.Add("Seek"); OnSeek?.Invoke(); return SeekResult; }
+        public NtfsRawVolumeLease.NativeReadResult Read(SafeFileHandle _, IntPtr buffer, int length)
+        {
+            Reads++; reading = true; Events.Add("ReadStart");
+            try
+            {
+                Aligned &= (nuint)buffer % (nuint)Alignment == 0;
+                OnRead?.Invoke();
+                var result = ReadResult ?? new(true, length, 0);
+                if (result.Success && result.BytesRead is >= 0 && result.BytesRead <= length)
+                {
+                    byte[] bytes = Enumerable.Range(0, result.BytesRead).Select(index => (byte)((Position % 251 + index) % 251)).ToArray();
+                    Marshal.Copy(bytes, 0, buffer, bytes.Length);
+                }
+                return result;
+            }
+            finally { reading = false; Events.Add("ReadEnd"); }
+        }
+        public IntPtr Allocate(int bytes)
+        { Allocations++; Events.Add("Allocate"); OnAllocate?.Invoke(); return AllocateZero ? IntPtr.Zero : Marshal.AllocHGlobal(bytes); }
+        public void Free(IntPtr allocation)
+        {
+            Frees++; FreeWhileReading |= reading; Events.Add("Free");
+            Marshal.FreeHGlobal(allocation);
+            OnFree?.Invoke();
+        }
+    }
+
+    internal static int Run()
+    {
+        int passed = 0;
+        void Check(bool value, string name)
+        {
+            if (!value) throw new InvalidOperationException("NTFS raw lease check failed: " + name);
+            passed++; Console.WriteLine("PASS NTFS raw lease " + name);
+        }
+        Exception? Catch(Action action)
+        {
+            try { action(); return null; }
+            catch (Exception error) { return error; }
+        }
+        SafeFileHandle Handle() => new(new IntPtr(12345), ownsHandle: false);
+        NtfsRawVolumeLease Acquire(FakeNative native, SafeFileHandle handle, CancellationToken token = default,
+            long bytes = 256 * 1024 * 1024, int logical = 512, int physical = 4096) =>
+            NtfsRawVolumeLease.AcquireForTests(handle, bytes, logical, physical, native, token);
+
+        using (var handle = Handle())
+        {
+            var native = new FakeNative();
+            var lease = Acquire(native, handle);
+            Check(lease.UnlockCode == "Pending" && !lease.UnlockSucceeded && native.Locks == 1, "successful acquisition records its single pending lock");
+            byte[] bytes = lease.Read(512, 1024);
+            Check(bytes.SequenceEqual(Enumerable.Range(0, 1024).Select(index => (byte)((512 + index) % 251))), "read returns exact native bytes without an IOCTL header");
+            Check(native.Aligned && native.Reads == 1 && native.Seeks == 1, "native read uses an explicitly aligned buffer and one seek");
+            Check(lease.ReadCalls == 1 && lease.RequestedBytes == 1024 && native.Frees == 1, "completed work counts requests and frees its buffer");
+            lease.Dispose(); lease.Dispose();
+            Check(lease.UnlockSucceeded && lease.UnlockCode == "Unlocked" && native.Unlocks == 1, "repeated disposal unlocks exactly once");
+            Check(!handle.IsClosed, "lease disposal preserves the caller-owned handle");
+            Check(Catch(() => lease.Read(0, 512)) is ObjectDisposedException && native.Reads == 1, "disposed lease performs no additional I/O");
+        }
+        foreach (int alignment in new[] { 512, 4096, 65536 })
+        {
+            using var handle = Handle(); var native = new FakeNative { Alignment = alignment };
+            using var lease = Acquire(native, handle, physical: alignment);
+            _ = lease.Read(0, 512);
+            Check(native.Aligned && native.Allocations == 1 && native.Frees == 1, "supported physical alignment endpoints are honored");
+        }
+        foreach (var geometry in new[] { (0L,512,4096), (513L,512,4096), (4096L,0,4096), (4096L,4096,4096),
+            (4096L,512,0), (4096L,512,256), (4096L,512,513), (4096L,512,131072) })
+        {
+            using var handle = Handle(); var native = new FakeNative();
+            Check(Catch(() => Acquire(native, handle, bytes: geometry.Item1, logical: geometry.Item2, physical: geometry.Item3)) is InvalidDataException && native.Locks == 0,
+                "invalid geometry fails before any native lock");
+        }
+        using (var handle = new SafeFileHandle(IntPtr.Zero, false))
+        {
+            var native = new FakeNative();
+            Check(Catch(() => Acquire(native, handle)) is InvalidDataException && native.Locks == 0, "invalid handle cannot reach native operations");
+        }
+        using (var handle = Handle())
+        {
+            handle.Dispose(); var native = new FakeNative();
+            Check(Catch(() => Acquire(native, handle)) is InvalidDataException && native.Locks == 0, "closed handle cannot acquire a lock");
+        }
+        using (var handle = Handle())
+        {
+            var native = new FakeNative { LockResult = new(false, 32) };
+            var error = Catch(() => Acquire(native, handle));
+            Check(error is NtfsRawVolumeException { Code: "LockFailed", NativeErrorCode: 32 } && native.Reads == 0 && native.Unlocks == 0,
+                "failed lock exposes a typed numeric error without pretending to own a lock");
+            Check(!handle.IsClosed, "failed acquisition releases only its own handle reference");
+        }
+        using (var handle = Handle())
+        {
+            var native = new FakeNative(); var lease = Acquire(native, handle);
+            handle.Dispose();
+            _ = lease.Read(0, 512);
+            lease.Dispose();
+            Check(handle.IsClosed && native.Reads == 1 && native.Unlocks == 1,
+                "borrowed handle reference survives caller disposal until lease cleanup releases it");
+        }
+        foreach (var bounds in new[] { (-512L,512), (1L,512), (0L,0), (0L,-512), (0L,513), (0L,65537), (65536L,512), (long.MaxValue-511,1024) })
+        {
+            using var handle = Handle(); var native = new FakeNative();
+            using var lease = Acquire(native, handle, bytes: 65536);
+            Check(Catch(() => lease.Read(bounds.Item1, bounds.Item2)) is InvalidDataException && native.Reads == 0 && native.Unlocks == 1,
+                "invalid or overflowing ranges fail closed before allocating or reading");
+        }
+        using (var handle = Handle())
+        {
+            long length = long.MaxValue - 511; var native = new FakeNative();
+            using var lease = Acquire(native, handle, bytes: length);
+            _ = lease.Read(length - 512, 512);
+            Check(native.Reads == 1 && native.Position == length - 512, "subtraction-based bounds accept a valid range near the signed limit");
+        }
+
+        void Fault(Action<FakeNative> configure, Func<Exception?, bool> expected, int reads, int frees, string name)
+        {
+            using var handle = Handle(); var native = new FakeNative(); configure(native);
+            using var lease = Acquire(native, handle);
+            var error = Catch(() => lease.Read(0, 512));
+            Check(expected(error) && native.Reads == reads && native.Frees == frees && native.Unlocks == 1, name);
+            Check(!native.FreeWhileReading && lease.ReadCalls == reads && lease.RequestedBytes == reads * 512L,
+                "faulted work retains exact counters and never frees an active synchronous buffer");
+            lease.Dispose();
+            Check(native.Unlocks == 1, "faulted lease disposal does not unlock twice");
+        }
+        Fault(x => x.OnAllocate = () => throw new OutOfMemoryException("SyntheticAllocation"), x => x is OutOfMemoryException, 0, 0,
+            "allocation failure releases the acquired lock without a phantom buffer");
+        Fault(x => x.AllocateZero = true, x => x is NtfsRawVolumeException { Code: "AllocationFailed" }, 0, 0,
+            "null allocation is rejected without attempting to free an unowned pointer");
+        Fault(x => x.SeekResult = new(false, 87), x => x is NtfsRawVolumeException { Code: "SeekFailed", NativeErrorCode: 87 }, 0, 1,
+            "seek failure frees the buffer and preserves its typed native error");
+        Fault(x => x.ReadResult = new(false, 0, 5), x => x is NtfsRawVolumeException { Code: "ReadFailed", NativeErrorCode: 5 }, 1, 1,
+            "failed read counts the actual request and frees its buffer");
+        foreach (int returned in new[] { -1, 0, 511, 513 })
+            Fault(x => x.ReadResult = new(true, returned, 0), x => x is NtfsRawVolumeException { Code: "ShortRead", NativeErrorCode: 0 }, 1, 1,
+                "non-exact successful native counts are rejected without zero padding");
+        var primary = new IOException("SyntheticPrimary");
+        Fault(x => { x.OnRead = () => throw primary; x.OnFree = () => throw new IOException("SyntheticFree"); x.OnUnlock = () => throw new IOException("SyntheticUnlock"); },
+            x => ReferenceEquals(x, primary), 1, 1, "free and unlock failures cannot replace the primary read exception");
+        Fault(x => x.OnFree = () => throw new IOException("SyntheticFree"), x => x is NtfsRawVolumeException { Code: "BufferReleaseFailed" }, 1, 1,
+            "a standalone buffer release failure cannot return a successful read");
+
+        using (var handle = Handle())
+        {
+            var native = new FakeNative { UnlockResult = new(false, 5) };
+            var lease = Acquire(native, handle); lease.Dispose(); lease.Dispose();
+            Check(!lease.UnlockSucceeded && lease.UnlockCode == "UnlockFailed" && lease.UnlockNativeErrorCode == 5 && native.Unlocks == 1,
+                "unlock failure is visible without throwing from Dispose");
+            Check(!handle.IsClosed, "failed unlock still preserves caller handle ownership");
+        }
+        foreach (string stage in new[] { "BeforeAcquire", "Lock", "BeforeRead", "Allocate", "Seek", "Read" })
+        {
+            using var cts = new CancellationTokenSource(); using var handle = Handle(); var native = new FakeNative();
+            if (stage == "BeforeAcquire") cts.Cancel();
+            if (stage == "Lock") native.OnLock = cts.Cancel;
+            if (stage is "BeforeAcquire" or "Lock")
+            {
+                var error = Catch(() => Acquire(native, handle, cts.Token));
+                Check(error is OperationCanceledException && native.Reads == 0 && native.Unlocks == (stage == "Lock" ? 1 : 0),
+                    "cancellation around acquisition never leaks a successful lock");
+                continue;
+            }
+            using var lease = Acquire(native, handle);
+            if (stage == "BeforeRead") cts.Cancel();
+            if (stage == "Allocate") native.OnAllocate = cts.Cancel;
+            if (stage == "Seek") native.OnSeek = cts.Cancel;
+            if (stage == "Read") native.OnRead = cts.Cancel;
+            var canceled = Catch(() => lease.Read(0, 512, cts.Token));
+            Check(canceled is OperationCanceledException && native.Unlocks == 1 && native.Frees == (stage == "BeforeRead" ? 0 : 1),
+                "cancellation at native boundaries releases all acquired resources");
+            Check(!native.FreeWhileReading && native.Reads == (stage == "Read" ? 1 : 0),
+                "cancellation waits for the synchronous operation before freeing its buffer");
+        }
+        using (var handle = Handle())
+        {
+            var native = new FakeNative(); using var lease = Acquire(native, handle);
+            for (int i = 0; i < 128; i++) _ = lease.Read(0, 512);
+            Check(Catch(() => lease.Read(0, 512)) is InvalidDataException && lease.ReadCalls == 128 && native.Unlocks == 1,
+                "call budget rejects the next operation before additional native work");
+        }
+        using (var handle = Handle())
+        {
+            var native = new FakeNative(); using var lease = Acquire(native, handle);
+            for (int i = 0; i < 32; i++) _ = lease.Read(0, 65536);
+            Check(Catch(() => lease.Read(0, 512)) is InvalidDataException && lease.RequestedBytes == 2 * 1024 * 1024 && native.Reads == 32,
+                "actual requested bytes enforce the aggregate budget independently from call count");
+        }
+        using (var handle = Handle())
+        using (var entered = new ManualResetEventSlim())
+        using (var release = new ManualResetEventSlim())
+        using (var disposing = new ManualResetEventSlim())
+        {
+            var native = new FakeNative { OnRead = () => { entered.Set(); if (!release.Wait(5000)) throw new IOException("SyntheticWait"); } };
+            var lease = Acquire(native, handle);
+            var reading = Task.Run(() => lease.Read(0, 512));
+            try
+            {
+                Check(entered.Wait(2000), "concurrent disposal fixture reaches its synchronous read");
+                var disposal = Task.Run(() => { disposing.Set(); lease.Dispose(); });
+                Check(disposing.Wait(2000) && native.Frees == 0 && native.Unlocks == 0, "Dispose cannot free or unlock while a synchronous read is active");
+                release.Set();
+                Check(Task.WaitAll([reading, disposal], 5000), "read and concurrent Dispose finish within the test deadline");
+                Check(native.Frees == 1 && native.Unlocks == 1 && !native.FreeWhileReading &&
+                    native.Events.IndexOf("ReadEnd") < native.Events.IndexOf("Free") && native.Events.IndexOf("Free") < native.Events.IndexOf("Unlock"),
+                    "synchronous completion precedes exactly one free and unlock");
+            }
+            finally { release.Set(); _ = reading.Wait(5000); lease.Dispose(); }
+        }
+        using (var handle = Handle())
+        using (var entered = new ManualResetEventSlim())
+        using (var release = new ManualResetEventSlim())
+        using (var secondStarted = new ManualResetEventSlim())
+        {
+            var native = new FakeNative();
+            native.OnRead = () => { if (native.Reads == 1) { entered.Set(); if (!release.Wait(5000)) throw new IOException("SyntheticWait"); } };
+            using var lease = Acquire(native, handle);
+            var first = Task.Run(() => lease.Read(0, 512));
+            Task<byte[]>? second = null;
+            try
+            {
+                Check(entered.Wait(2000), "parallel read fixture reaches the first native call");
+                second = Task.Run(() => { secondStarted.Set(); return lease.Read(512, 512); });
+                Check(secondStarted.Wait(2000) && native.Seeks == 1 && native.Reads == 1,
+                    "second caller cannot move the shared file pointer during the first native read");
+                release.Set();
+                Check(Task.WaitAll([first, second], 5000), "parallel callers finish within the test deadline");
+                Check(first.Result.SequenceEqual(Enumerable.Range(0, 512).Select(index => (byte)(index % 251))) &&
+                    second.Result.SequenceEqual(Enumerable.Range(0, 512).Select(index => (byte)((512 + index) % 251))) &&
+                    native.Reads == 2 && native.Seeks == 2 && native.Frees == 2,
+                    "each serialized seek and read preserves its own bytes and buffer ownership");
+            }
+            finally { release.Set(); _ = first.Wait(5000); if (second != null) _ = second.Wait(5000); }
+        }
+        return passed;
+    }
+}

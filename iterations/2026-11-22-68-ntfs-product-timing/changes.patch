+                    }
+                    catch (Exception error) { failure ??= ExceptionDispatchInfo.Capture(error); }
+                    finally { done = true; form.Close(); }
+                };
+                Application.Run(form);
+            }
+            catch (Exception error) { failure ??= ExceptionDispatchInfo.Capture(error); }
+        }) { IsBackground = true };

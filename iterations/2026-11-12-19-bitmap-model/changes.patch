+using System.Buffers;
+using System.Collections;
+using System.Text.Json;
+
+namespace DiskAtlas.NtfsPrototype;
+
+// Independent model counterexamples. Every token, bitmap and observation is
+// synthetic; no filesystem, device, raw record, path or native call is used.
+internal static class NtfsSyntheticBitmapAdversarialTests
+{
+    private sealed class EqualToken
+    {
+        public override bool Equals(object? other) => other is EqualToken;
+        public override int GetHashCode() => 1;
+    }
+
+    private sealed class CallbackList(IReadOnlyList<NtfsSyntheticSlotObservation> values) : IReadOnlyList<NtfsSyntheticSlotObservation>
+    {
+        internal Action? OnCount;
+        internal Action<int>? OnIndex;
+        internal bool ThrowCount, ThrowIndex;
+        internal Exception? CountError, IndexError;
+        public int Count
+        {
+            get
+            {
+                OnCount?.Invoke();
+                if (CountError != null) throw CountError;
+                if (ThrowCount) throw new InvalidOperationException("SyntheticPrivateCount");
+                return values.Count;
+            }
+        }
+        public NtfsSyntheticSlotObservation this[int index]
+        {
+            get
+            {
+                OnIndex?.Invoke(index);
+                if (IndexError != null) throw IndexError;
+                if (ThrowIndex) throw new InvalidOperationException("SyntheticPrivateIndex");
+                return values[index];
+            }
+        }
+        public IEnumerator<NtfsSyntheticSlotObservation> GetEnumerator()
+        { for (int index = 0; index < Count; index++) yield return this[index]; }
+        IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();
+    }
+
+    private sealed class CallbackMemory(Exception error, Action? onAccess) : MemoryManager<byte>
+    {
+        internal ReadOnlyMemory<byte> View => CreateMemory(1);
+        public override Span<byte> GetSpan() { onAccess?.Invoke(); throw error; }
+        public override MemoryHandle Pin(int elementIndex = 0) => throw new NotSupportedException("SyntheticPin");
+        public override void Unpin() { }
+        protected override void Dispose(bool disposing) { }
+    }
+
+    internal static int Run()
+    {
+        int passed = 0;
+        void Check(bool condition, string name)
+        {
+            if (!condition) throw new InvalidOperationException("Synthetic bitmap adversarial check failed: " + name);
+            passed++; Console.WriteLine("PASS synthetic bitmap adversarial " + name);
+        }
+        Exception? Catch(Action action) { try { action(); return null; } catch (Exception error) { return error; } }
+        void Rejected(Action action, string code, string name) =>
+            Check(Catch(action) is NtfsSyntheticBitmapException error && error.Code == code && error.Message == code && error.InnerException == null, name);
+        NtfsSyntheticBitmapBinding Binding(int slots) => new(new object(), new object(), slots);
+        NtfsSyntheticSlotObservation[] Observations(int count) => Enumerable.Range(0, count).Select(slot =>
+        {
+            var status = (NtfsDecodeStatus)(slot % 4);
+            bool? inUse = status == NtfsDecodeStatus.Decoded ? true : status == NtfsDecodeStatus.Free ? false : null;
+            return new NtfsSyntheticSlotObservation(slot, status, inUse, status == NtfsDecodeStatus.Invalid);
+        }).ToArray();
+
+        var binding = Binding(12); var observations = Observations(12); byte[] bits = [0x0f];
+        var bitmap = new NtfsSyntheticBitmapInput(binding, NtfsSyntheticBitmapPresence.Provided, 8, bits);
+        var report = NtfsSyntheticBitmapModel.Evaluate(binding, binding, observations, bitmap);
+        Check(report is { Revision: "synthetic-mft-bitmap-v1", EvidenceKind: "Synthetic", Slots: 12, CoveredSlots: 8,
+            BitmapCoverageComplete: false, Allocated: 4, Unallocated: 4, Unknown: 4, Decoded: 3, Free: 3, Invalid: 3, Unsupported: 3 },
+            "deliberately partial evidence retains three allocation states and all four strict categories");
+        Check(report.CrossCounts.Count == 12 && report.CrossCounts.All(row => row.Count == 1) && report.CrossCounts.Sum(row => row.Count) == 12,
+            "the complete three-by-four matrix conserves observations without losing zero or unknown categories");
+        Check(report is { AllZeroInvalid: 3, AllZeroAllocated: 1, AllZeroUnallocated: 1, AllZeroUnknown: 1, HeaderCompared: 4, HeaderDisagreements: 2 },
+            "zero-byte observations do not imply allocation and header disagreements remain observations");
+        Check(report.CrossCounts.Select(row => row.Allocation + "/" + row.Status).SequenceEqual(new[] {
+            "Allocated/Decoded", "Allocated/Free", "Allocated/Invalid", "Allocated/Unsupported",
+            "Unallocated/Decoded", "Unallocated/Free", "Unallocated/Invalid", "Unallocated/Unsupported",
+            "Unknown/Decoded", "Unknown/Free", "Unknown/Invalid", "Unknown/Unsupported" }),
+            "cross counts use a deterministic complete state and status order");
+        var beforeBits = bits.ToArray(); var beforeObservations = observations.ToArray();
+        var shuffled = NtfsSyntheticBitmapModel.Evaluate(binding, binding, observations.Reverse().ToArray(), bitmap);
+        Check(JsonSerializer.Serialize(report) == JsonSerializer.Serialize(shuffled) && bits.SequenceEqual(beforeBits) && observations.SequenceEqual(beforeObservations),
+            "observation order does not change the aggregate or mutate bitmap and observation inputs");
+        bool immutable = false;
+        try { ((IList<NtfsSyntheticBitmapCrossCount>)report.CrossCounts).Clear(); } catch (NotSupportedException) { immutable = true; }
+        Check(immutable, "the result matrix cannot be edited after successful evaluation");
+
+        var missing = NtfsSyntheticBitmapModel.Evaluate(binding, binding, observations,
+            new(binding, NtfsSyntheticBitmapPresence.Missing, 0, ReadOnlyMemory<byte>.Empty));
+        Check(missing is { Allocated: 0, Unallocated: 0, Unknown: 12, CoveredSlots: 0, BitmapCoverageComplete: false,
+            AllZeroInvalid: 3, AllZeroUnknown: 3, HeaderCompared: 0, HeaderDisagreements: 0 } && missing.CrossCounts.Count == 12,
+            "missing bitmap evidence never becomes implicit unallocated or known-zero records");
+        byte[] allAllocated = [0xff, 0xff];
+        var allocated = NtfsSyntheticBitmapModel.Evaluate(binding, binding, observations, new(binding, NtfsSyntheticBitmapPresence.Provided, 12, allAllocated));
+        Check(allocated is { Allocated: 12, Unallocated: 0, Unknown: 0, AllZeroAllocated: 3, Invalid: 3, Free: 3, BitmapCoverageComplete: true },
+            "zero invalid records can be declared allocated while strict Free counts remain unchanged");
+        var one = Binding(1);
+        var nonzeroInvalid = NtfsSyntheticBitmapModel.Evaluate(one, one,
+            [new(0, NtfsDecodeStatus.Invalid, false)], new(one, NtfsSyntheticBitmapPresence.Provided, 1, new byte[] { 0 }));
+        Check(nonzeroInvalid is { Unallocated: 1, Invalid: 1, Free: 0, AllZeroInvalid: 0, HeaderCompared: 1, HeaderDisagreements: 0 },
+            "nonzero invalid declared unallocated remains invalid rather than changing the raw classification");
+
+        var maximum = Binding(4096); var maximumObservations = Observations(4096); var edgeBits = new byte[512];
+        edgeBits[0] = 0x80; edgeBits[1] = 0x01; edgeBits[511] = 0x80;
+        var edges = NtfsSyntheticBitmapModel.Evaluate(maximum, maximum, maximumObservations,
+            new(maximum, NtfsSyntheticBitmapPresence.Provided, 4096, edgeBits));
+        Check(edges is { Slots: 4096, CoveredSlots: 4096, Allocated: 3, Unallocated: 4093, Unknown: 0, BitmapCoverageComplete: true } &&
+            edges.CrossCounts.Sum(row => row.Count) == 4096,
+            "LSB-first bits seven eight and 4095 stay distinct at byte and maximum boundaries");
+        var nine = Binding(12); var twelveObservations = Observations(12);
+        var padded = NtfsSyntheticBitmapModel.Evaluate(nine, nine, twelveObservations,
+            new(nine, NtfsSyntheticBitmapPresence.Provided, 9, new byte[] { 0x80, 0xff }));
+        var cleanPadding = NtfsSyntheticBitmapModel.Evaluate(nine, nine, twelveObservations,
+            new(nine, NtfsSyntheticBitmapPresence.Provided, 9, new byte[] { 0x80, 0x01 }));
+        Check(padded is { CoveredSlots: 9, Allocated: 2, Unallocated: 7, Unknown: 3, BitmapCoverageComplete: false } &&
+            JsonSerializer.Serialize(padded) == JsonSerializer.Serialize(cleanPadding),
+            "padding bits beyond explicit coverage cannot allocate unknown slots");
+
+        foreach (bool replaceSource in new[] { true, false })
+        {
+            var equal = new NtfsSyntheticBitmapBinding(new EqualToken(), new EqualToken(), 12);
+            var foreign = equal with { SourceToken = replaceSource ? new EqualToken() : equal.SourceToken, MapEpoch = replaceSource ? equal.MapEpoch : new EqualToken() };
+            Rejected(() => NtfsSyntheticBitmapModel.Evaluate(equal, foreign, observations,
+                new(equal, NtfsSyntheticBitmapPresence.Missing, 0, ReadOnlyMemory<byte>.Empty)), "BitmapModelBinding",
+                "equal-valued tokens cannot impersonate another source or mapping epoch");
+            Rejected(() => NtfsSyntheticBitmapModel.Evaluate(equal, equal, observations,
+                new(foreign, NtfsSyntheticBitmapPresence.Provided, 8, bits)), "BitmapModelBinding",
+                "bitmap binding mismatch cannot be hidden by otherwise valid observation binding");
+        }
+        var wrongSlots = binding with { Slots = 11 };
+        Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, wrongSlots, observations, bitmap), "BitmapModelBinding",
+            "matching tokens with another expected slot count still fail binding");
+        foreach (int slots in new[] { 0, -1, 4097, int.MaxValue })
+        {
+            var bad = Binding(slots);
+            Rejected(() => NtfsSyntheticBitmapModel.Evaluate(bad, bad, observations,
+                new(bad, NtfsSyntheticBitmapPresence.Missing, 0, ReadOnlyMemory<byte>.Empty)), "BitmapModelSlotBudget",
+                "invalid or oversized slot declarations fail before model iteration");
+        }
+        foreach (var badObservations in new[] { observations[..11], observations.Concat([observations[0]]).ToArray() })
+            Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, badObservations, bitmap), "BitmapModelObservationBudget",
+                "missing and excess observations cannot pretend to cover the declared model");
+        foreach (int badSlot in new[] { -1, 12, int.MaxValue, 0 })
+        {
+            var bad = observations.ToArray(); bad[11] = bad[11] with { Slot = badSlot };
+            Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, bad, bitmap), "BitmapModelObservationSlot",
+                "negative out-of-range and duplicate slots cannot hide an omitted observation");
+        }
+        foreach (int covered in new[] { 0, -1, 13, int.MaxValue })
+            Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, observations,
+                new(binding, NtfsSyntheticBitmapPresence.Provided, covered, bits)), "BitmapModelCoverage",
+                "provided bitmap coverage must be a positive bounded declaration");
+        foreach (byte[] bytes in new[] { Array.Empty<byte>(), new byte[2], new byte[513] })
+            Check(Catch(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, observations,
+                new(binding, NtfsSyntheticBitmapPresence.Provided, 8, bytes))) is NtfsSyntheticBitmapException error &&
+                error.Code is "BitmapModelCoverage" or "BitmapModelByteBudget", "truncation extra bytes and oversize are rejected rather than treated as intentional partial coverage");
+        var badStatus = observations.ToArray(); badStatus[0] = badStatus[0] with { Status = (NtfsDecodeStatus)99 };
+        Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, badStatus, bitmap), "BitmapModelDecodeStatus", "undefined strict status cannot create another model category");
+        foreach (var badObservation in new[] { new NtfsSyntheticSlotObservation(0, NtfsDecodeStatus.Decoded, false),
+            new(0, NtfsDecodeStatus.Free, true), new(0, NtfsDecodeStatus.Decoded, true, true), new(0, NtfsDecodeStatus.Invalid, false, true) })
+        {
+            var bad = observations.ToArray(); bad[0] = badObservation;
+            Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, bad, bitmap), "BitmapModelObservationShape",
+                "contradictory header or zero-byte observations cannot claim valid synthetic shape");
+        }
+        foreach (string stage in new[] { "Before", "Count", "Index", "ThrowCount", "ThrowIndex" })
+        {
+            using var cancellation = new CancellationTokenSource(); var callbacks = new CallbackList(observations);
+            if (stage == "Before") cancellation.Cancel();
+            if (stage == "Count") callbacks.OnCount = cancellation.Cancel;
+            if (stage == "Index") callbacks.OnIndex = _ => cancellation.Cancel();
+            if (stage == "ThrowCount") { callbacks.OnCount = cancellation.Cancel; callbacks.ThrowCount = true; }
+            if (stage == "ThrowIndex") { callbacks.OnIndex = _ => cancellation.Cancel(); callbacks.ThrowIndex = true; }
+            NtfsSyntheticBitmapReport? partial = null;
+            var error = Catch(() => partial = NtfsSyntheticBitmapModel.Evaluate(binding, binding, callbacks, bitmap, cancellation.Token));
+            Check(error is OperationCanceledException && partial == null && bits.SequenceEqual(beforeBits),
+                "cancellation at input callback boundaries publishes no partial aggregate or mutated bitmap");
+        }
+        foreach (bool atCount in new[] { false, true })
+        {
+            var callbacks = new CallbackList(observations) { ThrowCount = atCount, ThrowIndex = !atCount };
+            Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, callbacks, bitmap), "BitmapModelInput",
+                "input accessor exceptions become fixed model codes without private callback messages");
+        }
+        foreach (string boundary in new[] { "Count", "Index", "Memory" })
+        foreach (bool forgeModelError in new[] { false, true })
+        foreach (bool cancelAtBoundary in new[] { false, true })
+        {
+            using var cancellation = new CancellationTokenSource();
+            const string marker = "SyntheticPrivateAccessor";
+            Exception forged = forgeModelError ? new NtfsSyntheticBitmapException(marker) : new OperationCanceledException(marker);
+            Action? cancel = cancelAtBoundary ? cancellation.Cancel : null;
+            using var memory = new CallbackMemory(forged, cancel);
+            var callbacks = new CallbackList(observations);
+            var input = bitmap;
+            if (boundary == "Count") { callbacks.CountError = forged; callbacks.OnCount = cancel; }
+            if (boundary == "Index") { callbacks.IndexError = forged; callbacks.OnIndex = _ => cancel?.Invoke(); }
+            if (boundary == "Memory") input = new(binding, NtfsSyntheticBitmapPresence.Provided, 8, memory.View);
+            NtfsSyntheticBitmapReport? partial = null;
+            var error = Catch(() => partial = NtfsSyntheticBitmapModel.Evaluate(binding, binding, callbacks, input, cancellation.Token));
+            bool safe = cancelAtBoundary ? error is OperationCanceledException canceled && canceled.CancellationToken == cancellation.Token &&
+                !canceled.Message.Contains(marker, StringComparison.Ordinal) :
+                error is NtfsSyntheticBitmapException model && model.Code == "BitmapModelInput" && model.Message == "BitmapModelInput" && model.InnerException == null;
+            Check(safe && partial == null, "forged accessor cancellation or model codes cannot bypass fixed input errors or caller cancellation priority");
+        }
+        string json = JsonSerializer.Serialize(report);
+        Check(!json.Contains("SourceToken", StringComparison.Ordinal) && !json.Contains("MapEpoch", StringComparison.Ordinal) &&
+            !json.Contains("HeaderInUse", StringComparison.Ordinal) && !json.Contains("Bytes", StringComparison.Ordinal),
+            "synthetic result exposes aggregate claims without tokens raw bitmap or per-slot observations");
+        return passed;
+    }
+}
diff --git a/tests/Prototypes/Ntfs/NtfsSyntheticBitmapModel.cs b/tests/Prototypes/Ntfs/NtfsSyntheticBitmapModel.cs
new file mode 100644
index 0000000..8ce3c96
--- /dev/null
+++ b/tests/Prototypes/Ntfs/NtfsSyntheticBitmapModel.cs
@@ -0,0 +1,145 @@
+using System.Diagnostics.CodeAnalysis;
+
+namespace DiskAtlas.NtfsPrototype;
+
+internal enum NtfsSyntheticBitmapPresence { Missing, Provided }
+internal enum NtfsSyntheticAllocationState { Allocated, Unallocated, Unknown }
+internal sealed record NtfsSyntheticBitmapBinding(object SourceToken, object MapEpoch, int Slots);
+internal sealed record NtfsSyntheticBitmapInput(NtfsSyntheticBitmapBinding Binding,
+    NtfsSyntheticBitmapPresence Presence, int CoveredSlots, ReadOnlyMemory<byte> Bytes);
+internal sealed record NtfsSyntheticSlotObservation(int Slot, NtfsDecodeStatus Status, bool? HeaderInUse, bool AllZero = false);
+internal sealed record NtfsSyntheticBitmapCrossCount(string Allocation, string Status, int Count);
+internal sealed record NtfsSyntheticBitmapReport(string Revision, string EvidenceKind, int Slots, int CoveredSlots,
+    bool BitmapCoverageComplete, int Allocated, int Unallocated, int Unknown, int Decoded, int Free, int Invalid, int Unsupported,
+    int HeaderCompared, int HeaderDisagreements, int AllZeroInvalid, int AllZeroAllocated, int AllZeroUnallocated,
+    int AllZeroUnknown, IReadOnlyList<NtfsSyntheticBitmapCrossCount> CrossCounts);
+internal sealed class NtfsSyntheticBitmapException(string code) : IOException(code)
+{
+    internal string Code { get; } = code;
+}
+
+// Pure synthetic protocol only. The tokens are in-memory simulation identities,
+// not a validated volume, snapshot, bitmap attribute or reading lease. LSB-first
+// is this model's byte encoding and does not certify any real NTFS extraction.
+internal static class NtfsSyntheticBitmapModel
+{
+    internal const int MaximumSlots = 4096;
+    internal const int MaximumBitmapBytes = 512;
+
+    private static void Require([DoesNotReturnIf(false)] bool condition, string code)
+    { if (!condition) throw new NtfsSyntheticBitmapException(code); }
+
+    private static T ReadExternal<T>(Func<T> access, CancellationToken token)
+    {
+        T value;
+        try { value = access(); }
+        catch (Exception)
+        {
+            // External accessors can impersonate either of our exception types.
+            // Only the supplied cancellation token and our own fixed codes count.
+            token.ThrowIfCancellationRequested();
+            throw new NtfsSyntheticBitmapException("BitmapModelInput");
+        }
+        token.ThrowIfCancellationRequested();
+        return value;
+    }
+
+    internal static NtfsSyntheticBitmapReport Evaluate(NtfsSyntheticBitmapBinding expectedBinding,
+        NtfsSyntheticBitmapBinding observationBinding, IReadOnlyList<NtfsSyntheticSlotObservation> observations,
+        NtfsSyntheticBitmapInput bitmap, CancellationToken token = default)
+    {
+        try { return EvaluateCore(expectedBinding, observationBinding, observations, bitmap, token); }
+        catch (OperationCanceledException) { throw; }
+        catch (NtfsSyntheticBitmapException) { throw; }
+        catch (Exception)
+        {
+            // A failing external memory/list accessor must not publish private
+            // messages. A cancellation triggered by that accessor takes priority.
+            token.ThrowIfCancellationRequested();
+            throw new NtfsSyntheticBitmapException("BitmapModelInput");
+        }
+    }
+
+    private static NtfsSyntheticBitmapReport EvaluateCore(NtfsSyntheticBitmapBinding expectedBinding,
+        NtfsSyntheticBitmapBinding observationBinding, IReadOnlyList<NtfsSyntheticSlotObservation> observations,
+        NtfsSyntheticBitmapInput bitmap, CancellationToken token)
+    {
+        token.ThrowIfCancellationRequested();
+        Require(expectedBinding != null && observationBinding != null && observations != null && bitmap != null,
+            "BitmapModelInput");
+        Require(expectedBinding.Slots is >= 1 and <= MaximumSlots, "BitmapModelSlotBudget");
+        Require(expectedBinding.SourceToken != null && expectedBinding.MapEpoch != null, "BitmapModelBinding");
+        bool SameBinding(NtfsSyntheticBitmapBinding? candidate) => candidate != null &&
+            ReferenceEquals(expectedBinding.SourceToken, candidate.SourceToken) &&
+            ReferenceEquals(expectedBinding.MapEpoch, candidate.MapEpoch) && candidate.Slots == expectedBinding.Slots;
+        Require(SameBinding(observationBinding) && SameBinding(bitmap.Binding), "BitmapModelBinding");
+        int slots = expectedBinding.Slots;
+        int byteLength = bitmap.Bytes.Length;
+        Require(byteLength is >= 0 and <= MaximumBitmapBytes, "BitmapModelByteBudget");
+        Require(bitmap.Presence is NtfsSyntheticBitmapPresence.Missing or NtfsSyntheticBitmapPresence.Provided, "BitmapModelPresence");
+        if (bitmap.Presence == NtfsSyntheticBitmapPresence.Missing)
+            Require(bitmap.CoveredSlots == 0 && byteLength == 0, "BitmapModelCoverage");
+        else
+            Require(bitmap.CoveredSlots >= 1 && bitmap.CoveredSlots <= slots &&
+                byteLength == (bitmap.CoveredSlots + 7) / 8, "BitmapModelCoverage");
+        int observationCount = ReadExternal(() => observations.Count, token);
+        Require(observationCount == slots && observationCount is >= 1 and <= MaximumSlots, "BitmapModelObservationBudget");
+
+        // All declared budgets and shapes are checked before either copy. An
+        // explicit partial coverage is distinct from a truncated Provided input.
+        byte[] privateBits = ReadExternal(() => bitmap.Bytes.ToArray(), token);
+        var privateObservations = new NtfsSyntheticSlotObservation[slots];
+        var seen = new bool[slots];
+        for (int i = 0; i < slots; i++)
+        {
+            token.ThrowIfCancellationRequested();
+            var observation = ReadExternal(() => observations[i], token);
+            Require(observation != null, "BitmapModelObservationShape");
+            Require(observation.Slot >= 0 && observation.Slot < slots && !seen[observation.Slot], "BitmapModelObservationSlot");
+            Require(observation.Status is NtfsDecodeStatus.Decoded or NtfsDecodeStatus.Free or NtfsDecodeStatus.Invalid or NtfsDecodeStatus.Unsupported,
+                "BitmapModelDecodeStatus");
+            // These are only caller-supplied synthetic observations. Full zero
+            // bytes have no verified header, and cannot claim a Free decoder result.
+            Require(!observation.AllZero || observation.Status == NtfsDecodeStatus.Invalid && !observation.HeaderInUse.HasValue,
+                "BitmapModelObservationShape");
+            Require(!observation.HeaderInUse.HasValue ||
+                observation.Status != NtfsDecodeStatus.Decoded && observation.Status != NtfsDecodeStatus.Free ||
+                observation.Status == NtfsDecodeStatus.Decoded && observation.HeaderInUse == true ||
+                observation.Status == NtfsDecodeStatus.Free && observation.HeaderInUse == false,
+                "BitmapModelObservationShape");
+            seen[observation.Slot] = true;
+            privateObservations[i] = observation;
+        }
+
+        int[] allocations = new int[3], statuses = new int[4], cross = new int[12], zero = new int[3];
+        int headerCompared = 0, headerDisagreements = 0, allZeroInvalid = 0;
+        foreach (var observation in privateObservations)
+        {
+            token.ThrowIfCancellationRequested();
+            var allocation = NtfsSyntheticAllocationState.Unknown;
+            if (bitmap.Presence == NtfsSyntheticBitmapPresence.Provided && observation.Slot < bitmap.CoveredSlots)
+                allocation = (privateBits[observation.Slot / 8] & (1 << (observation.Slot % 8))) != 0
+                    ? NtfsSyntheticAllocationState.Allocated : NtfsSyntheticAllocationState.Unallocated;
+            int a = (int)allocation, s = (int)observation.Status;
+            allocations[a]++; statuses[s]++; cross[a * 4 + s]++;
+            if (allocation != NtfsSyntheticAllocationState.Unknown && observation.HeaderInUse.HasValue)
+            {
+                headerCompared++;
+                if ((allocation == NtfsSyntheticAllocationState.Allocated) != observation.HeaderInUse.Value) headerDisagreements++;
+            }
+            if (observation.AllZero) { allZeroInvalid++; zero[a]++; }
+        }
+        Require(allocations.Sum() == slots && statuses.Sum() == slots && cross.Sum() == slots &&
+            zero.Sum() == allZeroInvalid && allZeroInvalid <= statuses[(int)NtfsDecodeStatus.Invalid] &&
+            headerDisagreements <= headerCompared, "BitmapModelAggregation");
+        var rows = new List<NtfsSyntheticBitmapCrossCount>(12);
+        foreach (var allocation in Enum.GetValues<NtfsSyntheticAllocationState>())
+            foreach (var status in Enum.GetValues<NtfsDecodeStatus>())
+                rows.Add(new(allocation.ToString(), status.ToString(), cross[(int)allocation * 4 + (int)status]));
+        token.ThrowIfCancellationRequested();
+        return new("synthetic-mft-bitmap-v1", "Synthetic", slots, bitmap.CoveredSlots,
+            bitmap.Presence == NtfsSyntheticBitmapPresence.Provided && bitmap.CoveredSlots == slots,
+            allocations[0], allocations[1], allocations[2], statuses[0], statuses[1], statuses[2], statuses[3],
+            headerCompared, headerDisagreements, allZeroInvalid, zero[0], zero[1], zero[2], rows.AsReadOnly());
+    }
+}
diff --git a/tests/Prototypes/Ntfs/NtfsSyntheticBitmapModelTests.cs b/tests/Prototypes/Ntfs/NtfsSyntheticBitmapModelTests.cs
new file mode 100644
index 0000000..81d522f
--- /dev/null
+++ b/tests/Prototypes/Ntfs/NtfsSyntheticBitmapModelTests.cs
@@ -0,0 +1,163 @@
+namespace DiskAtlas.NtfsPrototype;
+
+// Pure aggregate-model tests. No record bytes, paths, Native calls or real
+// source tokens are constructed; bit encoding below belongs to this model only.
+internal static class NtfsSyntheticBitmapModelTests
+{
+    internal static int Run()
+    {
+        int passed = 0;
+        void Check(bool condition, string name)
+        {
+            if (!condition) throw new InvalidOperationException("Synthetic bitmap check failed: " + name);
+            passed++; Console.WriteLine("PASS synthetic bitmap " + name);
+        }
+        void Rejected(Action action, string code, string name)
+        {
+            bool rejected = false;
+            try { action(); }
+            catch (NtfsSyntheticBitmapException error) { rejected = error.Code == code && error.Message == code && error.InnerException == null; }
+            Check(rejected, name);
+        }
+        var binding = Binding(12);
+        var observations = Observations(12);
+        byte[] bits = [0x0f];
+        var input = new NtfsSyntheticBitmapInput(binding, NtfsSyntheticBitmapPresence.Provided, 8, bits);
+        var result = NtfsSyntheticBitmapModel.Evaluate(binding, binding, observations, input);
+        Check(result is { Revision: "synthetic-mft-bitmap-v1", EvidenceKind: "Synthetic", Slots: 12, CoveredSlots: 8,
+            BitmapCoverageComplete: false, Allocated: 4, Unallocated: 4, Unknown: 4 },
+            "explicit partial coverage preserves three separate allocation declarations");
+        Check(result is { Decoded: 3, Free: 3, Invalid: 3, Unsupported: 3, HeaderCompared: 4, HeaderDisagreements: 2 },
+            "header disagreements are aggregate observations without rewriting any strict category");
+        Check(result.CrossCounts.Count == 12 && result.CrossCounts.All(row => row.Count == 1) &&
+            result.CrossCounts.Sum(row => row.Count) == result.Slots,
+            "all twelve allocation and decode combinations are independently conserved");
+        Check(result.CrossCounts.Select(row => row.Allocation).Distinct().SequenceEqual(new[] { "Allocated", "Unallocated", "Unknown" }) &&
+            result.CrossCounts.Take(4).Select(row => row.Status).SequenceEqual(new[] { "Decoded", "Free", "Invalid", "Unsupported" }),
+            "cross counts have fixed allocation and decoder enum order including zero buckets");
+        var missing = NtfsSyntheticBitmapModel.Evaluate(binding, binding, observations,
+            new(binding, NtfsSyntheticBitmapPresence.Missing, 0, ReadOnlyMemory<byte>.Empty));
+        Check(missing is { Allocated: 0, Unallocated: 0, Unknown: 12, HeaderCompared: 0, HeaderDisagreements: 0,
+            BitmapCoverageComplete: false } && missing.Decoded == result.Decoded && missing.Free == result.Free &&
+            missing.Invalid == result.Invalid && missing.Unsupported == result.Unsupported,
+            "missing bitmap never converts unknown declarations into unallocated or changes decode results");
+        var zeroBinding = Binding(3);
+        NtfsSyntheticSlotObservation[] zeroObservations = [
+            new(0, NtfsDecodeStatus.Invalid, null, true), new(1, NtfsDecodeStatus.Invalid, null, true),
+            new(2, NtfsDecodeStatus.Invalid, null, true)];
+        var zeros = NtfsSyntheticBitmapModel.Evaluate(zeroBinding, zeroBinding, zeroObservations,
+            new(zeroBinding, NtfsSyntheticBitmapPresence.Provided, 2, new byte[] { 1 }));
+        Check(zeros is { Invalid: 3, Free: 0, AllZeroInvalid: 3, AllZeroAllocated: 1, AllZeroUnallocated: 1, AllZeroUnknown: 1,
+            Allocated: 1, Unallocated: 1, Unknown: 1, HeaderCompared: 0 },
+            "all-zero declarations can be allocated unallocated or unknown while remaining strictly invalid");
+        var fullBinding = Binding(9);
+        var fullObservations = Observations(9);
+        var full = NtfsSyntheticBitmapModel.Evaluate(fullBinding, fullBinding, fullObservations,
+            new(fullBinding, NtfsSyntheticBitmapPresence.Provided, 9, new byte[] { 0x80, 0x01 }));
+        Check(full is { BitmapCoverageComplete: true, Allocated: 2, Unallocated: 7, Unknown: 0 },
+            "LSB-first model encoding crosses the seven and eight slot boundary");
+        var padding = NtfsSyntheticBitmapModel.Evaluate(fullBinding, fullBinding, fullObservations,
+            new(fullBinding, NtfsSyntheticBitmapPresence.Provided, 9, new byte[] { 0x80, 0xff }));
+        Check(SameAggregates(full, padding), "unused high padding bits never create extra known slots or counts");
+        var partialPadding = NtfsSyntheticBitmapModel.Evaluate(fullBinding, fullBinding, fullObservations,
+            new(fullBinding, NtfsSyntheticBitmapPresence.Provided, 7, new byte[] { 0x80 }));
+        Check(partialPadding is { Allocated: 0, Unallocated: 7, Unknown: 2 },
+            "padding set bits beyond declared coverage do not remove unknown state");
+        var maximumBinding = Binding(4096);
+        var maximumObservations = Observations(4096);
+        byte[] maximumBits = new byte[512]; maximumBits[^1] = 0x80;
+        var maximum = NtfsSyntheticBitmapModel.Evaluate(maximumBinding, maximumBinding, maximumObservations,
+            new(maximumBinding, NtfsSyntheticBitmapPresence.Provided, 4096, maximumBits));
+        Check(maximum is { Slots: 4096, Allocated: 1, Unallocated: 4095, Unknown: 0, BitmapCoverageComplete: true } &&
+            maximum.CrossCounts.Sum(row => row.Count) == 4096,
+            "the exact slot and byte budgets retain the final four-thousand-ninety-fifth bit");
+        var one = Binding(1);
+        var single = NtfsSyntheticBitmapModel.Evaluate(one, one, Observations(1),
+            new(one, NtfsSyntheticBitmapPresence.Provided, 1, new byte[] { 0 }));
+        Check(single is { Slots: 1, Decoded: 1, Unallocated: 1, HeaderDisagreements: 1 } &&
+            single.CrossCounts.Count == 12 && single.CrossCounts.Count(row => row.Count == 0) == 11,
+            "the smallest valid range still publishes all twelve aggregate buckets");
+        var shuffled = NtfsSyntheticBitmapModel.Evaluate(binding, binding, observations.Reverse().ToArray(), input);
+        Check(SameAggregates(result, shuffled), "complete unique observations may arrive in any order");
+        var sameIdentity = new NtfsSyntheticBitmapBinding(binding.SourceToken, binding.MapEpoch, binding.Slots);
+        Check(SameAggregates(result, NtfsSyntheticBitmapModel.Evaluate(binding, sameIdentity, observations,
+            input with { Binding = sameIdentity })), "a new binding container preserves the same exact simulated source and epoch objects");
+        byte[] originalBits = bits.ToArray(); var originalObservations = observations.ToArray();
+        NtfsSyntheticBitmapModel.Evaluate(binding, binding, observations, input);
+        Check(bits.SequenceEqual(originalBits) && observations.SequenceEqual(originalObservations),
+            "evaluation never changes caller bitmap or observation arrays");
+        bits[0] = 0xff; observations[0] = new(0, NtfsDecodeStatus.Invalid, null);
+        Check(result.Allocated == 4 && result.Decoded == 3 && result.CrossCounts.All(row => row.Count == 1),
+            "later caller input changes cannot alter a published aggregate result");
+        bool immutable = false;
+        try { ((IList<NtfsSyntheticBitmapCrossCount>)result.CrossCounts).Clear(); } catch (NotSupportedException) { immutable = true; }
+        Check(immutable, "published cross counts are immutable and retain neither input arrays nor tokens");
+        string[] fields = typeof(NtfsSyntheticBitmapReport).GetProperties(System.Reflection.BindingFlags.Instance |
+            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic).Select(property => property.Name).ToArray();
+        Check(fields.All(field => field is not "Binding" and not "SourceToken" and not "MapEpoch" and not "Bytes" and not "Observations" and not "Slot"),
+            "result schema has no bitmap tokens source identities or per-slot observations");
+
+        foreach (int badSlots in new[] { -1, 0, 4097, int.MaxValue })
+        {
+            var bad = Binding(badSlots);
+            Rejected(() => NtfsSyntheticBitmapModel.Evaluate(bad, bad, [], new(bad, NtfsSyntheticBitmapPresence.Missing, 0, default)),
+                "BitmapModelSlotBudget", "invalid slot budgets are rejected before input copies");
+        }
+        foreach (var badInput in new[] {
+            new NtfsSyntheticBitmapInput(binding, NtfsSyntheticBitmapPresence.Provided, 8, ReadOnlyMemory<byte>.Empty),
+            new NtfsSyntheticBitmapInput(binding, NtfsSyntheticBitmapPresence.Provided, 8, new byte[2]),
+            new NtfsSyntheticBitmapInput(binding, NtfsSyntheticBitmapPresence.Provided, 13, new byte[2]),
+            new NtfsSyntheticBitmapInput(binding, NtfsSyntheticBitmapPresence.Provided, 0, ReadOnlyMemory<byte>.Empty),
+            new NtfsSyntheticBitmapInput(binding, NtfsSyntheticBitmapPresence.Missing, 1, ReadOnlyMemory<byte>.Empty),
+            new NtfsSyntheticBitmapInput(binding, NtfsSyntheticBitmapPresence.Missing, 0, new byte[1]) })
+            Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, Observations(12), badInput),
+                "BitmapModelCoverage", "truncated excess or contradictory coverage is not intentional partial coverage");
+        Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, Observations(12), input with { Bytes = new byte[513] }),
+            "BitmapModelByteBudget", "oversized bitmap input cannot expand the declared model budget");
+        Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, Observations(12), input with { Presence = (NtfsSyntheticBitmapPresence)99 }),
+            "BitmapModelPresence", "unknown bitmap presence enum values are rejected");
+        var foreignSource = binding with { SourceToken = new object() };
+        var foreignMap = binding with { MapEpoch = new object() };
+        foreach (var foreign in new[] { foreignSource, foreignMap, binding with { Slots = 11 } })
+        {
+            Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, foreign, Observations(12), input),
+                "BitmapModelBinding", "observation source map or range mismatch is rejected");
+            Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, Observations(12), input with { Binding = foreign }),
+                "BitmapModelBinding", "bitmap source map or range mismatch is rejected");
+        }
+        Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, Observations(11), input),
+            "BitmapModelObservationBudget", "missing observations cannot be silently filled with unknown or free");
+        Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, Observations(13), input),
+            "BitmapModelObservationBudget", "excess observations cannot expand a declared range");
+        foreach (var badObservation in new NtfsSyntheticSlotObservation?[] {
+            null, new(0, NtfsDecodeStatus.Free, false, true), new(0, NtfsDecodeStatus.Invalid, false, true),
+            new(0, NtfsDecodeStatus.Decoded, false), new(0, NtfsDecodeStatus.Free, true) })
+        {
+            var altered = Observations(12); altered[0] = badObservation!;
+            Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, altered, input),
+                "BitmapModelObservationShape", "self-contradictory zero or header observations are rejected without inference");
+        }
+        foreach (int slot in new[] { -1, 1, 12, int.MaxValue })
+        {
+            var altered = Observations(12); altered[0] = altered[0] with { Slot = slot };
+            Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, altered, input),
+                "BitmapModelObservationSlot", "negative duplicate missing or overflowing slot identities are rejected");
+        }
+        var badStatus = Observations(12); badStatus[0] = badStatus[0] with { Status = (NtfsDecodeStatus)99 };
+        Rejected(() => NtfsSyntheticBitmapModel.Evaluate(binding, binding, badStatus, input), "BitmapModelDecodeStatus",
+            "unknown strict classification enum values cannot enter cross counts");
+        using var cancellation = new CancellationTokenSource(); cancellation.Cancel();
+        bool canceled = false;
+        try { NtfsSyntheticBitmapModel.Evaluate(binding, binding, Observations(12), input, cancellation.Token); }
+        catch (OperationCanceledException) { canceled = true; }
+        Check(canceled, "pre-cancellation publishes no aggregate result");
+        return passed;
+    }
+
+    private static NtfsSyntheticBitmapBinding Binding(int slots) => new(new object(), new object(), slots);
+    private static NtfsSyntheticSlotObservation[] Observations(int slots) => Enumerable.Range(0, slots)
+        .Select(slot => new NtfsSyntheticSlotObservation(slot, (NtfsDecodeStatus)(slot % 4), (slot % 4) switch { 0 => true, 1 => false, _ => (bool?)null }))
+        .ToArray();
+    private static bool SameAggregates(NtfsSyntheticBitmapReport first, NtfsSyntheticBitmapReport second) =>
+        (first with { CrossCounts = second.CrossCounts }) == second && first.CrossCounts.SequenceEqual(second.CrossCounts);
+}

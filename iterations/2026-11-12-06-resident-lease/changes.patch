+            ExclusiveReopen("success releases its handle for an exclusive writer");
+            FailedAfterOpen(Read(candidateVolume: volume ^ 1), "IdentityChanged", "wrong volume stays unknown");
+            ushort sequence = (ushort)(record.Reference >> 48);

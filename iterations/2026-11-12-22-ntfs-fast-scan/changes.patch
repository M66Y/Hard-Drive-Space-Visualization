+                foreach (var name in Records[target.Storage.Identity.Low].Names.Where(name => name.Namespace != 2))
+                    directory.MutableChildren.Add(DiskEntry.FromName(name.Name, false, directory, ".bin").WithMetadata(target.Storage,

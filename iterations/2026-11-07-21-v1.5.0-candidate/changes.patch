+#requires -Version 7.4
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'PackageAcceptance.Guards.ps1')
+$script:passed = 0
+function Check([bool]$Condition, [string]$Name) {
+    if (-not $Condition) { throw ('FAIL ' + $Name) }
+    $script:passed++; Write-Host ('PASS ' + $Name)
+}
+function Reject([scriptblock]$Action, [string]$Name) {
+    $rejected = $false
+    try { & $Action | Out-Null } catch { $rejected = $true }
+    Check $rejected $Name
+}
+Reject { Get-PackageAcceptanceProfile $false $false } 'formal assets require explicit candidate opt-in'
+Reject { Get-PackageAcceptanceProfile $true $true } 'formal opt-in cannot silently test LOCAL TEST assets'
+$local = Get-PackageAcceptanceProfile $true $false
+$formal = Get-PackageAcceptanceProfile $false $true
+Check ($local.Id -eq 'AsukaLens.LocalTest' -and $formal.Id -eq 'AsukaLens.8E3208AB-7151-4AC5-983C-22C5529B8746') 'separate exact installer identities'
+foreach ($profile in @($local,$formal)) {
+    Check ($profile.Locations.Count -eq 10 -and @($profile.Locations | Select-Object -Unique).Count -eq 10) 'all registry views, shortcuts, default installation and recovery checked'
+    Assert-PackageAcceptanceLocationsEmpty $profile { param($Path) $false }
+    Check $true 'empty state allows acceptance'
+    foreach ($occupied in $profile.Locations) {
+        Reject { Assert-PackageAcceptanceLocationsEmpty $profile { param($Path) $Path -eq $occupied } } 'any prior ownership blocks acceptance'
+    }
+    Reject { Assert-PackageAcceptanceLocationsEmpty $profile { throw 'read denied' } } 'inventory failure cannot permit installation'
+}
+$owned = Join-Path $PSScriptRoot '../artifacts/owned-installation'
+Assert-PackageAcceptanceInstallOwned ([IO.Path]::GetFullPath($owned) + '\') $owned
+Check $true 'owned registered installation allows cleanup'
+Reject { Assert-PackageAcceptanceInstallOwned '' $owned } 'missing registered location blocks cleanup'
+Reject { Assert-PackageAcceptanceInstallOwned ($owned + '-unowned') $owned } 'neighboring installation blocks cleanup'
+Write-Host "$script:passed acceptance guard checks passed."
diff --git a/tests/PackageAcceptance.Guards.ps1 b/tests/PackageAcceptance.Guards.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..f5ed1464b8c5213da1443b106535030a7a08ddbe
--- /dev/null
+++ b/tests/PackageAcceptance.Guards.ps1
@@ -0,0 +1,30 @@
+# Identity selection is explicit. Formal candidate testing never adopts an existing installation.
+function Get-PackageAcceptanceProfile([bool]$LocalTest, [bool]$FormalCandidate) {
+    if ($LocalTest -eq $FormalCandidate) { throw 'Use LOCAL TEST assets by default, or explicitly opt into -FormalCandidate for committed candidate assets.' }
+    $name = if ($LocalTest) { 'AsukaLens (LOCAL TEST)' } else { 'AsukaLens' }
+    $id = if ($LocalTest) { 'AsukaLens.LocalTest' } else { 'AsukaLens.8E3208AB-7151-4AC5-983C-22C5529B8746' }
+    $key = 'Software/Microsoft/Windows/CurrentVersion/Uninstall/' + $id + '_is1'
+    $registry = 'HKCU:/' + $key
+    $shortcuts = @('Programs','DesktopDirectory' | ForEach-Object { Join-Path ([Environment]::GetFolderPath($_)) ($name + '.lnk') })
+    $recovery = Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) ('AsukaLens/InstallerRecovery-' + $id)
+    $locations = @($registry, ('HKLM:/' + $key), ('HKCU:/Software/WOW6432Node/' + $key.Substring(9)), ('HKLM:/Software/WOW6432Node/' + $key.Substring(9)))
+    $locations += $shortcuts
+    $locations += @('CommonPrograms','CommonDesktopDirectory' | ForEach-Object { Join-Path ([Environment]::GetFolderPath($_)) ($name + '.lnk') })
+    $locations += Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) ('Programs/' + $name)
+    $locations += $recovery
+    return [pscustomobject]@{ Name=$name; Id=$id; Registry=$registry; Shortcuts=$shortcuts; Recovery=$recovery; Locations=$locations }
+}
+
+function Assert-PackageAcceptanceLocationsEmpty($Profile, [scriptblock]$Exists = { param($Path) Test-Path -LiteralPath $Path -ErrorAction Stop }) {
+    foreach ($path in $Profile.Locations) {
+        if (& $Exists $path) { throw 'Existing installation, shortcut, default directory or recovery data detected. Candidate acceptance refuses to replace it.' }
+    }
+}
+
+function Assert-PackageAcceptanceInstallOwned([string]$RegisteredPath, [string]$ExpectedPath) {
+    if ([string]::IsNullOrWhiteSpace($RegisteredPath) -or
+        -not [IO.Path]::GetFullPath($RegisteredPath).TrimEnd('\','/').Equals(
+            [IO.Path]::GetFullPath($ExpectedPath).TrimEnd('\','/'), [StringComparison]::OrdinalIgnoreCase)) {
+        throw 'Installation ownership changed; refusing automatic uninstall.'
+    }
+}
